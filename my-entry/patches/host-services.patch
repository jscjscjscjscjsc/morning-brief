+# octosense-model-service — the `model` host service, for a development host.
+#
+# A store app may ask for the `model` capability and call `model.complete`
+# (PUBLISHING: "Make bounded one-shot model calls through the host's `model`
+# service"). The shipping OctoSense shells serve it. `card-host` serves no
+# host services at all (DEVELOPMENT § "card-host registers no host services"),
+# so an app that uses `model` cannot be built or verified against the
+# reference host. This crate answers `model.complete` there, with the same
+# contract, so a `model`-using app is developable locally.
+#
+# Not a substitute for the shipping service: it holds no per-app budget and
+# writes nothing to disk. Its key comes from the environment that started the
+# host, so it never reaches the app.
+[package]
+name = "octosense-model-service"
+version = "0.1.0"
+edition = "2021"
+license = "Apache-2.0"
+publish = false
+description = "Answers model.complete and the host's voice methods for a development host, so an app that uses the `model` capability can be built and verified locally"
+
+[dependencies]
+octosense-appstore = { path = "../appstore" }
+serde_json = "1"
+# The edge-tts bridge hands PCM back as base64 inside its JSON line replies.
+base64 = "0.22"
+# `json` is what `send_json` lives behind; the default features carry TLS.
+ureq = { version = "3", features = ["json"] }
+# The OS's own speech engines (Windows.Media.SpeechSynthesis / SpeechRecognition,
+# Apple Speech, Android SpeechRecognizer/TextToSpeech). No models, no network.
+makepad-system-speech = { path = "../../../makepad/libs/system_speech" }
