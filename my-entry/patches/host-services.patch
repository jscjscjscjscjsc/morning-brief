@@ -0,0 +1,252 @@
+//! Voice for contained apps: the OS speech engines behind `model.speak` /
+//! `model.listen_*`, and the PCM queue the host app plays.
+//!
+//! The app never touches a device or a model file. It asks the host to say a
+//! sentence; the host renders it with the operating system's own voice and
+//! hands the PCM to the app's audio output, which the host owns. It asks the
+//! host to open the microphone; the host runs the OS recognizer and hands back
+//! transcripts. Both directions are poll-shaped and never block the card.
+//!
+//! Why `model.` and not a capability of its own: the published capability set
+//! has no voice family (PUBLISHING: `llm` serves `os.` system apps only, and
+//! there is no speech capability for a store app). This host therefore answers
+//! voice under the family the app already holds — `model`, "the host's AI
+//! services" — so a card that speaks needs no capability it is not already
+//! granted. A host without these methods answers an error and the card falls
+//! back to text, which is the contract every caller here already handles.
+pub mod edge;
+mod player;
+mod stt;
+
+pub use player::{player, Player};
+pub use stt::{listen_poll, listen_start, listen_stop};
+
+use makepad_system_speech::tts::{self};
+use makepad_system_speech::TtsOptions;
+use serde_json::{json, Value};
+
+/// `model.speech` — what this machine can actually do, so a card shows the
+/// controls it has rather than the ones it hopes for.
+pub fn speech_status() -> Value {
+    let mut voices: Vec<Value> = Vec::new();
+    // 咕嘎的软萌音排在最前：卡片那边的优选表把 Xiaoyi 放在第 0 位，
+    // 「和桌面版一个声音」就是靠这里把它报上去的。没有桥就不报，
+    // 卡片自动退到系统引擎里最像人的那把（行为与本模块加入前一致）。
+    if edge::configured() {
+        voices.extend(edge::voices());
+    }
+    voices.extend(tts::voices().into_iter().map(|voice| {
+        json!({
+            "id": voice.id,
+            "name": voice.name,
+            "language": voice.language,
+            "gender": format!("{:?}", voice.gender).to_lowercase(),
+            "offline": voice.offline,
+        })
+    }));
+    json!({
+        "tts": {
+            "available": tts::available(),
+            "engine": tts::engine_name(),
+            "voices": voices,
+        },
+        "stt": {
+            "available": makepad_system_speech::stt::available(),
+            "engine": makepad_system_speech::stt::engine_name(),
+            "caps": {
+                "mic": makepad_system_speech::stt::capabilities().engine_mic,
+                "partial": makepad_system_speech::stt::capabilities().partial_results,
+                "offline": makepad_system_speech::stt::capabilities().offline,
+            },
+        },
+    })
+}
+
+/// The most natural voice this machine has, for a card that asks for a
+/// language without naming a voice.
+///
+/// Voices differ a lot in how human they sound: Windows' older SAPI voices
+/// are flat, while the newer `Natural` / `Neural` ones and cloud neural
+/// voices named like `zh-CN-XiaoxiaoNeural` are much closer to a person
+/// reading the news. A card that asks for a Chinese briefing should get the
+/// best voice installed, not whichever one the engine happens to default to.
+///
+/// `PREFERRED` is ordered best-first and matched as substrings, so the same
+/// table covers SAPI, OneCore and edge-tts style ids. `Xiaoyi` sits right
+/// after `Xiaoxiao` on purpose: it is the soft girlish voice the desktop
+/// penguin uses, so a machine that has it sounds the way that pet does.
+pub fn pick_voice(language: &str) -> Option<String> {
+    // Order matters, and not only between engines.
+    //
+    // A Windows install with no neural packs still ships three Chinese
+    // OneCore voices: Huihui, Kangkang (male) and Yaoyao. Of those, Yaoyao is
+    // the young, girlish one — the nearest thing to the penguin's Xiaoyi —
+    // while Huihui is a mature woman. Listing Huihui first made that machine
+    // fall through to it, so the pet and the card sounded like two different
+    // people; Yaoyao has to come first among the old SAPI voices.
+    //
+    // The male voices stay at the end on purpose: a news briefing read by a
+    // man is a different product, not a lower-quality version of this one.
+    const PREFERRED: &[&str] = &[
+        "Natural", "Neural", "Xiaoxiao", "Xiaoyi", "Yunxia", "Yaoyao", "Huihui", "Yunyang", "Yunxi",
+    ];
+    let tag = language.split('-').next().unwrap_or(language).to_lowercase();
+    let mut best: Option<(usize, String)> = None;
+    for voice in tts::voices() {
+        if !voice.language.to_lowercase().starts_with(&tag) {
+            continue;
+        }
+        let haystack = format!("{} {}", voice.id, voice.name);
+        let rank = PREFERRED
+            .iter()
+            .position(|needle| haystack.contains(needle))
+            .unwrap_or(PREFERRED.len());
+        if best.as_ref().map_or(true, |(best_rank, _)| rank < *best_rank) {
+            best = Some((rank, voice.id));
+        }
+    }
+    best.map(|(_, id)| id)
+}
+
+/// `model.speak {text, voice?, lang?, rate?, pitch?}` — render and start
+/// playing. Returns as soon as the audio is queued; playback continues while
+/// the card draws.
+///
+/// With no `voice`, the most natural one for `lang` is chosen instead of
+/// leaving the engine on its own (usually oldest) default.
+///
+/// `pitch` exists because a character voice is not only a choice of voice:
+/// the desktop penguin raises its pitch about 7% on top of a girlish speaker,
+/// and Windows' synthesizer can do exactly that. Engines without pitch control
+/// ignore it, so asking is always safe.
+pub fn speak(args: &Value) -> Result<Value, String> {
+    let text = args
+        .get("text")
+        .and_then(|v| v.as_str())
+        .unwrap_or("")
+        .trim()
+        .to_string();
+    if text.is_empty() {
+        return Err("speak needs text".into());
+    }
+    // A long passage is spoken in one go; the OS engine renders the whole
+    // utterance, and the card's own lines are short.
+    let text: String = text.chars().take(600).collect();
+    if !tts::available() {
+        return Err("no text-to-speech engine on this machine".into());
+    }
+    let mut options = TtsOptions::default();
+    options.language = args
+        .get("lang")
+        .and_then(|v| v.as_str())
+        .unwrap_or("zh-CN")
+        .to_string();
+    if let Some(voice) = args.get("voice").and_then(|v| v.as_str()) {
+        let voice = voice.trim();
+        if !voice.is_empty() {
+            options.voice = Some(voice.to_string());
+        }
+    }
+    // No voice named: pick the most human one for this language rather than
+    // leaving the engine on its own default, which is usually its oldest.
+    if options.voice.is_none() {
+        options.voice = pick_voice(&options.language);
+    }
+    if let Some(rate) = args.get("rate").and_then(|v| v.as_f64()) {
+        options.rate = (rate as f32).clamp(0.5, 2.0);
+    }
+    if let Some(pitch) = args.get("pitch").and_then(|v| v.as_f64()) {
+        options.pitch = (pitch as f32).clamp(0.5, 2.0);
+    }
+    let rate = options.rate;
+    let pitch = options.pitch;
+    let started = std::time::Instant::now();
+
+    // 咕嘎的嗓子优先：卡片点名 edge 音色（或这台机器配了桥）时先走桥 ——
+    // 它就是桌面版桌宠那把 edge-tts 软萌音，rate/pitch 也对齐桌面版。
+    // 桥不可用（没配、没网、超时）就原样落到下面的系统引擎，卡片无感。
+    let wants_edge = options
+        .voice
+        .as_deref()
+        .map(|v| v.starts_with("zh-CN-Xiaoyi") || v == edge::EDGE_VOICE)
+        .unwrap_or(false);
+    if wants_edge && edge::configured() {
+        match edge::synthesize(&text, edge::EDGE_VOICE, edge::EDGE_RATE, edge::EDGE_PITCH) {
+            Ok(audio) if !audio.is_empty() => {
+                let seconds = audio.duration_secs();
+                player().queue(audio.samples, audio.sample_rate, edge::EDGE_VOICE.to_string());
+                eprintln!(
+                    "model voice: spoke {} chars in {:.2}s via edge-tts ({}, rate {}, pitch {}) | text=[{}]",
+                    text.chars().count(),
+                    seconds,
+                    edge::EDGE_VOICE,
+                    edge::EDGE_RATE,
+                    edge::EDGE_PITCH,
+                    text,
+                );
+                return Ok(json!({
+                    "ok": true,
+                    "seconds": (seconds * 10.0).round() / 10.0,
+                    "sample_rate": audio.sample_rate,
+                    "voice": edge::EDGE_VOICE,
+                    "engine": "edge-tts",
+                    "rate": 1.15,
+                    "pitch": 1.07,
+                }));
+            }
+            Ok(_) => {
+                eprintln!("model voice: edge-tts returned an empty utterance; falling back to the OS engine");
+            }
+            Err(why) => {
+                eprintln!("model voice: edge-tts unavailable ({why}); falling back to the OS engine");
+            }
+        }
+    }
+
+    let audio = tts::synthesize(&text, &options).map_err(|error| error.to_string())?;
+    if audio.is_empty() {
+        return Err("the voice engine produced no audio".into());
+    }
+    let seconds = audio.duration_secs();
+    let voice = options.voice.clone().unwrap_or_else(|| "default".to_string());
+    player().queue(audio.samples, audio.sample_rate, voice.clone());
+    // The whole utterance, so a voice problem is diagnosable from the host log
+    // alone (the desktop-vs-card comparison starts by grepping this line).
+    eprintln!(
+        "model voice: spoke {} chars in {:.2}s ({} Hz, voice {}, rate {:.2}, pitch {:.2}) | text=[{}]",
+        text.chars().count(),
+        seconds,
+        audio.sample_rate,
+        voice,
+        rate,
+        pitch,
+        text,
+    );
+    Ok(json!({
+        "ok": true,
+        "seconds": (seconds * 10.0).round() / 10.0,
+        "sample_rate": audio.sample_rate,
+        "voice": voice,
+        "engine": tts::engine_name(),
+        "rate": rate,
+        "pitch": pitch,
+        "render_ms": started.elapsed().as_millis() as u64,
+        "chars": text.chars().count(),
+    }))
+}
+
+/// `model.speaking` — is the host still talking, so the card can animate.
+pub fn speaking() -> Value {
+    let state = player().state();
+    json!({
+        "playing": state.playing,
+        "seconds": (state.seconds * 10.0).round() / 10.0,
+        "voice": state.voice,
+    })
+}
+
+/// `model.speech_stop` — drop the queue, for a card that wants silence now.
+pub fn speech_stop() -> Value {
+    player().stop();
+    json!({"ok": true, "note": "the queue is empty"})
+}
