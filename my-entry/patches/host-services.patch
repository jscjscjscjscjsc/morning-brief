+++ b/crates/model-service/src/voice/edge.rs
@@ -0,0 +1,238 @@
+//! The girlish edge-tts voice, when this machine offers one.
+//!
+//! The desktop penguin speaks through edge-tts' `zh-CN-XiaoyiNeural` at
+//! rate +15% / pitch +14Hz. The Windows engines here have nothing that sits
+//! in the same place: Huihui is a mature voice and reads like a manual. So
+//! a card line spoken by the penguin and a card line spoken by the host
+//! engine are two different characters — the exact complaint this module
+//! exists to answer.
+//!
+//! The host process has no Python runtime (edge-tts is a Python package),
+//! and the card cannot reach a network service on its own. So this module
+//! keeps one long-lived helper process (`tools/edge_tts_bridge.py`) and
+//! talks to it over line-delimited JSON: one sentence in, PCM out. The
+//! helper caches synthesized sentences, so the second time a line is said
+//! it costs nothing.
+//!
+//! It is strictly optional. No script, no Python, no bridge: `synthesize`
+//! errors and the caller falls back to the OS engine, which is the behavior
+//! every existing install already has. Nothing here changes the card's
+//! contract — a card still asks `model.speak` and still names no engine.
+
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::sync::mpsc;
+use std::sync::{Mutex, OnceLock};
+use std::time::Duration;
+
+use base64::Engine as _;
+use serde_json::{json, Value};
+
+use makepad_system_speech::SpeechAudio;
+
+/// `zh-CN-XiaoyiNeural` is edge-tts' girlish speaker — the penguin's voice.
+pub const EDGE_VOICE: &str = "zh-CN-XiaoyiNeural";
+/// The desktop penguin speaks a little faster and a little higher.
+pub const EDGE_RATE: &str = "+15%";
+pub const EDGE_PITCH: &str = "+14Hz";
+
+/// How long one sentence may take before the helper is presumed stuck. The
+/// desktop app allows 20 s for a network synthesis; this is that budget.
+const REQUEST_TIMEOUT: Duration = Duration::from_millis(20000);
+/// After this many consecutive failures the bridge is left alone for the
+/// rest of the session: a machine without a working network should not pay
+/// a 20 s stall on every line.
+const MAX_CONSECUTIVE_FAILURES: u32 = 2;
+
+struct Bridge {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+impl Drop for Bridge {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+static BRIDGE: OnceLock<Mutex<Option<Bridge>>> = OnceLock::new();
+static FAILURES: OnceLock<Mutex<u32>> = OnceLock::new();
+
+fn bridge_slot() -> &'static Mutex<Option<Bridge>> {
+    BRIDGE.get_or_init(|| Mutex::new(None))
+}
+
+fn failures() -> &'static Mutex<u32> {
+    FAILURES.get_or_init(|| Mutex::new(0))
+}
+
+/// Where the helper script lives. The launcher passes `GUGUA_VOICE_BRIDGE`;
+/// without it the bridge stays off (there is no reliable way to guess a
+/// checkout path from a release binary, and guessing wrong is worse than
+/// falling back to the OS engine).
+fn script_path() -> Option<String> {
+    let p = std::env::var("GUGUA_VOICE_BRIDGE").ok()?;
+    if std::path::Path::new(&p).is_file() {
+        Some(p)
+    } else {
+        None
+    }
+}
+
+fn python_path() -> String {
+    std::env::var("GUGUA_VOICE_PYTHON").unwrap_or_else(|_| "python".to_string())
+}
+
+/// True when this machine has a bridge configured (script present). Named
+/// voices from `speech_status` are only offered when this holds, so a card
+/// never picks a voice the host cannot actually render.
+pub fn configured() -> bool {
+    script_path().is_some()
+}
+
+fn spawn() -> Result<Bridge, String> {
+    let script = script_path().ok_or("no GUGUA_VOICE_BRIDGE configured")?;
+    let python = python_path();
+    let mut child = Command::new(&python)
+        .arg(&script)
+        .arg("--serve")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|e| format!("cannot start the voice bridge ({python}): {e}"))?;
+    let stdin = child.stdin.take().ok_or("bridge stdin unavailable")?;
+    let stdout = child.stdout.take().ok_or("bridge stdout unavailable")?;
+    Ok(Bridge {
+        child,
+        stdin,
+        stdout: BufReader::new(stdout),
+    })
+}
+
+/// Synthesize one line through the bridge.
+///
+/// Runs the request on its own thread so a hung helper cannot pin this
+/// thread past `REQUEST_TIMEOUT`; a timeout (or any error) resets the
+/// bridge, and enough failures turn it off for the session.
+pub fn synthesize(text: &str, voice: &str, rate: &str, pitch: &str) -> Result<SpeechAudio, String> {
+    if !configured() {
+        return Err("the edge voice bridge is not configured".into());
+    }
+    {
+        let f = failures().lock().unwrap();
+        if *f >= MAX_CONSECUTIVE_FAILURES {
+            return Err("the edge voice bridge is disabled after repeated failures".into());
+        }
+    }
+
+    let request = json!({
+        "text": text,
+        "voice": voice,
+        "rate": rate,
+        "pitch": pitch,
+    })
+    .to_string();
+
+    let (tx, rx) = mpsc::channel::<Result<SpeechAudio, String>>();
+    std::thread::spawn(move || {
+        let result = request_once(&request);
+        let _ = tx.send(result);
+    });
+
+    match rx.recv_timeout(REQUEST_TIMEOUT) {
+        Ok(Ok(audio)) => {
+            let mut f = failures().lock().unwrap();
+            *f = 0;
+            Ok(audio)
+        }
+        Ok(Err(e)) => {
+            reset();
+            let mut f = failures().lock().unwrap();
+            *f += 1;
+            Err(e)
+        }
+        Err(_) => {
+            reset();
+            let mut f = failures().lock().unwrap();
+            *f += 1;
+            Err("the voice bridge did not answer in time".into())
+        }
+    }
+}
+
+fn request_once(request: &str) -> Result<SpeechAudio, String> {
+    let mut slot = bridge_slot().lock().unwrap();
+    if slot.is_none() {
+        *slot = Some(spawn()?);
+    }
+    let bridge = slot.as_mut().unwrap();
+
+    bridge
+        .stdin
+        .write_all(request.as_bytes())
+        .and_then(|_| bridge.stdin.write_all(b"\n"))
+        .and_then(|_| bridge.stdin.flush())
+        .map_err(|e| format!("writing to the voice bridge failed: {e}"))?;
+
+    let mut line = String::new();
+    let n = bridge
+        .stdout
+        .read_line(&mut line)
+        .map_err(|e| format!("reading from the voice bridge failed: {e}"))?;
+    if n == 0 {
+        return Err("the voice bridge closed its output".into());
+    }
+
+    let reply: Value = serde_json::from_str(line.trim())
+        .map_err(|e| format!("the voice bridge answered non-JSON: {e}"))?;
+    let ok = reply.get("ok").and_then(|v| v.as_bool()).unwrap_or(false);
+    if !ok {
+        let why = reply
+            .get("error")
+            .and_then(|v| v.as_str())
+            .unwrap_or("unknown error");
+        return Err(format!("edge-tts synthesis failed: {why}"));
+    }
+    let sample_rate = reply
+        .get("sample_rate")
+        .and_then(|v| v.as_u64())
+        .unwrap_or(24000) as u32;
+    let b64 = reply
+        .get("samples_b64")
+        .and_then(|v| v.as_str())
+        .ok_or("the voice bridge returned no samples")?;
+    let raw = base64::engine::general_purpose::STANDARD
+        .decode(b64)
+        .map_err(|e| format!("the voice bridge returned bad base64: {e}"))?;
+    if raw.len() < 2 {
+        return Err("the voice bridge returned an empty utterance".into());
+    }
+    let samples: Vec<f32> = raw
+        .chunks_exact(2)
+        .map(|c| i16::from_le_bytes([c[0], c[1]]) as f32 / 32768.0)
+        .collect();
+    Ok(SpeechAudio { samples, sample_rate })
+}
+
+/// Drop the helper so the next request starts a fresh one.
+fn reset() {
+    if let Ok(mut slot) = bridge_slot().lock() {
+        *slot = None;
+    }
+}
+
+/// The voices the bridge can speak, for `model.speech`. Reported first so
+/// the card's preference table (which puts Xiaoyi at rank 0, matching the
+/// desktop penguin) selects it.
+pub fn voices() -> Vec<Value> {
+    vec![json!({
+        "id": EDGE_VOICE,
+        "name": "Xiaoyi (edge-tts)",
+        "language": "zh-CN",
+        "gender": "female",
+        "offline": false,
+    })]
+}
diff --git a/crates/model-service/src/voice/player.rs b/crates/model-service/src/voice/player.rs
new file mode 100644
index 0000000..79942a1
--- /dev/null
+++ b/crates/model-service/src/voice/player.rs
@@ -0,0 +1,126 @@
+//! One utterance's PCM, sampled by the host app's audio-output callback.
+//!
+//! The service renders a sentence and queues it here; the host app installs
+//! one `cx.audio_output` callback at startup and copies frames from this
+//! queue. Nothing here blocks: the queue is a short vec and a cursor, and the
+//! audio thread takes a lock only long enough to read it.
+use std::sync::{Mutex, OnceLock};
+
+#[derive(Default)]
+struct PlayInner {
+    pcm: Vec<f32>,
+    src_rate: f64,
+    /// Fractional read position in `pcm`; starts at -1.0 for "not started".
+    pos: f64,
+    playing: bool,
+    voice: String,
+    seconds: f64,
+}
+
+pub struct Player {
+    inner: Mutex<PlayInner>,
+}
+
+/// What the audio callback needs to know, without holding the lock.
+pub struct PlayerState {
+    pub playing: bool,
+    pub seconds: f64,
+    pub voice: String,
+}
+
+impl Player {
+    pub fn queue(&self, samples: Vec<f32>, sample_rate: u32, voice: String) {
+        let seconds = if sample_rate == 0 {
+            0.0
+        } else {
+            samples.len() as f64 / sample_rate as f64
+        };
+        let mut inner = self.inner.lock().unwrap();
+        inner.pcm = samples;
+        inner.src_rate = sample_rate.max(1) as f64;
+        inner.pos = 0.0;
+        inner.playing = !inner.pcm.is_empty();
+        inner.voice = voice;
+        inner.seconds = seconds;
+    }
+
+    /// Drop whatever is queued; the next `speak` starts clean.
+    pub fn stop(&self) {
+        let mut inner = self.inner.lock().unwrap();
+        inner.pcm.clear();
+        inner.playing = false;
+        inner.pos = 0.0;
+    }
+
+    pub fn state(&self) -> PlayerState {
+        let inner = self.inner.lock().unwrap();
+        PlayerState {
+            playing: inner.playing,
+            seconds: inner.seconds,
+            voice: inner.voice.clone(),
+        }
+    }
+
+    /// Fill one mono buffer at `out_rate` by linear interpolation, advancing
+    /// the cursor. Called on the audio thread; allocates nothing.
+    pub fn fill(&self, out: &mut [f32], out_rate: f64) {
+        let mut inner = self.inner.lock().unwrap();
+        if !inner.playing || inner.pcm.is_empty() {
+            return;
+        }
+        let step = inner.src_rate / out_rate.max(1.0);
+        let last = inner.pcm.len() as f64 - 1.0;
+        let mut pos = inner.pos;
+        for sample in out.iter_mut() {
+            if pos >= last {
+                inner.playing = false;
+                inner.pcm.clear();
+                inner.pos = 0.0;
+                return;
+            }
+            let index = pos.floor() as usize;
+            let frac = (pos - index as f64) as f32;
+            let a = inner.pcm[index];
+            let b = inner.pcm[index + 1];
+            *sample = a + (b - a) * frac;
+            pos += step;
+        }
+        inner.pos = pos;
+    }
+}
+
+static PLAYER: OnceLock<Player> = OnceLock::new();
+
+pub fn player() -> &'static Player {
+    PLAYER.get_or_init(|| Player { inner: Mutex::new(PlayInner::default()) })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_queued_utterance_plays_once_and_stops() {
+        let player = Player { inner: Mutex::new(PlayInner::default()) };
+        player.queue(vec![0.25; 8], 16_000, "v".into());
+        let mut out = [0.0f32; 4];
+        player.fill(&mut out, 16_000.0);
+        assert!(out.iter().all(|s| (*s - 0.25).abs() < 1e-6));
+        assert!(player.state().playing);
+        // Reading past the end stops playback instead of repeating.
+        player.fill(&mut out, 16_000.0);
+        player.fill(&mut out, 16_000.0);
+        assert!(!player.state().playing);
+        let silence = [0.0f32; 4];
+        player.fill(&mut out, 16_000.0);
+        assert_eq!(out, silence);
+    }
+
+    #[test]
+    fn filling_does_not_advance_when_idle() {
+        let player = Player { inner: Mutex::new(PlayInner::default()) };
+        let mut out = [0.5f32; 4];
+        player.fill(&mut out, 48_000.0);
+        assert_eq!(out, [0.5f32; 4]);
+    }
+}
diff --git a/crates/model-service/src/voice/stt.rs b/crates/model-service/src/voice/stt.rs
new file mode 100644
index 0000000..d4acd4d
--- /dev/null
+++ b/crates/model-service/src/voice/stt.rs
@@ -0,0 +1,135 @@
+//! Microphone sessions over the OS recognizer, owned by the host.
+//!
+//! A card calls `model.listen_start`, then polls `model.listen_poll` while its
+//! user speaks, then `model.listen_stop`. The recognizer runs on its own
+//! thread; events land in a queue the poll drains, so a card never blocks on
+//! a microphone and never touches the device itself.
+use makepad_system_speech::{stt, SttEvent, SttOptions};
+use serde_json::{json, Value};
+use std::sync::mpsc;
+use std::sync::{Arc, Mutex, OnceLock};
+
+struct ListenState {
+    /// Events the recognizer produced since the last poll.
+    events: Arc<Mutex<Vec<SttEvent>>>,
+    /// Dropping the handle stops the session.
+    handle: Option<makepad_system_speech::ListenHandle>,
+    language: String,
+    engine: &'static str,
+    /// True until `listen_stop`; the card shows a live state for it.
+    live: bool,
+}
+
+static LISTEN: OnceLock<Mutex<Option<ListenState>>> = OnceLock::new();
+
+fn state() -> &'static Mutex<Option<ListenState>> {
+    LISTEN.get_or_init(|| Mutex::new(None))
+}
+
+/// `model.listen_start {language?}` — open the microphone. Replaces any session
+/// already running.
+pub fn listen_start(args: &Value) -> Result<Value, String> {
+    if !stt::available() {
+        return Err("no speech recognizer on this machine".into());
+    }
+    let language = args
+        .get("language")
+        .and_then(|v| v.as_str())
+        .map(str::trim)
+        .filter(|value| !value.is_empty())
+        .unwrap_or("zh-CN")
+        .to_string();
+    let mut options = SttOptions::default();
+    options.language = language.clone();
+    options.partial_results = true;
+
+    // Replace whatever was running: dropping the handle stops it.
+    {
+        let mut slot = state().lock().unwrap();
+        if let Some(previous) = slot.take() {
+            drop(previous);
+        }
+    }
+
+    let events: Arc<Mutex<Vec<SttEvent>>> = Arc::new(Mutex::new(Vec::new()));
+    let sink_events = events.clone();
+    let (tx, rx) = mpsc::channel::<SttEvent>();
+    // The recognizer hands events to `tx` on its worker; this relay copies
+    // them into the queue the polls read, and lets the channel close when the
+    // session ends.
+    std::thread::Builder::new()
+        .name("voice-relay".to_string())
+        .spawn(move || {
+            for event in rx {
+                sink_events.lock().unwrap().push(event);
+            }
+        })
+        .map_err(|error| format!("cannot start the voice relay: {error}"))?;
+
+    let handle = stt::listen(&options, tx).map_err(|error| error.to_string())?;
+    let mut slot = state().lock().unwrap();
+    *slot = Some(ListenState { events, handle: Some(handle), language: language.clone(), engine: stt::engine_name(), live: true });
+    Ok(json!({
+        "ok": true,
+        "language": language,
+        "engine": stt::engine_name(),
+        "note": "the microphone is open; poll listen_poll while the person speaks",
+    }))
+}
+
+/// `model.listen_poll` — take the events since the last poll.
+pub fn listen_poll() -> Value {
+    let mut slot = state().lock().unwrap();
+    let Some(listen) = slot.as_mut() else {
+        return json!({"live": false, "listening": false, "events": []});
+    };
+    let events: Vec<SttEvent> = listen.events.lock().unwrap().drain(..).collect();
+    let mut out = Vec::new();
+    let mut ended = false;
+    for event in events {
+        match event {
+            SttEvent::Level(value) => out.push(json!({"kind": "level", "v": value})),
+            SttEvent::Partial(text) => out.push(json!({"kind": "partial", "text": text})),
+            SttEvent::Final(transcript) => {
+                let text = transcript.text();
+                if !text.is_empty() {
+                    out.push(json!({"kind": "final", "text": text}));
+                }
+            }
+            SttEvent::Error(error) => out.push(json!({"kind": "error", "text": error.to_string()})),
+            SttEvent::Ended => {
+                ended = true;
+                out.push(json!({"kind": "ended"}));
+            }
+        }
+    }
+    if ended {
+        // The handle is spent once Ended arrives; keep the queue for a last
+        // poll, but nothing more will come.
+        listen.handle = None;
+        listen.live = false;
+    }
+    json!({
+        "live": listen.live,
+        "listening": listen.live,
+        "language": listen.language,
+        "engine": listen.engine,
+        "events": out,
+    })
+}
+
+/// `model.listen_stop` — close the microphone. Any final result still arrives
+/// through one more poll, then `ended`.
+pub fn listen_stop() -> Value {
+    let mut slot = state().lock().unwrap();
+    match slot.as_mut() {
+        Some(listen) => {
+            if let Some(handle) = listen.handle.take() {
+                handle.stop();
+            }
+            listen.live = false;
+            json!({"ok": true, "note": "the microphone is closed"})
+        }
+        None => json!({"ok": true, "note": "no session was open"}),
+    }
+}
