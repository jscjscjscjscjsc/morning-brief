+/// One audio output, installed once, reading whatever the voice service has
+/// queued. A card cannot hold a device; `model.speak` renders a sentence and
+/// this callback is where it becomes sound.
+fn install_audio_output(cx: &mut Cx) {
+    cx.audio_output(0, move |info, output| {
+        output.zero();
+        let frames = output.frame_count();
+        let channels = output.channel_count();
+        if frames == 0 || channels == 0 {
+            return;
+        }
+        let player = octosense_model_service::voice::player();
+        if !player.state().playing {
+            return;
+        }
+        let mut mono = vec![0.0f32; frames];
+        player.fill(&mut mono, info.sample_rate.max(1.0));
+        // The engine renders mono; every output channel gets the same frames.
+        let mut interleaved = vec![0.0f32; frames * channels];
+        for frame in 0..frames {
+            for channel in 0..channels {
+                interleaved[frame * channels + channel] = mono[frame];
+            }
+        }
+        output.copy_from_interleaved(channels, &interleaved);
+    });
+}
