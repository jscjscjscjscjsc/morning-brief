@@ -0,0 +1,651 @@
+//! octosense-model-service — the `model` host service, for a development host.
+//!
+//! A store app on the shelves may ask for the `model` capability and call
+//! `model.complete` (PUBLISHING: "Make bounded one-shot model calls through
+//! the host's `model` service"). The shipping OctoSense shells serve it.
+//! `card-host` serves no host services at all — DEVELOPMENT says so in as many
+//! words ("`card-host` registers no host services. A script app that calls
+//! `host.request("mail.…", …)` gets `no service answers "mail" on this
+//! device` here; develop a service-backed app in a shell that links the
+//! service") — which leaves an app that uses `model` with no way to run while
+//! it is being written.
+//!
+//! This crate answers `model.complete` for that host, with the same contract
+//! the shipping service has:
+//!
+//! | key | meaning |
+//! | --- | --- |
+//! | `task` | what to do: an instruction, at most 4096 bytes |
+//! | `input` | the data, any JSON, at most 32768 bytes |
+//! | `schema` | a JSON Schema the reply is checked against (required) |
+//! | `class` | `"fast"` (the default) or `"strong"` |
+//! | `allow_urls` | false: a reply that names a URL is refused |
+//!
+//! and it answers `{output, meta:{class, requested, attempts, usage, budget}}`.
+//! **The key never reaches the app.** It is read from the environment that
+//! started the host (`OCTOS_MODEL_KEY`), exactly as the shipping service keeps
+//! the person's credentials on its own side.
+//!
+//! What it deliberately does not do: hold a per-app budget, keep a call log, or
+//! reach any provider the environment did not name. It is a development host's
+//! answer, not the shipped one.
+//!
+//! It also answers this host's voice methods under the same family —
+//! `model.speech` / `speak` / `speaking` / `speech_stop` / `listen_*` — because
+//! the published capability set has no voice family a store app may hold
+//! (`llm` serves `os.` system apps only). An app that already declares `model`
+//! can therefore be spoken to without asking for a permission the store does
+//! not offer; a host without these methods answers an error and the app falls
+//! back to text. See [`voice`].
+
+use octosense_appstore::services::{register_host_service, HostService, Replier, ServiceCall, ServiceHost};
+use serde_json::{json, Value};
+use std::time::Duration;
+
+pub mod voice;
+
+/// The host service refuses a `task` larger than this, so a runaway prompt is
+/// a refusal rather than a bill. Same limit as the shipping service.
+const MAX_TASK_BYTES: usize = 4096;
+/// The data half of the call, likewise bounded.
+const MAX_INPUT_BYTES: usize = 32_768;
+/// The schema's own bounds: bytes, nesting, and properties.
+const MAX_SCHEMA_BYTES: usize = 8192;
+const MAX_SCHEMA_DEPTH: usize = 16;
+const MAX_SCHEMA_PROPERTIES: usize = 64;
+/// How long the app may wait. A `strong` call over a long candidate list takes
+/// minutes, not seconds, and a host that answers "timed out" mid-answer is
+/// worse than one that waits.
+const TIMEOUT: Duration = Duration::from_secs(180);
+/// The endpoint's own deadline, under the app's, so a slow provider produces
+/// the provider's error rather than the host's timeout.
+const ENDPOINT_TIMEOUT: Duration = Duration::from_secs(150);
+
+/// Where the development host's model connection is configured. Read once, in
+/// the environment that starts the host — never from a bundle.
+#[derive(Clone, Debug)]
+pub struct Config {
+    pub base_url: String,
+    pub key: String,
+    pub fast: String,
+    pub strong: String,
+}
+
+impl Config {
+    pub fn from_env() -> Config {
+        // The key, by the names a developer is likely to already have set.
+        let key = ["OCTOS_MODEL_KEY", "OCTOS_LLM_KEY", "SILICONFLOW_API_KEY", "OPENAI_API_KEY"]
+            .iter()
+            .find_map(|name| std::env::var(name).ok())
+            .map(|v| v.trim().to_string())
+            .filter(|v| !v.is_empty())
+            .unwrap_or_default();
+        let base_url = std::env::var("OCTOS_MODEL_BASE_URL")
+            .or_else(|_| std::env::var("OCTOS_LLM_BASE_URL"))
+            .map(|v| v.trim().trim_end_matches('/').to_string())
+            .unwrap_or_else(|_| "https://api.siliconflow.cn/v1".to_string());
+        Config {
+            base_url,
+            key,
+            fast: std::env::var("OCTOS_MODEL_FAST").unwrap_or_else(|_| "deepseek-ai/DeepSeek-V4-Flash".to_string()),
+            strong: std::env::var("OCTOS_MODEL_STRONG").unwrap_or_else(|_| "deepseek-ai/DeepSeek-V4-Pro".to_string()),
+        }
+    }
+
+    /// Whether the host can answer a call at all.
+    pub fn ready(&self) -> bool {
+        !self.key.is_empty() && !self.base_url.is_empty()
+    }
+
+    fn model_for(&self, class: &str) -> &str {
+        if class == "strong" {
+            &self.strong
+        } else {
+            &self.fast
+        }
+    }
+}
+
+/// Register the `model` service with this process's host.
+///
+/// Idempotent — a second registration replaces the first — so a host may call
+/// it wherever it starts. Without a key it still registers: the app then gets
+/// a sentence saying why, which is more use while developing than "no service
+/// answers `model` on this device".
+pub fn register() {
+    let cfg = Config::from_env();
+    if cfg.ready() {
+        // Not the key, not even a prefix of it: the endpoint and which model
+        // answers a `fast` and a `strong` call are enough to debug with.
+        eprintln!(
+            "card-host: model service ready — {} (fast {}, strong {}, key from the environment)",
+            cfg.base_url, cfg.fast, cfg.strong
+        );
+    } else {
+        eprintln!("card-host: model service registered without a key — set OCTOS_MODEL_KEY to answer cards that call model.complete");
+    }
+    register_host_service(Box::new(ModelService { cfg }));
+}
+
+struct ModelService {
+    cfg: Config,
+}
+
+impl HostService for ModelService {
+    fn family(&self) -> &'static str {
+        "model"
+    }
+
+    fn timeout(&self, _call: &ServiceCall) -> Duration {
+        TIMEOUT
+    }
+
+    fn call(&mut self, call: ServiceCall, reply: Replier, _host: &mut dyn ServiceHost) {
+        let method = call.method().to_string();
+        let args = call.args.clone();
+        match method.as_str() {
+            // A network round trip and a synthesis pass are both things the
+            // card must not wait on: the isolate that asked is promised an
+            // answer rather than a frozen window. The two poll methods answer
+            // from in-memory state and stay on this thread.
+            "complete" => {
+                let cfg = self.cfg.clone();
+                std::thread::spawn(move || {
+                    reply.send(complete(&cfg, &args));
+                });
+            }
+            "speak" => {
+                std::thread::spawn(move || {
+                    reply.send(voice::speak(&args));
+                });
+            }
+            "listen_start" => {
+                std::thread::spawn(move || {
+                    reply.send(voice::listen_start(&args));
+                });
+            }
+            "speech" => reply.send(Ok(voice::speech_status())),
+            "speaking" => reply.send(Ok(voice::speaking())),
+            "speech_stop" => reply.send(Ok(voice::speech_stop())),
+            "listen_poll" => reply.send(Ok(voice::listen_poll())),
+            "listen_stop" => reply.send(Ok(voice::listen_stop())),
+            other => reply.send(Err(format!(
+                "model.{other} is not a method this host answers; it answers model.complete, and the voice methods model.speech / speak / speaking / speech_stop / listen_start / listen_poll / listen_stop"
+            ))),
+        }
+    }
+}
+
+/// One bounded call. The argument checks mirror the shipping service's, so an
+/// app that runs here keeps running there.
+fn complete(cfg: &Config, args: &Value) -> Result<Value, String> {
+    if !cfg.ready() {
+        return Err("this host has no model key: set OCTOS_MODEL_KEY in the environment that starts it".into());
+    }
+    let args = args.as_object().ok_or("model.complete takes an object of {task, input, schema, class, allow_urls}")?;
+    for key in args.keys() {
+        if !matches!(key.as_str(), "task" | "input" | "schema" | "class" | "allow_urls") {
+            return Err(format!("model.complete does not take {key:?}"));
+        }
+    }
+    let task = args.get("task").and_then(Value::as_str).ok_or("model.complete needs a `task` string")?;
+    if task.trim().is_empty() {
+        return Err("model.complete needs a `task` that says what to do".into());
+    }
+    if task.len() > MAX_TASK_BYTES {
+        return Err(format!("task is {} bytes; a task is at most {MAX_TASK_BYTES}", task.len()));
+    }
+    let input = args.get("input").ok_or("model.complete needs an `input`")?;
+    let input_text = render_input(input);
+    if input_text.len() > MAX_INPUT_BYTES {
+        return Err(format!("input is {} bytes; an input is at most {MAX_INPUT_BYTES}", input_text.len()));
+    }
+    let schema = args.get("schema").ok_or("model.complete needs a `schema` its reply is checked against")?;
+    check_schema(schema)?;
+    let class = match args.get("class").and_then(Value::as_str).unwrap_or("fast") {
+        "fast" => "fast",
+        "strong" => "strong",
+        other => return Err(format!("class is {other:?}; it is \"fast\" or \"strong\"")),
+    };
+    let allow_urls = args.get("allow_urls").and_then(Value::as_bool).unwrap_or(false);
+
+    let (output, usage) = ask(cfg, cfg.model_for(class), task, &input_text)?;
+
+    // A reply the app did not ask to contain links is not handed one: the same
+    // rule the shipping service enforces, so an app cannot quietly acquire a
+    // URL it never declared a reach for.
+    if !allow_urls {
+        if let Some(found) = first_url(&output) {
+            return Err(format!("the reply names {found}; this call did not set allow_urls"));
+        }
+    }
+    validate(&output, schema, "output", 0)?;
+
+    Ok(json!({
+        "output": output,
+        "meta": {
+            "class": class,
+            "requested": class,
+            "attempts": 1,
+            "usage": usage,
+            // The shipping service keeps a per-app daily budget; a
+            // development host has none, and says so rather than pretending.
+            "budget": {"enforced": false, "note": "a development host keeps no per-app budget"},
+        }
+    }))
+}
+
+/// The data half of a call, as the model reads it. A string is the text it is;
+/// anything else is JSON, so the model sees structure rather than a Ruby-ish
+/// rendering of one.
+fn render_input(input: &Value) -> String {
+    match input {
+        Value::String(s) => s.clone(),
+        other => serde_json::to_string_pretty(other).unwrap_or_else(|_| other.to_string()),
+    }
+}
+
+/// One round trip to the endpoint the environment named, asking for JSON back.
+/// Returns the reply and its token counts, in the shape `model.complete`
+/// promises.
+fn ask(cfg: &Config, model: &str, task: &str, input: &str) -> Result<(Value, Value), String> {
+    let url = format!("{}/chat/completions", cfg.base_url);
+    let body = json!({
+        "model": model,
+        "messages": [
+            {"role": "system", "content": task},
+            {"role": "user", "content": input},
+        ],
+        // The contract is a JSON object checked against a schema, so ask the
+        // endpoint for one. A provider that ignores it still gets its prose
+        // parsed below, and a reply that is not JSON is the app's to handle.
+        "response_format": {"type": "json_object"},
+        "temperature": 0.3,
+        "max_tokens": 2048,
+    });
+    let agent = ureq::Agent::config_builder()
+        .timeout_global(Some(ENDPOINT_TIMEOUT))
+        // Read the endpoint's own error body: "insufficient balance" and
+        // "unknown model" are worth seeing, and a bare status code is not.
+        .http_status_as_error(false)
+        .build()
+        .new_agent();
+    let mut response = agent
+        .post(&url)
+        .header("Authorization", &format!("Bearer {}", cfg.key))
+        .header("Content-Type", "application/json")
+        .send_json(&body)
+        .map_err(|e| format!("the model endpoint could not be reached: {e}"))?;
+    let status = response.status().as_u16();
+    let text = response
+        .body_mut()
+        .with_config()
+        .limit(8 * 1024 * 1024)
+        .read_to_string()
+        .map_err(|e| format!("the model endpoint's answer could not be read: {e}"))?;
+    if !(200..300).contains(&status) {
+        return Err(format!("the model endpoint answered {status}: {}", excerpt(&text, 240)));
+    }
+    let answer: Value = serde_json::from_str(&text).map_err(|_| "the model endpoint's answer was not JSON".to_string())?;
+    let content = answer
+        .get("choices")
+        .and_then(Value::as_array)
+        .and_then(|c| c.first())
+        .and_then(|c| c.get("message"))
+        .and_then(|m| m.get("content"))
+        .and_then(Value::as_str)
+        .ok_or("the model endpoint's answer had no message content")?;
+    let output = parse_json_loose(content).map_err(|e| format!("the model did not answer with a JSON object: {e}"))?;
+    let u = answer.get("usage");
+    let usage = json!({
+        "input_tokens": u.and_then(|u| u.get("prompt_tokens")).and_then(Value::as_u64).unwrap_or(0),
+        "output_tokens": u.and_then(|u| u.get("completion_tokens")).and_then(Value::as_u64).unwrap_or(0),
+        "estimated": u.is_none(),
+    });
+    Ok((output, usage))
+}
+
+/// Reasoning models put a scratchpad in the message ahead of the answer:
+///
+/// ```text
+/// <think>The user wrote "probe". The schema is {"ready": true} …</think>
+///
+/// {"ready": true}
+/// ```
+///
+/// The scratchpad has braces of its own — it quotes the schema — so "the
+/// outermost object" below would find the one *inside the thinking*, and the
+/// answer would be the model talking to itself. The scratchpad is not the
+/// reply: drop it, and only then look for the object.
+///
+/// MiniMax M2/M3 (this competition's provider) and the deepseek-r1 family all
+/// answer this way.
+fn strip_reasoning(text: &str) -> String {
+    let mut out = text.to_string();
+    let blocks = [
+        ("<think>", "</think>"),
+        ("<thinking>", "</thinking>"),
+        ("<reasoning>", "</reasoning>"),
+    ];
+    for (open, close) in blocks {
+        while let Some(start) = out.find(open) {
+            match out[start + open.len()..].find(close) {
+                Some(rel) => {
+                    let end = start + open.len() + rel + close.len();
+                    out.replace_range(start..end, "");
+                }
+                // An unterminated scratchpad means the model was still thinking
+                // when it ran out of room; everything after the tag goes.
+                None => out.truncate(start),
+            }
+        }
+    }
+    out.trim().to_string()
+}
+
+/// The message's JSON, tolerating the three habits a model has: a reasoning
+/// block before the answer, a ``` fence around the object, and prose beside it.
+fn parse_json_loose(content: &str) -> Result<Value, String> {
+    let cleaned = strip_reasoning(content);
+    let text = cleaned.trim();
+    if let Ok(v) = serde_json::from_str::<Value>(text) {
+        return Ok(v);
+    }
+    let unfenced = text
+        .strip_prefix("```json")
+        .or_else(|| text.strip_prefix("```"))
+        .and_then(|rest| rest.strip_suffix("```"))
+        .map(str::trim)
+        .unwrap_or(text);
+    if let Ok(v) = serde_json::from_str::<Value>(unfenced) {
+        return Ok(v);
+    }
+    // The outermost object, so prose on either side of it does not lose it.
+    let start = text.find('{').ok_or("no JSON object in the reply")?;
+    let end = text.rfind('}').ok_or("no JSON object in the reply")?;
+    if end <= start {
+        return Err("no JSON object in the reply".into());
+    }
+    serde_json::from_str::<Value>(&text[start..=end]).map_err(|e| e.to_string())
+}
+
+/// The bounds on a schema: bytes, nesting, properties. Checked before the call,
+/// so an unusable schema costs no tokens.
+fn check_schema(schema: &Value) -> Result<(), String> {
+    if !schema.is_object() {
+        return Err("schema must be a JSON object".into());
+    }
+    let bytes = serde_json::to_string(schema).map(|s| s.len()).unwrap_or(0);
+    if bytes > MAX_SCHEMA_BYTES {
+        return Err(format!("schema is {bytes} bytes; a schema is at most {MAX_SCHEMA_BYTES}"));
+    }
+    fn walk(schema: &Value, depth: usize, properties: &mut usize) -> Result<(), String> {
+        if depth > MAX_SCHEMA_DEPTH {
+            return Err(format!("schema is nested deeper than {MAX_SCHEMA_DEPTH}"));
+        }
+        let Some(obj) = schema.as_object() else { return Ok(()) };
+        if obj.get("pattern").is_some() || obj.get("anyOf").is_some() || obj.get("oneOf").is_some() || obj.get("const").is_some() {
+            // Not a refusal of the app: the shipping service's own subset leaves
+            // these out, and a schema that relies on them would pass here and
+            // fail there. Better to say so now.
+            return Err("schema uses a keyword the model service does not check (pattern, anyOf, oneOf, const)".into());
+        }
+        if let Some(props) = obj.get("properties").and_then(Value::as_object) {
+            *properties += props.len();
+            if *properties > MAX_SCHEMA_PROPERTIES {
+                return Err(format!("schema declares more than {MAX_SCHEMA_PROPERTIES} properties"));
+            }
+            for (_, sub) in props {
+                walk(sub, depth + 1, properties)?;
+            }
+        }
+        if let Some(items) = obj.get("items") {
+            walk(items, depth + 1, properties)?;
+        }
+        Ok(())
+    }
+    let mut properties = 0;
+    walk(schema, 0, &mut properties)
+}
+
+/// Check a reply against the schema subset the model service publishes:
+/// `type`, `properties`, `required`, `additionalProperties`, `items`,
+/// `minItems`, `maxItems`, `minLength`, `maxLength`, `minimum`, `maximum`,
+/// `enum`. A keyword outside that list is ignored, as the shipping service
+/// ignores it — the check is a floor, not a proof.
+fn validate(value: &Value, schema: &Value, path: &str, depth: usize) -> Result<(), String> {
+    if depth > MAX_SCHEMA_DEPTH {
+        return Err(format!("{path} is nested deeper than the schema allows"));
+    }
+    let Some(schema) = schema.as_object() else { return Ok(()) };
+    if let Some(t) = schema.get("type").and_then(Value::as_str) {
+        let ok = match t {
+            "object" => value.is_object(),
+            "array" => value.is_array(),
+            "string" => value.is_string(),
+            "integer" => value.is_i64() || value.is_u64(),
+            "number" => value.is_number(),
+            "boolean" => value.is_boolean(),
+            "null" => value.is_null(),
+            _ => true,
+        };
+        if !ok {
+            return Err(format!("{path} is not a {t}"));
+        }
+    }
+    if let Some(allowed) = schema.get("enum").and_then(Value::as_array) {
+        if !allowed.iter().any(|a| a == value) {
+            return Err(format!("{path} is not one of the values the schema allows"));
+        }
+    }
+    if let Some(s) = value.as_str() {
+        if let Some(max) = schema.get("maxLength").and_then(Value::as_u64) {
+            if s.chars().count() as u64 > max {
+                return Err(format!("{path} is longer than {max} characters"));
+            }
+        }
+        if let Some(min) = schema.get("minLength").and_then(Value::as_u64) {
+            if (s.chars().count() as u64) < min {
+                return Err(format!("{path} is shorter than {min} characters"));
+            }
+        }
+    }
+    if let Some(n) = value.as_f64() {
+        if let Some(min) = schema.get("minimum").and_then(Value::as_f64) {
+            if n < min {
+                return Err(format!("{path} is below the schema's minimum"));
+            }
+        }
+        if let Some(max) = schema.get("maximum").and_then(Value::as_f64) {
+            if n > max {
+                return Err(format!("{path} is above the schema's maximum"));
+            }
+        }
+    }
+    match value {
+        Value::Object(object) => {
+            if let Some(required) = schema.get("required").and_then(Value::as_array) {
+                for name in required.iter().filter_map(Value::as_str) {
+                    if !object.contains_key(name) {
+                        return Err(format!("{path} is missing {name:?}"));
+                    }
+                }
+            }
+            let properties = schema.get("properties").and_then(Value::as_object);
+            for (key, item) in object {
+                match properties.and_then(|p| p.get(key)) {
+                    Some(sub) => validate(item, sub, &format!("{path}.{key}"), depth + 1)?,
+                    None => {
+                        // Absent means allowed, as in JSON Schema; only an
+                        // explicit false closes the object.
+                        if schema.get("additionalProperties").and_then(Value::as_bool) == Some(false) {
+                            return Err(format!("{path} carries {key:?}, which the schema does not describe"));
+                        }
+                    }
+                }
+            }
+        }
+        Value::Array(items) => {
+            if let Some(max) = schema.get("maxItems").and_then(Value::as_u64) {
+                if items.len() as u64 > max {
+                    return Err(format!("{path} carries more than {max} items"));
+                }
+            }
+            if let Some(min) = schema.get("minItems").and_then(Value::as_u64) {
+                if (items.len() as u64) < min {
+                    return Err(format!("{path} carries fewer than {min} items"));
+                }
+            }
+            if let Some(sub) = schema.get("items") {
+                for (i, item) in items.iter().enumerate() {
+                    validate(item, sub, &format!("{path}[{i}]"), depth + 1)?;
+                }
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+/// The first URL anywhere in a value, if it names one. Only the scheme is
+/// looked for: a host is what an app would need a `net` entry for, and the
+/// scheme is where one begins.
+fn first_url(value: &Value) -> Option<String> {
+    fn scan(value: &Value, out: &mut Option<String>) {
+        if out.is_some() {
+            return;
+        }
+        match value {
+            Value::String(s) => {
+                let lower = s.to_ascii_lowercase();
+                if let Some(at) = lower.find("http://").or_else(|| lower.find("https://")) {
+                    *out = Some(excerpt(&s[at..], 60));
+                }
+            }
+            Value::Array(items) => items.iter().for_each(|i| scan(i, out)),
+            Value::Object(object) => object.values().for_each(|v| scan(v, out)),
+            _ => {}
+        }
+    }
+    let mut found = None;
+    scan(value, &mut found);
+    found
+}
+
+/// A single line, cut to `max` characters, for a message a person reads.
+fn excerpt(text: &str, max: usize) -> String {
+    let one_line: String = text.chars().map(|c| if c == '\n' || c == '\r' { ' ' } else { c }).collect();
+    let trimmed = one_line.split_whitespace().collect::<Vec<_>>().join(" ");
+    if trimmed.chars().count() <= max {
+        return trimmed;
+    }
+    let cut: String = trimmed.chars().take(max).collect();
+    format!("{cut}…")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::{Read, Write};
+    use std::net::TcpListener;
+
+    fn cfg(base_url: &str) -> Config {
+        Config { base_url: base_url.into(), key: "test-key".into(), fast: "fast-model".into(), strong: "strong-model".into() }
+    }
+
+    /// Enough of HTTP/1.1 to stand in for an endpoint without pulling a server
+    /// into the build. The reply body is what the test wants the model to have
+    /// said. It answers every connection, not just the first: a test that calls
+    /// twice against one endpoint would otherwise find the port shut.
+    fn endpoint(body: &'static str) -> String {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let addr = listener.local_addr().unwrap();
+        std::thread::spawn(move || {
+            for stream in listener.incoming() {
+                let Ok(mut socket) = stream else { break };
+                let mut buf = [0u8; 8192];
+                // Headers are enough to know the whole request arrived: the
+                // test's bodies are far smaller than the read, so one read sees
+                // them.
+                let _ = socket.read(&mut buf);
+                let reply = format!(
+                    "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
+                    body.len(),
+                    body
+                );
+                let _ = socket.write_all(reply.as_bytes());
+            }
+        });
+        format!("http://{addr}/v1")
+    }
+
+    const ANSWER: &str = r#"{"choices":[{"message":{"content":"{\"ok\":true}"}}],"usage":{"prompt_tokens":11,"completion_tokens":2}}"#;
+
+    #[test]
+    fn a_call_answers_in_the_promised_shape() {
+        let url = endpoint(ANSWER);
+        let args = json!({
+            "task": "answer ok",
+            "input": "probe",
+            "schema": {"type": "object", "required": ["ok"], "properties": {"ok": {"type": "boolean"}}},
+        });
+        let answer = complete(&cfg(&url), &args).expect("a well-formed call answers");
+        assert_eq!(answer["output"]["ok"], json!(true));
+        assert_eq!(answer["meta"]["class"], json!("fast"));
+        assert_eq!(answer["meta"]["usage"]["input_tokens"], json!(11));
+        assert_eq!(answer["meta"]["usage"]["output_tokens"], json!(2));
+    }
+
+    #[test]
+    fn a_reply_that_breaks_its_schema_is_refused() {
+        // `ok` came back as a number, and the schema said boolean.
+        let url = endpoint(r#"{"choices":[{"message":{"content":"{\"ok\":7}"}}]}"#);
+        let args = json!({
+            "task": "answer ok",
+            "input": "probe",
+            "schema": {"type": "object", "required": ["ok"], "properties": {"ok": {"type": "boolean"}}},
+        });
+        let refused = complete(&cfg(&url), &args).unwrap_err();
+        assert!(refused.contains("output.ok"), "{refused}");
+    }
+
+    #[test]
+    fn a_url_is_refused_unless_the_call_asked_for_one() {
+        let url = endpoint(r#"{"choices":[{"message":{"content":"{\"link\":\"https://example.com/a\"}"}}]}"#);
+        let schema = json!({"type": "object", "properties": {"link": {"type": "string"}}});
+        let args = json!({"task": "t", "input": "d", "schema": schema});
+        let refused = complete(&cfg(&url), &args).unwrap_err();
+        assert!(refused.contains("allow_urls"), "{refused}");
+
+        let mut allowed = args;
+        allowed["allow_urls"] = json!(true);
+        assert!(complete(&cfg(&url), &allowed).is_ok(), "allow_urls admits the URL");
+    }
+
+    #[test]
+    fn unknown_keys_and_oversized_tasks_are_refused_before_the_call() {
+        let args = json!({"task": "t", "input": "d", "schema": {}, "temperature": 0});
+        assert!(complete(&Config::from_env(), &args).is_err());
+        // No key, no call either.
+        let bare = Config { base_url: "http://127.0.0.1:1/v1".into(), key: String::new(), fast: "f".into(), strong: "s".into() };
+        let refused = complete(&bare, &json!({"task": "t", "input": "d", "schema": {}})).unwrap_err();
+        assert!(refused.contains("OCTOS_MODEL_KEY"), "{refused}");
+    }
+
+    #[test]
+    fn a_fenced_or_chatty_reply_still_yields_its_object() {
+        assert_eq!(parse_json_loose("```json\n{\"a\":1}\n```").unwrap()["a"], json!(1));
+        assert_eq!(parse_json_loose("Sure! {\"a\":2} hope that helps").unwrap()["a"], json!(2));
+        assert!(parse_json_loose("no json here").is_err());
+    }
+
+    #[test]
+    fn the_schema_subset_refuses_what_the_model_service_cannot_check() {
+        assert!(check_schema(&json!({"type": "object", "pattern": "^a"})).is_err());
+        assert!(check_schema(&json!({"type": "object", "properties": {"a": {"type": "string"}}})).is_ok());
+        let deep = json!({"type": "object", "properties": {"a": {"type": "object", "properties": {"b": {"type": "object", "properties": {"c": {"type": "string"}}}}}}});
+        assert!(validate(&json!({"a": {"b": {"c": "x"}}}), &deep, "output", 0).is_ok());
+        let missing = validate(&json!({}), &json!({"type": "object", "required": ["a"]}), "output", 0).unwrap_err();
+        assert!(missing.contains("\"a\""), "{missing}");
+    }
+}
