+def validate_publisher_root(app):
+    """The release template needs bundle/ at the nearest Git repository root."""
+    for root in (app, *app.parents):
+        marker = root / ".git"
+        if marker.is_dir() or marker.is_file():
+            if root != app:
+                raise ValueError(
+                    f"GitHub publishing template only supports bundle/ at the repository root; "
+                    f"{app} is nested in {root}. GitHub only runs workflows in "
+                    f"{root / '.github' / 'workflows'}. For a nested app, manually review "
+                    "and configure a workflow there with the correct bundle/component paths.")
+            return
+
+
