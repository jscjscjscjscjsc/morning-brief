+# octosense-llm-service — the `llm` host service.
+#
+# Language models as a service the shell offers to contained apps. The app
+# asks a question and gets an answer; the key stays with the host, in this
+# process, and never reaches the app.
+[package]
+name = "octosense-llm-service"
+version = "0.1.0"
+edition = "2021"
+license = "Apache-2.0"
+publish = false
+description = "The `llm` host service: language models for contained apps, the key kept by the host"
+
+[dependencies]
+octosense-appstore = { path = "../appstore" }
+serde_json = "1"
+makepad-network = { path = "../../../makepad/platform/network" }
+# The OS's own speech engines (Windows.Media.SpeechSynthesis / SpeechRecognition,
+# Apple Speech, Android SpeechRecognizer/TextToSpeech). No models, no network.
+makepad-system-speech = { path = "../../../makepad/libs/system_speech" }
diff --git a/crates/llm-service/src/chat.rs b/crates/llm-service/src/chat.rs
new file mode 100644
index 0000000..9b0dc30
--- /dev/null
+++ b/crates/llm-service/src/chat.rs
@@ -0,0 +1,392 @@
+//! One conversation with an OpenAI-compatible endpoint: the request body,
+//! the reply, and the small pieces of tidying that make a model's answer
+//! usable by an app.
+//!
+//! Two things are taken out of a raw answer before an app sees it. A
+//! reasoning preamble (`<think>…</think>` and its relatives) is split off
+//! and returned separately, so an app can show what the model worked
+//! through without mixing it into the answer. And when the caller asked for
+//! JSON, the first well-formed object is what comes back.
+use crate::config::Config;
+use makepad_network::blocking_http::{post_json, Limits, Request, Response};
+use serde_json::{json, Map, Value};
+use std::time::{Duration, Instant};
+
+/// The tags a model may wrap its working in. The first pair that matches
+/// wins; an unclosed one runs to the end of the answer.
+const THINK_TAGS: [(&str, &str); 3] = [("<think>", "</think>"), ("<thinking>", "</thinking>"), ("<redacted_thinking>", "</redacted_thinking>")];
+
+/// A ceiling on how much the caller may send at once, so a runaway app
+/// cannot turn the host into a proxy for arbitrary traffic.
+const MAX_MESSAGES: usize = 16;
+const MAX_MESSAGE_CHARS: usize = 8_000;
+
+pub struct ChatRequest {
+    pub messages: Vec<Value>,
+    pub model: String,
+    pub temperature: Option<f64>,
+    pub max_tokens: u64,
+    pub as_json: bool,
+    pub schema: Option<Value>,
+}
+
+pub struct ChatOutcome {
+    pub value: Value,
+}
+
+impl ChatOutcome {
+    pub fn into_json(self) -> Value {
+        self.value
+    }
+}
+
+/// Run one chat call, retrying a shape failure once. A connection failure is
+/// not retried here: the caller decides, so a broken endpoint fails fast
+/// instead of holding the app for three timeouts.
+pub fn run(config: &Config, request: &ChatRequest) -> Result<ChatOutcome, String> {
+    let started = Instant::now();
+    let mut attempts = 0u32;
+    let mut last_shape_error = String::new();
+    loop {
+        attempts += 1;
+        let mut body = base_body(request);
+        if attempts > 1 && !last_shape_error.is_empty() {
+            // The second try tells the model, in the same conversation,
+            // what was wrong with the first answer.
+            let repair = format!(
+                "Your previous answer could not be used: {last_shape_error}. Reply with the JSON value alone, no prose, no fences."
+            );
+            if let Some(messages) = body.get_mut("messages").and_then(|v| v.as_array_mut()) {
+                messages.push(json!({"role": "user", "content": repair}));
+            }
+        }
+        let response = post_json(build_request(config, &body)?).map_err(|error| error.to_string())?;
+        let envelope = read_envelope(&response, config)?;
+        let choice = envelope
+            .get("choices")
+            .and_then(|v| v.as_array())
+            .and_then(|list| list.first())
+            .cloned()
+            .ok_or("the model returned no choices")?;
+        let raw = choice
+            .get("message")
+            .and_then(|m| m.get("content"))
+            .and_then(|v| v.as_str())
+            .unwrap_or("")
+            .to_string();
+        let (text, reasoning) = split_reasoning(&raw);
+        let usage = envelope.get("usage").cloned().unwrap_or_else(|| json!({}));
+        let finish = choice.get("finish_reason").and_then(|v| v.as_str()).unwrap_or("");
+        let model_used = envelope.get("model").and_then(|v| v.as_str()).unwrap_or(&config.model).to_string();
+        let elapsed = started.elapsed().as_millis() as u64;
+
+        let answer = if request.as_json {
+            match extract_json(&text) {
+                Some(value) => Some(value),
+                None => {
+                    last_shape_error = "it was not JSON".to_string();
+                    None
+                }
+            }
+        } else {
+            Some(Value::String(text.clone()))
+        };
+
+        let Some(answer) = answer else {
+            if attempts < 2 {
+                continue;
+            }
+            return Err(format!("the model did not answer with usable JSON: {last_shape_error}"));
+        };
+
+        if let Some(schema) = &request.schema {
+            if let Err(problem) = check_schema(schema, &answer) {
+                if attempts < 2 {
+                    last_shape_error = problem;
+                    continue;
+                }
+                return Err(format!("the model's JSON did not match the schema: {last_shape_error}"));
+            }
+        }
+
+        let value = json!({
+            "text": text,
+            "reasoning": reasoning,
+            "data": answer,
+            "model": model_used,
+            "finish_reason": finish,
+            "usage": {
+                "prompt_tokens": usage.get("prompt_tokens").cloned().unwrap_or(json!(0)),
+                "completion_tokens": usage.get("completion_tokens").cloned().unwrap_or(json!(0)),
+                "total_tokens": usage.get("total_tokens").cloned().unwrap_or(json!(0)),
+            },
+            "elapsed_ms": elapsed,
+            "attempts": attempts,
+        });
+        return Ok(ChatOutcome { value });
+    }
+}
+
+fn base_body(request: &ChatRequest) -> Value {
+    let mut body = Map::new();
+    body.insert("model".into(), json!(request.model));
+    body.insert("messages".into(), Value::Array(request.messages.clone()));
+    body.insert("max_tokens".into(), json!(request.max_tokens));
+    if let Some(temperature) = request.temperature {
+        body.insert("temperature".into(), json!(temperature));
+    }
+    Value::Object(body)
+}
+
+fn build_request(config: &Config, body: &Value) -> Result<Request, String> {
+    let url = format!("{}/chat/completions", config.endpoint.trim_end_matches('/'));
+    let bytes = serde_json::to_vec(body).map_err(|_| "cannot encode the request".to_string())?;
+    let limits = Limits {
+        total_timeout: Duration::from_secs(config.timeout),
+        max_body_bytes: 8 * 1024 * 1024,
+        ..Default::default()
+    };
+    Request::post(url)
+        .bearer(&config.key)
+        .map_err(|error| error.to_string())?
+        .json_body(bytes)
+        .map_err(|error| error.to_string())
+        .map(|request| request.limits(limits))
+}
+
+/// An answer may be an `error` object instead of a completion; and the body
+/// may carry a key by accident, so nothing is echoed before scrubbing.
+fn read_envelope(response: &Response, config: &Config) -> Result<Value, String> {
+    let text = String::from_utf8_lossy(&response.body).to_string();
+    if response.status != 200 {
+        let excerpt: String = text.chars().take(300).collect();
+        return Err(format!("the endpoint answered {}: {}", response.status, scrub(&excerpt, config)));
+    }
+    let value: Value = serde_json::from_str(&text).map_err(|_| "the endpoint's answer was not JSON".to_string())?;
+    if let Some(error) = value.get("error") {
+        let message = error.get("message").and_then(|v| v.as_str()).unwrap_or("the endpoint refused the call");
+        return Err(scrub(message, config));
+    }
+    Ok(value)
+}
+
+/// A model's answer is for a person; a key in it is a leak. It never leaves
+/// the service.
+fn scrub(text: &str, config: &Config) -> String {
+    let mut out = text.to_string();
+    if !config.key.is_empty() {
+        out = out.replace(&config.key, "…");
+    }
+    while let Some(at) = out.find("sk-") {
+        let tail = out[at..]
+            .find(|c: char| c.is_whitespace() || matches!(c, '"' | '\'' | ',' | '}' | ')' | '\u{201c}' | '\u{201d}'))
+            .unwrap_or(out.len() - at);
+        out.replace_range(at..at + tail, "\u{2026}");
+    }
+    out
+}
+
+/// Split working from answer. Everything inside a reasoning tag comes back
+/// as `reasoning`; the rest is the answer a person reads.
+pub fn split_reasoning(content: &str) -> (String, String) {
+    let mut text = String::new();
+    let mut reasoning = String::new();
+    let mut rest = content;
+    loop {
+        let mut earliest: Option<(usize, &str, &str)> = None;
+        for (open, close) in THINK_TAGS {
+            if let Some(at) = rest.find(open) {
+                if earliest.map(|(best, _, _)| at < best).unwrap_or(true) {
+                    earliest = Some((at, open, close));
+                }
+            }
+        }
+        let Some((at, open, close)) = earliest else {
+            text.push_str(rest);
+            break;
+        };
+        let after = &rest[at + open.len()..];
+        let Some(end) = after.find(close) else {
+            text.push_str(rest);
+            break;
+        };
+        text.push_str(&rest[..at]);
+        reasoning.push_str(&after[..end]);
+        reasoning.push('\n');
+        rest = &after[end + close.len()..];
+    }
+    (text.trim().to_string(), reasoning.trim().to_string())
+}
+
+/// The first JSON object in a model's answer: sometimes it is the whole
+/// answer, sometimes it is inside a fence, sometimes there is a sentence
+/// around it.
+pub fn extract_json(text: &str) -> Option<Value> {
+    let trimmed = text.trim();
+    if let Ok(value) = serde_json::from_str::<Value>(trimmed) {
+        return Some(value);
+    }
+    let unfenced = strip_fences(trimmed);
+    if unfenced != trimmed {
+        if let Ok(value) = serde_json::from_str::<Value>(unfenced.trim()) {
+            return Some(value);
+        }
+    }
+    let start = unfenced.find('[').into_iter().chain(unfenced.find('{')).min()?;
+    let open = unfenced.as_bytes()[start];
+    let close = if open == b'[' { b']' } else { b'}' };
+    let end = unfenced.rfind(close as char)?;
+    if end <= start {
+        return None;
+    }
+    serde_json::from_str::<Value>(&unfenced[start..=end]).ok()
+}
+
+fn strip_fences(text: &str) -> &str {
+    let Some(at) = text.find("```") else {
+        return text;
+    };
+    let after = &text[at + 3..];
+    let after = after.strip_prefix("json").unwrap_or(after);
+    let after = after.strip_prefix("JSON").unwrap_or(after);
+    match after.find("```") {
+        Some(end) => &after[..end],
+        None => after,
+    }
+}
+
+/// A small, useful subset of JSON Schema: the parts an app's answer list
+/// actually leans on. A schema that asks for more than this is not treated
+/// as a failure.
+fn check_schema(schema: &Value, value: &Value) -> Result<(), String> {
+    let kind = schema.get("type").and_then(|v| v.as_str()).unwrap_or("");
+    match kind {
+        "object" => {
+            let Some(object) = value.as_object() else {
+                return Err("the answer was not a JSON object".into());
+            };
+            if let Some(required) = schema.get("required").and_then(|v| v.as_array()) {
+                for key in required.iter().filter_map(|v| v.as_str()) {
+                    if !object.contains_key(key) {
+                        return Err(format!("it has no {key:?}"));
+                    }
+                }
+            }
+            if let Some(properties) = schema.get("properties").and_then(|v| v.as_object()) {
+                for (key, sub) in properties {
+                    if let Some(field) = object.get(key) {
+                        check_schema(sub, field)?;
+                    }
+                }
+            }
+        }
+        "array" => {
+            let Some(items) = value.as_array() else {
+                return Err("the answer was not a JSON list".into());
+            };
+            if let Some(count) = schema.get("minItems").and_then(|v| v.as_u64()) {
+                if items.len() < count as usize {
+                    return Err(format!("it has {} items, fewer than {count}", items.len()));
+                }
+            }
+            if let Some(item_schema) = schema.get("items") {
+                for item in items {
+                    check_schema(item_schema, item)?;
+                }
+            }
+        }
+        "string" => {
+            if !value.is_string() {
+                return Err("a field was not text".into());
+            }
+        }
+        "integer" | "number" => {
+            if !value.is_number() {
+                return Err("a field was not a number".into());
+            }
+        }
+        "boolean" => {
+            if !value.is_boolean() {
+                return Err("a field was not a yes-or-no".into());
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+/// Build a message list from `{system, prompt}` or a ready `messages`.
+pub fn messages_from_args(args: &Value) -> Result<Vec<Value>, String> {
+    if let Some(list) = args.get("messages").and_then(|v| v.as_array()) {
+        let mut out = Vec::new();
+        for message in list.iter().take(MAX_MESSAGES) {
+            let role = message.get("role").and_then(|v| v.as_str()).unwrap_or("user");
+            let content = message.get("content").and_then(|v| v.as_str()).unwrap_or("");
+            if content.is_empty() {
+                continue;
+            }
+            let content: String = content.chars().take(MAX_MESSAGE_CHARS).collect();
+            out.push(json!({"role": role, "content": content}));
+        }
+        if out.is_empty() {
+            return Err("messages carried no content".into());
+        }
+        return Ok(out);
+    }
+    let prompt = args.get("prompt").and_then(|v| v.as_str()).unwrap_or("").trim().to_string();
+    if prompt.is_empty() {
+        return Err("the call carried no prompt".into());
+    }
+    let mut out = Vec::new();
+    if let Some(system) = args.get("system").and_then(|v| v.as_str()) {
+        if !system.trim().is_empty() {
+            out.push(json!({"role": "system", "content": system.trim()}));
+        }
+    }
+    out.push(json!({
+        "role": "user",
+        "content": prompt.chars().take(MAX_MESSAGE_CHARS).collect::<String>(),
+    }));
+    Ok(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn working_is_split_from_the_answer() {
+        let (text, reasoning) = split_reasoning("<think>weigh the sources</think>The line held.");
+        assert_eq!(text, "The line held.");
+        assert_eq!(reasoning, "weigh the sources");
+    }
+
+    #[test]
+    fn a_tag_named_in_the_answer_is_left_alone() {
+        let (text, reasoning) = split_reasoning("Write <think> to start.");
+        assert_eq!(text, "Write <think> to start.");
+        assert_eq!(reasoning, "");
+    }
+
+    #[test]
+    fn json_is_found_whole_fenced_or_embedded() {
+        assert_eq!(extract_json("{\"a\": 1}").unwrap()["a"], 1);
+        assert_eq!(extract_json("```json\n{\"a\": 2}\n```").unwrap()["a"], 2);
+        assert_eq!(extract_json("Here it is: {\"a\": 3} — done.").unwrap()["a"], 3);
+        assert_eq!(extract_json("[{\"a\": 4}]").unwrap()[0]["a"], 4);
+        assert!(extract_json("no json here").is_none());
+    }
+
+    #[test]
+    fn a_schema_says_what_it_needs() {
+        let schema = json!({
+            "type": "object",
+            "required": ["items"],
+            "properties": {"items": {"type": "array", "minItems": 2, "items": {"type": "string"}}},
+        });
+        assert!(check_schema(&schema, &json!({"items": ["a", "b"]})).is_ok());
+        assert!(check_schema(&schema, &json!({"items": ["a"]})).is_err());
+        assert!(check_schema(&schema, &json!({})).is_err());
+        assert!(check_schema(&schema, &json!({"items": [1, 2]})).is_err());
+    }
+}
