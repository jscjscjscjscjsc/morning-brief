    {id: "draft_interview" hint: "起草追问邮件" desc: "给正在阅读的这一条起草一封采访追问邮件，存进本机草稿箱（只写稿，绝不发送）。args: {}。只有当读者明确说「问问他 / 写封信 / 追问一下」时才调用"}
    {id: "read_ledger" hint: "查更正台账" desc: "查本报自己的更正与口径核对台账（本地，不联网）：累计更正过几条、发现过几次跨源口径不一致、最近的具体记录。读者问「你上次是不是报错了」「更正过几次」时用它。args: {}"}
    {id: "read_trail" hint: "回放出报过程" desc: "回放最近一期的出报链路（本地，不联网）：本期扫了多少条、进了候选池的是哪些、三位初审编辑各自的原话、主编终审的导语与每条取舍理由、以及被砍掉的三条。读者问「你们是怎么选的」「为什么没选那条」「这个决定怎么来的」时用它。args: {n: 可选，回放第几期（1=最近），默认 1}"}
    {id: "read_charter" hint: "念编辑方针" desc: "念出本报的编辑部宪法（本地，不联网）：一共几条方针、每条各是什么、当前版本号。读者问「你们的编辑原则是什么」「你们按什么标准选新闻」时用它。args: {}"}
]

fn art_pick_load(){
    art_pick = ["" "" ""]
    art_pick_at = time_now()
    let i = 0
    for r in picked {
        if i < 3 {
            let line = "咕嘎为什么选它：" + art_why_of(r)
            let w = art_clean(line)
            art_pick[i] = w
        }
        i = i + 1
    }
}

fn picks_from_ai(list){
    picked = []
    art_pick = ["" "" ""]
    ai_whys = []
    for pk in list {
        let idx = pk.i
        if idx >= 0 && idx < cand.len() {
            let r = cand[idx]
            if !already(picked, r.id) {
                picked.push(r)
                ai_whys.push({id: r.id why: pk.why})
            }
        }
    }
    art_pick_load()
}

// 落选公开：主编得说清他砍掉了什么、为什么。取舍被看见，才能被反驳。
// 落选公开：主编得说清他砍掉了什么、为什么。取舍被看见，才能被反驳。
fn drops_from_ai(list){
    drop = []
    if list == nil { return }
    let k = 0
    for d in list {
        if k < 3 {
            let idx = d.i
            if idx != nil {
                if idx >= 0 && idx < cand.len() {
                    let r = cand[idx]
                    if !already(picked, r.id) {
                        let wy = ""
                        let wv = d["why"]
                        if wv != nil { wy = "" + wv }
                        drop.push({title: r.title tier: tier_label(r) why: wy})
                        k = k + 1
                    }
                }
            }
        }
    }
}

// 给一条挑一句私货。题材命中就按题材说，否则按信源档位说。
fn guga_take(r, i){
    let title = "" + r.title
    let topic = ""
    if vc_has(title, "芯片") || vc_has(title, "半导体") || vc_has(title, "GPU") { topic = "chip" }
    else if vc_has(title, "开源") || vc_has(title, "GitHub") || vc_has(title, "Rust") { topic = "oss" }
    else if vc_has(title, "安全") || vc_has(title, "漏洞") || vc_has(title, "攻击") { topic = "sec" }
    else if vc_has(title, "融资") || vc_has(title, "估值") || vc_has(title, "收购") { topic = "money" }
    else if vc_has(title, "AI") || vc_has(title, "模型") || vc_has(title, "智能体") { topic = "ai" }
    // 种子 = 条号 × 13 + 标题长度：让同一条在同一期里稳定取到同一句，
    // 不同条之间又不容易撞（原来只用条号 + 长度，第 1 条和第 4 条撞过同一句）。
    let seed = i * 13 + title.len()
    if topic != "" {
        let t = guga_take_pick(topic, seed)
        if t != "" { return t }
    }
    guga_take_pick(tier_of(r), seed)
}

fn guga_outro(){
    let rows = rv_rows()
    let n = rows.len()
    if n == 0 { return "今天就到这儿，本鹅明天接着给你盯。" }
    let f = 0
    for r in rows {
        if tier_of(r) == "first" { f = f + 1 }
    }
    let mood = ""
    if f >= 4 { mood = "今天一手料 " + ("" + f) + " 条，本鹅说话难得这么硬气。" }
    else if f >= 1 { mood = "今天一手料 " + ("" + f) + " 条，剩下的是本鹅替你筛过的二手。" }
    else { mood = "今天全是转述来的，本鹅念得不太痛快，将就看。" }
    let on = guga_outros.len()
    let sign = ""
    if on > 0 { sign = guga_outros[guga_mod(n + f, on)] }
    if sign == "" { return mood }
    mood + " " + sign
}

// 给一条挑一句私货。题材命中就按题材说，否则按信源档位说。


fn rv_build(){
    rv_q = []
    rv_q.push(rv_intro())
    let i = 1
    let all = rv_rows()
    for r in all {
        if i < 6 {
            let ii = "" + i
            // 标题先掐到 52 字再拼。一段的上限是 150 字（vc_say_now 那边还会再裁
            // 一次），英文长标题动辄一百多字 —— 不先掐，咕嘎后面那句点评就会被
            // 整个挤掉（实测过：第 4 条念出来只剩标题，私货没了）。
            // 只影响「念出来的」，屏幕上仍然是完整标题。
            let head = art_cut(r.title, 52)
            // 每条后面跟一句咕嘎自己的话（来源见上面的 guga_takes）。
            // 这里刻意把「事实」和「私货」用句号断开、私货另起一句，
            // 念出来也有停顿，读者分得清哪句是报、哪句是它说的。
            let tk = guga_take(r, i)
            if tk == "" {
                rv_q.push("第 " + ii + " 条，" + head)
            } else {
                rv_q.push("第 " + ii + " 条，" + head + "。" + tk)
            }
        }
        i = i + 1
    }
    // 第 6 条往后不逐条念（150 字一段 × 十条会念到读者睡着），
    // 但得让听众知道后面还有几条，收尾那句也才有依据。
    let n = all.len()
    if n >= 6 {
        rv_q.push("后面还有 " + ("" + (n - 5)) + " 条，本鹅就不一条条念了，你往下翻。")
    }
    rv_q.push(guga_outro())
}

fn issues_push(){
    // 这一期出完了，存进档。同一个 id（出报时间戳）只留一份。
    let it = []
    if fs.exists("issues.json") {
        let v = fs.read("issues.json").parse_json()
        if v != nil {
            let x = v["items"]
            if x != nil { it = x }
        }
    }
    let kept = []
    let myid = "" + finished_at
    for e in it {
        if "" + e.id != myid { kept.push(e) }
    }
    kept.push({id: myid stamp: stamp_label(finished_at) intro: ai_intro rows: picked okn: ok_sources.len() failn: failed.len()})
    // 留 5 期 —— 够回看几天，也不至于把本机存储撑大
    while kept.len() > 5 { kept.remove(0) }
    issues = kept
    fs.write("issues.json", {schema: 1 saved_at: time_now() items: kept}.to_json())
}

// 结果页正文现在显示哪一期的条目
// 结果页正文现在显示哪一期的条目
fn issues_rows(){
    if issue_sel == "" { return show_rows() }
    for e in issues {
        if "" + e.id == issue_sel { return issue_rows_safe(e.rows) }
    }
    show_rows()
}

// 存档行形状归一：渲染路径（row_meta / row_img / row_sum / panel_mark /
// open_story）都会碰这些字段，缺一个就抛错、整个闭包作废。这里一次性补全，
// 补的都是「空值」而不是假数据 —— 显示为空，不代表这条新闻有那个信息。
// ---- 时间归一：把读者输入折成「月-日」或关键词 ----
// 支持：10月11日 / 10-11 / 10/11 / 1011 / 昨天 / 今天 / 前天。
fn wb_norm_date(q){
    let s = q.trim()
    s = s.replace(" ", "")
    s = s.replace("号", "日")
    s = s.replace(".", "-")
    // 「10月11日」→「10-11」
    s = s.replace("月", "-")
    s = s.replace("日", "")
    // 「2026-10-11」→ 取后两段
    let parts = s.split("-")
    if parts.len() >= 3 {
        let mm = parts[parts.len() - 2]
        let dd = parts[parts.len() - 1]
        return wb_pad(mm) + "-" + wb_pad(dd)
    }
    if parts.len() == 2 {
        return wb_pad(parts[0]) + "-" + wb_pad(parts[1])
    }
    // 「1011」这种四位纯数字
    let d2 = wb_digits_only(s)
    if d2.len() == 4 {
        let mm2 = ""
        let dd2 = ""
        let k = 0
        for c in d2.split("") {
            if c != "" {
                if k < 2 { mm2 = mm2 + c } else { dd2 = dd2 + c }
                k = k + 1
            }
        }
        return mm2 + "-" + dd2
    }
    ""
}

// 档案分区每次 sync_ui 都刷新一遍（命名控件 + set_text / set_visible，
// 不用 on_render：面板里的 on_render 重建子控件会打断布局，见期次标签条的教训）。
fn wb_arc_sync(){
    ui.wb_hint.set_text(wb_hint_text())
    let n = wb_arc_res.len()
    ui.wb_rrow1.set_visible(n >= 1)
    ui.wb_r1.set_text(wb_res_line(0))
    ui.wb_rrow2.set_visible(n >= 2)
    ui.wb_r2.set_text(wb_res_line(1))
    ui.wb_star.set_text(wb_star_text())
    ui.wb_fav_head.set_text(wb_fav_head_text())
    // 收藏夹面板只放最上面两条，最新的排前面 —— 按钮索引跟着算出来
    // （面板没有滚动，这是刻意的：两条 + 「打开/移除」点得到，比塞满点不到强）。
    let m = wb_favs.len()
    let i1 = m - 1
    let i2 = m - 2
    ui.wb_frow1.set_visible(m >= 1)
    if m >= 1 { ui.wb_f1.set_text(wb_fav_line(i1)) }
    ui.wb_frow2.set_visible(m >= 2)
    if m >= 2 { ui.wb_f2.set_text(wb_fav_line(i2)) }
}

fn pg_status_load(){
    if !fs.exists("guga_pet.json") { return }
    let v = fs.read("guga_pet.json").parse_json()
    if v == nil { return }
    if v["hunger"] != nil { pg_hunger = v["hunger"] }
    if v["happy"] != nil { pg_happy = v["happy"] }
    if v["energy"] != nil { pg_energy = v["energy"] }
    // 体量与位置也存同一个文件 —— 但存的是「合并后的整包」，
    // 见 pg_geo_write()：分开写会把对方那一半冲掉。
    if v["px"] != nil { pet_px = v["px"] }
    if v["py"] != nil { pet_py = v["py"] }
    if v["size"] != nil { pet_size_i = v["size"] }
}

// 唯一的落盘口：状态和体量一起写，谁先写都不会把另一半抹掉。
// 拖动：dx/dy 是相对按下的累计偏移（宿主 GestureView 的口径）。
// 拖的过程里只切占位控件，绝不重建桌宠本体 —— 这是手势能一路跟到 phase 2 的原因。
fn pet_pan(dx, dy, phase){
    if phase == 0 {
        pet_drag_on = true
        pet_drag_x0 = pet_px
        pet_drag_y0 = pet_py
        pet_line = "咕嘎～轻点放，本鹅会头晕的。"
        pet_line_until = time_now() + 2.0
        pet_sync_bubble()
        return
    }
    if phase == 1 {
        pet_set_pos(pet_drag_x0 + dx, pet_drag_y0 + dy)
        return
    }
    pet_set_pos(pet_drag_x0 + dx, pet_drag_y0 + dy)
    pet_drag_on = false
    pet_geo_save()
}

// 捏合缩放（触屏；鼠标上不产生这个事件）—— 用累计倍数跨过阈值就换一档。
// 记一条「正在查」。等主编把结果端回来再回填条数与标题。
fn bl_begin(kind, q){
    bl_load()
    bl_start_fin = "" + finished_at
    let one = {d: today_text() kind: kind q: q n: 0 top: "" st: "正在联网查"}
    bl_items.push(one)
    bl_pending = bl_items.len() - 1
    bl_save()
    bl_sync()
    return bl_pending
}

// 主编那边一旦把这一期做出来（phase 走到 done），就把真结果回填进刚才那条。
// 挂在这里而不是和模型回调耦合：出报路径只有一条，phase 是它唯一的收敛信号。
// 主编那边一旦把这一期做出来（phase 走到 done），就把真结果回填进刚才那条。
// 挂在这里而不是和模型回调耦合：出报路径只有一条，phase 是它唯一的收敛信号。
fn bl_harvest(){
    if bl_pending < 0 { return false }
    if phase != "done" { return false }
    let key = "" + finished_at
    if key == bl_last_harvest { return false }
    bl_last_harvest = key
    let i = bl_pending
    bl_pending = -1
    if i < 0 || i >= bl_items.len() { return false }
    let one = bl_items[i]
    let n = picked.len()
    one.n = n
    let tops = ""
    let c = 0
    for r in picked {
        if c >= 3 { break }
        let tt = ""
        if r["title"] != nil { tt = "" + r["title"] }
        if tt != "" {
            if c > 0 { tops = tops + " ／ " }
            tops = tops + art_cut(tt, 26)
        }
        c = c + 1
    }
    one.top = tops
    if n > 0 { one.st = "已汇总" } else { one.st = "没查到干净的条目" }
    bl_items[i] = one
    bl_save()
    bl_sync()
    bl_log_line()
    true
}

// 主编这条路走不通时，把「正在联网查」那条如实收尾。
// 一条永远停在「正在查」的记录，比一条写着失败原因的记录更误导人 ——
// 饲养员会以为查询还在跑，其实早就断了。
// 主编这条路走不通时，把「正在联网查」那条如实收尾。
// 一条永远停在「正在查」的记录，比一条写着失败原因的记录更误导人 ——
// 饲养员会以为查询还在跑，其实早就断了。
fn bl_fail(why){
    if bl_pending < 0 { return }
    let i = bl_pending
    bl_pending = -1
    if i < 0 || i >= bl_items.len() { return }
    let one = bl_items[i]
    one.st = "没查成：" + art_cut(why, 26)
    bl_items[i] = one
    bl_save()
    bl_sync()
    ag_log.push({who: "tool" text: "浏览记录 +1：" + one.kind + " · " + one.st})
    ag_trim_log()
}

// 一轮对话收尾时调用。出报成功的那条由 bl_harvest 回填（phase 走到 done），
// 这里只管「这一轮压根没出报」的情况，避免记录悬着。
// 一轮对话收尾时调用。出报成功的那条由 bl_harvest 回填（phase 走到 done），
// 这里只管「这一轮压根没出报」的情况，避免记录悬着。
fn bl_settle(){
    if bl_pending < 0 { return }
    // 只有「这一轮把新一期做出来了」才算查成 —— finished_at 变了才是新一期，
    // 否则会拿上一期的 picked 充数，把这次询问误记成「已汇总」。
    if ("" + finished_at) != bl_start_fin {
        if bl_harvest() { return }
    }
    bl_fail("主编这一轮没出报")
}

fn bl_toggle(){
    bl_open = !bl_open
    if bl_open { pf_open = false }
    bl_sync()
    pf_sync()
}

