// 晨报卡 v2 — AI 主编
// 官方技术栈：OctoSense App Hub 的 card-host + splash 脚本 + 宿主大模型服务（llm）
// 说明：新闻只来自公开来源；标题原样呈现；是否让 AI 参与由用户在计划页批准。

// =====================================================================
// 编辑部宪法 · 提示词版本表
// ---------------------------------------------------------------------
// 所有喂给大模型的 system 指令集中在这里，每条带一个版本号。
// 为什么要有这个东西：
//   以前提示词散落在 9 处 host.request 里，改了哪一处、什么时候改的，
//   事后无从查证。一份可以被审问的报纸，必须说清它是照着哪版规矩编的。
//   出报时会把这几个版本号一起写进 trail.json，于是任何一期都能倒推回当时的规矩。
// 改动纪律：改文案就升版本号（v1 → v2），不要原地改。
// 条款说明写在 note 里，答读者「你们的编辑方针是什么」时用得上。
let charter = [
    {id: "ask"    v: "v1" label: "开报前的一问" note: "两个选项必须互斥，且都能直接当成本期关注点"}
    {id: "panel"  v: "v1" label: "三视角初审" note: "技术 / 行业 / 读者各判各的，不许串供"}
    {id: "judge"  v: "v2" label: "主编终审" note: "传闻最多 1 条且须写明未证实；一手同权重优先；公开砍掉的三条"}
    {id: "story"  v: "v1" label: "逐条解读" note: "写给不懂技术的普通人，两段，不复述标题"}
    {id: "forecast" v: "v2" label: "预测与断言台账" note: "预测须一周内可检验；claims 只写标题里看见的，不推测"}
    {id: "factcheck" v: "v1" label: "跨源核对与更正" note: "宁可空着也不硬凑；略有出入不算推翻"}
    {id: "cover"  v: "v1" label: "头版视觉" note: "英文标语 + 无文字画面描述"}
    {id: "interview" v: "v1" label: "追问信" note: "只问一个可验证的问题，不奉承不指控"}
]

fn charter_v(id){
    for c in charter { if c.id == id { return c.v } }
    "?"
}

fn charter_version_line(){
    out = ""
    for c in charter {
        if out != "" { out = out + " · " }
        out = out + c.id + "/" + c.v
    }
    "编辑部宪法 " + out
}

fn charter_text(){
    let out = "本报实行的编辑方针（可被读者引用与追责）："
    for c in charter {
        out = out + "\n· " + c.label + "（" + c.id + " " + c.v + "）—— " + c.note
    }
    out
}

