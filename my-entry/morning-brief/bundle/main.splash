fn fetch_h(url, hdrs){
    let p = promise()
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: hdrs}) do net.HttpEvents{
        on_response: |res| p.resolve(res)
        on_error: |_err| p.resolve(nil)
    }
    p
}

fn fetch(url){
    // 这里**故意不带任何自定义请求头**。
    //
    // 踩过的坑（已报上游，见 my-entry/patches/UPSTREAM-net-headers.md）：
    // 宿主把一批「传输层」头列为保留头——`host` / `content-length` / `connection` /
    // **`user-agent`** / `accept-encoding` / `expect` / `te` / `trailer` / `upgrade` /
    // `keep-alive` / `proxy-*`——卡片一旦设置，`Request::header()` 直接返回
    // `Err(ReservedHeader)`，**整条请求根本不发出去**，只在卡片这边触发 `on_error`。
    // 而 `on_error` 拿到的错误值和「DNS 失败 / 超时」长得一模一样：11 个来源
    // 全部变成「取不到」，界面上看不出任何原因。这一点排查了两轮，
    // 第一轮还错误地把原因归到「值必须是字符串数组」上（最小探针实测：不是，裸字符串照样能用）。
    //
    // 其余头都能用：实测 `Authorization` / `Referer` / `Cookie` / `Accept-Language`
    // 全部 200，所以带密钥调外部 API 完全没问题。
    // 不带 UA 也不影响这几个源：实测 B站热门、抖音热榜在空 UA 下同样 200。
    fetch_h(url, {})
}

fn hn_rows(body){
    let out = []
    let data = body.parse_json()
    if data == nil || data.hits == nil { return out }
    for hit in data.hits {
        // 缺字段的读法是「先取键，再判空」：直接 hit.title 在缺键时会抛错，
        // 整轮取数会卡死（HN 的 Ask HN 类帖子天生没有 url）。
        let title = hit["title"]
        if title == nil { continue }
        title = "" + title
        if title == "" { continue }
        let oid = hit["objectID"]
        if oid == nil { continue }
        oid = "" + oid
        let discussion = "https://news.ycombinator.com/item?id=" + oid
        let link = discussion
        let u = hit["url"]
        if u != nil && u != "" { link = "" + u }
        let published = 0
        let pi = hit["created_at_i"]
        if pi != nil { published = pi }
        out.push({id: "hn-" + oid title: title link: link source: "Hacker News" published: published
            summary: "" image: "" discussion: discussion points: hit["points"] comments: hit["num_comments"]})
    }
    out
}

fn bili_rows(body){
    // B站综合热门：公开 JSON，data.list[]，bvid 拼视频地址，UP 名当来源，播放量当热度。
    let out = []
    let data = body.parse_json()
    if data == nil || data["data"] == nil || data["data"]["list"] == nil { return out }
    for it in data["data"]["list"] {
        let title = it["title"]
        if title == nil || title == "" { continue }
        title = "" + title
        let bv = it["bvid"]
        if bv == nil { continue }
        bv = "" + bv
        if bv == "" { continue }
        let src = "B站"
        let ow = it["owner"]
        if ow != nil && ow["name"] != nil { src = "" + ow["name"] }
        let pub = 0
        let pd = it["pubdate"]
        if pd != nil { pub = pd }
        let pv = nil
        let st = it["stat"]
        if st != nil && st["view"] != nil { pv = st["view"] }
        out.push({id: "bili-" + bv title: title link: "https://www.bilibili.com/video/" + bv source: src published: pub
            summary: "" image: "" discussion: "" points: pv comments: nil})
    }
    out
}

fn dy_rows(body){
    // 抖音热榜（iesdouyin 公开热搜榜）：只有词和热度，没有链接，按词生成搜索页地址。
    let out = []
    let data = body.parse_json()
    if data == nil || data["word_list"] == nil { return out }
    let i = 0
    for it in data["word_list"] {
        let w = it["word"]
        if w == nil || w == "" { continue }
        w = "" + w
        if w == "" { continue }
        let hv = nil
        if it["hot_value"] != nil { hv = it["hot_value"] }
        out.push({id: "dy-" + i title: w link: "https://www.douyin.com/search/" + w.url_encode() source: "抖音热榜" published: 0
            summary: "" image: "" discussion: "" points: hv comments: nil})
        i = i + 1
    }
    out
}

fn feed_rows(body, s){
    let items = body.parse_feed(s.kind)
    if items == nil { return nil }
    let out = []
    for i it in items {
        let itt = it["title"]
        if itt == nil || itt == "" { continue }
        let source = it["source"]
        if source == nil || source == "" { source = s.label }
        let published = 0
        let pu = it["published"]
        if pu != nil { published = pu }
        out.push({id: s.id + "-" + i title: it.title link: it.link source: source published: published
            summary: it.summary image: it.image discussion: "" points: nil comments: nil})
    }
    out
}

fn clean_html(raw){
    if raw == nil || raw == "" { return "" }
    let doc = raw.parse_html()
    let ps = doc.query("p").array()
    if ps.len() == 0 { return doc.text.trim() }
    let out = ""
    for p in ps {
        let t = p.text.trim()
        if t != "" {
            if out != "" { out = out + "\n" }
            out = out + t
        }
    }
    out
}

fn fail_has(label){
    for f in failed { if f.label == label { return true } }
    false
}

fn src_ok(label){
    for o in ok_sources { if o.label == label { return true } }
    false
}

fn topic_hit(t, title){
    if regex(t.en, "i").test(title) { return true }
    regex(t.zh, "i").test(title)
}

fn topic_on(id){
    // 品类表以后还会加，别再把 id 硬编码成一串 if。
    let v = chosen[id]
    if v == nil { return false }
    v
}

fn plat_on(id){
    let v = chosen_plat[id]
    if v == nil { return false }
    v
}

fn plat_label(id){
    for p in plats { if p.id == id { return p.label } }
    id
}

fn plat_line(){
    let out = ""
    let n = 0
    for p in plats {
        if plat_on(p.id) {
            if out != "" { out = out + "、" }
            out = out + p.label
            n = n + 1
        }
    }
    if n == 0 { return "未选平台（一个都不取）" }
    out
}

fn plat_note_line(){
    // 计划页要如实说出「这次会去哪儿取数」，勾了几个就说几个。
    let out = ""
    for s in sources {
        if plat_on(s.plat) {
            out = out + "  · " + s.label + " — " + s.note + "\n"
        }
    }
    if out == "" { return "（没有勾选任何平台）\n" }
    out
}

fn src_n(){
    // 「全部失败」的判断要用「这次实际取了几家」，不是来源总数——
    // 否则用户只勾 2 家、这 2 家都挂了，界面会说「部分失败」。
    let n = 0
    for s in sources { if plat_on(s.plat) { n = n + 1 } }
    n
}

fn row_hit(title){
    let n = 0
    for t in topics { if topic_on(t.id) { n = n + 1 } }
    if n == 0 { return true }
    for t in topics {
        if topic_on(t.id) && topic_hit(t, title) { return true }
    }
    false
}

fn sort_desc(rows){
    let out = []
    for r in rows {
        let placed = false
        let next = []
        for o in out {
            if !placed && r.published > o.published {
                next.push(r)
                placed = true
            }
            next.push(o)
        }
        if !placed { next.push(r) }
        out = next
    }
    out
}

fn already(rows, id){
    for r in rows { if r.id == id { return true } }
    false
}

fn reason_of(id){
    for w in ai_whys { if w.id == id { return w.why } }
    ""
}

fn pad2(n){
    // 数字拼串必须先转成文本：直接 "0" + n 会在运行时中断整段渲染。
    let t = "" + n
    if n < 10 { return "0" + t }
    t
}

fn gen_time(){
    if finished_at <= 0 { return "尚未生成" }
    let t = local_time(time_now() + 28800)
    days[t.weekday] + " " + months[t.month - 1] + " " + t.day + "  " + pad2(t.hour) + ":" + pad2(t.minute)
}

fn today_text(){
    let t = local_time(time_now() + 28800)
    months[t.month - 1] + " " + t.day
}

// 报头上的期号：这是本报出到第几期（数字拼串必须先转文本再拼）
// 报头上的期号：这是本报出到第几期（数字拼串必须先转文本再拼）
fn issue_text(){
    // 回看往期时，期号位置明说「正在回看」，免得读者以为这就是最新一期。
    if issue_sel != "" { return "往期 · 回看中" }
    let n = pf_briefs + 1
    let t = "" + n
    "第 " + t + " 期"
}

// =====================================================================
// ISO8601 → Unix 秒
//
// GitHub 搜索 API 给的时间是 "2026-09-11T12:34:56Z"，不是 Unix 秒。
//
// 踩过的坑（这个坑差点毁掉整条演示路径）：这里原本把 published 直接写成 0。
// 后果是一条链：
//   published=0 → `sort_desc`（按 published 降序）把 GitHub 条目全部沉底
//   → pool=16 一截，25 条一手来源一条不剩
//   → 信源构成变成「一手 0 · 二手 1 · 转载 15」
//   → 而拒刊判据恰好是「一手为 0 且二手 ≤ 2」→ 主编直接「今日休刊」
//   → 界面上只写「今天这些消息我没有把握」，看不出跟 GitHub 有任何关系。
// 所以时间必须真算出来，不能拿 0 糊过去。凡是「某来源的条目永远排在最后」
// 这类现象，都要先怀疑它的 published 是不是常数。
//
// 实现用 Howard Hinnant 的 days_from_civil，纯整数运算，不引任何时间库。
// =====================================================================
let iso_nonnum = regex("[^\\d]", "g")

fn days_from_civil(y, m, d){
    // 把公历 Y-M-D 折成「距 1970-01-01 的天数」。3 月被当成一年的起点，
    // 这样闰日永远落在年末，公式里不用单独特殊处理 2 月。
    let yy = y
    if m <= 2 { yy = y - 1 }
    let era = floor(yy / 400)
    let yoe = yy - era * 400
    let mp = m + 9
    if m > 2 { mp = m - 3 }
    let doy = floor((153 * mp + 2) / 5) + d - 1
    let doe = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy
    era * 146097 + doe - 719468
}

fn ago(secs){
    if secs == nil || secs <= 0 { return "" }
    let d = time_now() - secs
    if d < 60 { return "just now" }
    if d < 3600 { return "" + floor(d / 60) + "m ago" }
    if d < 86400 { return "" + floor(d / 3600) + "h ago" }
    "" + floor(d / 86400) + "d ago"
}

// 纯函数：只由下标算编号。绝不能在渲染循环里再遍历 show_rows()——
// 那会打断外层迭代，列表只会渲染出第一行。
fn row_sum(r){
    let s = r["summary"]
    if s == nil { return "" }
    s
}

fn row_img(r){
    let v = r["image"]
    if v == nil { return "" }
    if v.len() < 12 { return "" }
    if v.search("http") != 0 { return "" }
    v
}

// model.complete answers {output, meta:{class,requested,attempts,usage,budget}}.
// The app never sees the provider or the model id, so the token count comes from
// meta.usage and nothing else is reported.
// model.complete answers {output, meta:{class,requested,attempts,usage,budget}}.
// The app never sees the provider or the model id, so the token count comes from
// meta.usage and nothing else is reported.
fn model_tokens(reply){
    if reply == nil { return 0 }
    let meta = reply.meta
    if meta == nil { return 0 }
    let usage = meta.usage
    if usage == nil { return 0 }
    let n = 0
    if usage.input_tokens != nil { n = n + usage.input_tokens }
    if usage.output_tokens != nil { n = n + usage.output_tokens }
    n
}

fn seconds_text(ms){
    if ms <= 0 { return "" }
    "" + (floor(ms / 100) / 10) + " 秒"
}

fn topics_line(){
    let out = ""
    for t in topics {
        if topic_on(t.id) {
            if out != "" { out = out + "、" }
            out = out + t.label
        }
    }
    if out == "" { return "未选主题（全部放行）" }
    out
}

fn hosts_line(){
    let out = ""
    for s in sources {
        if out != "" { out = out + "、" }
        out = out + s.host
    }
    out
}

fn sources_line(){
    if ok_sources.len() == 0 { return "无" }
    let out = ""
    for s in ok_sources {
        if out != "" { out = out + " · " }
        out = out + s.label + " " + s.n + " 条"
    }
    out
}

fn intent_preview(){
