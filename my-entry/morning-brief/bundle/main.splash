// ===== 线索时间轴 · 这条线索本报是从哪一步听到的 =====
//   stage 由信源等级映射而来，不是对事件本身的判断：
//     一手 → 已确认（官方口径）；二手 → 跟进中（媒体转述）；传闻/转载 → 爆料
//   本期入选条目与本报档案里同主题的上一条比较，升级或降级都记一笔。
let th_up = []

// ===== 落选公开 · 被砍掉的也让人看见 =====
let drop = []

// ===== 出报链路留痕 · 让这一期可以被复盘，而不只是被审问 =====
//   到目前为止，这份报已经能被「审问」（断言 / 更正 / 口径 / 落选四条台账），
//   但还不能被「复盘」：读者看不到编辑部当时到底看了什么、谁说了什么、主编为什么这么取舍。
//   新闻业需要可审计，而 AI 新闻产品现在几乎全是黑盒 —— 这里就是把过程摊开。
//   四样东西：候选池（原始条数 / 入池条数 / 标题）、三位初审的原始意见、
//   主编终审的原话、以及当时照着哪版提示词编的。
//   全部是本地数据，零额外 LLM 调用（都是本来就要落盘的东西）。
let trail = {}
let trail_msg = ""
// ★ 留痕的读盘缓存：trail.json 整包只读一次，之后永远走内存。
//
// 为什么必须有这道缓存 —— 这是「用着用着就白屏」的根因：
// 结果页列表的 on_render 每帧都要调 replay_text / replay_pool_line /
// replay_panel_line / replay_judge_line，其中 replay_text 原来是**直接**
// fs.read("trail.json") + parse_json()，replay_now() 在 trail 为空时也一样。
// 也就是每一帧要做 4 次磁盘读 + 4 次 JSON 解析。脚本单次求值有墙钟预算，
// 被打爆后 VM 直接掐断（日志 `script time budget exceeded`，vm.rs:1046），
// 这一帧什么都画不出来 → 白屏；下一帧照样超时 → 永远白屏，只能退出重开。
// 而「退出重开」恰恰又会再进这个状态（last_brief.json 恢复了正文、
// 留痕却没进内存），所以用户看到的是「经常白屏、重开也治不好」。
//
// 出报后 trail_save() 会把最新一期写进内存里的 `trail`，并把本缓存作废重读。
let replay_items_c = nil

// 本期留痕的骨架。approve() 里初始化，各处逐步填。
fn trail_set_panel(id, label, votes, digest, ms){
    if trail.len() == 0 { return }
    let p = trail["panel"]
    p.push({id: id label: label votes: votes digest: digest ms: ms})
    trail["panel"] = p
}

fn trail_load(){
    if !fs.exists("trail.json") { return }
    let v = fs.read("trail.json").parse_json()
    if v == nil { return }
    let it = v["items"]
    if it == nil { return }
    let n = it.len()
    if n == 0 { return }
    trail_msg = "本报留了 " + ("" + n) + " 期的出报过程可复盘"
}

// 给主编看的留痕摘要
// 安全取字符串：字段缺失或类型不对时返回空串，绝不把 nil 拼进 art_cut
// （本项目历史上踩过「JSON 缺字段直接取属性会抛错」的坑，这里统一走这个口）
fn s_of(o, k){
    if o == nil { return "" }
    let v = o[k]
    if v == nil { return "" }
    "" + v
}

// 取「最近一期」的留痕对象（优先内存里正在跑的这一期）
// 留痕整包（最多三期）。只在第一次用到时读一次盘。
// 所有回放相关的取数都必须走这里，绝不允许在 on_render 里直接 fs.read。
fn replay_all(){
    if replay_items_c != nil { return replay_items_c }
    replay_items_c = []
    if !fs.exists("trail.json") { return replay_items_c }
    let v = fs.read("trail.json").parse_json()
    if v == nil { return replay_items_c }
    let it = v["items"]
    if it == nil { return replay_items_c }
    replay_items_c = it
    replay_items_c
}

fn replay_now(){
    // 当前这一期优先用内存里的 `trail`（它比盘上的新 —— 封面/核对回来还会补写）
    if trail.len() > 0 { return trail }
    let it = replay_all()
    let n = it.len()
    if n == 0 { return {} }
    it[n - 1]
}


// 域名匹配：先判相等，再判「.域名」结尾。
// 这个 DSL 没有 ends_with，所以只能靠 search("." + d) 来模拟后缀判断；
// 好处是 netflix.com 不会被误判成 x.com。
// 域名匹配：先判相等，再判「.域名」结尾。
// 这个 DSL 没有 ends_with，所以只能靠 search("." + d) 来模拟后缀判断；
// 好处是 netflix.com 不会被误判成 x.com。
fn dom_hit(h, d){
    if h == d { return true }
    if h.len() <= d.len() { return false }
    h.search("." + d) >= 0
}

// 档位查表：域名 → 档位。原来是把四张表挨个 dom_hit 一遍（95 次/域名），
// 80 条候选就要跑近万次字符串比较 —— 实测直接把脚本指令预算打爆
// （[E] script instruction limit exceeded），后果是 gather() 半路中断、
// 候选池变成 0 条、整期晨报空着出来，而界面上只写「候选 0 条」，
// 完全看不出是档位判定把预算烧光了。
// 改成先建表、再用「后缀链」查（news.ycombinator.com → ycombinator.com → com），
// 一个域名最多查 3~4 次。
let tier_map = {}
let tier_cache = {}

fn tier_map_build(){
    tier_map = {}
    // 写入顺序 = 原来的判定优先级：先传闻、再转载、再一手，最后二手。
    // 同一个域名同时出现在两张表里时，先写的赢。
    for d in tier_rumor  { if tier_map[d] == nil { tier_map[d] = "rumor" } }
    for d in tier_repost { if tier_map[d] == nil { tier_map[d] = "repost" } }
    for d in tier_first  { if tier_map[d] == nil { tier_map[d] = "first" } }
    for d in tier_second { if tier_map[d] == nil { tier_map[d] = "second" } }
}

fn tier_of_h(h){
    if h == "" { return "repost" }
    let got = tier_cache[h]
    if got != nil { return got }
    let parts = ("" + h).split(".")
    let t = ""
    let i = 0
    // 从最具体的后缀开始往回收，第一个命中的就是答案（越具体越优先）。
    while i < parts.len() {
        let suf = parts[i]
        let k = i + 1
        while k < parts.len() {
            suf = suf + "." + parts[k]
            k = k + 1
        }
        let hit = tier_map[suf]
        if hit != nil { t = hit  break }
        i = i + 1
    }
    if t == "" { t = "second" }
    tier_cache[h] = t
    t
}

