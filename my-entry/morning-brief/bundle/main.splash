let pet_stock_names = ["idle" "cheer" "pout" "sad" "sleepy" "surprised"]

// ---- 状态系统（桌宠的饱食度/心情/精力，20 秒一滴、按心情换脸）----
//   桌宠里这三条是 QTimer 驱动的生命周期，喂食/逗玩/摸摸/打盹各有增减；
//   卡片里同样保留：数值存在本机 fs（guga_pet.json），换脸由 pg_mood() 决定。
//   差别在于「谁来补」：桌宠靠玩家点喂食，卡片靠主编台的实干功（总结/出报/换头版…），
//   见下面的 pg_effect。所以菜单里不再有卖萌按钮，也不该有。
//   差别在于「谁来补」：桌宠靠玩家点喂食，卡片靠主编台的实干功（总结/出报/换头版…），
//   见下面的 pg_effect。所以菜单里不再有卖萌按钮，也不该有。
let pg_hunger = 85.0
let pg_happy = 75.0
let pg_energy = 90.0
let pg_status_t = 0
let pg_saved_t = 0

fn pg_mood(){
    // 桌宠的阈值原样搬过来：默认开心，只有极饿/极困才难过。
    if pg_hunger < 10.0 { return "sad" }
    if pg_energy < 12.0 { return "sleepy" }
    if pg_hunger < 25.0 { return "pout" }
    if pg_happy > 60.0 && pg_energy > 50.0 { return "cheer" }
    "idle"
}

// 唯一的落盘口：状态和体量一起写，谁先写都不会把另一半抹掉。
fn pg_geo_write(){
    fs.write("guga_pet.json", {schema: 2 saved_at: time_now()
        hunger: pg_hunger happy: pg_happy energy: pg_energy
        px: pet_px py: pet_py size: pet_size_i}.to_json())
}

fn pet_geo_save(){
    pg_geo_write()
}

fn pg_status_save(){
    let now = time_now()
    // 落盘节流：状态每 20 秒才动一点，没必要每个心跳都写
    if now - pg_saved_t < 60.0 { return }
    pg_saved_t = now
    pg_geo_write()
}

fn pg_clamp(v){
    let x = v
    if x < 0.0 { x = 0.0 }
    if x > 100.0 { x = 100.0 }
    x
}

fn pg_status_tick(){
    pg_status_t = pg_status_t + 1
    if pg_status_t < 20 { return }
    pg_status_t = 0
    // 20 秒一滴。桌宠原值是「饿 -0.4 / 心情 -0.3 / 精力 -0.3」，
    // 但桌宠有喂食按钮补，卡片这边把入口换成了真实功能（见 pg_effect），
    // 补得慢了就得降耗：饿改成 -0.25，一小时掉 45 点，一次总结能补回来 5 点。
    pg_hunger = pg_clamp(pg_hunger - 0.25)
    pg_happy = pg_clamp(pg_happy - 0.2)
    pg_energy = pg_clamp(pg_energy - 0.3)
    pg_status_save()
}

fn pg_effect(kind){
    // 干实事就是喂饭。主编台改成「总结 / 换头版 / 查档案 / 出报 / 配图」这类真实功能后，
    // 这里也跟着改成按工作量回馈 —— 菜单里已经没有空转的卖萌互动了，
    // 如果还留着「摸摸 +8 心情」那套，咕嘎就再也吃不上饭、只会一直撇嘴。
    if kind == "sum" {              // 总结今天这一期：动脑子，费点精力
        pg_hunger = pg_clamp(pg_hunger + 5.0)
        pg_happy = pg_clamp(pg_happy + 6.0)
        pg_energy = pg_clamp(pg_energy - 4.0)
    }
    else if kind == "cover" {        // 换头版（构图）：最费视觉主编
        pg_hunger = pg_clamp(pg_hunger + 4.0)
        pg_happy = pg_clamp(pg_happy + 8.0)
        pg_energy = pg_clamp(pg_energy - 5.0)
    }
    else if kind == "brief" {        // 出整期：最累，也最饱
        pg_hunger = pg_clamp(pg_hunger + 8.0)
        pg_happy = pg_clamp(pg_happy + 12.0)
        pg_energy = pg_clamp(pg_energy - 10.0)
    }
    else if kind == "art" {          // 给某一条画配图
        pg_hunger = pg_clamp(pg_hunger + 3.0)
        pg_happy = pg_clamp(pg_happy + 6.0)
        pg_energy = pg_clamp(pg_energy - 4.0)
    }
    else if kind == "talk" {         // 分析讨论
        pg_hunger = pg_clamp(pg_hunger + 3.0)
        pg_happy = pg_clamp(pg_happy + 5.0)
        pg_energy = pg_clamp(pg_energy - 3.0)
    }
    else if kind == "read" {         // 查档案 / 更正台账 / 回放：纯本地，几乎不耗
        pg_hunger = pg_clamp(pg_hunger + 2.0)
        pg_happy = pg_clamp(pg_happy + 3.0)
    }
}

// ---- 桌宠神态/互动的运行态 ----
let pet_act = ""                 // 正在播的动作：bounce/shake/point/peek/tsundere
let pet_seq_q = []               // 动作帧序列（每步 {f: 帧名 d: 秒}）
let pet_seq_i = 0
let pet_talk_on = false          // 说话口型在不在跑
let pet_talk_until = 0
let pet_talk_t = 0
let pet_breath = false           // 呼吸帧开关（脚底锚点微缩，见 bake_motion_frames.py）
// 呼吸节奏闸：主循环 1 秒一拍，这里每 2 拍才换一次呼吸帧（4 秒一个来回）。
// 之前每拍就翻一次 —— 1Hz 硬切两帧，实机上就是「企鹅不停闪动」的观感来源之一。
let pet_breath_gate = 0
let pet_hold = ""                // 互动后的临时表情
let pet_hold_until = 0
let pet_idle_cd = 12             // 闲时小动作的倒计时（秒）
let pet_line = ""                // 气泡里说的话
let pet_line_until = 0
let pet_bubble_vis = false
let pet_listen = false           // 麦克风开着时竖耳朵（惊讶脸）
let pet_last_phase = ""
let pet_cur_frame = "idle"
let pet_cur_src = ""             // 当前已经下发过的贴图路径（重复下发会让桌宠闪）
// 咕嘎说话要不要冒气泡框。用户要的是「能看见它说的那句话」，所以要有个开关
// 让他自己决定（工作台顶上那枚「气泡 开/关」）。默认开着。
let pet_bubble_on = true
let pet_tick_on = false          // 呼吸/闲时小动作的主循环开关
let pet_seq_gen = 0              // 动作序列代次：连点企鹅时旧定时器不许推进新序列

// ===== 桌宠的体量与位置 =====
// 桌面版那只企鹅可以随便拖、随便放大缩小。卡片脚本层没有任何几何 setter
// （见 OctoScript-App-Design-Flow/docs/SCRIPT-API.md 的「ui.<id>」那一节：
//  只有 set_text / set_visible / render / set_src / value 这一组），所以这里换一条路：
//   * 位置 = 一组预先声明好的「占位控件」按二进制开关叠出来的偏移。
//     要往右挪 137px，就把 128 / 8 / 1 三个占位符打开。
//     占位符是普通静态控件，只切可见性 —— 隐藏的控件不参与布局（已实测）。
//   * 体量 = 四只尺寸各写死一份的咕嘎，同一时刻只让一只可见。
// 全程不碰任何几何字段，所以 GestureView 不会被重建，拖动期间手势不会断
// （对照：把桌宠放进 on_render 里、拖动中调 render() 重建，会立刻丢掉手势，
//  实测只收到 phase 0/1 各一次，phase 2 永远不来）。
// 卡片内容区宽 412、高 723（不含顶部 29px 标题栏）。
let pet_size_i = 1               // 0 小 / 1 中 / 2 大 / 3 特大
let pet_px = 6.0                 // 当前位置（卡片内坐标，逻辑点）
let pet_py = 430.0
let pet_drag_on = false
let pet_drag_x0 = 0.0
let pet_drag_y0 = 0.0
let pet_pinch_on = false
let pet_pinch_last = 1.0

fn pet_w_of(i){
    if i <= 0 { return 60.0 }
    if i == 1 { return 92.0 }
    if i == 2 { return 130.0 }
    170.0
}

fn pet_h_of(i){
    if i <= 0 { return 84.0 }
    if i == 1 { return 128.0 }
    if i == 2 { return 181.0 }
    236.0
}

fn pet_size_name(i){
    if i <= 0 { return "小" }
    if i == 1 { return "中" }
    if i == 2 { return "大" }
    "特大"
}

// 把 pet_px / pet_py 拆成二进制，逐位切占位控件的可见性。
// 顺序必须是「从大到小」：先拿掉权重最大的那一位，剩下的余数再给下一位。
// 反过来从 1 开始贪心的话，`余数 >= 1` 这一条对任何正数都成立，
// 前八位会全亮，位置会永远卡在 255（这个坑实测踩过）。
// 只在「整数位置真的变了」时才调用 —— 鼠标每个移动事件都发二十来个宿主调用不值得。
// 把 pet_px / pet_py 拆成二进制，逐位切占位控件的可见性。
// 顺序必须是「从大到小」：先拿掉权重最大的那一位，剩下的余数再给下一位。
// 反过来从 1 开始贪心的话，`余数 >= 1` 这一条对任何正数都成立，
// 前八位会全亮，位置会永远卡在 255（这个坑实测踩过）。
// 只在「整数位置真的变了」时才调用 —— 鼠标每个移动事件都发二十来个宿主调用不值得。
fn pet_spacers_sync(){
    let bx = pet_px
    let sx256 = bx >= 256.0
    if sx256 { bx = bx - 256.0 }
    let sx128 = bx >= 128.0
    if sx128 { bx = bx - 128.0 }
    let sx64 = bx >= 64.0
    if sx64 { bx = bx - 64.0 }
    let sx32 = bx >= 32.0
    if sx32 { bx = bx - 32.0 }
    let sx16 = bx >= 16.0
    if sx16 { bx = bx - 16.0 }
    let sx8 = bx >= 8.0
    if sx8 { bx = bx - 8.0 }
    let sx4 = bx >= 4.0
    if sx4 { bx = bx - 4.0 }
    let sx2 = bx >= 2.0
    if sx2 { bx = bx - 2.0 }
    let sx1 = bx >= 1.0
    ui.px256.set_visible(sx256)
    ui.px128.set_visible(sx128)
    ui.px64.set_visible(sx64)
    ui.px32.set_visible(sx32)
    ui.px16.set_visible(sx16)
    ui.px8.set_visible(sx8)
    ui.px4.set_visible(sx4)
    ui.px2.set_visible(sx2)
    ui.px1.set_visible(sx1)

    let by = pet_py
    let sy512 = by >= 512.0
    if sy512 { by = by - 512.0 }
    let sy256 = by >= 256.0
    if sy256 { by = by - 256.0 }
    let sy128 = by >= 128.0
    if sy128 { by = by - 128.0 }
    let sy64 = by >= 64.0
    if sy64 { by = by - 64.0 }
    let sy32 = by >= 32.0
    if sy32 { by = by - 32.0 }
    let sy16 = by >= 16.0
    if sy16 { by = by - 16.0 }
    let sy8 = by >= 8.0
    if sy8 { by = by - 8.0 }
    let sy4 = by >= 4.0
    if sy4 { by = by - 4.0 }
    let sy2 = by >= 2.0
    if sy2 { by = by - 2.0 }
    let sy1 = by >= 1.0
    ui.py512.set_visible(sy512)
    ui.py256.set_visible(sy256)
    ui.py128.set_visible(sy128)
    ui.py64.set_visible(sy64)
    ui.py32.set_visible(sy32)
    ui.py16.set_visible(sy16)
    ui.py8.set_visible(sy8)
    ui.py4.set_visible(sy4)
    ui.py2.set_visible(sy2)
    ui.py1.set_visible(sy1)
}

fn pet_set_pos(x, y){
    let w = pet_w_of(pet_size_i)
    let h = pet_h_of(pet_size_i)
    let maxx = 412.0 - w - 4.0
    let maxy = 723.0 - h - 4.0
    if maxx < 4.0 { maxx = 4.0 }
    if maxy < 4.0 { maxy = 4.0 }
    if x < 4.0 { x = 4.0 }
    if x > maxx { x = maxx }
    if y < 4.0 { y = 4.0 }
    if y > maxy { y = maxy }
    let nx = floor(x)
    let ny = floor(y)
    if nx == pet_px && ny == pet_py { return }
    pet_px = nx
    pet_py = ny
    pet_spacers_sync()
}

// 工作台一开，先看桌宠挡没挡道 —— 用户原话：「工作台卡片就在咕嘎旁边，
// 不要盖住卡片」。工作台钉在右下角（宽 352、离底 58），桌宠要是正停在
// 它身上，就抬到工作台上沿之上、右沿对齐 —— 视觉上就是「咕嘎趴在工作台
// 边上看你办事」。
// 高度估计值 560：面板实际压矮后约 450 高，估大一点桌宠抬得更高、更稳。
// 只在这两块真的重叠时才动桌宠：饲养员亲手摆的位置，能不动就不动。
// ⚠️ 2026-10-13 踩坑：这个定义曾经整段丢失（只有调用没有定义），点工作台
// 就报 not found、工作台打不开。定义必须留在 pet_set_pos 之后、wb_open 之前。
fn pet_dodge_wb(){
    let w = pet_w_of(pet_size_i)
    let h = pet_h_of(pet_size_i)
    let wb_x0 = 412.0 - 10.0 - 352.0
    let wb_y0 = 723.0 - 58.0 - 560.0
    let hit_x = pet_px + w > wb_x0 && pet_px < 402.0
    let hit_y = pet_py + h > wb_y0 && pet_py < 665.0
    if hit_x && hit_y {
        pet_set_pos(402.0 - w - 6.0, wb_y0 - h - 8.0)
    }
}


fn pet_size_sync(){
    ui.pet_s.set_visible(pet_size_i <= 0)
    ui.pet_m.set_visible(pet_size_i == 1)
    ui.pet_l.set_visible(pet_size_i == 2)
    ui.pet_xl.set_visible(pet_size_i >= 3)
}

fn bl_load(){
    if bl_loaded { return }
    bl_loaded = true
    if !fs.exists("ask_log.json") { return }
    let v = fs.read("ask_log.json").parse_json()
    if v == nil { return }
    let its = v["items"]
    if its == nil { return }
    let today = today_text()
    for it in its {
        let d = ""
        if it["d"] != nil { d = "" + it["d"] }
        if d != today { continue }
        let one = {d: d kind: "" q: "" n: 0 top: "" st: ""}
        if it["kind"] != nil { one.kind = "" + it["kind"] }
        if it["q"] != nil { one.q = "" + it["q"] }
        if it["n"] != nil { one.n = it["n"] }
        if it["top"] != nil { one.top = "" + it["top"] }
        if it["st"] != nil { one.st = "" + it["st"] }
        bl_items.push(one)
    }
}

fn bl_save(){
    let today = today_text()
    let keep = []
    for it in bl_items {
        if it.d == today { keep.push(it) }
    }
    fs.write("ask_log.json", {schema: 1 saved_at: time_now() items: keep}.to_json())
}

// 记一条「正在查」。等主编把结果端回来再回填条数与标题。
fn bl_text(i){
    if i < 0 || i >= bl_items.len() { return "" }
    let one = bl_items[i]
    let head = "" + one.kind + " · " + ("" + one.n) + " 条 · " + ("" + one.st)
    // 时间戳只取「今天 + 序号」，够认出来是哪一次问的即可
    "第 " + ("" + (i + 1)) + " 次询问  " + head
}

fn bl_top_text(i){
    if i < 0 || i >= bl_items.len() { return "" }
    let one = bl_items[i]
    if one.top != "" { return one.top }
    if one.q != "" { return "问的是：" + art_cut(one.q, 30) }
    ""
}

fn bl_head_text(){
    bl_load()
    let n = bl_items.len()
    if n == 0 { return "今天还没问过我什么。" }
    "今天问了 " + ("" + n) + " 次，账都记在这儿"
}

fn bl_pill_text(){
    // 这一行五个胶囊是均分面板宽度的，每个只有 ~58px。
    // 写「📋 浏览记录」会被裁成「浏」—— 保持两字，跟 聊天/出报/配图/分析 齐平。
    if bl_open { return "收起" }
    "记录"
}

fn pf_head_text(){
    // 标题只留一行。「还不认识你」这层意思下面 pf_stat/pf_focus 已经说清了，
    // 头一行再拖一句解释会折成两行，把面板顶高一截。
    if pf_briefs == 0 && pf_opens == 0 && pf_notes.len() == 0 { return "主编还不认识你" }
    "主编记住的你"
}

fn pf_stat_text(){
    "已出报 " + ("" + pf_briefs) + " 期 · 读过 " + ("" + pf_opens) + " 条 · 只存在这台机器上，不上传"
}

fn pf_focus_text(){
    let out = ""
    for t in pf_t {
        if t.n > 0 {
            if out != "" { out = out + " · " }
            out = out + pf_label(t.id) + " " + ("" + t.n) + " 次"
        }
    }
    if out == "" { return "常读：还没看出偏向 —— 多读几条，它就知道了。" }
    "常读：" + out
}

fn pf_notes_head_text(){
    let n = pf_notes.len()
    if n == 0 { return "你亲口要它记住的：还没有" }
    "你亲口要它记住的 " + ("" + n) + " 条"
}

// 把一次询问写进主编的对话里（沿用主编那套 22 件工具的链路，
// 它自己会去联网取数、筛选、落到本报上）。
fn bl_log_line(){
    let n = bl_items.len()
    if n == 0 { return }
    let one = bl_items[n - 1]
    ag_log.push({who: "tool" text: "浏览记录 +1：" + one.kind + " · " + ("" + one.n) + " 条 · " + art_cut(one.top, 40)})
    ag_trim_log()
}

// 向主编问某品类：界面上立刻亮一条「正在查」，再让主编去干活。



// 把 pet_px / pet_py 拆成二进制，逐位切占位控件的可见性。
// 顺序必须是「从大到小」：先拿掉权重最大的那一位，剩下的余数再给下一位。
// 反过来从 1 开始贪心的话，`余数 >= 1` 这一条对任何正数都成立，
// 前八位会全亮，位置会永远卡在 255（这个坑实测踩过）。
// 只在「整数位置真的变了」时才调用 —— 鼠标每个移动事件都发二十来个宿主调用不值得。
// 把 pet_px / pet_py 拆成二进制，逐位切占位控件的可见性。
// 顺序必须是「从大到小」：先拿掉权重最大的那一位，剩下的余数再给下一位。
// 反过来从 1 开始贪心的话，`余数 >= 1` 这一条对任何正数都成立，
// 前八位会全亮，位置会永远卡在 255（这个坑实测踩过）。
// 只在「整数位置真的变了」时才调用 —— 鼠标每个移动事件都发二十来个宿主调用不值得。



fn rip_layer_hide(){
    rip_on = false
    ui.rip_r0.set_visible(false)
    ui.rip_r1.set_visible(false)
    ui.rip_r2.set_visible(false)
}

fn rip_tap(y){
    // 按点击高度选一段：三段环覆盖上/中/下三条主交互带。
    let band = 1
    if y < 260 { band = 0 }
    else if y > 560 { band = 2 }
    rip_band = band
    rip_on = true
    ui.rip_r0.set_visible(band == 0)
    ui.rip_r1.set_visible(band == 1)
    ui.rip_r2.set_visible(band == 2)
    // 0.85 秒够环摊开一圈；再长就开始显得黏。
    start_timeout(0.85, || rip_layer_hide())
}

// ===== 今日晨报 · 浏览记录 =====
// 饲养员让咕嘎去问什么、问了哪几类、查到几条、都是什么标题，一条条记下来，
// 落盘 ask_log.json（按天分组，只留最近三天）。这是「问主编」这条路的账本。
let bl_items = []                // [{d: 日期, kind: 品类, q: 原话, n: 条数, top: 标题串, st: 状态}]
let bl_open = false
let bl_pending = -1              // 正在等主编回话的那一条的序号；-1 = 没有
let bl_loaded = false
let bl_last_harvest = ""
let bl_start_fin = ""            // 这次询问发起时的 finished_at，用来判断「这一轮真的出了新一期」

// ===== 读者画像面板（主编台「画像」）=====
// 数据本身早就有（pf_* 系列，落盘 profile.json），这一版只是把它摆到主编台上：
// 主人被记住的历史喜好要看得见、能补、能直接拿去选新闻，而不是藏在代码里。
let pf_open = false

// ===== 读者画像面板（主编台「画像」）=====
// 数据本身早就有（pf_* 系列，落盘 profile.json），这一版只是把它摆到主编台上：
// 主人被记住的历史喜好要看得见、能补、能直接拿去选新闻，而不是藏在代码里。



// 记一条「正在查」。等主编把结果端回来再回填条数与标题。


fn bl_sync(){
    bl_load()
    ui.bl_panel.set_visible(bl_open)
    ui.bl_pill.set_text(bl_pill_text())
    if !bl_open { return }
    let n = bl_items.len()
    ui.bl_head.set_text(bl_head_text())
    ui.bl_r1_head.set_text(bl_text(n - 1))
    ui.bl_r1_top.set_text(bl_top_text(n - 1))
    ui.bl_r1.set_visible(n >= 1)
    ui.bl_r2_head.set_text(bl_text(n - 2))
    ui.bl_r2_top.set_text(bl_top_text(n - 2))
    ui.bl_r2.set_visible(n >= 2)
    ui.bl_r3_head.set_text(bl_text(n - 3))
    ui.bl_r3_top.set_text(bl_top_text(n - 3))
    ui.bl_r3.set_visible(n >= 3)
    ui.bl_empty.set_visible(n == 0)
}



// =====================================================================
// 读者画像面板 · 主编台「画像」
//   摆出来的都是 pf_* 里已有的真数据（profile.json，只存本机）：
//   出过几期、读过几条、常读哪几类各多少次、你亲口要它记住的偏好。
//   两个按钮也都是真动作：「记一条偏好」把输入行交给主人去说（主编会用
//   remember_reader 落库）；「照着画像排一期」直接把画像当作选材依据发过去。
// =====================================================================
fn pf_sync(){
    ui.pf_panel.set_visible(pf_open)
    if !pf_open { return }
    ui.pf_head.set_text(pf_head_text())
    ui.pf_stat.set_text(pf_stat_text())
    ui.pf_focus.set_text(pf_focus_text())
    ui.pf_notes_head.set_text(pf_notes_head_text())
    ui.pf_notes_lbl.set_text(pf_notes_line())
}





fn pf_toggle(){
    pf_open = !pf_open
    if pf_open { bl_open = false }
    pf_sync()
    bl_sync()
}

// 「记一条偏好」：不开新面板，直接把主编的输入行交给主人 ——
// 偏好必须是主人亲口说的，卡里不替他编。主编收到后会调 remember_reader 落库。
// 把一次询问写进主编的对话里（沿用主编那套 22 件工具的链路，
// 它自己会去联网取数、筛选、落到本报上）。

// 向主编问某品类：界面上立刻亮一条「正在查」，再让主编去干活。
fn pet_stock_expr(){
    // 出报阶段的表情优先（other agent 的相位驱动）；停在首页/常态时，
    // 由状态系统决定脸：饿了撇嘴、困了打盹、开心就笑 —— 与桌宠一致。
    if pet_expr != "idle" { return pet_expr }
    let m = pg_mood()
    if m == "cheer" { return "cheer" }
    m
}

fn pet_len(s){
    let n = 0
    for c in s.split("") { if c != "" { n = n + 1 } }
    n
}

fn pet_line_dur(text){
    let d = pet_len(text) * 0.22 + 1.2
    if d < 2.0 { d = 2.0 }
    if d > 9.0 { d = 9.0 }
    d
}

fn pet_rand_n(n){
    // 不依赖 floor：把 [0,1) 均分成 n 份，落在第几份就是几（1..n）
    let r = random()
    let acc = 0.0
    let k = 0
    for i in n {
        acc = acc + 1.0 / n
        k = k + 1
        if r <= acc { return k }
    }
    n
}

fn pet_pick(list){
    let n = list.len()
    if n == 0 { return nil }
    let r = random() * n
    let acc = 0.0
    for l in list {
        acc = acc + 1.0
        if r <= acc { return l }
    }
    list[0]
}

fn pet_lines_of(scene){
    let out = []
    for l in pet_lines {
        if l.s == scene { out.push(l) }
    }
    out
}

fn pet_frame_src(name){
    for b in pet_stock_names {
        if b == name { return "{{assets}}/assets/guga/" + name + ".png" }
    }
    "{{assets}}/assets/guga/motion/" + name + ".png"
}

// 给「当前这一只」换图。
//
// 为什么不再一次给四只都 set_src：说话口型是每 0.16 秒一帧、动作序列
// 0.10~0.20 秒一帧，点一下企鹅会连着换好几次帧 —— 一次给四只都下发，
// 一秒钟就是几十次贴图重载，每次都会让画面闪一下。用户看到的就是
// 「点一下桌宠就时不时闪烁」（2026-10-13 反馈）。
//
// 四只里同一时刻只有一只是可见的（pet_size_sync 管可见性），所以只喂那一只；
// 换尺寸时由 pet_size_sync 补一次，不会漏。
fn pet_src_apply(){
    if pet_cur_frame == "" { return }
    let src = pet_frame_src(pet_cur_frame)
    if src == pet_cur_src { return }          // 同一张图重复下发是纯浪费，也是闪的来源
    pet_cur_src = src
    let u = http_resource(src)
    if pet_size_i <= 0 { ui.pet_img_s.set_src(u) }
    else if pet_size_i == 1 { ui.pet_img_m.set_src(u) }
    else if pet_size_i == 2 { ui.pet_img_l.set_src(u) }
    else { ui.pet_img_xl.set_src(u) }
}

fn pet_breath_frame(expr){
    if pet_breath { return expr + "_breath" }
    expr
}

fn pet_sync_bubble(){
    // 气泡什么时候冒：
    //   ① 有话要说（pet_line 非空、还没到点）
    //   ② 气泡开关开着（工作台标题栏那枚「气泡 开/关」——用户点名要的开关）
    //   ③ 工作台没开（工作台一开，咕嘎的话直接进对话区，气泡和面板
    //      同住右下角会叠在一起；关掉工作台气泡立刻恢复）
    let show = pet_line != "" && time_now() < pet_line_until && !ag_open && pet_bubble_on
    if show == pet_bubble_vis {
        if show { ui.pet_bubble_lbl.set_text(pet_line) }
        return
    }
    pet_bubble_vis = show
    ui.pet_bubble.set_visible(show)
    if show { ui.pet_bubble_lbl.set_text(pet_line) }
}

// 气泡开关（工作台标题栏那枚）。用户原话：「咕嘎主编说的话能有气泡框
//（可以在工作台选择关闭）」—— 所以开关放在工作台顶上，一点就换。
// 关掉之后它照样说话、照样有声音（念报、点它时的碎嘴都不受影响），
// 只是不再在卡片上冒气泡 —— 留给专心读报、不想被气泡挡住的饲养员。
//
// ⚠️ 别写成 `pet_bubble_on ? "开" : "关"` —— splash **没有 C 风格三元表达式**，
// `?` 会被解析成「命名函数参数」语法，直接报
// 「named_fn_arg called without prototype object」并中断整次求值。
// 2026-10-13 实测：这一行把 warm_static 和 sync_ui 各腰斩一次，
// 后面所有控件的 set_text 全没执行（不进布局）——语音按钮、分区按钮
// 全都"消失"，查了半天。条件取值一律用 if 包个小函数。
// 气泡开关（工作台标题栏那枚）。用户原话：「咕嘎主编说的话能有气泡框
//（可以在工作台选择关闭）」—— 所以开关放在工作台顶上，一点就换。
// 关掉之后它照样说话、照样有声音（念报、点它时的碎嘴都不受影响），
// 只是不再在卡片上冒气泡 —— 留给专心读报、不想被气泡挡住的饲养员。
//
// ⚠️ 别写成 `pet_bubble_on ? "开" : "关"` —— splash **没有 C 风格三元表达式**，
// `?` 会被解析成「命名函数参数」语法，直接报
// 「named_fn_arg called without prototype object」并中断整次求值。
// 2026-10-13 实测：这一行把 warm_static 和 sync_ui 各腰斩一次，
// 后面所有控件的 set_text 全没执行（不进布局）——语音按钮、分区按钮
// 全都"消失"，查了半天。条件取值一律用 if 包个小函数。
fn pet_bub_text(){
    if pet_bubble_on { return "气泡 开" }
    "气泡 关"
}

fn wb_tab_text(i){
    // 用户点名要的三个必须项：对话（语音 + 输入）、干活（今天这一期）、
    // 往期（检索历史晨报）。「档案」这个词太机关，改成「往期」一眼就懂。
    let lab = "对话"
    if i == 1 { lab = "干活" }
    if i == 2 { lab = "往期" }
    if wb_tab == i { return "● " + lab }
    lab
}

// 一次实干之后的统一收尾：按工作量回馈数值、落盘、收面板。
// 咕嘎的饱食/心情现在是靠实干补的（见 pg_effect），不再是空转的卖萌按钮。
//
// 三个浮层（主编台 / 浏览记录 / 读者画像）同住一列，谁都不该挡着谁。
// 所以任何一件实事开跑之前，先把三块都收掉：结果要靠气泡说出来，
// 留着上一块面板摊在那儿只会把气泡挤走、让人看不清到底办没办。
// 一次实干之后的统一收尾：按工作量回馈数值、落盘、收面板。
// 咕嘎的饱食/心情现在是靠实干补的（见 pg_effect），不再是空转的卖萌按钮。
//
// 三个浮层（主编台 / 浏览记录 / 读者画像）同住一列，谁都不该挡着谁。
// 所以任何一件实事开跑之前，先把三块都收掉：结果要靠气泡说出来，
// 留着上一块面板摊在那儿只会把气泡挤走、让人看不清到底办没办。
fn pet_close_panels(){
    // 浏览记录与读者画像两块浮层跟工作台同住一屏，谁都不该挡着谁。
    // 注意：工作台本身（ag_open）不再跟着关 —— 它现在是干活的台面，
    // 点完一件活留在台上、结果直接进对话区，比「关掉再弹气泡」顺手。
    if pf_open { pf_open = false pf_sync() }
    if bl_open { bl_open = false bl_sync() }
}

fn pet_work_done(kind){
    pet_close_panels()
    pg_effect(kind)
    pg_status_save()
}

// 「总结」——把今天这一期从头到尾讲一遍。
// 还没出报时不硬发，直接说实话（主编没版面可总结，发过去也只是浪费一次联网）。
fn cg_pet_in(){
    ui.cg_pet.set_visible(true)
}

fn cg_text(){
    ui.cg_eye.set_text("M O R N I N G   B R I E F")
    ui.cg_ttl.set_text("晨 报 卡")
    ui.cg_rul.set_text("— 中英双语 · 主编咕嘎，随叫随到 —")
}

// —— 「初始 visible:false 的容器」里的静态文案，必须显式 set_text 一次才会进布局 ——
// 踩过的坑：待批准页的标题与「批准并取数 / 暂不」两个按钮一直不出现 ——
// 界面不报错，也没有留空位，就像那两个控件根本不存在（它们确实没被加进布局）。
// 但同层那几个 text 一开始为空、随后由 set_text 填进去的 Label 一直都正常。
// 差别就在这里：**只有文本被 set_text 写过的子控件才会被布局**。
// 容器一出生就 visible:false 时，写在声明里的静态 text 不算「写过」。
// 修法：给这些静态控件起名字，启动时用 set_text 把原样再写一遍（幂等，不影响后续逻辑）。
// —— 「初始 visible:false 的容器」里的静态文案，必须显式 set_text 一次才会进布局 ——
// 踩过的坑：待批准页的标题与「批准并取数 / 暂不」两个按钮一直不出现 ——
// 界面不报错，也没有留空位，就像那两个控件根本不存在（它们确实没被加进布局）。
// 但同层那几个 text 一开始为空、随后由 set_text 填进去的 Label 一直都正常。
// 差别就在这里：**只有文本被 set_text 写过的子控件才会被布局**。
// 容器一出生就 visible:false 时，写在声明里的静态 text 不算「写过」。
// 修法：给这些静态控件起名字，启动时用 set_text 把原样再写一遍（幂等，不影响后续逻辑）。
fn warm_static(){
    ui.aq_title.set_text("出报前，主编想问一句")
    ui.aq_skip.set_text("你定，不用问")
    ui.plan_title.set_text("待批准的取数计划")
    ui.plan_ok.set_text("批准并取数")
    ui.plan_no.set_text("暂不")
    ui.judge_sub.set_text("三位编辑背靠背独立阅读，互相看不到对方的选择；随后由主编终审取舍。")
    ui.deny_title.set_text("已取消 — 未发起任何网络请求。")
    ui.deny_sub.set_text("你的授权是取数的前提；拒绝后不会读取任何来源。")
    ui.deny_restart.set_text("重新开始")
    ui.refuse_t1.set_text("今日休刊")
    ui.refuse_t2.set_text("REFUSED TO PUBLISH · 主编拒刊")
    ui.refuse_lead.set_text("今天这些消息我没有把握，不想拿一个二手转述来充今天的晨报。")
    ui.refuse_h.set_text("为什么不出")
    // 控件名特意不叫 refuse_go —— 那是这个按钮要调的函数名，
    // 控件和函数重名虽然实测能跑，但读代码的人第一眼就会误判，不值得省这几个字。
    ui.refuse_go_b.set_text("仍要出报")
    ui.refuse_restart.set_text("重新开始")
    ui.refuse_foot.set_text("拒刊是主编的判断，不是对你的束缚 —— 决定权在你手里，你说了出，我就出。")
    ui.story_back.set_text("返回晨报")
    ui.story_ask.set_text("写封信追问")
    ui.story_sum_head.set_text("官方摘要")
    ui.story_vf_head.set_text("核验台 · 这一条的可信度")
    ui.story_ai_head.set_text("AI 解读")
    ui.arc_head.set_text("本报追过这条线索")
    ui.story_src_head.set_text("这条消息的出处")
    ui.story_prev.set_text("上一条")
    ui.story_next.set_text("下一条")
    ui.iv_rewrite.set_text("重写一封")
    ui.iv_hide.set_text("收起")
    ui.ag_title.set_text("咕嘎 · 工作台")
    ui.ag_badge.set_text("常驻")
    // 气泡开关：咕嘎说话冒不冒气泡，用户在工作台上一点就换（默认开）。
    ui.pet_bub_b.set_text(pet_bub_text())
    ui.ag_clear_b.set_text("清空")
    ui.ag_hide_b.set_text("收起")
    ui.vc_big.set_text("🎙 语音对话")
    ui.vc_autob.set_text("自动朗读")
    ui.vc_contb.set_text("连续对话")
    ui.wb_hint.set_text(wb_arc_note)
    ui.vc_who.set_text("咕嘎在听")
    ui.vc_cancelb.set_text("×")
    ui.vc_sendb.set_text("↑")
    // 形体（原来还有一行「形体 · 想让本鹅多大只」标题，跟控件一起删了 ——
    // 用户要清爽，四个尺寸胶囊自己会说话）
    ui.pet_s1.set_text("小")
    ui.pet_s2.set_text("中")
    ui.pet_s3.set_text("大")
    ui.pet_s4.set_text("特大")
    // 今天这一期的实事（这一行固定五个，所以不放 emoji —— 放上去会把第五个挤出面板）
    ui.pet_menu_work.set_text("今天这一期 · 点哪件办哪件")
    ui.pet_m1.set_text("总结")
    ui.pet_m2.set_text("头版")
    ui.pet_m3.set_text("画像")
    ui.pet_m4.set_text("台账")
    ui.pet_m5.set_text("回放")
    // 派活：按品类让咕嘎去联网查，结果进浏览记录
    ui.pet_menu_ask.set_text("问新闻 · 联网查，结果汇总进浏览记录")
    ui.pet_k1.set_text("商业")
    ui.pet_k2.set_text("科技")
    ui.pet_k3.set_text("芯片")
    ui.pet_k4.set_text("国际")
    ui.pet_k5.set_text("生活")
    // 直接指挥（原来五个：聊天/出报/配图/分析/记录。聊天与出报跟对话分区的
    // 输入行重复，删掉；剩三个是对话替代不了的。文案保持两字以内）
    ui.pet_c3.set_text("配图")
    ui.pet_c4.set_text("分析")
    ui.bl_pill.set_text("记录")
    // 读者画像面板：静态部分先铺一遍底，动态内容由 pf_sync() 每次刷新。
    ui.pf_head.set_text("主编记住的你")
    ui.pf_stat.set_text("")
    ui.pf_focus.set_text("")
    ui.pf_notes_head.set_text("")
    ui.pf_notes_lbl.set_text("")
    ui.pf_b1.set_text("记一条偏好")
    ui.pf_b2.set_text("照着排一期")
}

fn vd_reset(){
    vd_state = ""
    vd_note = ""
    vd_rows = []
    vd_agree = 0
    vd_unknown = 0
    vd_ms = 0
    vd_tokens = 0
}

// 一次调用、三个问题，全部是「有限选项」：档位（Choice）、够不够格（Noul）、热度（Score）。
fn vd_tier_name(t){
    if t == "first" { return "一手" }
    if t == "second" { return "二手" }
    if t == "rumor" { return "传闻·未证实" }
    if t == "repost" { return "转载" }
    if t == "unknown" { return "超出预设集合" }
    t
}

fn vd_head_line(){
    if vd_state == "asking" { return vd_note }
    if vd_state == "failed" { return vd_note }
    if vd_rows.len() == 0 { return "决策台没有给出结论。" }
    let line = "与本报判级一致 " + vd_agree + "/" + vd_rows.len() + " · 用时 " + seconds_text(vd_ms) + " · " + vd_tokens + " tokens"
    if vd_unknown > 0 { line = line + " · 有 " + vd_unknown + " 条落不进预设集合" }
    line
}

fn vd_row_text(k){
    if k >= vd_rows.len() { return "" }
    let v = vd_rows[k]
    let tag = "分歧"
    if v.same { tag = "一致" }
    let call = "不值得上"
    if v.worth >= 50 { call = "够格上" }
    "" + (k + 1) + ". 信源 " + vd_tier_name(v.tier) + " · 与本报" + tag + "\n    " + call + " " + v.worth + "% · 热度 " + v.heat + "/10 · " + art_cut("" + v.row.title, 26)
}

fn vf_reset(){
    vf_state = ""
    vf_note = ""
    vf_rows = []
    vf_ev = []
    vf_wc = {}
    vf_index = {}
    vf_ms = 0
    vf_tokens = 0
    vf_avg = 0
    vf_weak = 0
    vf_contra = 0
    vf_x = []
    vf_try = 0
    vf_gen = 0
    vf_list = ""
}

fn vf_chars(s){
    // 字符数（不是字节数）。.len() 给的是字节，汉字会算成 3。
    // 用 to_chars() 直接拿字符数组。
    //
    // 这是整条链路里最贵的一步（要分配一个数组），所以只在**真正需要精确字数**的
    // 地方调用：vf_peer_scan_s 里判「够不够长 / 是不是 10 字以上的长词」。
    // 索引构建阶段一律只用 c.len() 做粗筛，绝不在这里逐词算字数。
    ("" + s).to_chars().len()
}

fn vf_pos(list, v){
    // list 里 v 的下标，没有就是 -1。这里不用 index() 是因为要按值找，不是按字段找。
    let i = 0
    for x in list {
        if x == v { return i }
        i = i + 1
    }
    -1
}

fn vf_dom_split(bag){
    // "|a.com|b.com|" → ["a.com" "b.com"]
    let out = []
    for h in ("" + bag).split("|") {
        if h != "" { out.push(h) }
    }
    out
}

fn vf_spread(peers){
    // 为真概率的区间半径：跟报的人越多越窄，最窄 6 个点。
    let s = 26 - peers * 4
    if s < 6 { s = 6 }
    s
}

fn vf_remind(){
    // 只在重问时才追加。第一次问不加 —— 加了反而像是我们在提醒模型它要失败。
    if vf_try == 0 { return "" }
    "\n\n【重问】上一次的答复不是合法 JSON（被截断，或 JSON 之外夹带了别的字）。这一次务必只输出**一个** JSON 对象：第一个字符就是 {，最后一个字符就是 }；items 数组里每一项都要写完整，不许省略、不许截断；不要写解释、不要加代码围栏、不要在 JSON 前后添加任何一个字。"
}

fn vf_tone(c){
    // 分数只用来上色，不用来下结论 —— 文案永远把区间一起给出来
    if c >= 80 { return "可信度高" }
    if c >= 65 { return "可信度中上" }
    if c >= 50 { return "证据不足，按待核处理" }
    "证据薄弱，已按未证实处理"
}

fn vf_head_line(){
    if vf_state == "asking" { return vf_note }
    if vf_rows.len() == 0 { return vf_note }
    let line = "本期平均为真概率 " + vf_avg + "% · 低于 60% 的有 " + vf_weak + " 条"
    if vf_contra > 0 { line = line + " · 见到相反证据 " + vf_contra + " 条" }
    if vf_state == "ok" { line = line + " · 用时 " + seconds_text(vf_ms) + " · " + vf_tokens + " tokens" }
    line
}

fn vf_ev_arith(x){
    // 证据分写成「加法等式」，读者自己能验算。
    // 触顶时必须把触顶也写出来 —— 否则 74 旁边的 91 像是算错了。
    if x.capped { return "先验 " + x.prior + " + 跨源 " + x.bonus + " = " + x.raw + "，触顶 " + x.cap + " → " + x.ev }
    "先验 " + x.prior + " + 跨源 " + x.bonus + " = " + x.ev
}

fn vf_x_has(k){
    for i in vf_x {
        // 行号是整数，不要写成 `if i == k` 之外的花样 —— 这里的 i 就是行号本身。
        if i == k { return true }
    }
    false
}

fn vf_row_text(k){
    if k >= vf_rows.len() { return "" }
    let x = vf_rows[k]
    let src = "另有 " + x.peers + " 家渠道也在报"
    if x.peers == 0 { src = "无第二家跟进" }
    let mm = "模型 " + x.model
    if x.model < 0 { mm = "模型未答" }
    // 证据分直接印成加法式（含触顶），这样「跨源到底算没算进去」一眼可核，
    // 不必先点开 —— 点开是看更细的一段一段。
    let line = "" + (k + 1) + ". 为真 " + x.cal + "%（区间 " + x.lo + "–" + x.hi + "）· " + vf_tone(x.cal) + "\n    " + src + " · 证据分 " + x.ev + " = " + vf_ev_arith(x) + " · " + mm
    if x.doms.len() > 0 {
        let j = 0
        let nm = ""
        for h in x.doms {
            if j > 0 { nm = nm + "、" }
            nm = nm + ch_label(h)
            j = j + 1
        }
        line = line + "\n    跟报的是：" + nm
    }
    // 弱信号：只提一句，不进分。读者有权利知道我们看见了什么、又为什么没算它。
    if x.peers == 0 && x.weak > 0 { line = line + "\n    另有 " + x.weak + " 家渠道的标题里出现同一个长词（弱信号，未计入证据分）" }
    if x.contra { line = line + " · 有相反证据" }
    if x.basis != "" { line = line + "\n    " + x.basis }
    if vf_x_has(k) {
        line = line + "\n    ▸ 已展开 · 再点这一行收起"
    } else {
        line = line + "\n    ▸ 点这一行，看证据分是怎么一段一段加出来的"
    }
    line
}

fn vf_ch_show(id){
    // 渠道显示名。渠道 id 是内部标识（hn / techmeme / github），
    // 直接印给读者看不成话，转成来源标签。
    ch_label(id)
}

fn vf_story_line(){
    // 阅读页里这一条自己的核验结论。区间、同行家数、依据一起给 —— 单给一个分数是不诚实的。
    if story == nil { return "" }
    for x in vf_rows {
        if x.row.id == story.id {
            let src = "另有 " + x.peers + " 家渠道也在报"
            if x.peers == 0 { src = "无第二家跟进" }
            return "为真 " + x.cal + "%（区间 " + x.lo + "–" + x.hi + "）· " + src + " · " + vf_tone(x.cal)
        }
    }
    ""
}

fn vf_story_basis(){
    if story == nil { return "" }
    for x in vf_rows {
        if x.row.id == story.id {
            if x.contra { return "依据：" + x.basis + "（另有相反证据）" }
            return "依据：" + x.basis
        }
    }
    ""
}

fn vf_platform_line(){
    // 计划页就要说清楚：哪些平台一条就够，哪些必须有人跟着报
    "可信度口径：用户投稿平台（B站 · 抖音 · 油管）单来源时上限 58%；一手机构与权威科技媒体上限 92%；「传闻·未证实」一律不超过 55%。核验台会为每条给出为真概率、区间与依据，跨源一致性由本机按标题指纹实数。"
}

// ---- 语音音色优选：宿主报上来的音色里，挑最像人的那一个 ----
// 各家 shell 都会把可用音色连 id、name、language 一起报上来。Windows 自带的
// SAPI 音色偏机械，新系统的 Natural / Neural 音色自然得多；edge-tts 那类云端
// 神经音色（XiaoxiaoNeural / YunxiNeural / YunyangNeural…）是同一族的命名。
// 这里只做「挑一个」，不做合成；挑不到就返回空串，宿主用它的默认音色，行为不变。
let vc_voice = ""

fn vc_has(s, sub){
    if s.search(sub) >= 0 { return true }
    false
}

fn vc_pick_voice(vs){
    let best = ""
    let best_rank = 99
    for v in vs {
        let lang = ""
        if v["language"] != nil { lang = "" + v["language"] }
        if vc_has(lang, "zh") {
            let vid = ""
            let all = ""
            if v["id"] != nil { vid = "" + v["id"] all = vid }
            if v["name"] != nil { all = all + " " + ("" + v["name"]) }
            let rk = 9
            // 排序对齐桌面版咕嘎用的那把嗓子：桌面版走 edge-tts 的
            // zh-CN-XiaoyiNeural（软萌少女音，rate +15% / pitch +14Hz）。
            // 宿主侧语音服务没有 Neural 音色时，退到本地 SAPI 的老音色，
            // 语速与音调已由调用处统一给了 rate 1.15 / pitch 1.07。
            //
            // 关键顺序：Yaoyao 必须排在 Huihui 前面。
            // 本机（Speech_OneCore）只有 Huihui / Kangkang / Yaoyao 三把中文嗓子，
            // 而「少女感」这一档只有 Yaoyao（年轻女声）顶得住 ——
            // Huihui 是成熟女声，念出来跟桌宠那把完全不是一个人。
            // 之前 Yaoyao 排在 Huihui 后面，于是这台机器永远选中 Huihui，
            // 音色就此跑偏；换过来之后卡片才会用上最接近桌宠的那一把。
            if vc_has(all, "Xiaoyi") { rk = 0 }        // 桌宠同款（软萌少女）
            else if vc_has(all, "Xiaoxiao") { rk = 1 } // 微软在线神经，年轻女声
            else if vc_has(all, "Natural") { rk = 2 }  // 任何已装的 Natural 语音
            else if vc_has(all, "Neural") { rk = 3 }
            else if vc_has(all, "Yunxia") { rk = 4 }
            else if vc_has(all, "Yaoyao") { rk = 5 }   // 本机最接近少女感的一把
            else if vc_has(all, "Huihui") { rk = 6 }   // 成熟女声，排后面
            else if vc_has(all, "Yunyang") { rk = 7 }  // 以下两把是男声，兜底
            else if vc_has(all, "Yunxi") { rk = 8 }
            if vid != "" && rk < best_rank { best_rank = rk best = vid }
        }
    }
    if best_rank >= 9 { return "" }
    best
}

// 当前这把嗓子叫什么（给人看的名字）。
// 为什么要显示出来：主编就是咕嘎，报里报外必须**只有一把嗓子**。
// 以前这事儿看不出来 —— 读者只会觉得「主编怎么跟桌宠不是一个人」。
// 现在选中的是哪把嗓子直接写在状态行里，出问题一眼能定位
// （比如显示成「系统音色 …Huihui」就说明语音桥没被宿主接上）。
// 当前这把嗓子叫什么（给人看的名字）。
// 为什么要显示出来：主编就是咕嘎，报里报外必须**只有一把嗓子**。
// 以前这事儿看不出来 —— 读者只会觉得「主编怎么跟桌宠不是一个人」。
// 现在选中的是哪把嗓子直接写在状态行里，出问题一眼能定位
// （比如显示成「系统音色 …Huihui」就说明语音桥没被宿主接上）。
fn guga_voice_name(){
    if vc_voice == "" { return "宿主默认音色" }
    if vc_has(vc_voice, "Xiaoyi") { return "软萌少女音 · 与桌面版桌宠同款" }
    if vc_has(vc_voice, "Xiaoxiao") { return "年轻女声 · 云端神经音色" }
    if vc_has(vc_voice, "Yaoyao") { return "系统少女音" }
    if vc_has(vc_voice, "Huihui") { return "系统音色（成熟女声，偏机械）" }
    "音色 " + vc_voice
}
// 当前这把嗓子叫什么（给人看的名字）。
// 为什么要显示出来：主编就是咕嘎，报里报外必须**只有一把嗓子**。
// 以前这事儿看不出来 —— 读者只会觉得「主编怎么跟桌宠不是一个人」。
// 现在选中的是哪把嗓子直接写在状态行里，出问题一眼能定位
// （比如显示成「系统音色 …Huihui」就说明语音桥没被宿主接上）。
fn trail_set_judge(model, ms, intro, rows, dl){
    if trail.len() == 0 { return }
    let j = trail["judge"]
    j["model"] = model
    j["ms"] = ms
    j["intro"] = intro
    let ps = []
    for r in rows {
        let wy = reason_of(r.id)
        ps.push({title: r.title why: wy})
    }
    j["picks"] = ps
    j["drops"] = dl
    trail["judge"] = j
}

fn trail_save(){
    if trail.len() == 0 { return }
    let box = []
    if fs.exists("trail.json") {
        let v = fs.read("trail.json").parse_json()
        if v != nil {
            let it = v["items"]
            if it != nil { box = it }
        }
    }
    // 同一期会被写多次（终审后落一次、封面和核对回来各补一次），
    // 按日期合并：同一天的旧记录丢掉，只留最新最全的那一份。
    let today = "" + trail["date"]
    let kept = []
    for e in box {
        let d = e["date"]
        let ds = ""
        if d != nil { ds = "" + d }
        if ds != today { kept.push(e) }
    }
    kept.push(trail)
    // 只留最近三期 —— 留痕是为了复盘，不是为了囤积
    while kept.len() > 3 { kept.remove(0) }
    fs.write("trail.json", {schema: 1 saved_at: time_now() items: kept}.to_json())
    // 留痕变了，把整包缓存作废，下一次 replay_all() 会重读一次盘
    replay_items_c = nil
    trail_msg = "这一期的出报过程已留痕（trail.json），共 " + ("" + kept.len()) + " 期可复盘"
}

// 给主编看的留痕摘要
fn trail_text(){
    if !fs.exists("trail.json") {
        return "还没有出过报，没有可回放的过程。"
    }
    let v = fs.read("trail.json").parse_json()
    if v == nil { return "留痕文件读不出来。" }
    let it = v["items"]
    if it == nil { return "留痕文件是空的。" }
    let n = it.len()
    if n == 0 { return "还没有出过报，没有可回放的过程。" }
    let out = "本报留了 " + ("" + n) + " 期可复盘"
    let last = it[n - 1]
    let j = last["judge"]
    if j != nil {
        let jm = s_of(j, "model")
        let jms = s_of(j, "ms")
        if jm != "" { out = out + "。最近一期终审用 " + jm }
        if jms != "" { out = out + "，耗时 " + jms + " 毫秒" }
    }
    let ch = last["charter"]
    if ch != nil {
        let vv = s_of(ch, "judge")
        if vv != "" { out = out + "，照 judge/" + vv + " 版规矩取舍" }
    }
    out = out + "。要逐项看候选池、三位初审的原话和主编取舍，用 read_trail。"
    out
}

// 回放页：把最近一期摊开
fn replay_pool_line(){
    let t = replay_now()
    if t.len() == 0 { return "" }
    let p = t["pool"]
    if p == nil { return "" }
    let sc = p["scanned"]
    let cd = p["cand"]
    "取数：" + ("" + sc) + " 条原始 → " + ("" + cd) + " 条入池（淘汰率见工作量卡）"
}

fn replay_panel_line(){
    let t = replay_now()
    if t.len() == 0 { return "" }
    let pn = t["panel"]
    if pn == nil { return "初审：这一期没有留痕" }
    let out = "三位初审各自的原话（互不商量）："
    for p in pn {
        let lb = s_of(p, "label")
        let dg = s_of(p, "digest")
        if dg == "" { dg = "（这位编辑这次没有留下点评）" }
        out = out + "\n· " + lb + "：" + dg
    }
    out
}

// 安全取字符串：字段缺失或类型不对时返回空串，绝不把 nil 拼进 art_cut
// （本项目历史上踩过「JSON 缺字段直接取属性会抛错」的坑，这里统一走这个口）
fn replay_judge_line(){
    let t = replay_now()
    if t.len() == 0 { return "" }
    let res = t["result"]
    let refused = false
    if res != nil {
        let rv = res["refused"]
        if rv != nil { if rv { refused = true } }
    }
    let j = t["judge"]
    if j == nil { return "" }
    let out = "主编终审原话："
    let intro = j["intro"]
    if refused {
        // 拒刊那期没有导语，intro 存的是主编的拒刊理由
        out = "主编决定：今日休刊"
        if intro != nil && intro != "" { out = out + "\n理由：" + art_cut("" + intro, 90) }
        out = out + "\n（本期没有出报，读者可以用「仍要出报」否决这个决定）"
        return out
    }
    if intro != nil && intro != "" { out = out + "\n导语：" + art_cut("" + intro, 90) }
    let ps = j["picks"]
    if ps != nil {
        let i = 1
        for p in ps {
            out = out + "\n" + ("" + i) + ". " + art_cut(s_of(p, "title"), 40)
            let wy = s_of(p, "why")
            if wy != "" { out = out + "\n　为什么上：" + art_cut(wy, 50) }
            i = i + 1
        }
    }
    let dl = j["drops"]
    if dl != nil && dl.len() > 0 {
        for d in dl {
            out = out + "\n砍：" + art_cut(s_of(d, "title"), 36)
            let wy = s_of(d, "why")
            if wy != "" { out = out + " —— " + art_cut(wy, 40) }
        }
    }
    out
}

// 取「最近一期」的留痕对象（优先内存里正在跑的这一期）
// 留痕整包（最多三期）。只在第一次用到时读一次盘。
// 所有回放相关的取数都必须走这里，绝不允许在 on_render 里直接 fs.read。
fn row_host(r){
    let l = r["link"]
    if l == nil { return "" }
    let s = "" + l
    if s == "" { return "" }
    link_host(s)
}

// 渠道 = 这一条是**从哪个入口**进来的（hn / techmeme / github / sspai …）。
//
// 为什么不能拿 link 域名当「渠道」：
//   聚合站的 link 指向的是被引用的原文媒体。同一条消息被 TechMeme 和 Hacker News
//   同时收录时，两条的 link 域名**完全相同**（都指向那家原始媒体），
//   按域名分组会把它们算成「同一家」，于是真正的「两家不同渠道都在报」被判成 0 ——
//   跨源印证永远数不出来，而且看不出哪里错了。
// 渠道是用来回答「几家不同渠道在报同一件事」的，域名是用来回答「原文出自谁家」的，
// 两个问题不能共用一个字段。
// 渠道 = 这一条是**从哪个入口**进来的（hn / techmeme / github / sspai …）。
//
// 为什么不能拿 link 域名当「渠道」：
//   聚合站的 link 指向的是被引用的原文媒体。同一条消息被 TechMeme 和 Hacker News
//   同时收录时，两条的 link 域名**完全相同**（都指向那家原始媒体），
//   按域名分组会把它们算成「同一家」，于是真正的「两家不同渠道都在报」被判成 0 ——
//   跨源印证永远数不出来，而且看不出哪里错了。
// 渠道是用来回答「几家不同渠道在报同一件事」的，域名是用来回答「原文出自谁家」的，
// 两个问题不能共用一个字段。
fn row_ch(r){
    let c = r["ch"]
    if c == nil { return row_host(r) }
    let s = "" + c
    if s == "" { return row_host(r) }
    s
}

fn tier_of(r){
    // 优先读取数时写回行上的档位：gather 之后 tier_of 会被反复调用
    // （保底选池、构成统计、核验台先验、封顶计算…），每次都重算一遍是纯浪费。
    let t = r["tier"]
    if t != nil && t != "" { return "" + t }
    tier_of_h(row_host(r))
}

fn tier_label(r){
    let t = tier_of(r)
    if t == "first" { return "一手" }
    if t == "second" { return "二手" }
    if t == "rumor" { return "传闻·未证实" }
    "转载"
}

// 计入本期信源构成
// 计入本期信源构成
fn tier_add(r){
    let t = tier_of(r)
    if t == "first" { tier_mix["first"] = tier_mix["first"] + 1 return }
    if t == "rumor" { tier_mix["rumor"] = tier_mix["rumor"] + 1 return }
    if t == "repost" { tier_mix["repost"] = tier_mix["repost"] + 1 return }
    tier_mix["second"] = tier_mix["second"] + 1
}

fn tier_tally(rows){
    tier_mix = {first: 0 second: 0 rumor: 0 repost: 0}
    for r in rows { tier_add(r) }
}

// 本期信源构成一行
// 本期淘汰率一行：读者该知道编辑部到底看了多少、扔了多少
fn work_line(){
    if work_n == 0 { return "" }
    let kept = show_rows().len()
    let drop = work_n - kept
    if drop < 0 { drop = 0 }
    let pct = floor(kept * 100 / work_n)
    "" + work_n + " 条里见报 " + kept + " 条，淘汰率 " + (100 - pct) + "%"
}

// =====================================================================
// 线索的三段旅程 · 一条消息是怎么走到「确认」的
//   注意：stage 说的是「本报这次是从什么成色的渠道听到的」，不是对事实
//   本身的判定。一手渠道进来就是「已确认」，社交平台进来就是「爆料」。
//   同一个主题上，上一期和本期的 stage 不一样，就说明线索往前走了。
// =====================================================================
// =====================================================================
// 线索的三段旅程 · 一条消息是怎么走到「确认」的
//   注意：stage 说的是「本报这次是从什么成色的渠道听到的」，不是对事实
//   本身的判定。一手渠道进来就是「已确认」，社交平台进来就是「爆料」。
//   同一个主题上，上一期和本期的 stage 不一样，就说明线索往前走了。
// =====================================================================
fn stage_of(r){
    let t = tier_of(r)
    if t == "first" { return "confirm" }
    if t == "second" { return "follow" }
    "lead"
}

// 记一次失败。三件事必须同时成立，否则账会乱：
//   * 只记**这次真的勾选了**的来源（没勾的平台不算失败，否则「失败数」会超过「应取数」）
//   * 同一个来源只记一次（watchdog 与真实失败会先后报到）
//   * **带上原因** —— 否则界面上只有一句「未取到」，用户无法分辨是自己网络的问题、
//     对方站点的问题，还是本程序的问题。这条是产品要求，不只是调试信息。
fn src_fail(label, why){
    if fail_has(label) { return }
    failed.push({label: label why: why})
}

fn src_pending_n(){
    // 勾选了、但既没成功也没失败的来源数 —— watchdog 只在它不为 0 时才需要补记
    let n = 0
    for s in sources {
        if !plat_on(s.plat) { continue }
        if src_ok(s.label) { continue }
        if fail_has(s.label) { continue }
        n = n + 1
    }
    n
}

fn iso_secs(t){
    let s = ("" + t).replace(iso_nonnum, " ")
    let p = s.split(" ")
    if p.len() < 6 { return 0 }
    // to_f64 在空串/非数字上会给 NaN，而 NaN 参与算术会污染整个时间轴。
    // 用 `!(x >= 下界)` 这种写法挡 NaN：NaN 与任何数比较都是 false，取反即 true。
    let y = p[0].to_f64()
    if !(y >= 1970) { return 0 }
    let mo = p[1].to_f64()
    if !(mo >= 1) { return 0 }
    let d = p[2].to_f64()
    if !(d >= 1) { return 0 }
    let hh = p[3].to_f64()
    if !(hh >= 0) { return 0 }
    let mm = p[4].to_f64()
    if !(mm >= 0) { return 0 }
    let ss = p[5].to_f64()
    if !(ss >= 0) { return 0 }
    days_from_civil(y, mo, d) * 86400 + hh * 3600 + mm * 60 + ss
}

// 纯函数：只由下标算编号。绝不能在渲染循环里再遍历 show_rows()——
// 那会打断外层迭代，列表只会渲染出第一行。
fn rank_text(i){
    pad2(i + 1)
}

fn row_meta(r){
    // r.source 用 ["source"] + nil 判定读：直接写 r.source 在字段缺失时
    // 会抛错，把整个 on_render 闭包的输出作废（白屏的机制之一）。
    let sr = r["source"]
    let src = ""
    if sr != nil { src = "" + sr }
    let line = tier_label(r) + "  ·  " + src
    let a = ago(r.published)
    if a != "" { line = line + "  ·  " + a }
    let p = r["points"]
    if p != nil { line = line + "  ·  " + p + " 热度" }
    let c = r["comments"]
    if c != nil { line = line + "  ·  " + c + " 条讨论" }
    line
}

fn plan_text(){
    let out = "操作计划\n"
    out = out + plat_note_line()
    out + "候选范围：按发布时间取最近 " + pool + " 条\n" + "判断方式：" + plan_way() + "\n" + "排序：由咕嘎按重要性排序（离线时按发布时间）"
}

fn art_is_photo(u){
    let s = u.trim()
    if s == "" { return false }
    if s.search("http") != 0 { return false }
    if art_has(s, "$[") { return false }
    true
}

fn art_prompt(){
    let raw = story_title
    let cut = raw.search(" - ")
    if cut > 8 { raw = raw.split(" - ")[0] }
    let cut2 = raw.search(" | ")
    if cut2 > 8 { raw = raw.split(" | ")[0] }
    if raw.len() > 400 { raw = art_cut(raw, 400) }
    "editorial news illustration ABOUT THIS STORY: " + raw + " -- dramatic but tasteful newspaper art, 16:9, no text, no letters, no watermark"
}

// 截到 n 个字符。
// 不能用 to_chars()：它给的是每个字的代码点（数字），拼起来会变成一串数字，
// 语音合成就会把「中文」念成「2001325991」。split("") 给的是单字符本身。
// （另注意：字符串的 .len() 是字节数，不是字数。）
fn vc_caps(){
    ag_caps_line()
}

// ---- 连续会话：一段话可以有很多个 final ----
// Windows 识别器把「停顿」当一句话的结束，长句会在中间切出好几个 final。
// 老逻辑收到第一个 final 就发送 → 长语音只会送出去前半句（用户报的
// 「长语音识别不能用」就是它）。现在：final 累积、只在收尾（点 ↑ / 安静下来）
// 时整段发送；界面上以「已听到」实时显示累积文本。
fn pf_watch(r){
    for t in topics {
        if topic_hit(t, r.title) { pf_bump(t.id) }
    }
    pf_opens = pf_opens + 1
    pf_save()
}

fn arc_add(rows){
    let d = arc_date()
    for r in rows {
        let s = r["summary"]
        if s == nil { s = "" }
        arc.push({ts: time_now() date: d id: r.id title: r.title source: r.source sum: art_cut(s, 90) stage: stage_of(r)})
    }
    if arc.len() > 240 {
        let keep = []
        let k = 0
        let n = arc.len()
        for e in arc {
            if k >= n - 240 { keep.push(e) }
            k = k + 1
        }
        arc = keep
    }
    arc_save()
}

// 出报时扫一遍：哪些线索今天往前走了，哪些退了回去
// 必须在 arc_add 之前调用 —— 否则本期条目会把自己当成「上一条」。
fn th_scan(rows){
    th_up = []
    for r in rows {
        let s = stage_of(r)
        let sr = stage_rank(s)
        let prev = th_prev(r)
        if prev != nil {
            let pv = prev["stage"]
            if pv != nil {
                let ps = "" + pv
                let pr = stage_rank(ps)
                if pr != sr {
                    if th_up.len() < 3 {
                        th_up.push({title: r.title to_label: stage_label(s) prev_label: stage_label(ps) date: prev.date up: sr > pr})
                    }
                }
            }
        }
    }
}

fn ag_context(){
    let out = "【当前界面】" + ag_phase_name()
    out = out + "\n【这一期的设置】主题=" + topics_line() + "；条数上限=" + limit + " 条"
    if ask != "" { out = out + "；用户写下的关注点=" + ask }
    let rows = show_rows()
    if rows.len() > 0 {
        out = out + "\n【这一期已经入选的条目】（open_story 的 i 按这个序号）"
        let i = 1
        for r in rows {
            if i < 11 { out = out + "\n" + i + ". " + r.title }
            i = i + 1
        }
    }
    if phase == "story" && story != nil {
        out = out + "\n【用户正在读的那条】" + story_title
        if story_sum != "" { out = out + "\n它的摘要：" + art_cut(story_sum, 300) }
    }
    out = out + "\n【读者画像】" + pf_focus() + "。已出报 " + pf_briefs + " 期，读过 " + pf_opens + " 条。"
    if pf_notes.len() > 0 { out = out + "\n读者要你记住的：" + pf_notes_line() }
    out = out + "\n【本报记忆】档案里有 " + arc.len() + " 条往期报道（search_archive 可查）。"
    if vc_tts { out = out + "\n【语音】你能用 speak 说话；自动朗读" }
    if vc_tts { if vc_auto { out = out + "已打开。" } else { out = out + "已关闭。" } }
    if vc_stt { if vc_listen { out = out + "用户正在对你说话，听到的片段：" + vc_partial } }
    if phase == "asking" {
        out = out + "\n【你问出去的那一问】" + aq_q + "\nA：" + aq_a + "\nB：" + aq_b + "\n读者给了明确倾向时，你就用 pick_angle 把它定下来；他只说「你定」时也用 pick_angle，which 填 skip。"
    }
    if tier_line() != "" { out = out + "\n【" + tier_line() + "】" }
    if work_line() != "" { out = out + "\n【本期工作量】" + work_line() }
    if refuse_on { out = out + "\n【你的拒刊理由】" + refuse_why }
    if clash_count() > 0 { out = out + "\n【今天的口径核对】" + clash_note }
    if fix_count() > 0 { out = out + "\n【今天要登的更正】\n" + fix_line(0) }
    if fix_count() > 1 { out = out + "\n" + fix_line(1) }
    if drop_count() > 0 { out = out + "\n【你砍掉的三条】" + drop_line(0) }
    if th_count() > 0 { out = out + "\n【线索进展】" + th_text(0) }
    out = out + "\n【更正台账】累计更正 " + ("" + fix_total) + " 条，发现口径不一致 " + ("" + clash_total) + " 次（read_ledger 可查）"
    if trail_msg != "" { out = out + "
【出报留痕】" + trail_msg + "（read_trail 可回放）" }
    out = out + "
【编辑方针】" + charter_version_line() + "（read_charter 可念）"
    if iv_box_line() != "" { out = out + "\n【" + iv_box_line() + "】（草稿只存在本机，你不发信，发信是读者在外部的动作）" }
    if rv_q.len() > 0 && rv_i < rv_q.len() {
        out = out + "\n【分段朗读的断点】" + rv_text_line()
        if !rv_on { out = out + "，现在是停着的，读者说「接着念」时调用 read_brief 会从头开始，所以只在他要重念时调用" }
    }
    out
}

// =====================================================================
// L3 工具层 · 主编能对这个程序做的事（唯一入口；界面上的按钮都在这一层有对应）
// =====================================================================
