                View{width: Fill height: Fit flow: Down spacing: 5
                    new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                    refuse_h := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    refuse_why_l := Label{width: Fill text: "" max_lines: 8 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                    refuse_tier := Label{width: Fill text: "" max_lines: 3 draw_text.color: #x6e7280 draw_text.text_style.font_size: 11}
                }
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    refuse_go_b := PrimaryBtn{text: "" on_click: || refuse_go()}
                    refuse_restart := GhostBtn{text: "" on_click: || restart()}
                }
                refuse_foot := Label{width: Fill text: "" max_lines: 3 draw_text.color: #xa8a49c draw_text.text_style.font_size: 10}
            }
        }
        run_pane := View{visible: false width: Fill height: Fill flow: Down
            new_batch: true show_bg: true draw_bg.color: ground
            View{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{left: 14 right: 14 top: 10 bottom: 6}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    status_line := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                    st_gen := Label{text: "" draw_text.color: secondary draw_text.text_style.font_size: 10}
                }
                fail_line := Label{visible: false width: Fill text: "" draw_text.color: #xc0392b draw_text.text_style.font_size: 11}
                ai_sum := Label{visible: false width: Fill text: "" draw_text.color: #x6a4bb8 draw_text.text_style: theme.font_bold{font_size: 11}}
                ai_intro := Label{visible: false width: Fill text: "" max_lines: 2 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                ai_note := Label{visible: false width: Fill text: "" draw_text.color: #x6b6b70 draw_text.text_style.font_size: 10}
                View{width: Fill height: Fit flow: Down spacing: 3
                    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 10.0
                    padding: Inset{top: 8 bottom: 8 left: 10 right: 10}
                    pipe_line := Label{width: Fill text: "" draw_text.color: #x3a3a3c draw_text.text_style.font_size: 10}
                    st_src := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 10}
                }
                stale_line := Label{visible: false width: Fill text: "" draw_text.color: #x8a6a24 draw_text.text_style.font_size: 11}
                // 编辑部到底看了多少、扔了多少，以及今天这池子是什么成色
                View{width: Fill height: Fit flow: Down spacing: 3
                    new_batch: true show_bg: true draw_bg.color: #xfaf7f1 draw_bg.border_radius: 10.0
                    padding: Inset{top: 8 bottom: 8 left: 10 right: 10}
                    work_line := Label{visible: false width: Fill text: "" draw_text.color: gold draw_text.text_style: theme.font_bold{font_size: 11}}
                    tier_line := Label{visible: false width: Fill text: "" draw_text.color: #x6e7280 draw_text.text_style.font_size: 10}
                }
            }
            // ---- 期次标签条 · 像浏览器标签页一样在几期之间来回翻 ----
            // 放在 run_pane 里、list 的上面。它自己是 height: Fit，
            // 会从 list（height: Fill）那里分走几十像素 —— 这是刻意的：
            // 标签条本来就该贴着正文顶上，就像浏览器的标签页贴着页面。
            issue_tabs := View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 14 right: 14 top: 2 bottom: 0}
                // 三轮实验的血泪结论都压在这条注释里：
                //   ① on_render 闭包体里「包在 View{} 主体中部的 if / for」不产出子控件
                //      —— 5 个 if 槽位版、View 里包 for 版，全都只剩 padding 的 2px；
                //      官方正写要求 for/if 直接是 on_render 的顶层语句。
                //   ② 顶层 for 写对之后，标签条仍然不自动出现（on_render 不重跑）；
                //      用 ui.tabs_row.render() 强制重跑会杀死渲染管线 —— 出报后整页
                //      白屏（帧恒 7977 字节），布局层（/snap /d）却活着，只能重启。
                //   ③ 最终方案：彻底不用 on_render，固定 5 枚命名按钮，sync_ui 每帧
                //      set_text + set_visible（与 plan_ok 的救活方式完全同款，实测安全）。
                //      越界期次由 issue_tab_text 返回空串 + set_visible(false) 收掉。
                tabs_row := View{width: Fill height: Fit flow: Right spacing: 6
                    tab_b0 := BarBtn{text: "" on_click: || issue_pick_at(0)}
                    tab_b1 := BarBtn{text: "" on_click: || issue_pick_at(1)}
                    tab_b2 := BarBtn{text: "" on_click: || issue_pick_at(2)}
                    tab_b3 := BarBtn{text: "" on_click: || issue_pick_at(3)}
                    tab_b4 := BarBtn{text: "" on_click: || issue_pick_at(4)}
                }
                note := Label{visible: false width: Fill text: "" draw_text.color: #x8a6a24 draw_text.text_style.font_size: 10}
            }
            list := ScrollYView{width: Fill height: Fill flow: Down spacing: 8 padding: Inset{left: 14 right: 14 bottom: 12}
                on_render: || {
                    if cover_on {
                        // 封面卡 = 图上叠字，两层必须重合，所以是 flow: Overlay。
                        //
                        // 这里连着踩过三次「不报错、只是内容不出现」，记下来省得再犯：
                        //   ① 容器写 `height: 236`，但三个直系子控件全是 `height: Fill`。
                        //      Overlay 容器的高度在「Fill 子控件 ↔ 容器高度」之间循环求解，
                        //      解不开就沿用**上一个分支**的旧盒子 —— 上一个分支是一条
                        //      `height: Fit` 的 RoundedView，实测正好 122。
                        //      症状：英文大标题第二行被从中间切断，中文副标题整条不见。
                        //   ② 给副标题起名 `:=` —— 它所在的 View 由 on_render 每帧重建，
                        //      命名绑定会跟着重复注册，控件一直不出画。
                        //   ③ 内联 `visible: cover_sub != ""` —— Label 的可视性只认
                        //      set_visible（见 SCRIPT-API.md），内联字段不受支持。
                        //
                        // 正解：容器 height: Fit，三个直系子控件**都写死 236**。
                        // Fit 取三者最大值 = 236，纵向一个 Fill 都没有，循环求解不存在。
                        // 这与本文件阅读页配图的写法（Fit 容器 + 具体高度 Image）一致，实测可用。
                        View{width: Fill height: Fit flow: Overlay
                            new_batch: true
                            Image{width: Fill height: 236 fit: ImageFit.CropToFill draw_bg.color: #x0b1020 draw_bg.border_radius: 14.0 src: http_resource(cover_url)}
                            View{width: Fill height: 236 show_bg: true draw_bg.color: #x07101ecc draw_bg.border_radius: 14.0}
                            View{width: Fill height: 236 flow: Down spacing: 6 padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                                    Label{width: Fill text: "晨报卡 · AI EDITION" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 10}}
                                    Label{text: cover_line() draw_text.color: #xa9badb draw_text.text_style.font_size: 9}
                                }
                                View{width: Fill height: Fill}
                                Label{width: Fill text: cover_head max_lines: 3 draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 21}}
                                // 副标题坑见上方 ①②③。现在它就是一条普通匿名 Label，只给 text。
                                // 内容为空时它是一条 0 字高的空标签，不占地方。
                                Label{width: Fill text: cover_sub max_lines: 2 draw_text.color: #xd8e2f5 draw_text.text_style.font_size: 12}
                                View{width: Fill height: Fit flow: Right align: Align{x: 1.0 y: 1.0}
                                    DarkBtn{text: "换一张头版" on_click: || cover_retry()}
                                }
                            }
                        }
                    } else if cover_state == "asking" || cover_state == "drawing" || cover_state == "failed" {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true draw_bg.color: #x0e1424 draw_bg.border_radius: 14.0
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            Label{width: Fill text: "今日头版 · 视觉主编" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: cover_note max_lines: 3 draw_text.color: #x9fb0d0 draw_text.text_style.font_size: 11}
                        }
                    }
                    // ---- 更正 · 报错了就写在最前面 ----
                    if issue_sel == "" && fix_count() > 0 {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: #xfdf0ee draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "更正 · 上一期有一处说法要改" draw_text.color: #xb03a2e draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: fix_line(0) max_lines: 4 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{visible: fix_count() > 1 width: Fill text: fix_line(1) max_lines: 4 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{visible: fix_count() > 2 width: Fill text: fix_line(2) max_lines: 4 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{width: Fill text: "本报自己记着这笔。截至今天累计更正 " + ("" + fix_total) + " 条。" draw_text.color: #x9b968c draw_text.text_style.font_size: 10}
                        }
                    }
                    // ---- 口径不一致 · 两个说法都在，我不替你选 ----
                    if issue_sel == "" && clash_count() > 0 {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: #xf4f0e8 draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "本报注意到口径不一致" draw_text.color: #x8a6a24 draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: clash_line(0) max_lines: 5 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{visible: clash_count() > 1 width: Fill text: clash_line(1) max_lines: 5 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{width: Fill text: "两个数字都在，我不替你选。" draw_text.color: #x9b968c draw_text.text_style.font_size: 10}
                        }
                    }
                    // ---- 主编押下的三条预测（下一期自己回来对账） ----
                    if issue_sel == "" && fc_items.len() > 0 {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: #xf4f0e8 draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "主编押下的三条 · 下一期自己回来对账" draw_text.color: #x8a6a24 draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: fc_line(0) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{width: Fill text: fc_line(1) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{width: Fill text: fc_line(2) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{width: Fill text: fc_review_line() draw_text.color: #x9b968c draw_text.text_style.font_size: 10}
                        }
                    } else if fc_state == "asking" || fc_state == "checking" {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true show_bg: true draw_bg.color: #xf4f0e8 draw_bg.border_radius: 14.0
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            Label{width: Fill text: "主编的三个预测" draw_text.color: #x8a6a24 draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: fc_note max_lines: 3 draw_text.color: #x6e7280 draw_text.text_style.font_size: 11}
                        }
                    }
                    // ---- 上一期押下的、已经对完账的记录 ----
                    if issue_sel == "" && fc_hist_text() != "" {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 3
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: fc_hist_text() max_lines: 10 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                        }
                    }
                    // ---- 线索进展 · 同一条线索，本报上次听到时是什么成色 ----
                    if issue_sel == "" && th_count() > 0 {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: th_line() draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: th_text(0) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{visible: th_count() > 1 width: Fill text: th_text(1) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{visible: th_count() > 2 width: Fill text: th_text(2) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                        }
                    }
                    let rows = issues_rows()
                    if rows.len() == 0 {
                        View{width: Fill height: 120 align: Align{x: 0.5 y: 0.5}
                            Label{text: empty_line() draw_text.color: secondary draw_text.text_style.font_size: 12}
                        }
                    }
                    else for i r in rows {
                        GestureView{width: Fill height: Fit on_tap: |x, y| { rip_tap(430) open_story(r) }
                            let thumb = row_img(r)
                            if thumb != "" {
                                RowCardImg{col.rm.text: rank_text(i) + " · " + row_meta(r) col.rt.text: r.title
                                    col.rsu.text: row_sum(r) col.rsu.visible: row_sum(r) != ""
                                    col.rw.text: reason_of(r.id) col.rw.visible: reason_of(r.id) != ""
                                    col.rp.text: panel_mark(r.id) col.rp.visible: panel_mark(r.id) != ""
                                    rth.src: http_resource(thumb)}
                            } else {
                                RowCard{rm.text: rank_text(i) + " · " + row_meta(r) rt.text: r.title
                                    rsu.text: row_sum(r) rsu.visible: row_sum(r) != ""
                                    rw.text: reason_of(r.id) rw.visible: reason_of(r.id) != ""
                                    rp.text: panel_mark(r.id) rp.visible: panel_mark(r.id) != ""}
                            }
                        }
                    }
                    // ---- 回放出报过程 · 这一期是怎么做出来的 ----
                    if issue_sel == "" && phase == "done" && replay_text() != "" {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "回放 · 这一期是怎么做出来的" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: replay_pool_line() max_lines: 2 draw_text.color: #x6e7280 draw_text.text_style.font_size: 11}
                            Label{width: Fill text: replay_panel_line() max_lines: 10 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 11}
                            Label{width: Fill text: replay_judge_line() max_lines: 16 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 11}
                            Label{width: Fill text: charter_version_line() max_lines: 3 draw_text.color: #x9b968c draw_text.text_style.font_size: 10}
                        }
                    }
                    // ---- 没上的三条 · 取舍被看见，才能被反驳 ----
                    if issue_sel == "" && drop_count() > 0 {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true show_bg: true draw_bg.color: #xf7f5f0 draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "没上的三条 · 以及为什么" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: drop_line(0) max_lines: 3 draw_text.color: #x4a4c54 draw_text.text_style.font_size: 11}
                            Label{visible: drop_count() > 1 width: Fill text: drop_line(1) max_lines: 3 draw_text.color: #x4a4c54 draw_text.text_style.font_size: 11}
                            Label{visible: drop_count() > 2 width: Fill text: drop_line(2) max_lines: 3 draw_text.color: #x4a4c54 draw_text.text_style.font_size: 11}
                        }
                    }
                    // ---- 决策台 · 同一批候选，换一类模型再判一次（Jev 式校准选择） ----
                    // 主编那一版是「给人读的」：导语和理由都是句子。这一版是「给程序用的」：
                    // 每条只回一个档位、一个概率、一个分。两者不一样的地方就是分歧，点一行可读原文。
                    if issue_sel == "" && vd_state != "" {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: #xeef2ff draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "决策台 · 另一类模型只回「选择 + 置信度」" draw_text.color: #x3f4fae draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: "上面那版写给人读，这一版给程序用：档位只能落进预设四档，掉出去记 unknown，另加 0-100 进刊概率与 0-10 热度分。点一行可打开原报道。" max_lines: 4 draw_text.color: #x7a8098 draw_text.text_style.font_size: 10}
                            Label{width: Fill text: vd_head_line() max_lines: 3 draw_text.color: #x4a4c54 draw_text.text_style.font_size: 11}
                            if vd_state == "asking" {
                                Label{width: Fill text: "决策台正在判…" draw_text.color: secondary draw_text.text_style.font_size: 10}
                            }
                            for k v in vd_rows {
                                GestureView{width: Fill height: Fit on_tap: |x, y| vd_open(k)
                                    RoundedView{width: Fill height: Fit flow: Down spacing: 2
                                        new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 10.0
                                        padding: Inset{top: 9 bottom: 9 left: 11 right: 11}
                                        Label{width: Fill text: vd_row_text(k) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 11}
                                    }
                                }
                            }
                        }
                    }
                    // ---- 真伪核验台 · 为用户投稿平台上的消息给一个可以被追问的数 ----
                    if issue_sel == "" && vf_state != "" {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: #xeafaf1 draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "真伪核验台 · 为真概率与跨源一致性" draw_text.color: #x1f6b4a draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: "校准分 =（模型分 + 2 × 证据分）÷ 3。证据分由本机算：来源档位先验 + 跨源加成，并受档位封顶。跨源一致性按标题指纹实**不同渠道**：与某个渠道重合 2 个以上长词（或 1 个 10 字以上长词）算「强印证」，进分数；只重合 1 个长词的算弱信号，只提一句不进分。渠道按入口算（Hacker News / TechMeme / 少数派…），不按链接指向的网站算——否则同一条消息被两家聚合站收录时会被当成同一家。模型只能补上「这句话合不合理」，不能单独把一条消息判成真的。" max_lines: 6 draw_text.color: #x5c7a6e draw_text.text_style.font_size: 10}
                            Label{width: Fill text: vf_head_line() max_lines: 3 draw_text.color: #x2f4f41 draw_text.text_style.font_size: 11}
                            if vf_state == "asking" {
                                Label{width: Fill text: "核验台正在判…" draw_text.color: secondary draw_text.text_style.font_size: 10}
                            }
                            for k v in vf_rows {
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    new_batch: true
                                    GestureView{width: Fill height: Fit on_tap: |x, y| vf_toggle(k)
                                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                                            new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 10.0
                                            padding: Inset{top: 9 bottom: 9 left: 11 right: 11}
                                            Label{width: Fill text: vf_row_text(k) max_lines: 8 draw_text.color: #x33473d draw_text.text_style.font_size: 11}
                                            if vf_x_has(k) {
                                                RoundedView{width: Fill height: Fit flow: Down spacing: 2
                                                    new_batch: true show_bg: true draw_bg.color: #xf2f8f4 draw_bg.border_radius: 8.0
                                                    padding: Inset{top: 8 bottom: 8 left: 9 right: 9}
                                                    Label{width: Fill text: vf_chain(k) max_lines: 12 draw_text.color: #x2f4f41 draw_text.text_style.font_size: 10}
                                                }
                                            }
                                        }
                                    }
                                    if vf_x_has(k) {
                                        View{width: Fill height: 32 flow: Right align: Align{x: 1.0 y: 0.5}
                                            BarBtn{text: "打开这条新闻" on_click: || vf_open(k)}
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // ---- 页脚：读者画像 + 重新开始 ----
                    // 这一行提示 + 一个「重新开始」按钮，原来写在 `list` 的**外面**，
                    // 是 run_pane 里 `list` 的兄弟节点。run_pane 是 Down 流、`list`
                    // 是 height: Fill，makepad 就按「Fill = 扣掉兄弟之后的剩余」分账：
                    // 头部 407 + 页脚 195 一扣，`list` 只剩 121px。
                    //
                    // 症状极有迷惑性：不报错、也真的能滚，只是**整页正文被塞进一个
                    // 121px 高的滚窗口**里 —— 封面卡（236）被裁掉一半、中文副标题
                    // 永远看不见，10 条新闻也要在这个小窗口里一条一条慢慢滚。
                    // 截图里看着像「头版排版被切断」，其实是整页布局塌了。
                    //
                    // 挪进滚动内容之后，它成为最后一项，`list` 拿回全部剩余高度
                    // （723 - 407 = 316）。阅读页的 ScrollYView 本来就是这个结构：
                    // 头部 Fit + ScrollYView Fill，页脚也在滚动内容里。
                    //
                    // 一律用匿名控件、不做 `:=` 命名 —— `on_render` 每帧重建，
                    // 命名绑定会重复注册（本文件里已踩过一次，见封面副标题那条注释）。
                    // 所以「读者画像」那行改成用 `if` 决定出不出，不再靠 set_visible。
                    View{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{top: 14 left: 14 right: 14 bottom: 60}
                        if pf_view_line() != "" {
                            Label{width: Fill text: pf_view_line() draw_text.color: #x8a6a24 draw_text.text_style.font_size: 10}
                        }
                        Label{width: Fill text: "点任意条目，在卡片里读这条新闻的来龙去脉；右下角的主编会听你说话，也能替你操作整个程序" draw_text.color: secondary draw_text.text_style.font_size: 11}
                        View{width: Fill height: 44 flow: Right align: Align{y: 0.5}
                            GhostBtn{text: "重新开始" on_click: || restart()}
                        }
                    }
                }
            }
        }
        story_pane := View{visible: false width: Fill height: Fill flow: Down
            new_batch: true show_bg: true draw_bg.color: ground
            View{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{left: 10 right: 14 top: 8 bottom: 8}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
                    story_back := BarBtn{text: "" on_click: || close_story()}
                    story_ask := BarBtn{text: "" on_click: || iv_kick()}
                    story_pos := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 10}
                }
                story_title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                story_meta := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
            ScrollYView{width: Fill height: Fill flow: Down spacing: 10 padding: Inset{left: 14 right: 14 bottom: 300}
                art_pane := View{width: Fill height: Fit flow: Down
                    on_render: || {
                        if art_on {
                            View{width: Fill height: Fit flow: Down spacing: 6
                                Image{width: Fill height: 210 fit: ImageFit.CropToFill src: http_resource(art_url)}
                                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                                    Label{width: Fill text: art_line() draw_text.color: secondary draw_text.text_style.font_size: 10}
                                    GhostBtn{text: "重画" on_click: || art_retry()}
                                    GhostBtn{text: "收起" on_click: || art_off()}
                                }
                            }
                        } else {
                            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                                Label{width: Fill text: art_line() draw_text.color: secondary draw_text.text_style.font_size: 10}
                                if art_busy {
                                    Label{text: "正在画…" draw_text.color: secondary draw_text.text_style.font_size: 10}
                                } else {
                                    BarBtn{text: "画一张配图" on_click: || art_retry()}
                                }
                            }
                        }
                    }
                }
                story_sum_box := View{width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    story_sum_head := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    story_sum := Label{width: Fill text: "" max_lines: 8 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 13}
                }
                // ---- 阅读页里的核验结论：这条到底有多真，说清楚 ----
                story_vf_box := View{visible: false width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xeafaf1 draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    story_vf_head := Label{width: Fill text: "" draw_text.color: #x4d3a86 draw_text.text_style: theme.font_bold{font_size: 11}}
                    story_vf_line := Label{width: Fill text: "" max_lines: 3 draw_text.color: #x2f2a3d draw_text.text_style.font_size: 13}
                    story_vf_who := Label{width: Fill text: "" max_lines: 3 draw_text.color: #x4d3a86 draw_text.text_style.font_size: 11}
                    story_vf_basis := Label{width: Fill text: "" max_lines: 4 draw_text.color: #x5b5570 draw_text.text_style.font_size: 11}
                }
                View{width: Fill height: Fit flow: Down spacing: 5
                    new_batch: true show_bg: true draw_bg.color: #xf6f2ff draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    story_ai_head := Label{width: Fill text: "" draw_text.color: #x6a4bb8 draw_text.text_style: theme.font_bold{font_size: 11}}
                    story_state := Label{width: Fill text: "" draw_text.color: #x8e8e93 draw_text.text_style.font_size: 11}
                    story_ai := Label{width: Fill text: "" max_lines: 20 draw_text.color: ink draw_text.text_style.font_size: 13}
                }
                arc_box := View{visible: false width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xfff7f0 draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    arc_head := Label{width: Fill text: "" draw_text.color: #x8a6a24 draw_text.text_style: theme.font_bold{font_size: 11}}
                    arc_text := Label{width: Fill text: "" max_lines: 6 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                }
                story_more_box := View{visible: false width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    story_more_head := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    story_more_text := Label{width: Fill text: "" max_lines: 12 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                }
                story_cmt_box := View{visible: false width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    story_cmt_head := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    story_cmt_text := Label{width: Fill text: "" max_lines: 16 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                }
                // ---- 主编的追问草稿：只写稿，绝不替读者发信 ----
                iv_pane := View{visible: false width: Fill height: Fit flow: Down spacing: 5
                    new_batch: true show_bg: true draw_bg.color: #xf4f0e8 draw_bg.border_radius: 14.0
                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                    iv_head := Label{width: Fill text: "" draw_text.color: #x8a6a24 draw_text.text_style: theme.font_bold{font_size: 11}}
                    iv_text := Label{width: Fill text: "" max_lines: 14 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                    iv_note := Label{width: Fill text: "" max_lines: 3 draw_text.color: #x6e7280 draw_text.text_style.font_size: 10}
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                        iv_rewrite := GhostBtn{text: "" on_click: || iv_kick()}
                        iv_hide := BarBtn{text: "" on_click: || iv_reset()}
                    }
                }
                View{width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    story_src_head := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    story_src := Label{width: Fill text: "" max_lines: 4 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                    story_url := Label{width: Fill text: "" max_lines: 2 draw_text.color: #x8e8e93 draw_text.text_style.font_size: 10}
                }
                View{width: Fill height: 44 flow: Right align: Align{y: 0.5} spacing: 8
                    story_prev := GhostBtn{text: "" on_click: || story_step(-1)}
                    story_next := GhostBtn{text: "" on_click: || story_step(1)}
                }
            }
        }
        pet_layer := View{width: Fill height: Fill flow: Down
            py1 := View{visible: false width: 1 height: 1}
            py2 := View{visible: false width: 1 height: 2}
            py4 := View{visible: false width: 1 height: 4}
            py8 := View{visible: false width: 1 height: 8}
            py16 := View{visible: false width: 1 height: 16}
            py32 := View{visible: false width: 1 height: 32}
            py64 := View{visible: false width: 1 height: 64}
            py128 := View{visible: false width: 1 height: 128}
            py256 := View{visible: false width: 1 height: 256}
            py512 := View{visible: false width: 1 height: 512}
            View{width: Fill height: Fit flow: Right
                px1 := View{visible: false width: 1 height: 1}
                px2 := View{visible: false width: 2 height: 1}
                px4 := View{visible: false width: 4 height: 1}
                px8 := View{visible: false width: 8 height: 1}
                px16 := View{visible: false width: 16 height: 1}
                px32 := View{visible: false width: 32 height: 1}
                px64 := View{visible: false width: 64 height: 1}
                px128 := View{visible: false width: 128 height: 1}
                px256 := View{visible: false width: 256 height: 1}
                // 点一下 = 戳它；双击（触屏长按）= 主编台；按住拖 = 挪位置；双指捏合 = 换体量。
                pet_s := View{visible: false width: 60 height: 84
                    new_batch: true
                    GestureView{width: Fill height: Fill
                        on_tap: |x, y| { pet_tap() }
                        on_double_tap: |x, y| pet_menu_toggle()
                        on_long_press: |x, y| pet_menu_toggle()
                        on_pan: |dx, dy, phase| pet_pan(dx, dy, phase)
                        on_pinch: |scale, x, y, phase| pet_pinch(scale, x, y, phase)
                        pet_img_s := Image{width: Fill height: Fill fit: ImageFit.Stretch src: http_resource("{{assets}}/assets/guga/idle.png")}
                    }
                }
                pet_m := View{width: 92 height: 128
                    new_batch: true
                    GestureView{width: Fill height: Fill
                        on_tap: |x, y| { pet_tap() }
                        on_double_tap: |x, y| pet_menu_toggle()
                        on_long_press: |x, y| pet_menu_toggle()
                        on_pan: |dx, dy, phase| pet_pan(dx, dy, phase)
                        on_pinch: |scale, x, y, phase| pet_pinch(scale, x, y, phase)
                        pet_img_m := Image{width: Fill height: Fill fit: ImageFit.Stretch src: http_resource("{{assets}}/assets/guga/idle.png")}
                    }
                }
                pet_l := View{visible: false width: 130 height: 181
                    new_batch: true
                    GestureView{width: Fill height: Fill
                        on_tap: |x, y| { pet_tap() }
                        on_double_tap: |x, y| pet_menu_toggle()
                        on_long_press: |x, y| pet_menu_toggle()
                        on_pan: |dx, dy, phase| pet_pan(dx, dy, phase)
                        on_pinch: |scale, x, y, phase| pet_pinch(scale, x, y, phase)
                        pet_img_l := Image{width: Fill height: Fill fit: ImageFit.Stretch src: http_resource("{{assets}}/assets/guga/idle.png")}
                    }
                }
                pet_xl := View{visible: false width: 170 height: 236
                    new_batch: true
                    GestureView{width: Fill height: Fill
                        on_tap: |x, y| { pet_tap() }
                        on_double_tap: |x, y| pet_menu_toggle()
                        on_long_press: |x, y| pet_menu_toggle()
                        on_pan: |dx, dy, phase| pet_pan(dx, dy, phase)
                        on_pinch: |scale, x, y, phase| pet_pinch(scale, x, y, phase)
                        pet_img_xl := Image{width: Fill height: Fill fit: ImageFit.Stretch src: http_resource("{{assets}}/assets/guga/idle.png")}
                    }
                }
            }
        }
        ag_dock := View{width: Fill height: Fill flow: Down align: Align{x: 1.0 y: 1.0}
            padding: Inset{right: 10 bottom: 58}
            // ===== 咕嘎 · 工作台（浮在咕嘎旁边的小卡片）=====
            // 用户反馈（2026-10-13）：原来是**整屏遮罩**，一打开就把整张卡片盖住，
            // 「我要的是工作台在咕嘎旁边，不是把卡片盖掉」。
            // 现在：靠右下角停、宽 352（卡宽 412），高度靠各分区自己收着，
            // 上方始终留着 300 多像素能看见卡片本体；底部让开那个「咕嘎·工作台」胶囊。
            ag_panel := RoundedView{visible: false width: 352 height: Fit flow: Down spacing: 6
                // f2 = 94% 不透明：底下的品类胶囊不再从面板里透出来（截图里
                // 看着像重影），同时保住一点点夜色通透感。
                new_batch: true draw_bg.color: #x141a27f7 draw_bg.border_radius: 18.0
                padding: Inset{top: 8 bottom: 9 left: 13 right: 13}
                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                    ag_title := Label{text: "" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 13}}
                    ag_badge := Label{text: "" draw_text.color: #x6d7d9c draw_text.text_style.font_size: 9}
                    View{width: Fill height: 1}
                    pet_bub_b := ChipDk{text: "" on_click: || pet_toggle_bubble()}
                    ag_clear_b := BarBtn{text: "" on_click: || ag_clear()}
                    ag_hide_b := BarBtn{text: "" on_click: || wb_close()}
                }
                // ⚠️ ag_note 这里**不能删**：它既是脚本里的状态变量（ag_note = …），
                // 也是这个界面控件（sync_ui 里 ui.ag_note.set_text(ag_line())）。
                // 删掉控件，那行 set_text 就会抛错 —— 读一个不存在的控件名同样会
                // 中断整次求值（见 load_last 那条注释）。它也是读者唯一能看到
                // 「主编这次没有答复」的地方，必须留着。
                ag_note := Label{width: Fill text: "" max_lines: 2 draw_text.color: #x93a4c6 draw_text.text_style.font_size: 10}
                // 三分区切换：当前那枚前面带 ●（见 wb_tab_text）
                View{width: Fill height: Fit flow: Right spacing: 6
                    wb_b0 := ChipDk{text: "" on_click: || wb_pick(0)}
                    wb_b1 := ChipDk{text: "" on_click: || wb_pick(1)}
                    wb_b2 := ChipDk{text: "" on_click: || wb_pick(2)}
                }
                // ---------- 分区 0 · 对话 ----------
                wb_t0 := View{width: Fill height: Fit flow: Down spacing: 9
                    View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                        vc_big := MicBtn{text: "" on_click: || vc_voice_go()}
                        vc_contb := ChipDk{text: "" on_click: || vc_toggle_cont()}
                        vc_autob := ChipDk{text: "" on_click: || vc_toggle_auto()}
                    }
                    vc_note := Label{width: Fill text: "" max_lines: 1 draw_text.color: #x93a4c6 draw_text.text_style.font_size: 10}
                    ag_caps := Label{width: Fill text: "" max_lines: 1 draw_text.color: #x6f7f9e draw_text.text_style.font_size: 9}
                    ag_iv := Label{visible: false width: Fill text: "" draw_text.color: #x8fe0b0 draw_text.text_style.font_size: 9}
                    // 对话记录（65 高 ≈ 一条半消息，可滚动）。
                    // 为什么压这么矮：工作台要和桌宠在竖向上「住得下」——
                    // 实测（_wbgeo.py）面板高 510 时顶部到 y=115，而桌宠让位后
                    // 底部最低只能到 166，压到 65 高面板顶退到 ~185 才不重叠。
                    ag_log_box := ScrollYView{width: Fill height: 65 flow: Down spacing: 5
                        on_render: || {
                            if ag_log.len() == 0 {
                                Label{width: Fill text: "试着对我说：只看芯片和 AI，生成今天的晨报。" draw_text.color: #x7c8db0 draw_text.text_style.font_size: 11}
                            }
                            else for e in ag_log {
                                if e.who == "me" {
                                    View{width: Fill height: Fit flow: Right
                                        RoundedView{width: Fit height: Fit flow: Down
                                            new_batch: true draw_bg.color: #x24304d draw_bg.border_radius: 12.0
                                            padding: Inset{top: 7 bottom: 7 left: 11 right: 11}
                                            Label{width: Fit text: e.text max_lines: 3 draw_text.color: #xe8eefc draw_text.text_style.font_size: 12}
                                        }
                                    }
                                }
                                else if e.who == "tool" {
                                    Label{width: Fill text: e.text max_lines: 2 draw_text.color: #x8fe0b0 draw_text.text_style.font_size: 10}
                                }
                                else {
                                    View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.0}
                                        Label{text: "主编" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 10}}
                                        Label{width: Fill text: e.text max_lines: 3 draw_text.color: #xdbe4f7 draw_text.text_style.font_size: 12}
                                    }
                                }
                            }
                        }
                    }
                    // 输入行：用户原话「输入想查找的内容，咕嘎直接在卡片上
                    // 生成今日的晨报」—— 这里输入，出报动作全在卡片上发生
                    //（工作台只负责转达与显示进度）。
                    View{width: Fill height: Fit flow: Right spacing: 8
                        ag_in := TextInput{width: Fill height: 42 empty_text: "想找什么 / 想生成什么，对主编说…" on_change: |t| ag_set_draft(t)
                            draw_bg +: {color: #x1a2338 color_hover: #x1a2338 color_focus: #x1f2a44 color_empty: #x1a2338
                                border_color: #x2b3a5e border_color_hover: #x2b3a5e border_color_focus: accent border_color_empty: #x2b3a5e
                                border_radius: 12.0}
                            draw_text +: {color: #xe8eefc color_hover: #xe8eefc color_focus: #xe8eefc color_empty: #x6f7f9e color_empty_hover: #x6f7f9e}
                        }
                        PrimaryBtn{text: "发送" on_click: || { rip_tap(540) ag_send() }}
                    }
                    // 一行快捷键：能干的活儿都能从输入行说出来，这里只放最常用的
                    // 三个例句（用户要求「清爽简洁」，原来两行七个删到一行三个）。
                    View{width: Fill height: Fit flow: Right spacing: 6
                        ChipDk{text: "生成今天这份" on_click: || ag_say("生成今天这份晨报")}
                        ChipDk{text: "只看 AI 和芯片" on_click: || ag_say("只看 AI 和芯片，生成今天的晨报")}
                        ChipDk{text: "念给我听" on_click: || rv_toggle()}
                    }
                }
                // ---------- 分区 1 · 干活（原主编台整页搬进来）----------
                wb_t1 := View{visible: false width: Fill height: Fit flow: Down spacing: 5
                    // 形体行（原来的标题行「形体 · 想让本鹅多大只」已删 —— 标题占一行
                    // 太费地方，四个尺寸胶囊自己会说话。桌宠也可以直接双指捏合换体量）
                    View{width: Fill height: Fit flow: Right spacing: 6
                        pet_s1 := ChipDk{text: "" on_click: || pet_menu_size(0)}
                        pet_s2 := ChipDk{text: "" on_click: || pet_menu_size(1)}
                        pet_s3 := ChipDk{text: "" on_click: || pet_menu_size(2)}
                        pet_s4 := ChipDk{text: "" on_click: || pet_menu_size(3)}
                    }
                    // 这一行是主编台的正事：没有一个是逗宠物的。
                    pet_menu_work := Label{width: Fill text: "" draw_text.color: #x93a4c6 draw_text.text_style.font_size: 9}
                    View{width: Fill height: Fit flow: Right spacing: 6
                        pet_m1 := ChipDk{text: "" on_click: || pet_sum_brief()}
                        pet_m2 := ChipDk{text: "" on_click: || pet_menu_cmd("cover")}
                        pet_m3 := ChipDk{text: "" on_click: || pf_open_from_menu()}
                        pet_m4 := ChipDk{text: "" on_click: || pet_menu_cmd("ledger")}
                        pet_m5 := ChipDk{text: "" on_click: || pet_menu_cmd("trail")}
                    }
                    pet_menu_ask := Label{width: Fill text: "" draw_text.color: #x93a4c6 draw_text.text_style.font_size: 9}
                    View{width: Fill height: Fit flow: Right spacing: 6
                        pet_k1 := ChipDk{text: "" on_click: || pet_ask_kind("商业")}
                        pet_k2 := ChipDk{text: "" on_click: || pet_ask_kind("科技")}
                        pet_k3 := ChipDk{text: "" on_click: || pet_ask_kind("芯片")}
                        pet_k4 := ChipDk{text: "" on_click: || pet_ask_kind("国际")}
                        pet_k5 := ChipDk{text: "" on_click: || pet_ask_kind("生活")}
                    }
                    // 直接指挥（原来五个：聊天/出报/配图/分析/记录 —— 聊天与出报
                    // 跟对话分区的输入行重复，删掉；剩下三件是对话替代不了的）
                    View{width: Fill height: Fit flow: Right spacing: 6
                        pet_c3 := ChipDk{text: "" on_click: || pet_menu_cmd("art")}
                        pet_c4 := ChipDk{text: "" on_click: || pet_menu_cmd("talk")}
                        bl_pill := ChipDk{text: "" on_click: || pet_menu_cmd("browse")}
                    }
                }
                // ---------- 分区 2 · 档案（按时间查往期、收藏）----------
                wb_t2 := View{visible: false width: Fill height: Fit flow: Down spacing: 7
                    wb_hint := Label{width: Fill text: "" max_lines: 2 draw_text.color: #x93a4c6 draw_text.text_style.font_size: 10}
                    View{width: Fill height: Fit flow: Right spacing: 8
                        wb_in := TextInput{width: Fill height: 38 empty_text: "输入时间，如 10月11日 / 1011 / 昨天" on_change: |t| wb_set_q(t)
                            draw_bg +: {color: #x1a2338 color_hover: #x1a2338 color_focus: #x1f2a44 color_empty: #x1a2338
                                border_color: #x2b3a5e border_color_hover: #x2b3a5e border_color_focus: accent border_color_empty: #x2b3a5e
                                border_radius: 12.0}
                            draw_text +: {color: #xe8eefc color_hover: #xe8eefc color_focus: #xe8eefc color_empty: #x6f7f9e color_empty_hover: #x6f7f9e}
                        }
                        ChipDk{text: "查" on_click: || wb_do_find()}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 6
                        ChipDk{text: "今天" on_click: || wb_quick("今天")}
                        ChipDk{text: "昨天" on_click: || wb_quick("昨天")}
                        ChipDk{text: "最近三期" on_click: || wb_quick("")}
                        wb_star := ChipDk{text: "" on_click: || wb_star_toggle()}
                    }
                    wb_rrow1 := View{visible: false width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                        wb_r1 := Label{width: Fill text: "" max_lines: 2 draw_text.color: #xdbe4f7 draw_text.text_style.font_size: 11}
                        wb_ro1 := ChipDk{text: "打开" on_click: || wb_res_open(0)}
                        wb_rs1 := ChipDk{text: "收藏" on_click: || wb_res_star(0)}
                    }
                    wb_rrow2 := View{visible: false width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                        wb_r2 := Label{width: Fill text: "" max_lines: 2 draw_text.color: #xdbe4f7 draw_text.text_style.font_size: 11}
                        wb_ro2 := ChipDk{text: "打开" on_click: || wb_res_open(1)}
                        wb_rs2 := ChipDk{text: "收藏" on_click: || wb_res_star(1)}
                    }
                    wb_fav_head := Label{width: Fill text: "" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 10}}
                    wb_frow1 := View{visible: false width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                        wb_f1 := Label{width: Fill text: "" max_lines: 2 draw_text.color: #xdbe4f7 draw_text.text_style.font_size: 11}
                        wb_fo1 := ChipDk{text: "打开" on_click: || wb_fav_open1()}
                        wb_fd1 := ChipDk{text: "移除" on_click: || wb_fav_del1()}
                    }
                    wb_frow2 := View{visible: false width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                        wb_f2 := Label{width: Fill text: "" max_lines: 2 draw_text.color: #xdbe4f7 draw_text.text_style.font_size: 11}
                        wb_fo2 := ChipDk{text: "打开" on_click: || wb_fav_open2()}
                        wb_fd2 := ChipDk{text: "移除" on_click: || wb_fav_del2()}
                    }
                }
            }
            // ---- 底部常驻条：只剩咕嘎一个入口（说话与主编都在工作台里）----
            View{width: Fill height: Fit flow: Right align: Align{x: 1.0 y: 1.0} spacing: 9 padding: Inset{left: 14 right: 14 bottom: 14 top: 6}
                arc_pill := Label{width: Fit height: Fit text: "" max_lines: 2 draw_text.color: #x9b968c draw_text.text_style.font_size: 9}
                View{width: 8 height: 1}
                ag_pill := PillBtn{text: "● 咕嘎 · 工作台" on_click: || ag_toggle()}
            }

        }

        // ===== 语音对话 · 豆包式收音台（全屏浮层，开麦即现）=====
        //   × 丢掉这一句 ／ 中间波形 ／ ↑ 把现在听到的整段发出去
        //   上面那行是实时转写：识别器每段落一句，全并进这一段文本。
        //   （长语音的正确姿势：多个 final 累积，见 vc_poll_go 的注释）
        // 注意：这里是 RoundedView 而不是 View —— 本项目实测过
        // `View{show_bg:true}` 的纯色底色在 card-host 不渲染（见 pet 那批教训），
        // 用 View 的话整层是透的，转写文字会浮在首页上、跟按钮叠在一起。
        vc_sheet := RoundedView{visible: false width: Fill height: Fill flow: Down spacing: 10
            new_batch: true draw_bg.color: #x0a0e16f7
            padding: Inset{left: 12 right: 12 bottom: 22 top: 12}
            View{width: Fill height: Fill flow: Down}
            View{width: Fill height: Fit flow: Down spacing: 9
                // 咕嘎在听：给一个看得见的「本鹅」在场
                vc_who := Label{width: Fill text: "" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 12}}
                vc_live := Label{width: Fill text: "" max_lines: 5 draw_text.color: #xe8eefc draw_text.text_style.font_size: 15}
                vc_sheet_hint := Label{width: Fill text: "" max_lines: 2 draw_text.color: #x93a4c6 draw_text.text_style.font_size: 10}
                // 控制条：× ／ 波形 ／ ↑
                RoundedView{width: Fill height: 72 flow: Right align: Align{y: 0.5} spacing: 12
                    new_batch: true draw_bg.color: #x1b2436f2 draw_bg.border_radius: 36.0
                    padding: Inset{left: 12 right: 12}
                    vc_cancelb := VcCircle{text: "×" on_click: || vc_cancel()}
                    View{width: Fill height: 46 show_bg: true
                        new_batch: true
                        draw_bg +: {pixel: fn() {
                            let vp = self.pos * self.rect_size
                            let vz = self.rect_size
                            let vt = self.draw_pass.time
                            let vn = 26.0
                            let vbx = vp.x / max(1.0 vz.x) * vn
                            let vbi = floor(vbx)
                            let vfr = vbx - vbi
                            let vin = 1.0 - smoothstep(0.26 0.40 abs(vfr - 0.5))
                            let vh = 0.18 + 0.82 * abs(sin(vbi * 1.9 + vt * 2.4)) * (0.45 + 0.55 * abs(sin(vbi * 0.61 + vt * 0.9)))
                            let vcy = abs(vp.y - vz.y * 0.5) / max(1.0 vz.y * 0.5)
                            let vbar = vin * (1.0 - smoothstep(vh - 0.10 vh + 0.02 vcy))
                            let vedge = 1.0 - smoothstep(0.0 26.0 abs(vp.x - vz.x * 0.5) * 2.0 - vz.x)
                            return vec4(0.86 0.90 0.98 vbar * 0.95)
                        }}
                    }
                    vc_sendb := VcCircle{text: "↑" on_click: || vc_send_now()}
                }
            }
        }
        // ---- 咕嘎 · 桌宠本体（可拖动、可换体量）----
        //   位置 = 一组静态占位控件按二进制开关叠出来的偏移（见 pet_spacers_sync）：
        //   要往右挪 137px 就把 128/8/1 三个开关打开。隐藏的控件不参与布局（实测）。
        //   体量 = 四只尺寸各写死一份，同一时刻只让 pet_size_i 指到的那只可见。
        //   为什么不用 on_render + abs_pos 直接改坐标：脚本层没有几何 setter，
        //   而 on_render 每帧重建子控件，拖动途中一重建手势就断（实测只收到
        //   phase 0/1 各一次，phase 2 永远不来）。这里是全静态控件，只切可见性。
        //   贴图仍走 bundle/assets/guga/（宿主 {{assets}} 回环地址，不联网）。
        // ---- 咕嘎的气泡、主编台与浏览记录：浮在底部右侧，点它/双击它才出现 ----
        //   底部工具条约 84px 高（工具条 + 上下留白），所以整组内容抬到 84px 之上。
        View{width: Fill height: Fill flow: Down align: Align{x: 1.0 y: 1.0} spacing: 6 padding: Inset{right: 16 bottom: 84}
            new_batch: true
            pet_bubble := RoundedView{visible: false width: Fit height: Fit flow: Down
                new_batch: true draw_bg.color: #xfdfcf7 draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: #xe4ded0
                padding: Inset{top: 7 bottom: 7 left: 11 right: 11}
                pet_bubble_lbl := Label{width: Fit text: "" max_lines: 3 draw_text.color: ink draw_text.text_style.font_size: 11}
            }
            // 浏览记录：今天派咕嘎去问过的每一笔，品类 / 条数 / 状态 / 查回来的标题。
            // 宽度同样写死，让长标题在面板里换行，而不是把面板撑出去。
            bl_panel := RoundedView{visible: false width: 340 height: Fit flow: Down spacing: 6
                new_batch: true draw_bg.color: #xfdfcf7 draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: #xe4ded0
                padding: Inset{top: 10 bottom: 10 left: 12 right: 12}
                View{width: Fill height: Fit flow: Right spacing: 8
                    bl_head := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    ChipDk{text: "收起" on_click: || bl_toggle()}
                }
                bl_empty := Label{width: Fill text: "点咕嘎 → 问新闻（商业/科技/芯片…），查回来的东西都会记在这里。" max_lines: 3 draw_text.color: secondary draw_text.text_style.font_size: 10}
                bl_r1 := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 2
                    new_batch: true draw_bg.color: #xf3efe6 draw_bg.border_radius: 10.0
                    padding: Inset{top: 7 bottom: 7 left: 10 right: 10}
                    bl_r1_head := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 10}}
                    bl_r1_top := Label{width: Fill text: "" max_lines: 4 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 10}
                }
                bl_r2 := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 2
                    new_batch: true draw_bg.color: #xf3efe6 draw_bg.border_radius: 10.0
                    padding: Inset{top: 7 bottom: 7 left: 10 right: 10}
                    bl_r2_head := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 10}}
                    bl_r2_top := Label{width: Fill text: "" max_lines: 4 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 10}
                }
                bl_r3 := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 2
                    new_batch: true draw_bg.color: #xf3efe6 draw_bg.border_radius: 10.0
                    padding: Inset{top: 7 bottom: 7 left: 10 right: 10}
                    bl_r3_head := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 10}}
                    bl_r3_top := Label{width: Fill text: "" max_lines: 4 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 10}
                }
            }
            // 读者画像：主编记住的主人（常读哪几类、你亲口要它记的偏好）。
            // 数据在 profile.json，只存本机；宽度同样写死 340，跟另外两块面板齐平。
            pf_panel := RoundedView{visible: false width: 340 height: Fit flow: Down spacing: 6
                new_batch: true draw_bg.color: #xfdfcf7 draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: #xe4ded0
                padding: Inset{top: 10 bottom: 10 left: 12 right: 12}
                View{width: Fill height: Fit flow: Right spacing: 8
                    pf_head := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    ChipDk{text: "收起" on_click: || pf_toggle()}
                }
                pf_stat := Label{width: Fill text: "" max_lines: 2 draw_text.color: secondary draw_text.text_style.font_size: 10}
                pf_focus := Label{width: Fill text: "" max_lines: 3 draw_text.color: ink draw_text.text_style.font_size: 10}
                pf_notes_head := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 10}}
                pf_notes_lbl := Label{width: Fill text: "" max_lines: 5 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 10}
                View{width: Fill height: Fit flow: Right spacing: 6
                    pf_b1 := ChipDk{text: "" on_click: || pf_add_hint()}
                    pf_b2 := ChipDk{text: "" on_click: || pf_use()}
                }
            }
        }
        // ---- 点击涟漪层：三段高度各一个环，rip_tap 按点击高度亮一段 ----
        View{width: Fill height: Fill flow: Down
            new_batch: true
            View{width: Fill height: 300
                rip_r0 := View{visible: false width: Fill height: Fill
                    new_batch: true show_bg: true
                    draw_bg +: {pixel: fn() {
                        let rw = self.draw_pass.time * 1.6
                        let rp = self.pos * self.rect_size
                        let rc = self.rect_size * 0.5
                        let rd = length(rp - rc) / max(1.0 rc.x)
                        let ring = 1.0 - smoothstep(0.0 0.09 abs(rd - fract(rw) * 0.75))
                        let fade = (1.0 - fract(rw)) * 0.5
                        return vec4(0.98 0.72 0.35 ring * fade)
                    }}
                }
            }
            View{width: Fill height: 300
                rip_r1 := View{visible: false width: Fill height: Fill
                    new_batch: true show_bg: true
                    draw_bg +: {pixel: fn() {
                        let rw = self.draw_pass.time * 1.6
                        let rp = self.pos * self.rect_size
                        let rc = self.rect_size * 0.5
                        let rd = length(rp - rc) / max(1.0 rc.x)
                        let ring = 1.0 - smoothstep(0.0 0.09 abs(rd - fract(rw) * 0.75))
                        let fade = (1.0 - fract(rw)) * 0.5
                        return vec4(0.98 0.72 0.35 ring * fade)
                    }}
                }
            }
            View{width: Fill height: Fill
                rip_r2 := View{visible: false width: Fill height: Fill
                    new_batch: true show_bg: true
                    draw_bg +: {pixel: fn() {
                        let rw = self.draw_pass.time * 1.6
                        let rp = self.pos * self.rect_size
                        let rc = self.rect_size * 0.5
                        let rd = length(rp - rc) / max(1.0 rc.x)
                        let ring = 1.0 - smoothstep(0.0 0.09 abs(rd - fract(rw) * 0.75))
                        let fade = (1.0 - fract(rw)) * 0.5
                        return vec4(0.98 0.72 0.35 ring * fade)
                    }}
                }
            }
        }
        cg := View{width: Fill height: Fill flow: Overlay show_bg: true
            new_batch: true
            draw_bg +: {
                pixel: fn() {
                    let cgT = self.draw_pass.time * 1.0
                    let cgSz = self.rect_size
                    let cgP = self.pos * cgSz
                    let cgCx = cgSz.x * 0.5
                    let cgCy = cgSz.y * 0.5
                    let cgRelX = cgP.x - cgSz.x * 0.5
                    let cgRelY = cgP.y - cgSz.y * 0.5
                    let cgInkA = #x07090f
                    let cgInkB = #x0d1220
                    let cgGrid = #x223050
                    let cgDawn = #xffd39a
                    let cgHot = #xfff6e6
                    let cgAcc = #xe0245e

                    let cgVg = clamp(cgP.y / cgSz.y, 0.0, 1.0)
                    var cgCol = cgInkA.mix(cgInkB, cgVg * 0.9)

                    let cgGA = smoothstep(0.55 1.70 cgT) * 0.5
                    let cgCell = 44.0
                    let cgDx = abs(fract(cgP.x / cgCell + 0.5) - 0.5) * cgCell
                    let cgDy = abs(fract(cgP.y / cgCell + 0.5) - 0.5) * cgCell
                    let cgGl = (1.0 - smoothstep(0.0 1.2 min(cgDx cgDy))) * cgGA
                    cgCol = cgCol.mix(cgGrid.mix(cgDawn, 0.22), cgGl)

                    let cgRise = smoothstep(1.70 2.90 cgT)
                    let cgBandY = cgSz.y * (1.15 - 1.35 * cgRise)
                    let cgDb = abs(cgP.y - cgBandY)
                    let cgBand = 1.0 - smoothstep(0.0 190.0 cgDb)
                    let cgCore = 1.0 - smoothstep(0.0 34.0 cgDb)
                    let cgBx = 1.0 - smoothstep(0.0 230.0 abs(cgP.x - cgCx))
                    cgCol = cgCol.mix(cgDawn, cgBand * cgBx * 0.42)
                    cgCol = cgCol.mix(cgHot, cgCore * cgBx * 0.85)

                    let cgPa = smoothstep(0.25 2.60 cgT)
                    let cgPd = 1.0 - cgPa
                    let cgKk = cgPa * cgPa

                    let cgR0 = 300.0 * (1.0 - cgKk) + 46.0 * cgKk
                    let cgA0 = 0.4 + cgT * 0.85
                    let cgM0 = (1.0 - smoothstep(0.0 3.2 length(cgP - vec2(cgCx + cos(cgA0) * cgR0 * 1.15, cgCy + sin(cgA0) * cgR0)))) * (0.45 + 0.55 * cgPd)
                    cgCol = cgCol.mix(cgHot, cgM0 * 0.95)

                    let cgR1 = 340.0 * (1.0 - cgKk) + 62.0 * cgKk
                    let cgA1 = 2.1 + cgT * 0.72
                    let cgM1 = (1.0 - smoothstep(0.0 2.8 length(cgP - vec2(cgCx + cos(cgA1) * cgR1 * 1.25, cgCy + sin(cgA1) * cgR1)))) * (0.42 + 0.58 * cgPd)
                    cgCol = cgCol.mix(cgDawn, cgM1 * 0.9)

                    let cgR2 = 268.0 * (1.0 - cgKk) + 38.0 * cgKk
                    let cgA2 = 3.6 + cgT * 1.05
                    let cgM2 = (1.0 - smoothstep(0.0 2.6 length(cgP - vec2(cgCx + cos(cgA2) * cgR2 * 1.05, cgCy + sin(cgA2) * cgR2)))) * (0.4 + 0.6 * cgPd)
                    cgCol = cgCol.mix(#xffe9c4, cgM2 * 0.9)

                    let cgR3 = 380.0 * (1.0 - cgKk) + 78.0 * cgKk
                    let cgA3 = 5.2 + cgT * 0.62
                    let cgM3 = (1.0 - smoothstep(0.0 2.4 length(cgP - vec2(cgCx + cos(cgA3) * cgR3 * 1.35, cgCy + sin(cgA3) * cgR3)))) * (0.38 + 0.62 * cgPd)
                    cgCol = cgCol.mix(cgDawn, cgM3 * 0.85)

                    let cgOrb = smoothstep(0.30 1.20 cgT) * (1.0 - smoothstep(2.70 3.10 cgT))
                    let cgCxr = cgRelX * cos(0.0 - 0.42) - cgRelY * sin(0.0 - 0.42)
                    let cgCyr = cgRelX * sin(0.0 - 0.42) + cgRelY * cos(0.0 - 0.42)
                    let cgRing = abs(length(vec2(cgCxr / 196.0, cgCyr / 64.0)) - 1.0)
                    let cgOrbI = (1.0 - smoothstep(0.0 0.055 cgRing)) * cgOrb
                    cgCol = cgCol.mix(cgDawn, cgOrbI * 0.55)

                    let cgSlY = cgSz.y * fract(cgT * 0.14 + 0.05)
                    let cgSl = (1.0 - smoothstep(0.0 2.5 abs(cgP.y - cgSlY))) * (1.0 - smoothstep(2.90 3.35 cgT))
                    cgCol = cgCol.mix(cgAcc, cgSl * 0.8)


                    // 咕嘎脚下的暖光：他登场的那一刻，光先亮起来，把生硬的"出现"盖过去
                    let cgGx = cgP.x - cgSz.x * 0.5
                    let cgGy = cgP.y - (cgSz.y - 170.0)
                    let cgGd = length(vec2(cgGx / 152.0, cgGy / 104.0))
                    let cgBurst = (1.0 - smoothstep(0.0 1.0 cgGd)) * smoothstep(1.14 1.62 cgT) * (1.0 - smoothstep(2.88 3.18 cgT))
                    cgCol = cgCol.mix(cgDawn, cgBurst * 0.42)

                    let cgFlash = smoothstep(2.90 3.08 cgT)
                    cgCol = cgCol.mix(#xffffff, cgFlash * 0.94)

                    let cgOut = 1.0
                    return vec4(cgCol.x * cgOut cgCol.y * cgOut cgCol.z * cgOut cgOut)
                }
            }
            View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 10
                cg_eye := Label{width: Fill align: Align{x: 0.5} text: "" draw_text.color: #xffd39a draw_text.text_style.font_size: 11}
                cg_ttl := Label{width: Fill align: Align{x: 0.5} text: "" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 30}}
                cg_rul := Label{width: Fill align: Align{x: 0.5} text: "" draw_text.color: #xe0245e draw_text.text_style.font_size: 12}
            }
            // ---- 咕嘎企鹅登场：破晓时站在画面下方，三秒后随 CG 一起退场 ----
            View{width: Fill height: Fill flow: Down align: Align{x: 0.5} spacing: 0 padding: Inset{bottom: 54}
                View{width: Fill height: Fill}
                cg_pet := Image{visible: false width: 180 height: 250 fit: ImageFit.Stretch src: http_resource("{{assets}}/assets/guga/cheer.png")}
            }
        }

    }
    tile: View{width: Fill height: Fill flow: Down padding: Inset{left: 14 right: 14 top: 12 bottom: 12} spacing: 6
        new_batch: true show_bg: true draw_bg.color: #xffffff
        Label{text: "晨报卡" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
        Label{width: Fill text: "一句话意图，生成一份可核验的晨报。" max_lines: 3 draw_text.color: ink draw_text.text_style.font_size: 12}
    }
}
