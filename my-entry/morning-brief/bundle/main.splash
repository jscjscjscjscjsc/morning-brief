    ui.gen_pane.set_visible(phase == "intent")
    ui.plan_pane.set_visible(phase == "plan")
    // 与 plan_ask 同理：pane 切换可见性后，「只在 boot 时被 set_text 写过一次」的
    // 静态控件会掉出布局（plan_ok 消失的教训）。这些每次 sync_ui 都重写一遍，幂等。
    ui.plan_title.set_text("待批准的取数计划")
    ui.plan_ok.set_text("批准并取数")
    ui.plan_no.set_text("暂不")
