}

fn story_src_text(){
    if story == nil { return "" }
    if hn_id(story) != "" { return "这篇报道来自 " + story.source + "，讨论发生在 Hacker News。" }
    "这条由 TechMeme 收录，来源是 " + story.source + "。"
}

fn art_has(s, part){
    if s.search(part) >= 0 { return true }
    false
}

fn art_clean(t){
    let s = t
    let bad = ["—" "–" "’" "‘" "“" "”" "…"]
    let good = ["-" "-" "'" "'" "\"" "\"" "."]
    let i = 0
    for b in bad {
        s = s.replace(b, good[i])
        i = i + 1
    }
    s
}

fn art_cached_for(id){
    let hit = ""
    for c in art_cache {
        if c.id == id { hit = c.url }
    }
    hit
}

fn art_put(id, url){
    let hit = -1
    let k = 0
    for c in art_cache {
        if c.id == id { hit = k }
        k = k + 1
    }
    if hit >= 0 { art_cache.remove(hit) }
    art_cache.push({id: id url: url})
    if art_cache.len() > 20 { art_cache.remove(0) }
}

fn photo_take(q){
    let raw = sys.photo(q)
    if raw == nil { return "" }
    let s = "" + raw
    if art_has(s, "%") { return s }
    if art_has(s, " ") == false { return s }
    s.url_encode()
}

fn art_take_shot(){
    let r = photo_take(art_q)
    r
}

fn art_mm_url(u){
    // MiniMax 交回来的是阿里云 OSS 的**带签名**公开地址（?Expires=…&Signature=…）；
    // pollinations 是即时 URL 工厂，两者一眼可分。签名地址要多挂参数就会失效。
    if art_has(u, "Expires=") { return true }
    if art_has(u, "Signature=") { return true }
    false
}

fn art_save(){
    let pack = []
    for c in art_cache {
        pack.push({id: c.id url: c.url})
    }
    fs.write("art_cache.json", {schema: 1 saved_at: time_now() items: pack}.to_json())
}

fn art_where(){
    let first = ""
    let i = 0
    for p in art_pick {
        if i == 0 { first = p }
        i = i + 1
    }
    first
}

// 截到 n 个字符。
// 不能用 to_chars()：它给的是每个字的代码点（数字），拼起来会变成一串数字，
// 语音合成就会把「中文」念成「2001325991」。split("") 给的是单字符本身。
// （另注意：字符串的 .len() 是字节数，不是字数。）
fn art_cut(s, n){
    let out = ""
    let k = 0
    for c in s.split("") {
        if c != "" {
            if k < n { out = out + c }
            k = k + 1
        }
    }
    out
}

