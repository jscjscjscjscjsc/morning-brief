    let i = 0
    for e in ag_log {
        if i >= n - 6 { kept.push(e) }
        i = i + 1
    }
    ag_log = kept
}

fn ag_trim_msgs(){
    let n = ag_msgs.len()
    if n <= 10 { return }
    let kept = []
    let i = 0
    for m in ag_msgs {
        if i >= n - 10 { kept.push(m) }
        i = i + 1
    }
    ag_msgs = kept
}

fn ag_wants_task(){
