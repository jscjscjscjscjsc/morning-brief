fn toggle_topic(id){
    // 品类表可扩，别再写成一串 if/else。
    if chosen[id] == true { chosen[id] = false } else { chosen[id] = true }
    sync_ui()
}

fn toggle_plat(id){
    if chosen_plat[id] == true { chosen_plat[id] = false } else { chosen_plat[id] = true }
    sync_ui()
}

fn bump(d){
    limit = limit + d
    if limit < 3 { limit = 3 }
    if limit > 30 { limit = 30 }
    sync_ui()
}

let cover_shape = {type: "object" required: ["headline" "subtitle" "image"] properties: {headline: {type: "string"} subtitle: {type: "string"} image: {type: "string"}}}

fn cover_kick(){
    if picked.len() == 0 { return }
    if cover_on { return }
    cover_state = "asking"
    cover_note = "视觉主编正在为今天这一期写头版标语…"
    sync_ui()
    if ai_ready != 1 { cover_fallback()
        return }
    let lines = ""
    let i = 1
    for r in picked {
        if i < 9 { lines = lines + "" + i + ". " + r.title + "\n" }
        i = i + 1
    }
    let intro = ai_intro
    if intro == "" { intro = "（这期没有导语）" }
    host.request("model.complete", {
        task: "[编辑部宪法 cover/" + charter_v("cover") + "]
你是报纸头版的视觉主编，负责为每天一期的科技晨报定头版标题和主画面。直接输出 JSON 对象，第一个字符就是 {，不要输出任何推理过程。JSON 结构：headline 是英文头版大标题（字符串，不超过 9 个词，全大写，不带引号）；subtitle 是中文副标题（字符串，不超过 20 个字，一句话说清今天的主线，不重复 headline 的意思、不要书名号与引号）；image 是英文画面描述（字符串，报纸插画风格，不含任何文字）。"
        input: "今天是 " + today_text() + "。\n本期晨报导语：" + intro + "\n今日入选标题（按重要性排序）：\n" + lines + "\n请为这一期设计头版：headline 写一句英文大标题，概括今天最重要的主题；subtitle 写一句中文副标题，给中文读者一句话的抓手；image 写一句英文画面描述，用来画头版主图。"
        schema: cover_shape
        class: "strong"
        allow_urls: true
    }, fn(r){
        let good = false
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.headline != nil && r.data.output.image != nil { good = true }
        if good {
            cover_head = "" + r.data.output.headline
            cover_sub = ""
            if r.data.output.subtitle != nil { cover_sub = art_cut("" + r.data.output.subtitle, 44) }
            if cover_sub == "" { cover_sub = cover_fallback_sub() }
            if trail.len() > 0 {
                let cv = trail["cover"]
                cv["headline"] = cover_head
                cv["subtitle"] = cover_sub
                cv["state"] = "ok"
                trail["cover"] = cv
                trail_save()
            }
            cover_q = "front page newspaper editorial illustration, " + r.data.output.image + ", bold iconic composition, dramatic but tasteful, 16:9, no text, no letters, no watermark"
            cover_state = "drawing"
            cover_note = "头版标语已定，正在画头版主图…"
            cover_wait = 40
            sync_ui()
            start_timeout(0.05, || cover_draw())
        } else {
            cover_fallback()
        }
    })
}

fn cover_fallback(){
    let t = ""
    let i = 0
    for r in picked {
        if i == 0 { t = r.title }
        i = i + 1
    }
    if t == "" { t = "今天的科技新闻" }
    cover_head = art_cut(t, 56)
    cover_sub = cover_fallback_sub()
    cover_q = "front page newspaper editorial illustration ABOUT THIS STORY: " + art_cut(t, 300) + " -- iconic front page art, dramatic but tasteful, 16:9, no text, no letters, no watermark"
    cover_state = "drawing"
    cover_note = "视觉主编这次没答复，已按头条标题兜底画头版"
    cover_wait = 40
    sync_ui()
    start_timeout(0.05, || cover_draw())
}

fn cover_draw(){
    let u = photo_take(cover_q)
    if u == nil || u == "" {
        // 与配图同理：宿主带 MiniMax 时头版主图是后台画的，给它一段时间。
        if cover_wait > 0 {
            cover_wait = cover_wait - 1
            cover_state = "drawing"
            sync_ui()
            start_timeout(0.8, || cover_draw())
            return
        }
        cover_state = "failed"
        cover_note = "这次没能画出头版图，文字内容不受影响。"
        sync_ui()
        return
    }
    let pic = ("" + u).trim()
    if art_is_photo(pic) == false {
        cover_state = "failed"
        cover_note = "这次没能画出头版图，文字内容不受影响。"
        sync_ui()
        return
    }
    cover_seed = cover_seed + 1
    if art_mm_url(pic) { cover_url = pic } else { cover_url = pic + "&seed=" + cover_seed }
    cover_mm = art_mm_url(pic)
    cover_on = true
    cover_state = "ok"
    cover_note = "视觉主编头版"
    cover_save()
    sync_ui()
}

fn cover_retry(){
    if cover_q == "" {
        cover_fallback()
        return
    }
    cover_state = "drawing"
    cover_note = "正在重画头版，请稍等…"
    cover_wait = 40
    sync_ui()
    start_timeout(0.05, || cover_draw())
}

// ---- 工作台的开关与分区 ----
// 三合一之后只有一个浮层：咕嘎工作台。
//   分区 0 对话：说话 + 咕嘎对话（原来的主编面板与「说话」胶囊）
//   分区 1 干活：总结/头版/画像/台账/回放 + 问新闻 + 直接指挥 + 形体（原来的主编台）
//   分区 2 档案：按时间找往期晨报、收藏往期
// ---- 工作台的开关与分区 ----
// 三合一之后只有一个浮层：咕嘎工作台。
//   分区 0 对话：说话 + 咕嘎对话（原来的主编面板与「说话」胶囊）
//   分区 1 干活：总结/头版/画像/台账/回放 + 问新闻 + 直接指挥 + 形体（原来的主编台）
//   分区 2 档案：按时间找往期晨报、收藏往期
fn wb_open(i){
    ag_open = true
    wb_tab = i
    if ag_open { pet_line = "" }
    pet_dodge_wb()
    // 直接开在「往期」分区时，同 wb_pick：先把留存下来的最近几期摆出来。
    if i == 2 && wb_arc_res.len() == 0 && issues.len() > 0 { wb_quick("") return }
    sync_ui()
}

fn vf_story_who(){
    // 到底跟谁对上了 —— 光说「有人跟着报」不够，把渠道名字写出来才可核。
    // 这里按**渠道**列（Hacker News / TechMeme / 少数派…），不按原文媒体域名：
    // 读者真正想知道的是「还有谁也在报」，而不是「这条链接指向哪家网站」。
    if story == nil { return "" }
    if vf_state != "ok" && vf_state != "local" { return "" }
    let ns = vf_peers_dom(story, "")
    if ns.len() == 0 { return "" }
    let line = ""
    let k = 0
    for h in ns {
        if k >= 3 { break }
        if k > 0 { line = line + " · " }
        line = line + vf_ch_show(h)
        k = k + 1
    }
    if ns.len() > 3 { line = line + " 等 " + ns.len() + " 家" }
    "另有 " + ns.len() + " 家不同渠道在报同一件事：" + line
}

