    "意图：只要 " + topics_line() + " 相关，" + limit + " 条以内"
}

fn ai_line(){
    if ai_ready == -1 { return "正在检查咕嘎…" }
    if ai_ready == 0 { return "没接上 AI 模型服务（本机没有可用的 AI 供应商配置）。仍可按主题筛选。" }
    "已接上「" + ai_model + "」，可由它挑选重点。"
}

fn ai_sum_line(){
    if phase == "fetching" { return "正在取数 · 官方 net 能力" }
    if ai_on { return "咕嘎 · 主编 · 用时 " + seconds_text(ai_ms) + " · " + ai_tokens + " tokens" }
    if ai_state == "failed" { return "离线模式：咕嘎没有答复，已按你勾选的主题做规则筛选" }
    if ai_state == "restored" { return "这是上次由咕嘎挑出的晨报" }
    "离线模式：没有调用 AI，按你勾选的主题做规则筛选"
}

fn ai_note_line(){
    if ai_note != "" { return ai_note }
    ""
}

fn src_line(){
    "取用 " + sources_line() + " · 上限 " + limit + " 条"
}

fn pipe_text(){
    if phase == "fetching" { return "官方能力 · 取数 net.http_request · 正在跑" + "\n" + "接下来交给咕嘎（主编 · model.complete）挑选重点" }
    if ai_state == "restored" { return "上次结果 · 本次没有重新取数" }
    let l1 = "官方能力 · 取数 net.http_request · 候选 " + cand_n + " 条"
    let l2 = "官方能力 · 主编 model.complete · 选 " + picked.len() + " 条 · 落地 fs.write"
    if !ai_on { l2 = "官方能力 · 规则兜底筛选 · 选 " + picked.len() + " 条 · 落地 fs.write" }
    l1 + "\n" + l2
}

fn judge_line(){
    if panel_state == "asking" { return "初审编辑部 · " + roles.len() + " 个角度正在独立阅读 " + cand_n + " 条候选…" }
    if panel_state == "done" { return "主编终审 · 正在参考三位编辑的意见挑出重点…" }
    "咕嘎正在读 " + cand_n + " 条候选标题，挑选重点并写理由…"
}

fn panel_head(){
    if panel.len() < roles.len() { return "初审编辑部 · 已交回 " + panel.len() + " / " + roles.len() + " 份意见" }
    "初审编辑部 · " + roles.len() + " 个角度交回意见"
}

fn panel_ok_count(){
    let n = 0
    for p in panel { if p.state == "ok" { n = n + 1 } }
    n
}

fn plan_way(){
    if ai_ready == 0 { return "规则筛选（咕嘎不可用）" }
    "咕嘎挑选 + 规则兜底"
}

fn ask_text(){
    if ai_ready == 0 { return "点「暂不」就什么都不会发生。" }
    "点「暂不」就什么都不会发生。"
}

fn status_line(){
    if phase == "fetching" { return "正在获取 " + src_n() + " 个来源…" }
    if phase == "judging" { return "咕嘎正在判断…" }
    if phase == "done" {
        // 成败只看「这次勾选并真取到了几家」，不看失败名单长度 ——
        // 两者口径一旦混用，就会出现「取用 3 家」同时标题写「未能获取任何来源」的自相矛盾。
        if ok_sources.len() == 0 { return "未能获取任何来源。" }
        if failed.len() > 0 { return "部分完成 · " + ok_sources.len() + " 家取到 / " + src_n() + " 家" }
        return "已完成 · " + ok_sources.len() + " 家来源全部取到"
    }
    ""
}

fn fail_line(){
    if failed.len() == 0 { return "" }
    let out = "未取到："
    for f in failed {
        if out != "未取到：" { out = out + "、" }
        out = out + f.label
        if f.why != "" { out = out + "（" + f.why + "）" }
    }
    if ok_sources.len() == 0 { return out + "（这次一家都没取到，下面是规则筛选能做的部分）" }
    out + "（其余来源结果如下，条数未补齐）"
}

fn empty_line(){
    if phase == "fetching" { return "正在获取…" }
    if phase == "judging" { return "咕嘎正在判断…" }
    if ok_sources.len() == 0 { return "无法获取任何来源。" }
    if ai_on && picked.len() == 0 { return "咕嘎认为今天没有值得进入晨报的条目 — 这是判断结果，不是获取失败。" }
    "未找到符合「" + topics_line() + "」的条目 — 这是筛选结果，不是获取失败。"
}

fn stale_line(){
    if picked.len() > 0 { return "" }
    if last_rows.len() == 0 { return "" }
    if ok_sources.len() == 0 { return "这次没能取到任何来源，下面是上次成功取到的晨报" }
    "下面是上次生成的晨报，想换新的就回到首屏重新生成"
}

fn show_rows(){
    if picked.len() > 0 { return picked }
    if ok_sources.len() == 0 && last_rows.len() > 0 { return last_rows }
    if phase == "done" && last_rows.len() > 0 { return last_rows }
    []
}

fn hn_id(r){
    // 字段读一律走 r["key"]：直接写 r.discussion 在字段缺失时会抛错，
    // 把调用它的整段 sync_ui 打断 —— 存档行（issue_rows_safe 归一的形状）
    // 与测试数据都可能缺这个字段，正是本项目反复踩过的那个坑。
    let d = r["discussion"]
    if d == nil { return "" }
    let ds = "" + d
    if ds == "" { return "" }
    let parts = ds.split("=")
    if parts.len() < 2 { return "" }
    parts[1]
}

fn story_key(link){
    if link == nil { return "" }
    let parts = link.split("#")
    if parts.len() < 2 { return "" }
    parts[1].strip_prefix("a")
}

fn link_host(u){
    if u == nil { return "" }
    let parts = u.split("/")
    if parts.len() < 3 { return u }
    parts[2]
}

fn story_rows(){
    show_rows()
}

fn story_pos(){
    if story == nil { return "" }
    let rows = story_rows()
    let k = 0
    let i = -1
    for r in rows {
        if r.id == story.id { i = k }
        k = k + 1
    }
    if i < 0 { return "" }
    let n = i + 1
    "第 " + n + " / " + rows.len() + " 条"
}

fn story_state_line(){
    if story_state == "loading" { return "正在打开这条新闻的官方页面…" }
    if story_state == "ai" { return "咕嘎正在读这条新闻…" }
    if story_state == "fail" { return story_err }
    if story_ms > 0 { return "AI 解读完成 · 用时 " + seconds_text(story_ms) }
    ""
}

