// ===== 线索时间轴 · 这条线索本报是从哪一步听到的 =====
//   stage 由信源等级映射而来，不是对事件本身的判断：
//     一手 → 已确认（官方口径）；二手 → 跟进中（媒体转述）；传闻/转载 → 爆料
//   本期入选条目与本报档案里同主题的上一条比较，升级或降级都记一笔。
let th_up = []

// ===== 落选公开 · 被砍掉的也让人看见 =====
let drop = []

// ===== 出报链路留痕 · 让这一期可以被复盘，而不只是被审问 =====
//   到目前为止，这份报已经能被「审问」（断言 / 更正 / 口径 / 落选四条台账），
//   但还不能被「复盘」：读者看不到编辑部当时到底看了什么、谁说了什么、主编为什么这么取舍。
//   新闻业需要可审计，而 AI 新闻产品现在几乎全是黑盒 —— 这里就是把过程摊开。
//   四样东西：候选池（原始条数 / 入池条数 / 标题）、三位初审的原始意见、
//   主编终审的原话、以及当时照着哪版提示词编的。
//   全部是本地数据，零额外 LLM 调用（都是本来就要落盘的东西）。
let trail = {}
let trail_msg = ""

// 本期留痕的骨架。approve() 里初始化，各处逐步填。
fn trail_begin(){
    trail = {
        ts: time_now()
        date: today_text()
        charter: {}
        pool: {scanned: 0 cand: 0 titles: []}
        panel: []
        judge: {model: "" ms: 0 intro: "" picks: [] drops: []}
        fore: {model: "" ms: 0 items: []}
        fact: {clashes: 0 fixes: 0 note: ""}
        cover: {headline: "" state: ""}
        result: {picked: 0 refused: false}
    }
    // 记下这一期照着哪版提示词编的 —— 出事能倒推
    for c in charter { trail["charter"][c.id] = c.v }
}

fn trail_set_pool(n, cn, rows){
    if trail.len() == 0 { return }
    trail["pool"]["scanned"] = n
    trail["pool"]["cand"] = cn
    let t = []
    let i = 0
    for r in rows {
        if i < 20 { t.push({t: r.title tier: tier_label(r)}) }
        i = i + 1
    }
    trail["pool"]["titles"] = t
}

fn trail_set_panel(id, label, votes, digest, ms){
    if trail.len() == 0 { return }
    let p = trail["panel"]
    p.push({id: id label: label votes: votes digest: digest ms: ms})
    trail["panel"] = p
}

fn trail_set_judge(model, ms, intro, rows, dl){
    if trail.len() == 0 { return }
    let j = trail["judge"]
    j["model"] = model
    j["ms"] = ms
    j["intro"] = intro
    let ps = []
    for r in rows {
        let wy = reason_of(r.id)
        ps.push({title: r.title why: wy})
    }
    j["picks"] = ps
    j["drops"] = dl
    trail["judge"] = j
}

fn trail_save(){
    if trail.len() == 0 { return }
    let box = []
    if fs.exists("trail.json") {
        let v = fs.read("trail.json").parse_json()
        if v != nil {
            let it = v["items"]
            if it != nil { box = it }
        }
    }
    // 同一期会被写多次（终审后落一次、封面和核对回来各补一次），
    // 按日期合并：同一天的旧记录丢掉，只留最新最全的那一份。
    let today = "" + trail["date"]
    let kept = []
    for e in box {
        let d = e["date"]
        let ds = ""
        if d != nil { ds = "" + d }
        if ds != today { kept.push(e) }
    }
    kept.push(trail)
    // 只留最近三期 —— 留痕是为了复盘，不是为了囤积
    while kept.len() > 3 { kept.remove(0) }
    fs.write("trail.json", {schema: 1 saved_at: time_now() items: kept}.to_json())
    trail_msg = "这一期的出报过程已留痕（trail.json），共 " + ("" + kept.len()) + " 期可复盘"
}

fn trail_load(){
    if !fs.exists("trail.json") { return }
    let v = fs.read("trail.json").parse_json()
    if v == nil { return }
    let it = v["items"]
    if it == nil { return }
    let n = it.len()
    if n == 0 { return }
    trail_msg = "本报留了 " + ("" + n) + " 期的出报过程可复盘"
}

// 给主编看的留痕摘要
fn trail_text(){
    if !fs.exists("trail.json") {
        return "还没有出过报，没有可回放的过程。"
    }
    let v = fs.read("trail.json").parse_json()
    if v == nil { return "留痕文件读不出来。" }
    let it = v["items"]
    if it == nil { return "留痕文件是空的。" }
    let n = it.len()
    if n == 0 { return "还没有出过报，没有可回放的过程。" }
    let out = "本报留了 " + ("" + n) + " 期可复盘"
    let last = it[n - 1]
    let j = last["judge"]
    if j != nil {
        let jm = s_of(j, "model")
        let jms = s_of(j, "ms")
        if jm != "" { out = out + "。最近一期终审用 " + jm }
        if jms != "" { out = out + "，耗时 " + jms + " 毫秒" }
    }
    let ch = last["charter"]
    if ch != nil {
        let vv = s_of(ch, "judge")
        if vv != "" { out = out + "，照 judge/" + vv + " 版规矩取舍" }
    }
    out = out + "。要逐项看候选池、三位初审的原话和主编取舍，用 read_trail。"
    out
}

// 回放页：把最近一期摊开
fn replay_text(){
    if !fs.exists("trail.json") { return "" }
    let v = fs.read("trail.json").parse_json()
    if v == nil { return "" }
    let it = v["items"]
    if it == nil { return "" }
    let n = it.len()
    if n == 0 { return "" }
    let t = it[n - 1]
    // 如果当前这一期就是最新一期，用内存里的（更及时）
    if trail.len() > 0 && trail["date"] == t["date"] { t = trail }
    let out = "第 " + ("" + n) + " 期 · " + ("" + t["date"]) + " 的出报过程"
    let ch = t["charter"]
    if ch != nil {
        let vj = ch["judge"]
        let vfc = ch["factcheck"]
        let vs = "judge " + ("" + vj) + " · factcheck " + ("" + vfc)
        out = out + "\n照着的规矩：" + vs
    }
    out = out + "\n" + replay_pool_line()
    out = out + "\n" + replay_panel_line()
    out = out + "\n" + replay_judge_line()
    out
}

fn replay_pool_line(){
    let t = replay_now()
    if t.len() == 0 { return "" }
    let p = t["pool"]
    if p == nil { return "" }
    let sc = p["scanned"]
    let cd = p["cand"]
    "取数：" + ("" + sc) + " 条原始 → " + ("" + cd) + " 条入池（淘汰率见工作量卡）"
}

fn replay_panel_line(){
    let t = replay_now()
    if t.len() == 0 { return "" }
    let pn = t["panel"]
    if pn == nil { return "初审：这一期没有留痕" }
    let out = "三位初审各自的原话（互不商量）："
    for p in pn {
        let lb = s_of(p, "label")
        let dg = s_of(p, "digest")
        if dg == "" { dg = "（这位编辑这次没有留下点评）" }
        out = out + "\n· " + lb + "：" + dg
    }
    out
}

// 安全取字符串：字段缺失或类型不对时返回空串，绝不把 nil 拼进 art_cut
// （本项目历史上踩过「JSON 缺字段直接取属性会抛错」的坑，这里统一走这个口）
fn s_of(o, k){
    if o == nil { return "" }
    let v = o[k]
    if v == nil { return "" }
    "" + v
}

fn replay_judge_line(){
    let t = replay_now()
    if t.len() == 0 { return "" }
    let res = t["result"]
    let refused = false
    if res != nil {
        let rv = res["refused"]
        if rv != nil { if rv { refused = true } }
    }
    let j = t["judge"]
    if j == nil { return "" }
    let out = "主编终审原话："
    let intro = j["intro"]
    if refused {
        // 拒刊那期没有导语，intro 存的是主编的拒刊理由
        out = "主编决定：今日休刊"
        if intro != nil && intro != "" { out = out + "\n理由：" + art_cut("" + intro, 90) }
        out = out + "\n（本期没有出报，读者可以用「仍要出报」否决这个决定）"
        return out
    }
    if intro != nil && intro != "" { out = out + "\n导语：" + art_cut("" + intro, 90) }
    let ps = j["picks"]
    if ps != nil {
        let i = 1
        for p in ps {
            out = out + "\n" + ("" + i) + ". " + art_cut(s_of(p, "title"), 40)
            let wy = s_of(p, "why")
            if wy != "" { out = out + "\n　为什么上：" + art_cut(wy, 50) }
            i = i + 1
        }
    }
    let dl = j["drops"]
    if dl != nil && dl.len() > 0 {
        for d in dl {
            out = out + "\n砍：" + art_cut(s_of(d, "title"), 36)
            let wy = s_of(d, "why")
            if wy != "" { out = out + " —— " + art_cut(wy, 40) }
        }
    }
    out
}

// 取「最近一期」的留痕对象（优先内存里正在跑的这一期）
fn replay_now(){
    if trail.len() > 0 { return trail }
    if !fs.exists("trail.json") { return {} }
    let v = fs.read("trail.json").parse_json()
    if v == nil { return {} }
    let it = v["items"]
    if it == nil { return {} }
    let n = it.len()
    if n == 0 { return {} }
    it[n - 1]
}


// 域名匹配：先判相等，再判「.域名」结尾。
// 这个 DSL 没有 ends_with，所以只能靠 search("." + d) 来模拟后缀判断；
// 好处是 netflix.com 不会被误判成 x.com。
fn dom_hit(h, d){
    if h == d { return true }
    if h.len() <= d.len() { return false }
    h.search("." + d) >= 0
}

fn tier_of_h(h){
    if h == "" { return "repost" }
    for d in tier_rumor { if dom_hit(h, d) { return "rumor" } }
    for d in tier_repost { if dom_hit(h, d) { return "repost" } }
    for d in tier_first { if dom_hit(h, d) { return "first" } }
    for d in tier_second { if dom_hit(h, d) { return "second" } }
    "second"
}

fn row_host(r){
    let l = r["link"]
    if l == nil { return "" }
    let s = "" + l
    if s == "" { return "" }
    link_host(s)
}

fn tier_of(r){
    tier_of_h(row_host(r))
}

fn tier_label(r){
    let t = tier_of(r)
    if t == "first" { return "一手" }
    if t == "second" { return "二手" }
    if t == "rumor" { return "传闻·未证实" }
    "转载"
}

// 计入本期信源构成
fn tier_add(r){
    let t = tier_of(r)
    if t == "first" { tier_mix["first"] = tier_mix["first"] + 1 return }
    if t == "rumor" { tier_mix["rumor"] = tier_mix["rumor"] + 1 return }
    if t == "repost" { tier_mix["repost"] = tier_mix["repost"] + 1 return }
    tier_mix["second"] = tier_mix["second"] + 1
}

fn tier_tally(rows){
    tier_mix = {first: 0 second: 0 rumor: 0 repost: 0}
    for r in rows { tier_add(r) }
}

// 本期信源构成一行
fn tier_line(){
    if work_cand == 0 { return "" }
    let f = "" + tier_mix["first"]
    let s = "" + tier_mix["second"]
    let m = "" + tier_mix["rumor"]
    let p = "" + tier_mix["repost"]
    "本期信源：一手 " + f + " · 二手 " + s + " · 传闻 " + m + " · 转载 " + p
}

// 本期淘汰率一行：读者该知道编辑部到底看了多少、扔了多少
fn work_line(){
    if work_n == 0 { return "" }
    let kept = show_rows().len()
    let drop = work_n - kept
    if drop < 0 { drop = 0 }
    let pct = floor(kept * 100 / work_n)
    "" + work_n + " 条里见报 " + kept + " 条，淘汰率 " + (100 - pct) + "%"
}

// =====================================================================
// 线索的三段旅程 · 一条消息是怎么走到「确认」的
//   注意：stage 说的是「本报这次是从什么成色的渠道听到的」，不是对事实
//   本身的判定。一手渠道进来就是「已确认」，社交平台进来就是「爆料」。
//   同一个主题上，上一期和本期的 stage 不一样，就说明线索往前走了。
// =====================================================================
fn stage_of(r){
    let t = tier_of(r)
    if t == "first" { return "confirm" }
    if t == "second" { return "follow" }
    "lead"
}

fn stage_label(s){
    if s == "confirm" { return "已确认" }
    if s == "follow" { return "跟进中" }
    "爆料"
}

fn stage_rank(s){
    if s == "confirm" { return 3 }
    if s == "follow" { return 2 }
    1
}


fn fetch(url){
    let p = promise()
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {}}) do net.HttpEvents{
        on_response: |res| p.resolve(res)
        on_error: |_err| p.resolve(nil)
    }
    p
}

fn hn_rows(body){
    let out = []
    let data = body.parse_json()
    if data == nil || data.hits == nil { return out }
    for hit in data.hits {
        // 缺字段的读法是「先取键，再判空」：直接 hit.title 在缺键时会抛错，
        // 整轮取数会卡死（HN 的 Ask HN 类帖子天生没有 url）。
        let title = hit["title"]
        if title == nil { continue }
        title = "" + title
        if title == "" { continue }
        let oid = hit["objectID"]
        if oid == nil { continue }
        oid = "" + oid
        let discussion = "https://news.ycombinator.com/item?id=" + oid
        let link = discussion
        let u = hit["url"]
        if u != nil && u != "" { link = "" + u }
        let published = 0
        let pi = hit["created_at_i"]
        if pi != nil { published = pi }
        out.push({id: "hn-" + oid title: title link: link source: "Hacker News" published: published
            summary: "" image: "" discussion: discussion points: hit["points"] comments: hit["num_comments"]})
    }
    out
}

fn feed_rows(body, s){
    let items = body.parse_feed(s.kind)
    if items == nil { return nil }
    let out = []
    for i it in items {
        let itt = it["title"]
        if itt == nil || itt == "" { continue }
        let source = it["source"]
        if source == nil || source == "" { source = s.label }
        let published = 0
        let pu = it["published"]
        if pu != nil { published = pu }
        out.push({id: s.id + "-" + i title: it.title link: it.link source: source published: published
            summary: it.summary image: it.image discussion: "" points: nil comments: nil})
    }
    out
}

fn clean_html(raw){
    if raw == nil || raw == "" { return "" }
    let doc = raw.parse_html()
    let ps = doc.query("p").array()
    if ps.len() == 0 { return doc.text.trim() }
    let out = ""
    for p in ps {
        let t = p.text.trim()
        if t != "" {
            if out != "" { out = out + "\n" }
            out = out + t
        }
    }
    out
}

fn load_source(s){
    let rows = nil
    try {
        let res = fetch(s.url).await()
        if res == nil || res.status_code >= 400 || res.body == nil {
            failed.push(s.label)
            return
        }
        let body = res.body.to_string()
        if s.kind == "hn" { rows = hn_rows(body) } else { rows = feed_rows(body, s) }
    } catch err {
        failed.push(s.label)
        return
    }
    if rows == nil || rows.len() == 0 {
        failed.push(s.label)
        return
    }
    ok_sources.push({label: s.label n: rows.len()})
    for r in rows { all_rows.push(r) }
}

fn topic_hit(t, title){
    if regex(t.en, "i").test(title) { return true }
    regex(t.zh, "i").test(title)
}

fn topic_on(id){
    if id == "ai" { return chosen["ai"] }
    if id == "oss" { return chosen["oss"] }
    if id == "sec" { return chosen["sec"] }
    chosen["chip"]
}

fn row_hit(title){
    let n = 0
    for t in topics { if topic_on(t.id) { n = n + 1 } }
    if n == 0 { return true }
    for t in topics {
        if topic_on(t.id) && topic_hit(t, title) { return true }
    }
    false
}

fn sort_desc(rows){
    let out = []
    for r in rows {
        let placed = false
        let next = []
        for o in out {
            if !placed && r.published > o.published {
                next.push(r)
                placed = true
            }
            next.push(o)
        }
        if !placed { next.push(r) }
        out = next
    }
    out
}

fn already(rows, id){
    for r in rows { if r.id == id { return true } }
    false
}

fn reason_of(id){
    for w in ai_whys { if w.id == id { return w.why } }
    ""
}

fn pad2(n){
    // 数字拼串必须先转成文本：直接 "0" + n 会在运行时中断整段渲染。
    let t = "" + n
    if n < 10 { return "0" + t }
    t
}

fn gen_time(){
    if finished_at <= 0 { return "尚未生成" }
    let t = local_time(time_now() + 28800)
    days[t.weekday] + " " + months[t.month - 1] + " " + t.day + "  " + pad2(t.hour) + ":" + pad2(t.minute)
}

fn today_text(){
    let t = local_time(time_now() + 28800)
    months[t.month - 1] + " " + t.day
}

// 报头上的期号：这是本报出到第几期（数字拼串必须先转文本再拼）
fn issue_text(){
    let n = pf_briefs + 1
    let t = "" + n
    "第 " + t + " 期"
}

fn ago(secs){
    if secs == nil || secs <= 0 { return "" }
    let d = time_now() - secs
    if d < 60 { return "just now" }
    if d < 3600 { return "" + floor(d / 60) + "m ago" }
    if d < 86400 { return "" + floor(d / 3600) + "h ago" }
    "" + floor(d / 86400) + "d ago"
}

// 纯函数：只由下标算编号。绝不能在渲染循环里再遍历 show_rows()——
// 那会打断外层迭代，列表只会渲染出第一行。
fn rank_text(i){
    pad2(i + 1)
}

fn row_meta(r){
    let line = tier_label(r) + "  ·  " + r.source
    let a = ago(r.published)
    if a != "" { line = line + "  ·  " + a }
    let p = r["points"]
    if p != nil { line = line + "  ·  " + p + " 热度" }
    let c = r["comments"]
    if c != nil { line = line + "  ·  " + c + " 条讨论" }
    line
}

fn row_sum(r){
    let s = r["summary"]
    if s == nil { return "" }
    s
}

fn row_img(r){
    let v = r["image"]
    if v == nil { return "" }
    if v.len() < 12 { return "" }
    if v.search("http") != 0 { return "" }
    v
}

fn seconds_text(ms){
    if ms <= 0 { return "" }
    "" + (floor(ms / 100) / 10) + " 秒"
}

fn topics_line(){
    let out = ""
    for t in topics {
        if topic_on(t.id) {
            if out != "" { out = out + "、" }
            out = out + t.label
        }
    }
    if out == "" { return "未选主题（全部放行）" }
    out
}

fn hosts_line(){
    let out = ""
    for s in sources {
        if out != "" { out = out + "、" }
        out = out + s.host
    }
    out
}

fn sources_line(){
    if ok_sources.len() == 0 { return "无" }
    let out = ""
    for s in ok_sources {
        if out != "" { out = out + " · " }
        out = out + s.label + " " + s.n + " 条"
    }
    out
}

fn intent_preview(){
    if ask != "" { return "意图：" + ask }
    "意图：只要 " + topics_line() + " 相关，" + limit + " 条以内"
}

fn ai_line(){
    if ai_ready == -1 { return "正在检查 AI 主编…" }
    if ai_ready == 0 { return "没接上 AI（这台机器没有配置模型钥匙）。仍可按主题筛选。" }
    "已接上「" + ai_model + "」，可由它挑选重点。"
}

fn ai_sum_line(){
    if phase == "fetching" { return "正在取数 · 官方 net 能力" }
    if ai_on { return "AI 主编 · " + ai_model + " · 用时 " + seconds_text(ai_ms) + " · " + ai_tokens + " tokens" }
    if ai_state == "failed" { return "离线模式：AI 主编没有答复，已按你勾选的主题做规则筛选" }
    if ai_state == "restored" { return "这是上次由 AI 主编挑出的晨报" }
    "离线模式：没有调用 AI，按你勾选的主题做规则筛选"
}

fn ai_note_line(){
    if ai_note != "" { return ai_note }
    ""
}

fn src_line(){
    "取用 " + sources_line() + " · 上限 " + limit + " 条"
}

fn pipe_text(){
    if phase == "fetching" { return "官方能力 · 取数 net.http_request · 正在跑" + "\n" + "接下来交给 AI 主编（llm.chat）挑选重点" }
    if ai_state == "restored" { return "上次结果 · 本次没有重新取数" }
    let l1 = "官方能力 · 取数 net.http_request · 候选 " + cand_n + " 条"
    let l2 = "官方能力 · 主编 llm.chat · 选 " + picked.len() + " 条 · 落地 fs.write"
    if !ai_on { l2 = "官方能力 · 规则兜底筛选 · 选 " + picked.len() + " 条 · 落地 fs.write" }
    l1 + "\n" + l2
}

fn judge_line(){
    if panel_state == "asking" { return "初审编辑部 · " + roles.len() + " 个角度正在独立阅读 " + cand_n + " 条候选…" }
    if panel_state == "done" { return "主编终审 · 正在参考三位编辑的意见挑出重点…" }
    "AI 编辑部正在阅读 " + cand_n + " 条候选标题，挑选重点并写理由…"
}

fn panel_head(){
    if panel.len() < roles.len() { return "初审编辑部 · 已交回 " + panel.len() + " / " + roles.len() + " 份意见" }
    "初审编辑部 · " + roles.len() + " 个角度交回意见"
}

fn panel_ok_count(){
    let n = 0
    for p in panel { if p.state == "ok" { n = n + 1 } }
    n
}

fn plan_text(){
    let out = "操作计划\n"
    for s in sources { out = out + "  · " + s.label + " — " + s.note + "\n" }
    out + "候选范围：按发布时间取最近 " + pool + " 条\n" + "判断方式：" + plan_way() + "\n" + "排序：由 AI 主编按重要性排序（离线时按发布时间）"
}

fn plan_way(){
    if ai_ready == 0 { return "规则筛选（AI 主编不可用）" }
    "AI 主编挑选 + 规则兜底"
}

fn ask_text(){
    if ai_ready == 0 { return "点「暂不」就什么都不会发生。" }
    "点「暂不」就什么都不会发生。"
}

fn status_line(){
    if phase == "fetching" { return "正在获取 " + sources.len() + " 个来源…" }
    if phase == "judging" { return "AI 主编正在判断…" }
    if phase == "done" {
        if failed.len() == 0 { return "已完成。" }
        if failed.len() < sources.len() { return "部分完成。" }
        return "未能获取任何来源。"
    }
    ""
}

fn fail_line(){
    if failed.len() == 0 { return "" }
    let out = "失败来源："
    for f in failed {
        if out != "失败来源：" { out = out + "、" }
        out = out + f
    }
    if failed.len() == sources.len() { return out + "（全部失败）" }
    out + "（其余来源结果如下，条数未补齐）"
}

fn empty_line(){
    if phase == "fetching" { return "正在获取…" }
    if phase == "judging" { return "AI 主编正在判断…" }
    if failed.len() == sources.len() { return "无法获取任何来源。" }
    if ai_on && picked.len() == 0 { return "AI 主编认为今天没有值得进入晨报的条目 — 这是判断结果，不是获取失败。" }
    "未找到符合「" + topics_line() + "」的条目 — 这是筛选结果，不是获取失败。"
}

fn stale_line(){
    if picked.len() > 0 { return "" }
    if last_rows.len() == 0 { return "" }
    if failed.len() == sources.len() { return "这次没能取到任何来源，下面是上次成功取到的晨报" }
    "下面是上次生成的晨报，想换新的就回到首屏重新生成"
}

fn show_rows(){
    if picked.len() > 0 { return picked }
    if failed.len() == sources.len() && last_rows.len() > 0 { return last_rows }
    if phase == "done" && last_rows.len() > 0 { return last_rows }
    []
}

fn hn_id(r){
    if r.discussion == nil || r.discussion == "" { return "" }
    let parts = r.discussion.split("=")
    if parts.len() < 2 { return "" }
    parts[1]
}

fn story_key(link){
    if link == nil { return "" }
    let parts = link.split("#")
    if parts.len() < 2 { return "" }
    parts[1].strip_prefix("a")
}

fn link_host(u){
    if u == nil { return "" }
    let parts = u.split("/")
    if parts.len() < 3 { return u }
    parts[2]
}

fn story_rows(){
    show_rows()
}

fn story_pos(){
    if story == nil { return "" }
    let rows = story_rows()
    let k = 0
    let i = -1
    for r in rows {
        if r.id == story.id { i = k }
        k = k + 1
    }
    if i < 0 { return "" }
    let n = i + 1
    "第 " + n + " / " + rows.len() + " 条"
}

fn story_state_line(){
    if story_state == "loading" { return "正在打开这条新闻的官方页面…" }
    if story_state == "ai" { return "AI 编辑部正在读这条新闻…" }
    if story_state == "fail" { return story_err }
    if story_ms > 0 { return "AI 解读完成 · 用时 " + seconds_text(story_ms) }
    ""
}

fn story_more_head(){
    if story_more.len() == 0 { return "" }
    "媒体报道 · 另有 " + story_more.len() + " 家也在跟进"
}

fn story_more_text(){
    if story_more.len() == 0 { return "" }
    let out = ""
    let i = 0
    for m in story_more {
        if i < 8 {
            if out != "" { out = out + "\n" }
            out = out + "· " + m.name + "  " + link_host(m.url)
        }
        i = i + 1
    }
    let rest = story_more.len() - 8
    if rest > 0 { out = out + "\n· 还有 " + rest + " 家" }
    out
}

fn story_cmt_head(){
    if story_comments.len() == 0 { return "" }
    "网友在讨论什么 · 已取到 " + story_comments.len() + " 条"
}

fn story_cmt_text(){
    if story_comments.len() == 0 { return "" }
    let out = ""
    for c in story_comments {
        if out != "" { out = out + "\n\n" }
        out = out + c.author + "：" + c.text
    }
    out
}

fn story_url_text(){
    if story == nil { return "" }
    if hn_id(story) != "" { return story.link }
    story.link.split("#")[0]
}

fn story_src_text(){
    if story == nil { return "" }
    if hn_id(story) != "" { return "这篇报道来自 " + story.source + "，讨论发生在 Hacker News。" }
    "这条由 TechMeme 收录，来源是 " + story.source + "。"
}

fn story_ai_ask(){
    let sid = story.id
    let body = "标题：" + story_title
    if story_sum != "" { body = body + "\n概述：" + story_sum }
    if story_more.len() > 0 { body = body + "\n另有 " + story_more.len() + " 家媒体在跟进这条消息。" }
    if story_comments.len() > 0 {
        body = body + "\n网友讨论：\n"
        let i = 0
        for c in story_comments {
            if i < 4 { body = body + "- " + c.author + "：" + c.text + "\n" }
            i = i + 1
        }
    }
    host.request("llm.chat", {
        system: "[编辑部宪法 story/" + charter_v("story") + "]
你是一位科技晨报的解读编辑，读者是关心科技行业但不懂技术的普通人。用中文回答，写成两段共三到五句话，不要用任何符号排版，不要罗列，不要重复标题原文。第一段说清这件事到底发生了什么，第二段说清它为什么值得关心。如果给了网友讨论，最后点一句大家在争论什么。"
        prompt: body
        temperature: 0.3
        max_tokens: 700
        label: "brief.story"
    }, fn(r){
        if r.is_ok && r.data != nil && r.data.text != nil && r.data.text != "" {
            story_ai = r.data.text.trim()
            story_state = "ok"
            story_ms = r.data.elapsed_ms
        } else {
            story_state = "fail"
            story_err = "AI 这次没有答复，上面几块是官方页面里的原文。"
        }
        sync_ui()
    })
}

fn story_ai_go(){
    if story_state != "loading" { return }
    story_state = "ai"
    sync_ui()
    story_ai_ask()
}

fn story_finish(){
    if story_state == "loading" { story_ai_go() }
}

fn load_story_comments(){
    let hid = hn_id(story)
    let url = "https://hn.algolia.com/api/v1/items/" + hid
    let res = fetch(url).await()
    if res != nil && res.status_code < 400 && res.body != nil {
        let d = res.body.to_string().parse_json()
        if d != nil && d.children != nil {
            let n = 0
            for c in d.children {
                if n < 6 {
                    if c.text != nil && c.text != "" {
                        let who = c.author
                        if who == nil || who == "" { who = "匿名" }
                        story_comments.push({author: who text: clean_html(c.text)})
                    }
                    n = n + 1
                }
            }
        }
    } else {
        story_err = "没能取到这条讨论，页面上的其他内容仍然可用。"
    }
    story_finish()
}

fn load_story_page(){
    let key = story_key(story.link)
    let parts = story.link.split("#")
    let base = parts[0]
    let res = fetch(base).await()
    if res != nil && res.status_code < 400 && res.body != nil {
        let doc = res.body.to_string().parse_html()
        let blk = doc.query("div#" + key)
        let ii = blk.query("div.ii").array()
        if ii.len() > 0 {
            let raw = ii[0].text.trim()
            let parts = raw.split("—")
            if parts.len() > 1 { story_sum = parts[1].trim() } else { story_sum = raw }
        }
        let links = blk.query("span.bls a").array()
        for a in links {
            let href = a.attr("href")
            if href != nil && href != "" { story_more.push({name: a.text.trim() url: href}) }
        }
        sync_ui()
    } else {
        story_err = "没能打开这条新闻的官方页面，下面只有列表里已有的信息。"
    }
    story_finish()
}

// 看门狗：官方页面抓取可能很慢（境外站点），不能让阅读页一直停在「正在打开」。
// 到点还没落地就直接进入 AI 解读，界面上说明官方原文这次没取到。
fn story_watch(left){
    if story_state != "loading" { return }
    if left <= 0 {
        story_err = "这次没能及时取到官方页面，下面是列表里已有的信息和 AI 解读。"
        story_finish()
        sync_ui()
        return
    }
    start_timeout(1.0, || story_watch(left - 1))
}

fn load_story(){
    if story == nil { return }
    story_state = "loading"
    start_timeout(1.0, || story_watch(12))
    if hn_id(story) != "" { load_story_comments() } else { load_story_page() }
}

fn art_is_photo(u){
    let s = u.trim()
    if s == "" { return false }
    if s.search("http") != 0 { return false }
    if art_has(s, "$[") { return false }
    true
}

fn art_has(s, part){
    if s.search(part) >= 0 { return true }
    false
}

fn art_clean(t){
    let s = t
    let bad = ["—" "–" "’" "‘" "“" "”" "…"]
    let good = ["-" "-" "'" "'" "\"" "\"" "."]
    let i = 0
    for b in bad {
        s = s.replace(b, good[i])
        i = i + 1
    }
    s
}

fn art_cached_for(id){
    let hit = ""
    for c in art_cache {
        if c.id == id { hit = c.url }
    }
    hit
}

fn art_put(id, url){
    let hit = -1
    let k = 0
    for c in art_cache {
        if c.id == id { hit = k }
        k = k + 1
    }
    if hit >= 0 { art_cache.remove(hit) }
    art_cache.push({id: id url: url})
    if art_cache.len() > 20 { art_cache.remove(0) }
}

fn photo_take(q){
    let raw = sys.photo(q)
    if raw == nil { return "" }
    let s = "" + raw
    if art_has(s, "%") { return s }
    if art_has(s, " ") == false { return s }
    s.url_encode()
}

fn art_take_shot(){
    let r = photo_take(art_q)
    r
}

fn art_ready(){
    art_busy = false
    let t0 = time_now()
    let u = art_take_shot()
    if u == nil || u == "" {
        art_note = "这次没能画出配图，文字内容不受影响。"
        sync_ui()
        return
    }
    let pic = ("" + u).trim()
    if art_is_photo(pic) == false {
        let small = pic
        if small.len() > 60 { small = art_cut(small, 60) }
        art_note = "这次没能画出配图，文字内容不受影响。"
        art_pick[0] = small
        sync_ui()
        return
    }
    art_seed = art_seed + 1
    art_url = pic + "&seed=" + art_seed
    art_on = true
    art_ms = time_now() - t0
    art_note = "AI 配图已就绪"
    art_put(story.id, art_url)
    art_save()
    sync_ui()
}

fn art_save(){
    let pack = []
    for c in art_cache {
        pack.push({id: c.id url: c.url})
    }
    fs.write("art_cache.json", {schema: 1 saved_at: time_now() items: pack}.to_json())
}

fn art_go(){
    if story == nil { return }
    if art_q == "" { return }
    if art_pending == art_q {
        if art_url != "" { art_on = true art_note = "配图已就绪" sync_ui() }
        return
    }
    art_pending = art_q
    art_on = false
    art_url = ""
    art_ms = 0
    art_busy = true
    art_note = "正在为这条消息画一张配图"
    sync_ui()
    let cache = art_cached_for(story.id)
    if cache != "" {
        art_url = cache
        art_on = true
        art_busy = false
        art_cached = 1
        art_note = "这条消息的配图来自本机缓存"
        sync_ui()
        return
    }
    art_cached = 0
    start_timeout(0.05, || art_ready())
}

fn art_where(){
    let first = ""
    let i = 0
    for p in art_pick {
        if i == 0 { first = p }
        i = i + 1
    }
    first
}

fn art_kick(){
    if story == nil { return }
    art_q = art_prompt()
    art_go()
}

fn art_prompt(){
    let raw = story_title
    let cut = raw.search(" - ")
    if cut > 8 { raw = raw.split(" - ")[0] }
    let cut2 = raw.search(" | ")
    if cut2 > 8 { raw = raw.split(" | ")[0] }
    if raw.len() > 400 { raw = art_cut(raw, 400) }
    "editorial news illustration ABOUT THIS STORY: " + raw + " -- dramatic but tasteful newspaper art, 16:9, no text, no letters, no watermark"
}

// 截到 n 个字符。
// 不能用 to_chars()：它给的是每个字的代码点（数字），拼起来会变成一串数字，
// 语音合成就会把「中文」念成「2001325991」。split("") 给的是单字符本身。
// （另注意：字符串的 .len() 是字节数，不是字数。）
fn art_cut(s, n){
    let out = ""
    let k = 0
    for c in s.split("") {
        if c != "" {
            if k < n { out = out + c }
            k = k + 1
        }
    }
    out
}

fn art_off(){
    art_busy = false
    art_on = false
    art_url = ""
    art_note = "已收起配图，只保留文字内容"
    sync_ui()
}

fn art_retry(){
    if story == nil { return }
    if art_q == "" { art_q = art_prompt() }
    if art_q == "" { return }
    art_pending = art_q
    art_on = false
    art_url = ""
    art_ms = 0
    art_cached = 0
    art_busy = true
    art_note = "正在为这条消息重新画一张配图"
    sync_ui()
    start_timeout(0.05, || art_ready())
}

fn art_wait_line(){
    if art_on { return "官方画图能力按这条消息的标题即时生成" }
    if art_note != "" { return art_note }
    return "这条消息也可以配一张图"
}

fn art_line(){
    if art_note == "" { return "" }
    if art_cached == 1 { return art_note }
    if art_url == "" { return art_note }
    "AI 配图 · 官方画图能力按标题即时生成 · 图片在后台下载"
}

fn open_story(r){
    story = r
    story_title = r.title
    story_meta = row_meta(r)
    story_sum = r["summary"]
    if story_sum == nil { story_sum = "" }
    story_more = []
    story_comments = []
    story_ai = ""
    story_ms = 0
    story_err = ""
    story_state = "loading"
    phase = "story"
    art_q = ""
    art_pending = ""
    art_url = ""
    art_on = false
    art_ms = 0
    art_cached = 0
    art_note = ""
    // 画像 + 记忆：读过什么、这条和往期哪几条是一条线索
    pf_watch(r)
    arc_rel = arc_rel_for(r)
    sync_ui()
    start_timeout(0.05, || load_story())
    start_timeout(0.60, || art_kick())
}

fn close_story(){
    story = nil
    story_state = ""
    art_q = ""
    art_pending = ""
    art_url = ""
    art_on = false
    art_note = ""
    phase = "done"
    sync_ui()
}

fn story_step(d){
    if story == nil { return }
    let rows = story_rows()
    let k = 0
    let i = -1
    for r in rows {
        if r.id == story.id { i = k }
        k = k + 1
    }
    if i < 0 { return }
    let j = i + d
    if j < 0 || j >= rows.len() { return }
    open_story(rows[j])
}


// =====================================================================
// 语音层 · 主编说得出、听得见（宿主语音服务：llm.speech / speak / listen_*）
// =====================================================================
fn vc_probe(){
    host.request("llm.speech", {}, fn(r){
        if r.is_ok && r.data != nil {
            let tts = r.data["tts"]
            if tts != nil {
                // 注意：不能在 splash 里用 `ok` 当变量名，它是保留字。
                let tv = tts["available"]
                if tv != nil {
                    if tv { vc_tts = true } else { vc_tts = false }
                }
                let vs = tts["voices"]
                if vs != nil { vc_voices = vs.len() }
            }
            let stt = r.data["stt"]
            if stt != nil {
                let sv = stt["available"]
                if sv != nil {
                    if sv { vc_stt = true } else { vc_stt = false }
                }
            }
        }
        if vc_tts && vc_stt { vc_note = "主编能说话，也能听见你" }
        else if vc_tts { vc_note = "主编能说话；这台机器没有可用的语音识别，打字一样用" }
        else { vc_note = "这台机器没有可用的语音能力，全程打字也算数" }
        sync_ui()
    })
}

fn vc_say_now(text){
    if !vc_tts { return }
    let t = art_cut(text, 150)
    if t == "" { return }
    host.request("llm.speak", {text: t lang: "zh-CN"}, fn(r){})
}

// 自动朗读只在「对主编说过话」的时候出声，不打搅只想看报的人。
fn vc_say(text){
    if !vc_auto { return }
    vc_say_now(text)
}

fn vc_toggle(){
    if vc_listen { vc_stop() }
    else { vc_start() }
}

fn vc_toggle_auto(){
    vc_auto = !vc_auto
    if vc_auto { vc_note = "主编回复时会自动念出来" }
    else { vc_note = "自动朗读已关，只显示文字" }
    sync_ui()
}

fn vc_mic_text(){
    if vc_listen { return "■ 正在听" }
    "🎙 说话"
}

fn vc_caps(){
    ag_caps_line()
}

fn vc_start(){
    if !vc_stt {
        vc_note = "这台机器没有可用的语音识别，先用文字对我说"
        sync_ui()
        return
    }
    vc_partial = ""
    vc_heard = ""
    vc_note = "正在打开麦克风…"
    sync_ui()
    host.request("llm.listen_start", {language: "zh-CN"}, fn(r){
        if r.is_ok {
            vc_listen = true
            vc_note = "我在听，说完点「停」或者直接说「就这样」"
            sync_ui()
            start_timeout(0.4, || vc_poll_go())
        } else {
            vc_note = "麦克风打不开：" + r.error
            sync_ui()
        }
    })
}

fn vc_stop(){
    vc_listen = false
    vc_note = "麦克风已关上"
    sync_ui()
    host.request("llm.listen_stop", {}, fn(r){})
}

fn vc_poll_go(){
    if !vc_listen { return }
    host.request("llm.listen_poll", {}, fn(r){
        if r.is_ok && r.data != nil {
            let evs = r.data["events"]
            if evs != nil {
                for e in evs {
                    let kv = e["kind"]
                    let k = ""
                    if kv != nil { k = "" + kv }
                    let tv = e["text"]
                    let t = ""
                    if tv != nil { t = "" + tv }
                    if k == "partial" {
                        vc_partial = t
                        vc_note = "听到：" + t
                    }
                    if k == "final" && t != "" {
                        vc_partial = ""
                        vc_heard = t
                        vc_listen = false
                        vc_note = "已听到：" + t
                        vc_last_voice = true
                        if !ag_open { ag_open = true }
                        // 插话：先停下朗读队列，再把手里的活交出去。
                        // 队列不清空，所以读者说完还能从这一句接着往下念。
                        if rv_on { rv_stop() }
                        ag_say(t)
                    }
                    if k == "error" {
                        vc_note = "语音识别停了：" + t
                        vc_listen = false
                    }
                    if k == "ended" && vc_listen {
                        vc_listen = false
                        vc_note = "这一轮听完了"
                    }
                }
            }
            let live = r.data["live"]
            if live != nil && live == false && vc_listen {
                vc_listen = false
                vc_note = "这一轮听完了"
            }
            sync_ui()
        }
        if vc_listen { start_timeout(0.4, || vc_poll_go()) }
        else { host.request("llm.listen_stop", {}, fn(r2){}) }
    })
}

// 播放状态回读：让「正在说」这件事在界面上看得见（也用来验证语音真的在走）
fn vc_speak_check(left){
    if left <= 0 { return }
    host.request("llm.speaking", {}, fn(r){
        if r.is_ok && r.data != nil {
            let p = r.data["playing"]
            let s = r.data["seconds"]
            let playing = false
            if p != nil { if p { playing = true } }
            if playing {
                let sv = ""
                if s != nil { sv = "" + s }
                vc_note = "主编正在说话…（这一轮约 " + sv + " 秒）"
                sync_ui()
                start_timeout(0.9, || vc_speak_check(left - 1))
            } else {
                vc_note = "已经念完了"
                sync_ui()
            }
        }
    })
}

// =====================================================================
// 读者画像 · 这份报只为一个人编（存在 profile.json，不上传）
// =====================================================================
fn pf_bump(id){
    let out = []
    for t in pf_t {
        let n = t.n
        if t.id == id { n = n + 1 }
        out.push({id: t.id n: n})
    }
    pf_t = out
}

fn pf_watch(r){
    for t in topics {
        if topic_hit(t, r.title) { pf_bump(t.id) }
    }
    pf_opens = pf_opens + 1
    pf_save()
}

fn pf_save(){
    fs.write("profile.json", {schema: 1 briefs: pf_briefs opens: pf_opens notes: pf_notes t: pf_t saved_at: time_now()}.to_json())
}

fn pf_load(){
    if fs.exists("profile.json") {
        let v = fs.read("profile.json").parse_json()
        if v != nil {
            let b = v["briefs"]
            if b != nil { pf_briefs = b }
            let o = v["opens"]
            if o != nil { pf_opens = o }
            let n = v["notes"]
            if n != nil { pf_notes = n }
            let t = v["t"]
            if t != nil { if t.len() > 0 { pf_t = t } }
        }
    }
}

fn pf_note_add(s){
    if s == "" { return }
    pf_notes.push(s)
    if pf_notes.len() > 12 { pf_notes.remove(0) }
    pf_save()
}

fn pf_notes_line(){
    if pf_notes.len() == 0 { return "还没有" }
    let out = ""
    let i = 0
    for x in pf_notes {
        if i > 0 { out = out + "；" }
        out = out + x
        i = i + 1
    }
    out
}

fn pf_n(id){
    for t in pf_t { if t.id == id { return t.n } }
    0
}

fn pf_label(id){
    // pf_t 里只存 id 和次数；标签要去 topics 里按 id 取。
    for t in topics { if t.id == id { return t.label } }
    id
}

fn pf_focus_short(){
    let out = ""
    for t in pf_t {
        if t.n > 0 {
            if out != "" { out = out + "、" }
            out = out + pf_label(t.id)
        }
    }
    out
}

// 给编辑部看的一行画像：它决定今天的取舍偏向谁
fn pf_focus(){
    let out = ""
    for t in pf_t {
        if t.n > 0 {
            if out != "" { out = out + "、" }
            out = out + pf_label(t.id) + " " + t.n + " 次"
        }
    }
    if out == "" { return "这位读者还没有明显偏好，按大众都会关心的标准选" }
    "这位读者最近常读：" + out
}

fn pf_view_line(){
    if pf_briefs == 0 && pf_opens == 0 { return "" }
    let out = "读者画像 · 已出报 " + pf_briefs + " 期"
    if pf_opens > 0 { out = out + " · 读过 " + pf_opens + " 条" }
    let f = pf_focus_short()
    if f != "" { out = out + " · 常读 " + f }
    if pf_notes.len() > 0 { out = out + " · 记着你的 " + pf_notes.len() + " 条偏好" }
    out
}

// =====================================================================
// 本地知识库 · 本报自己的记忆：往期报道存在 archive.json，检索不联网
// =====================================================================
fn arc_date(){
    let t = local_time(time_now() + 28800)
    pad2(t.month) + "-" + pad2(t.day)
}

fn arc_add(rows){
    let d = arc_date()
    for r in rows {
        let s = r["summary"]
        if s == nil { s = "" }
        arc.push({ts: time_now() date: d id: r.id title: r.title source: r.source sum: art_cut(s, 90) stage: stage_of(r)})
    }
    if arc.len() > 240 {
        let keep = []
        let k = 0
        let n = arc.len()
        for e in arc {
            if k >= n - 240 { keep.push(e) }
            k = k + 1
        }
        arc = keep
    }
    arc_save()
}

fn arc_save(){
    fs.write("archive.json", {schema: 1 saved_at: time_now() items: arc}.to_json())
}

fn arc_load(){
    if fs.exists("archive.json") {
        let v = fs.read("archive.json").parse_json()
        if v != nil {
            let items = v["items"]
            if items != nil { arc = items }
        }
    }
}

// 关键词检索：按空格拆词，全部命中才算（AND）。纯本地，无网络。
fn arc_find(q){
    let out = []
    let s = q.trim()
    if s == "" {
        let n = arc.len()
        let k = 0
        for e in arc {
            if k >= n - 6 { out.push(e) }
            k = k + 1
        }
        return out
    }
    let words = s.split(" ")
    for e in arc {
        let hay = e.title
        let sm = e["sum"]
        if sm != nil { hay = hay + " " + sm }
        let hit = true
        let used = 0
        for w in words {
            let ww = w.trim()
            if ww != "" {
                used = used + 1
                if hay.search(ww) < 0 { hit = false }
            }
        }
        if hit && used > 0 { out.push(e) }
    }
    out
}

fn topic_of(id){
    for t in topics { if t.id == id { return t } }
    nil
}

// 这条新闻命中的主题，本报过去报过哪几条（追一条线索）
fn arc_rel_for(r){
    let ids = []
    for t in topics {
        if topic_hit(t, r.title) { ids.push(t.id) }
    }
    let out = []
    if ids.len() == 0 { return out }
    for e in arc {
        if e.id != r.id {
            if out.len() < 3 {
                let hit = false
                for i in ids {
                    let t = topic_of(i)
                    if t != nil && topic_hit(t, e.title) { hit = true }
                }
                if hit { out.push(e) }
            }
        }
    }
    out
}

fn arc_rel_text(){
    let out = ""
    let i = 0
    for e in arc_rel {
        if i > 0 { out = out + "\n" }
        out = out + "· " + e.date + "　" + e.title
        i = i + 1
    }
    out
}

fn arc_hits_text(){
    if arc_hits.len() == 0 { return "档案里没有相关的往期报道。" }
    let out = "本报档案里找到 " + arc_hits.len() + " 条相关："
    let n = arc_hits.len()
    let i = 0
    for e in arc_hits {
        if i >= n - 6 { out = out + "\n· " + e.date + "　" + e.title }
        i = i + 1
    }
    out
}

fn arc_line(){
    if arc.len() == 0 { return "" }
    "本报记忆 " + arc.len() + " 条"
}

// 这条新闻在本报档案里的上一条同主题记录（没有就返回 nil）
fn th_prev(r){
    let out = nil
    for e in arc {
        if e.id != r.id {
            let hit = false
            for t in topics {
                if topic_hit(t, r.title) && topic_hit(t, e.title) { hit = true }
            }
            if hit { out = e }
        }
    }
    out
}

// 出报时扫一遍：哪些线索今天往前走了，哪些退了回去
// 必须在 arc_add 之前调用 —— 否则本期条目会把自己当成「上一条」。
fn th_scan(rows){
    th_up = []
    for r in rows {
        let s = stage_of(r)
        let sr = stage_rank(s)
        let prev = th_prev(r)
        if prev != nil {
            let pv = prev["stage"]
            if pv != nil {
                let ps = "" + pv
                let pr = stage_rank(ps)
                if pr != sr {
                    if th_up.len() < 3 {
                        th_up.push({title: r.title to_label: stage_label(s) prev_label: stage_label(ps) date: prev.date up: sr > pr})
                    }
                }
            }
        }
    }
}

fn th_count(){
    th_up.len()
}

// 纯函数：只由下标取。渲染循环里绝不能再遍历 th_up，那会打断外层迭代。
fn th_text(i){
    if i >= th_up.len() { return "" }
    let e = th_up[i]
    let t = art_cut(e.title, 24)
    if e.up {
        return "· " + t + "\n  " + e.date + " 本报听到它时还只是「" + e.prev_label + "」，今天到了「" + e.to_label + "」"
    }
    "· " + t + "\n  " + e.date + " 本报手上是「" + e.prev_label + "」，今天只有「" + e.to_label + "」级渠道在说"
}

fn th_line(){
    if th_up.len() == 0 { return "" }
    "本报追的线索 · 今天有 " + ("" + th_up.len()) + " 条进展"
}

// =====================================================================
// 预测性晨报 · 主编为自己说过的话负责
//   出报时公开押下三条「一周内可验证」的判断；下一期取数后自动回访对账，
//   说中就记一分，说错也记一分。所有记录存 forecast.json，只在本机。
// =====================================================================
let fc_shape = {type: "object" required: ["items"] properties: {items: {type: "array" items: {type: "object" required: ["text" "watch"] properties: {text: {type: "string"} watch: {type: "string"}}}} claims: {type: "array" items: {type: "string"}}}}
let fc_check_shape = {type: "object" required: ["results"] properties: {results: {type: "array" items: {type: "object" required: ["i" "verdict" "note"] properties: {i: {type: "integer"} verdict: {type: "string"} note: {type: "string"}}}}}}

fn fc_load(){
    if fs.exists("forecast.json") {
        let v = fs.read("forecast.json").parse_json()
        if v != nil {
            let o = v["open"]
            if o != nil { fc_open = o }
            let d = v["done"]
            if d != nil { fc_hist = d }
            let h = v["hit"]
            if h != nil { fc_hit = h }
            let m = v["miss"]
            if m != nil { fc_miss = m }
        }
    }
}

fn fc_save(){
    fs.write("forecast.json", {schema: 1 saved_at: time_now() open: fc_open done: fc_hist hit: fc_hit miss: fc_miss}.to_json())
}

// 战绩一行：对账过多少条、说中几条、手上还押着几条
fn fc_review_line(){
    let total = fc_hit + fc_miss
    let ws = "" + fc_open.len()
    if total == 0 {
        if fc_open.len() == 0 { return "" }
        return "主编战绩：还没有可对账的记录，手上押着 " + ws + " 条"
    }
    let ts = "" + total
    let hs = "" + fc_hit
    "主编战绩：" + ts + " 条已对账，说中 " + hs + " 条 · 手上还押着 " + ws + " 条"
}

// 第 i 条预测（纯函数，越界返回空串，供渲染循环里安全调用）
fn fc_line(i){
    if i >= fc_items.len() { return "" }
    let it = fc_items[i]
    let tv = it["text"]
    if tv == nil { return "" }
    let t = "" + tv
    if t == "" { return "" }
    let n = i + 1
    let head = "" + n
    let out = head + ". " + t
    let wv = it["watch"]
    if wv != nil {
        let w = "" + wv
        if w != "" { out = out + "\n  看点：" + w }
    }
    out
}

// 最近三条对账结果（说中 / 说错）
fn fc_hist_text(){
    if fc_hist.len() == 0 { return "" }
    let n = fc_hist.len()
    let i = 0
    let out = "上一期的对账结果"
    for h in fc_hist {
        if i >= n - 3 {
            let mv = h["verdict"]
            let mark = "还没到点"
            if mv != nil {
                let sv = "" + mv
                if sv == "hit" { mark = "说中了" }
                if sv == "miss" { mark = "说错了" }
            }
            let tv = h["text"]
            let st = ""
            if tv != nil { st = "" + tv }
            out = out + "\n· [" + mark + "] " + st
            let nn = h["note"]
            if nn != nil {
                let sn = "" + nn
                if sn != "" { out = out + "\n  " + sn }
            }
        }
        i = i + 1
    }
    out
}

fn fc_fallback(){
    fc_items = []
    fc_state = "off"
    fc_note = "这次没能拿定主意，主编没有押注"
    sync_ui()
}

// 出报后：让主编公开押三条可验证的预测
fn fc_kick(){
    if picked.len() == 0 { return }
    fc_items = []
    fc_state = "asking"
    fc_note = "主编正在写下三条可以验证的预测…"
    sync_ui()
    if ai_ready != 1 { fc_fallback() return }
    let lines = ""
    let i = 1
    for r in picked {
        if i < 9 { lines = lines + "" + i + ". " + r.title + "\n" }
        i = i + 1
    }
    let intro = ai_intro
    if intro == "" { intro = "这一期没有导语" }
    host.request("llm.chat", {
        system: "[编辑部宪法 forecast/" + charter_v("forecast") + "]
你是科技晨报的主编，现在要做两件事。第一，在报纸上公开发表三条预测：每一条都是未来一周内可以被事实检验的具体判断，不是模棱两可的评论，也不是对已发生事情的复述；text 是一句中文预测，不超过 40 字，watch 是一句验证口径，说清看到什么就算说中。第二，把这一期报到的三到五条硬事实记进 claims（每项一句中文，尽量带上具体数字、公司名或版本号）—— 那是本报自己的台账，下一期要拿它对账，所以只写你在本期标题里确实看到的，不要推测、不要补充。直接输出一个 JSON 对象，第一个字符就是 {，不要任何思考过程。"
        prompt: "今天是 " + today_text() + "。\n本期导语：" + intro + "\n今日入选标题：\n" + lines + "\n请给出三条预测，并把本期报到的硬事实记进 claims。"
        as_json: true
        temperature: 0.4
        max_tokens: 900
        schema: fc_shape
        label: "brief.forecast"
    }, fn(r){
        let good = false
        if r.is_ok && r.data != nil && r.data.data != nil && r.data.data.items != nil { good = true }
        if !good { fc_fallback() return }
        fc_items = []
        let k = 0
        for it in r.data.data.items {
            if k < 3 {
                let tx = it["text"]
                let wt = it["watch"]
                let t2 = ""
                if tx != nil { t2 = "" + tx }
                let w2 = ""
                if wt != nil { w2 = "" + wt }
                if t2 != "" {
                    fc_items.push({text: t2 watch: w2})
                    let stamp = "" + time_now()
                    let kn = "" + k
                    fc_open.push({id: "fc-" + stamp + "-" + kn date: today_text() text: t2 watch: w2})
                }
                k = k + 1
            }
        }
        if fc_items.len() == 0 { fc_fallback() return }
        claims_new = []
        let cw = r.data.data.claims
        if cw != nil {
            let ck = 0
            for c in cw {
                if ck < 5 {
                    let cs = "" + c
                    if cs != "" { claims_new.push(cs) }
                    ck = ck + 1
                }
            }
        }
        claim_save()
        claims_open = claims_new
        fc_state = "ok"
        fc_note = "主编押了 " + fc_items.len() + " 条，下一期自己回来对账"
        fc_save()
        if trail.len() > 0 {
            let fo = trail["fore"]
            fo["model"] = "" + ai_model
            fo["items"] = fc_items
            trail["fore"] = fo
            trail_save()
        }
        sync_ui()
    })
}

// 回访：拿今天取到的新标题，给上一期押下的预测对账
fn fc_review(){
    if fc_open.len() == 0 { return }
    if cand.len() == 0 { return }
    if ai_ready != 1 { return }
    fc_state = "checking"
    fc_note = "主编正在回访上一期押下的预测…"
    sync_ui()
    let plist = ""
    let i = 0
    for f in fc_open {
        if i < 6 {
            let isn = "" + i
            let ft = ""
            let fv = f["text"]
            if fv != nil { ft = "" + fv }
            let fw = ""
            let wv = f["watch"]
            if wv != nil { fw = "" + wv }
            plist = plist + isn + ". " + ft + "（看到「" + fw + "」算说中）\n"
        }
        i = i + 1
    }
    let tlist = ""
    let j = 0
    for r in cand {
        if j < 16 { tlist = tlist + "" + j + ". " + r.title + "\n" }
        j = j + 1
    }
    host.request("llm.chat", {
        system: "[编辑部宪法 forecast/" + charter_v("forecast") + "]
你是晨报主编，正在为自己上一期公开发表的预测对账。逐条判断：今天的新标题里已经有明确证据支持它 = hit；已经有明确证据推翻它 = miss；还在进行中、或今天完全没有相关信息 = open。不要勉强下结论，没有证据就老实说 open。note 是一句中文说明，不超过 30 字。直接输出一个 JSON 对象，第一个字符就是 {。"
        prompt: "待对账的预测：\n" + plist + "\n今天取到的新标题：\n" + tlist + "\n请逐条给出 verdict（只能是 hit / miss / open）和 note。"
        as_json: true
        temperature: 0
        max_tokens: 1200
        schema: fc_check_shape
        label: "brief.forecast.check"
    }, fn(r){
        let good = false
        if r.is_ok && r.data != nil && r.data.data != nil && r.data.data.results != nil { good = true }
        if !good {
            fc_state = "ok"
            fc_note = "这一期没能对上账，下一期再试"
            sync_ui()
            return
        }
        let results = r.data.data.results
        let kept = []
        let done = []
        let k = 0
        let h = fc_hit
        let m = fc_miss
        for f in fc_open {
            let v = "open"
            let nn = "还没有可以作证的报道"
            for res in results {
                let iv = res["i"]
                if iv != nil {
                    if iv == k {
                        let vv = res["verdict"]
                        if vv != nil {
                            let sv = "" + vv
                            if sv == "hit" || sv == "miss" { v = sv }
                        }
                        let nv = res["note"]
                        if nv != nil {
                            let sn = "" + nv
                            if sn != "" { nn = sn }
                        }
                    }
                }
            }
            if v == "hit" {
                h = h + 1
                done.push({id: f.id date: f.date text: f.text watch: f.watch verdict: "hit" note: nn})
            } else if v == "miss" {
                m = m + 1
                done.push({id: f.id date: f.date text: f.text watch: f.watch verdict: "miss" note: nn})
            } else {
                kept.push(f)
            }
            k = k + 1
        }
        fc_open = kept
        for d in done { fc_hist.push(d) }
        if fc_hist.len() > 60 {
            let keep = []
            let c = 0
            let ln = fc_hist.len()
            for e in fc_hist {
                if c >= ln - 60 { keep.push(e) }
                c = c + 1
            }
            fc_hist = keep
        }
        fc_hit = h
        fc_miss = m
        fc_state = "ok"
        fc_note = fc_review_line()
        fc_save()
        sync_ui()
    })
}

// =====================================================================
// 核对 · 今天的说法有没有打架，上一期说过的有没有错
//   一次调用做两件事，因为本质是同一件事：把两批文本摆在一起找出对不上的
//   地方。同期比对挑出「口径不一致」，跨期比对挑出「我说错了」。
//   宁可真话难听：没有就老实返回空数组，不许为了有东西而凑数。
// =====================================================================
let fact_shape = {type: "object" required: ["clashes" "fixes"] properties: {clashes: {type: "array" items: {type: "object" required: ["a" "b" "note"] properties: {a: {type: "integer"} b: {type: "integer"} note: {type: "string"}}}} fixes: {type: "array" items: {type: "object" required: ["i" "note"] properties: {i: {type: "integer"} note: {type: "string"}}}}}}

// 把序号映射成下标：用计数比较，不直接拿它当索引。
// 这样即便宿主把 integer 返回成字符串，也只是匹配不上（-1），不会中断渲染。
fn idx_in(v, list, n){
    let out = -1
    let i = 0
    for z in list {
        if z != nil {
            if i < n { if v != nil { if v == i { out = i } } }
        }
        i = i + 1
    }
    out
}

fn ledger_load(){
    if fs.exists("claims.json") {
        let v = fs.read("claims.json").parse_json()
        if v != nil {
            let it = v["items"]
            if it != nil { claims_open = it }
        }
    }
    if fs.exists("fixlog.json") {
        let v = fs.read("fixlog.json").parse_json()
        if v != nil {
            let fn2 = v["fix_n"]
            if fn2 != nil { fix_total = fn2 }
            let cn = v["clash_n"]
            if cn != nil { clash_total = cn }
        }
    }
}

fn claim_save(){
    fs.write("claims.json", {schema: 1 date: today_text() items: claims_new}.to_json())
}

fn fact_save(){
    let items = []
    if fs.exists("fixlog.json") {
        let v = fs.read("fixlog.json").parse_json()
        if v != nil {
            let it = v["items"]
            if it != nil { items = it }
        }
    }
    for f in fix { items.push(f) }
    if items.len() > 60 {
        let keep = []
        let c = 0
        let ln = items.len()
        for e in items {
            if c >= ln - 60 { keep.push(e) }
            c = c + 1
        }
        items = keep
    }
    fs.write("fixlog.json", {schema: 1 saved_at: time_now() fix_n: fix_total clash_n: clash_total items: items}.to_json())
}

fn fact_fallback(){
    clash = []
    fix = []
    clash_state = "off"
    clash_note = "今天没能静下来核对一遍说法"
    sync_ui()
}

fn fact_kick(){
    clash = []
    fix = []
    if cand.len() < 2 { clash_state = "off" clash_note = "" return }
    if ai_ready != 1 { fact_fallback() return }
    claims_check = claims_open
    clash_state = "asking"
    clash_note = "主编正在把今天的说法摆在一起核一遍…"
    sync_ui()
    let tlist = ""
    let i = 0
    for r in cand {
        if i < 16 { tlist = tlist + "" + i + ". [" + tier_label(r) + "] " + r.title + "\n" }
        i = i + 1
    }
    let clist = ""
    let k = 0
    for c in claims_check {
        if k < 6 { clist = clist + "" + k + ". " + c + "\n" }
        k = k + 1
    }
    if clist == "" { clist = "（上一期没有留下待核对的硬事实：fixes 请返回空数组）" }
    host.request("llm.chat", {
        system: "[编辑部宪法 factcheck/" + charter_v("factcheck") + "]
你是晨报主编，正在做两件核对工作，都要对自己狠一点。\n① clashes：今天的候选标题里，如果有两条讲的是同一件事、但关键数字或说法对不上（出货量、金额、日期、版本号、结论），把这一对挑出来，a 和 b 是候选序号，note 用一句中文说清分歧在哪、两边各是什么。如果没有任何两条指向同一件事，或者说法并不冲突，就返回空数组 —— 不要为了有东西而硬凑。\n② fixes：把上一期留下的硬事实与今天的新标题逐一比对。只有今天出现了明确证据推翻它的，才挑出来记一条，i 是事实序号，note 用一句中文说清新的说法是什么。今天没有消息、只是没被提到、或者略有出入但算不上推翻，一律不算，不要输出。\n直接输出一个 JSON 对象，第一个字符就是 {，不要任何思考过程。"
        prompt: "今天是 " + today_text() + "。\n\n今天的候选标题（核对它们之间有没有互相矛盾的说法）：\n" + tlist + "\n上一期本报记下的硬事实（核对是否被今天推翻）：\n" + clist + "\n请给出 clashes 与 fixes 两个数组。"
        as_json: true
        temperature: 0
        max_tokens: 1400
        schema: fact_shape
        label: "brief.factcheck"
    }, fn(r){
        let good = false
        if r.is_ok && r.data != nil && r.data.data != nil { good = true }
        if !good { fact_fallback() return }
        clash = []
        let cw = r.data.data.clashes
        if cw != nil {
            let n = 0
            for c in cw {
                if n < 2 {
                    let ai = idx_in(c["a"], cand, cand.len())
                    let bi = idx_in(c["b"], cand, cand.len())
                    if ai >= 0 && bi >= 0 && ai != bi {
                        let nt = ""
                        let nv = c["note"]
                        if nv != nil { nt = "" + nv }
                        let ra = cand[ai]
                        let rb = cand[bi]
                        clash.push({a: ra.title b: rb.title ta: tier_label(ra) tb: tier_label(rb) note: nt})
                        n = n + 1
                    }
                }
            }
        }
        fix = []
        let fw = r.data.data.fixes
        if fw != nil {
            let m = 0
            for f in fw {
                if m < 3 {
                    let fi = idx_in(f["i"], claims_check, claims_check.len())
                    if fi >= 0 {
                        let nt = ""
                        let nv = f["note"]
                        if nv != nil { nt = "" + nv }
                        fix.push({date: today_text() claim: claims_check[fi] note: nt})
                        m = m + 1
                    }
                }
            }
        }
        clash_total = clash_total + clash.len()
        fix_total = fix_total + fix.len()
        clash_state = "ok"
        let cs = "" + clash.len()
        let fs2 = "" + fix.len()
        if clash.len() > 0 && fix.len() > 0 {
            clash_note = "今天有 " + cs + " 处口径打架，" + fs2 + " 条旧说法要更正"
        } else if clash.len() > 0 {
            clash_note = "今天有 " + cs + " 处口径打架"
        } else if fix.len() > 0 {
            clash_note = "今天要对上一期的 " + fs2 + " 条说法作更正"
        } else {
            clash_note = "今天没有发现口径打架，上一期也没有需要更正的说法"
        }
        if trail.len() > 0 {
            let ft = trail["fact"]
            ft["clashes"] = clash_total
            ft["fixes"] = fix_total
            ft["note"] = clash_note
            trail["fact"] = ft
            trail_save()
        }
        fact_save()
        sync_ui()
    })
}

fn clash_count(){ clash.len() }
fn fix_count(){ fix.len() }

fn clash_line(i){
    if i >= clash.len() { return "" }
    let c = clash[i]
    let a = art_cut("" + c.a, 30)
    let b = art_cut("" + c.b, 30)
    "" + c.note + "\n一边（" + c.ta + "）：" + a + "\n另一边（" + c.tb + "）：" + b
}

fn fix_line(i){
    if i >= fix.len() { return "" }
    let f = fix[i]
    "【上一期】" + art_cut("" + f.claim, 48) + "\n【今天】" + art_cut("" + f.note, 48)
}

// 更正台账：这是本报最不该藏起来的一页
fn ledger_text(){
    let items = []
    if fs.exists("fixlog.json") {
        let v = fs.read("fixlog.json").parse_json()
        if v != nil {
            let it = v["items"]
            if it != nil { items = it }
        }
    }
    if items.len() == 0 && clash_total == 0 {
        return "本报还没有更正记录，也没有发现过口径打架。目前为止报过的，都还担着。"
    }
    let out = "本报更正台账：累计更正 " + ("" + fix_total) + " 条 · 发现口径不一致 " + ("" + clash_total) + " 次"
    let n = items.len()
    let i = 0
    for e in items {
        if i >= n - 5 {
            let c = e["claim"]
            let nt = e["note"]
            let sc = ""
            if c != nil { sc = "" + c }
            out = out + "\n· " + e.date + "　" + art_cut(sc, 40)
            if nt != nil {
                let sn = "" + nt
                if sn != "" { out = out + "\n  → " + art_cut(sn, 40) }
            }
        }
        i = i + 1
    }
    out
}

// =====================================================================
// L1 感知层 · 主编眼里的这个程序
// =====================================================================
fn ag_phase_name(){
    if phase == "intent" { return "首页（还没开始）" }
    if phase == "asking" { return "出报前的一问（你在问读者今天更想看哪个角度，等他答 A 或 B）" }
    if phase == "plan" { return "待批准页（取数计划写好了，等用户说批不批）" }
    if phase == "judging" { return "编辑部初审中（三个视角在独立阅读候选）" }
    if phase == "fetching" { return "正在联网取数并终审" }
    if phase == "done" { return "结果页（这一期晨报已经出来）" }
    if phase == "story" { return "阅读页（正在读一条新闻）" }
    if phase == "refused" { return "主编拒刊页（信源太薄，你拒绝出报，等读者决定要不要强行出）" }
    if phase == "denied" { return "已取消（用户没批准取数）" }
    "首页"
}

fn ag_context(){
    let out = "【当前界面】" + ag_phase_name()
    out = out + "\n【这一期的设置】主题=" + topics_line() + "；条数上限=" + limit + " 条"
    if ask != "" { out = out + "；用户写下的关注点=" + ask }
    let rows = show_rows()
    if rows.len() > 0 {
        out = out + "\n【这一期已经入选的条目】（open_story 的 i 按这个序号）"
        let i = 1
        for r in rows {
            if i < 11 { out = out + "\n" + i + ". " + r.title }
            i = i + 1
        }
    }
    if phase == "story" && story != nil {
        out = out + "\n【用户正在读的那条】" + story_title
        if story_sum != "" { out = out + "\n它的摘要：" + art_cut(story_sum, 300) }
    }
    out = out + "\n【读者画像】" + pf_focus() + "。已出报 " + pf_briefs + " 期，读过 " + pf_opens + " 条。"
    if pf_notes.len() > 0 { out = out + "\n读者要你记住的：" + pf_notes_line() }
    out = out + "\n【本报记忆】档案里有 " + arc.len() + " 条往期报道（search_archive 可查）。"
    if vc_tts { out = out + "\n【语音】你能用 speak 说话；自动朗读" }
    if vc_tts { if vc_auto { out = out + "已打开。" } else { out = out + "已关闭。" } }
    if vc_stt { if vc_listen { out = out + "用户正在对你说话，听到的片段：" + vc_partial } }
    if phase == "asking" {
        out = out + "\n【你问出去的那一问】" + aq_q + "\nA：" + aq_a + "\nB：" + aq_b + "\n读者给了明确倾向时，你就用 pick_angle 把它定下来；他只说「你定」时也用 pick_angle，which 填 skip。"
    }
    if tier_line() != "" { out = out + "\n【" + tier_line() + "】" }
    if work_line() != "" { out = out + "\n【本期工作量】" + work_line() }
    if refuse_on { out = out + "\n【你的拒刊理由】" + refuse_why }
    if clash_count() > 0 { out = out + "\n【今天的口径核对】" + clash_note }
    if fix_count() > 0 { out = out + "\n【今天要登的更正】\n" + fix_line(0) }
    if fix_count() > 1 { out = out + "\n" + fix_line(1) }
    if drop_count() > 0 { out = out + "\n【你砍掉的三条】" + drop_line(0) }
    if th_count() > 0 { out = out + "\n【线索进展】" + th_text(0) }
    out = out + "\n【更正台账】累计更正 " + ("" + fix_total) + " 条，发现口径不一致 " + ("" + clash_total) + " 次（read_ledger 可查）"
    if trail_msg != "" { out = out + "
【出报留痕】" + trail_msg + "（read_trail 可回放）" }
    out = out + "
【编辑方针】" + charter_version_line() + "（read_charter 可念）"
    if iv_box_line() != "" { out = out + "\n【" + iv_box_line() + "】（草稿只存在本机，你不发信，发信是读者在外部的动作）" }
    if rv_q.len() > 0 && rv_i < rv_q.len() {
        out = out + "\n【分段朗读的断点】" + rv_text_line()
        if !rv_on { out = out + "，现在是停着的，读者说「接着念」时调用 read_brief 会从头开始，所以只在他要重念时调用" }
    }
    out
}

// =====================================================================
// L3 工具层 · 主编能对这个程序做的事（唯一入口；界面上的按钮都在这一层有对应）
// =====================================================================
let ag_tools = [
    {id: "set_topics" hint: "换主题" desc: "设置主题过滤，只让列出的主题通过。args: {topics: 字符串数组，元素只取 ai/oss/sec/chip；空数组表示全部放行}"}
    {id: "set_limit" hint: "改条数" desc: "改这一期的条数上限。args: {n: 3 到 30 的整数}"}
    {id: "set_intent" hint: "写关注点" desc: "写下一句话，作为这一期的关注点（用户的一句话意图）。args: {text: 一句话}"}
    {id: "make_plan" hint: "生成计划" desc: "按当前设置写出取数计划，界面进入待批准页（不联网）。用户说「生成/来一份/看今天的」时的第一步。args: {}"}
    {id: "approve" hint: "批准取数" desc: "批准计划并开始真正联网取数。只有用户明确说出「批准」「开始取数」「同意」时才可调用；用户只说「生成」时不可以调用，要用 make_plan 把计划摆出来请他确认。args: {}"}
    {id: "deny" hint: "取消" desc: "不批准，取消本次取数，不发起任何网络请求。args: {}"}
    {id: "restart" hint: "重新开始" desc: "清空当前这一期，回到首页。args: {}"}
    {id: "open_story" hint: "打开某条" desc: "打开这一期里的第 i 条，进入阅读页。args: {i: 从 1 开始的整数}"}
    {id: "close_story" hint: "返回列表" desc: "从阅读页返回晨报列表。args: {}"}
    {id: "step_story" hint: "前后条" desc: "在阅读页跳到相邻一条。args: {d: 1 是下一条，-1 是上一条}"}
    {id: "redraw_cover" hint: "换头版" desc: "让视觉主编重画今日头版。args: {}"}
    {id: "draw_art" hint: "画配图" desc: "给正在读的这一条现场画一张配图。args: {}"}
    {id: "search_archive" hint: "查本报档案" desc: "在本报自己的往期报道里检索（本地，不联网）。args: {q: 关键词，可以空格分隔多个词；留空则列出最近几条}"}
    {id: "remember_reader" hint: "记住偏好" desc: "把读者亲口说的一条长期偏好记下来，以后每期都算数。args: {text: 一句话，例如「多关注开源社区」。只有读者明确要求记时才调用}"}
    {id: "speak" hint: "说一句" desc: "把一句话念出来给读者听（用这台机器的语音）。args: {text: 要念的内容}。只有当读者明确要求「念给我听 / 读出来」时才调用"}
    {id: "read_brief" hint: "分段念这一期" desc: "从头开始分段朗读这一期（导语加上最多前五条标题），可以中途停下、之后从断点接着念。args: {}"}
    {id: "stop_read" hint: "停下来" desc: "停止分段朗读，保留断点。args: {}"}
    {id: "pick_angle" hint: "答出报前那一问" desc: "当主编问过「今天更想看哪个角度」而读者给了一个明确的倾向时调用。args: {which: \"a\" 表示选第一个，\"b\" 表示选第二个，\"skip\" 表示让主编自己定}"}
    {id: "draft_interview" hint: "起草追问邮件" desc: "给正在阅读的这一条起草一封采访追问邮件，存进本机草稿箱（只写稿，绝不发送）。args: {}。只有当读者明确说「问问他 / 写封信 / 追问一下」时才调用"}
    {id: "read_ledger" hint: "查更正台账" desc: "查本报自己的更正与口径核对台账（本地，不联网）：累计更正过几条、发现过几次跨源口径不一致、最近的具体记录。读者问「你上次是不是报错了」「更正过几次」时用它。args: {}"}
    {id: "read_trail" hint: "回放出报过程" desc: "回放最近一期的出报链路（本地，不联网）：本期扫了多少条、进了候选池的是哪些、三位初审编辑各自的原话、主编终审的导语与每条取舍理由、以及被砍掉的三条。读者问「你们是怎么选的」「为什么没选那条」「这个决定怎么来的」时用它。args: {n: 可选，回放第几期（1=最近），默认 1}"}
    {id: "read_charter" hint: "念编辑方针" desc: "念出本报的编辑部宪法（本地，不联网）：一共几条方针、每条各是什么、当前版本号。读者问「你们的编辑原则是什么」「你们按什么标准选新闻」时用它。args: {}"}
]

fn ag_tool_lines(){
    let out = ""
    for t in ag_tools {
        if out != "" { out = out + "\n" }
        out = out + "- " + t.id + "：" + t.desc
    }
    out
}

fn ag_tool_hint(){
    let out = ""
    for t in ag_tools {
        if out != "" { out = out + " · " }
        out = out + t.hint
    }
    out
}

// 对话条上只放一句人话：能力清单太长，摆在下面反而看不清。
fn ag_caps_line(){
    if vc_tts {
        return "能改设置 · 能出报 · 能翻页 · 能查本报档案与更正台账 · 能回放出报过程 · 能念编辑方针 · 能说话"
    }
    "能改设置 · 能出报 · 能翻页 · 能查本报档案 · 能回放过程"
}

fn ag_arg(args, key){
    if args == nil { return nil }
    args[key]
}

fn ag_num(v, fallback){
    let n = sys.num(v)
    if n != n { return fallback }
    floor(n)
}

fn ag_row_at(i){
    let k = 1
    for r in show_rows() {
        if k == i { return r }
        k = k + 1
    }
    nil
}

fn ag_apply_topics(list){
    chosen["ai"] = false
    chosen["oss"] = false
    chosen["sec"] = false
    chosen["chip"] = false
    for t in list {
        let s = "" + t
        if s == "ai" || s == "oss" || s == "sec" || s == "chip" { chosen[s] = true }
    }
}

// 硬闸门：联网取数必须先拿到用户明确的批准。
// 用户只说「生成」，主编只能把计划写出来请他确认；说「批准 / 开始取数 / 同意」时才放行。
fn ag_user_approved(){
    if ag_last_user == "" { return false }
    if ag_last_user.search("批准") >= 0 { return true }
    if ag_last_user.search("开始取数") >= 0 { return true }
    if ag_last_user.search("同意") >= 0 { return true }
    if ag_last_user.search("开始吧") >= 0 { return true }
    if ag_last_user.search("去取数") >= 0 { return true }
    if ag_last_user.search("确认取数") >= 0 { return true }
    false
}

fn ag_do(tool, args){
    if tool == "set_topics" {
        let list = []
        let vs = ag_arg(args, "topics")
        if vs != nil { for t in vs { list.push("" + t) } }
        ag_apply_topics(list)
        sync_ui()
        return "主题已切换为：" + topics_line()
    }
    if tool == "set_limit" {
        let n = ag_num(ag_arg(args, "n"), limit)
        limit = n
        if limit < 3 { limit = 3 }
        if limit > 30 { limit = 30 }
        sync_ui()
        return "条数上限改为 " + limit + " 条"
    }
    if tool == "set_intent" {
        let s = ""
        let v = ag_arg(args, "text")
        if v != nil { s = "" + v }
        ask = s
        sync_ui()
        if ask == "" { return "关注点已清空" }
        return "关注点已写为：" + ask
    }
    if tool == "make_plan" {
        make_plan()
        return "取数计划已写好，界面切到待批准页；批准前不会联网"
    }
    if tool == "approve" {
        if !ag_user_approved() {
            return "还没批准：用户没有说「批准」或「开始取数」。请用 say 把计划讲给用户听，等他说了批准再调用本工具（他也可以直接点界面上的「批准并取数」）。"
        }
        approve()
        return "已按用户的话批准取数，正在联网取数"
    }
    if tool == "deny" {
        deny()
        return "已取消，未发起任何网络请求"
    }
    if tool == "restart" {
        restart()
        return "已清空这一期，回到首页"
    }
    if tool == "open_story" {
        let i = ag_num(ag_arg(args, "i"), 0)
        let r = ag_row_at(i)
        if r == nil { return "没有第 " + i + " 条；现在已经入选 " + show_rows().len() + " 条" }
        open_story(r)
        return "已打开第 " + i + " 条：" + r.title
    }
    if tool == "close_story" {
        if phase != "story" { return "现在不在阅读页，不用返回" }
        close_story()
        return "已回到晨报列表"
    }
    if tool == "step_story" {
        if phase != "story" { return "现在不在阅读页；先用 open_story 打开某一条" }
        let d = ag_num(ag_arg(args, "d"), 1)
        if d < 0 { d = -1 }
        else { d = 1 }
        story_step(d)
        return "已切到：" + story_title
    }
    if tool == "redraw_cover" {
        if picked.len() == 0 { return "现在没有可换的头版；先取数生成这一期" }
        cover_retry()
        return "视觉主编已经去重画头版了"
    }
    if tool == "draw_art" {
        if phase != "story" { return "先打开一条新闻（open_story），才能给它画配图" }
        art_retry()
        return "正在给这一条画配图"
    }
    if tool == "search_archive" {
        let q = ""
        let v = ag_arg(args, "q")
        if v != nil { q = "" + v }
        arc_hits = arc_find(q)
        if phase != "story" { phase = "done" }
        sync_ui()
        return arc_hits_text()
    }
    if tool == "remember_reader" {
        let s = ""
        let v = ag_arg(args, "text")
        if v != nil { s = "" + v }
        if s == "" { return "没听清要记什么，再说一次" }
        pf_note_add(s)
        sync_ui()
        return "已记住：" + s + "。以后每一期都会照这条偏好选。"
    }
    if tool == "speak" {
        let s = ""
        let v = ag_arg(args, "text")
        if v != nil { s = "" + v }
        if s == "" { s = ag_note }
        if !vc_tts { return "这台机器没有可用的语音合成，念不出来" }
        vc_auto = false
        vc_say_now(s)
        return "正在念：" + art_cut(s, 40)
    }
    if tool == "read_brief" {
        if picked.len() == 0 && last_rows.len() == 0 { return "现在还没有可念的晨报；先生成一期" }
        if !vc_tts { return "这台机器没有可用的语音合成，念不出来" }
        vc_auto = false
        rv_build()
        rv_i = 0
        rv_on = true
        rv_next()
        return "开始分段念这一期，" + rv_text_line() + "。读者随时可以插话，我会停下等着。"
    }
    if tool == "stop_read" {
        if !rv_on { return "现在没有在念" }
        rv_stop()
        return "已停下，" + vc_note
    }
    if tool == "pick_angle" {
        if phase != "asking" { return "现在没有待回答的问题" }
        let w = ""
        let v = ag_arg(args, "which")
        if v != nil { w = "" + v }
        if w == "" { w = "skip" }
        let picked_text = "让主编自己定"
        if w == "a" { picked_text = aq_a }
        if w == "b" { picked_text = aq_b }
        aq_choose(w)
        return "好，今天的角度按「" + picked_text + "」来，取数计划这就出来。"
    }
    if tool == "draft_interview" {
        if phase != "story" { return "先打开一条新闻（open_story），才有可追问的对象" }
        iv_kick()
        return "正在给这条起草一封追问邮件，写好会存进本机草稿箱。发信不在这份程序里，需要你之后在外部确认。"
    }
    if tool == "read_ledger" {
        return ledger_text()
    }
    if tool == "read_trail" {
        return trail_text() + "

" + replay_text()
    }
    if tool == "read_charter" {
        return charter_text() + "
当前 " + charter_version_line()
    }
    "没有 " + tool + " 这个工具"
}

// =====================================================================
// L2 决策层 · 主编循环：读用户的话 → 说话还是调用工具 → 拿到结果再来一轮
// =====================================================================
let ag_shape = {type: "object" required: ["say" "tool"] properties: {say: {type: "string"} tool: {type: "string"} args: {}}}

fn ag_system(){
    "你是《晨报卡》的常驻 AI 主编，是这个小程序里唯一的操作者：用户用对话让你做界面上的一切事，你也可以直接回答新闻问题。" +
    "\n\n你能调用的工具（只能从这个清单里选，不能自己发明）：\n" + ag_tool_lines() +
    "\n\n输出规则：每一轮只输出一个 JSON 对象。say 是给用户看的一句话（中文、口语、不超过 60 字）；tool 是要调用的工具名，不需要工具时填空字符串；args 是工具参数对象，没有参数就写空对象。多步任务一步一个工具，拿到结果再决定下一步，最多六步。同一个工具不要连着调用两次。用户说「生成今天的晨报」这类请求，就是两步：先 set_topics（如果他指定了主题），再 make_plan；到计划页就停手，请他说「批准」（或点界面按钮），绝不要自己调用 approve。事情办完立刻用 say 收尾一句。" +
    "approve 会真的联网取数：只有用户明确说要生成、批准、开始时才调用它；用户只是问问题、看东西，就直接用 say 回答，不要调用工具。" +
    "你有几样别人没有的东西，该用就用：① search_archive 查本报自己的往期报道，用户问「我们之前报过什么」「这条之前有没有提过」时用它；② remember_reader 在用户明确要你记住一条偏好时用它，那是他亲口说的长期偏好；③ speak 在用户明确要你念出来时把话变成声音；④ read_brief 分段念整期，读者中途插话会停下、断点保留，他说「接着念」你就用 read_brief 重开一次（会从头念，所以只在他想重听时才用）；⑤ draft_interview 在有读者正在读的新闻、且他明确要你写封信追问时用它 —— 你只写稿存本机，发信是他在外部的动作，你永远不替他发。" +
    "关于信源：你在出报前会拿到每条候选的信源等级（一手 / 二手 / 传闻 / 转载）。读者问「这条靠谱吗」「消息来源怎么样」时，照实说等级，不要替他下结论。" +
    "关于公开过程：你每出一次报，都会把过程留痕 —— 候选池里放了哪些、三位初审各自说了什么、你写下的导语和每条取舍理由、以及你砍掉了什么。读者问「你们是怎么选的」「为什么没选那条」时用 read_trail 调出来讲，照着当时的记录说，不要事后美化。同时本报有一套写死的编辑方针（编辑部宪法），你每期都按它办；读者问「你们的标准是什么」时用 read_charter 如实念，不要自己另编一套。" +
    "关于认错：你出报时会留下本期报到的硬事实（claims）和三条预测，下一期取数后自动核对 —— 被推翻的登进「更正」栏，同一天里不同来源说法打架的登进「口径不一致」栏，连你砍掉没上的三条也会公开。读者问「你报错过吗」「更正过几次」时用 read_ledger 查，如实说，不要粉饰，也不要讲「我会持续改进」这种空话。" +
    "注意：search_archive 只查本报档案（本地），不是联网搜索。用户问的是外面的事、你不知道的事，就如实说不知道，不要编。" +
    "\n\n" + ag_context()
}

fn ag_model_text(){
    let m = ai_model
    if m == "" { m = "官方模型" }
    m
}

fn ag_trim_log(){
    let n = ag_log.len()
    if n <= 6 { return }
    let kept = []
    let i = 0
    for e in ag_log {
        if i >= n - 6 { kept.push(e) }
        i = i + 1
    }
    ag_log = kept
}

fn ag_trim_msgs(){
    let n = ag_msgs.len()
    if n <= 10 { return }
    let kept = []
    let i = 0
    for m in ag_msgs {
        if i >= n - 10 { kept.push(m) }
        i = i + 1
    }
    ag_msgs = kept
}

fn ag_send(){
    if ag_busy { return }
    let text = ag_draft
    if text == "" { return }
    ag_draft = ""
    ui.ag_in.set_text("")
    ag_log.push({who: "me" text: text})
    ag_msgs.push({role: "user" content: text})
    ag_trim_msgs()
    ag_trim_log()
    ag_steps = 0
    ag_prev = ""
    ag_nudge = 0
    ag_last_user = text
    ag_busy = true
    ag_note = "主编正在读你的话…"
    sync_ui()
    start_timeout(0.05, || ag_turn())
}

fn ag_say(text){
    ag_draft = text
    ag_send()
}

fn ag_turn(){
    ag_steps = ag_steps + 1
    if ag_steps > 6 {
        ag_busy = false
        ag_note = "这一轮走了六步还没收口，先停在这里"
        sync_ui()
        return
    }
    let msgs = [{role: "system" content: ag_system()}]
    for m in ag_msgs { msgs.push(m) }
    host.request("llm.chat", {messages: msgs as_json: true temperature: 0 max_tokens: 1024 schema: ag_shape label: "brief.agent"}, fn(r){
        ag_reply(r)
    })
}

fn ag_reply(r){
    if !r.is_ok || r.data == nil || r.data.data == nil {
        ag_busy = false
        ag_note = "主编这次没有答复"
        if r.error != nil && r.error != "" { ag_note = "主编这次没有答复（" + r.error + "）" }
        ag_log.push({who: "ai" text: "我这边没接上模型，这次答不上来。界面上的按钮都还在，直接点也一样用。"})
        ag_trim_log()
        sync_ui()
        return
    }
    let d = r.data.data
    let say = ""
    if d.say != nil { say = "" + d.say }
    let tool = ""
    if d.tool != nil { tool = "" + d.tool }
    let args = d["args"]
    ag_used = ag_used + 1
    let line = say
    if tool != "" && tool != "none" {
        if line != "" { line = line + " " }
        line = line + "[调用工具 " + tool + "]"
    }
    if line != "" { ag_msgs.push({role: "assistant" content: line}) }
    if say != "" { ag_log.push({who: "ai" text: say}) }
    if tool == "" || tool == "none" {
        if ag_unfinished() && ag_nudge_more() { return }
        ag_busy = false
        ag_note = "主编 · " + seconds_text(r.data.elapsed_ms) + " · " + ag_model_text()
        ag_trim_log()
        sync_ui()
        // 主编的收尾话，配上自己的声音说一遍
        if say != "" && tool != "speak" { vc_say(say) }
        return
    }
    let sig = tool
    if args != nil { sig = sig + "|" + args.to_json() }
    if sig == ag_prev {
        ag_log.push({who: "tool" text: "· " + tool + " 重复调用已跳过"})
        ag_msgs.push({role: "user" content: "工具 " + tool + " 刚才已经调用过，结果一样，不用再来一遍。请直接用 say 回一句收尾。"})
        ag_trim_log()
        ag_trim_msgs()
        ag_busy = false
        ag_note = "已跳过重复调用：" + tool
        sync_ui()
        return
    }
    ag_prev = sig
    let res = ag_do(tool, args)
    ag_log.push({who: "tool" text: "· " + tool + " → " + res})
    ag_msgs.push({role: "user" content: "工具 " + tool + " 的结果：" + res + "。事情办完就用 say 回一句收尾；还要办就继续调用工具。"})
    ag_trim_log()
    ag_trim_msgs()
    ag_note = "已执行：" + tool
    sync_ui()
    start_timeout(0.40, || ag_turn())
}

// 用户要的是「一份晨报」这类任务，而界面还停在首页 —— 那就是还没办完。
// （模型会说「这就去出计划」却不真的调用工具，这一步把它推回去。）
let ag_nudge = 0

fn ag_wants_task(){
    if ag_last_user == "" { return false }
    if ag_last_user.search("生成") >= 0 { return true }
    if ag_last_user.search("来一份") >= 0 { return true }
    if ag_last_user.search("来一份") >= 0 { return true }
    if ag_last_user.search("出报") >= 0 { return true }
    if ag_last_user.search("晨报") >= 0 { return true }
    if ag_last_user.search("早报") >= 0 { return true }
    if ag_last_user.search("看今天") >= 0 { return true }
    false
}

fn ag_unfinished(){
    if !ag_wants_task() { return false }
    if phase == "intent" { return true }
    false
}

fn ag_nudge_more(){
    if ag_nudge >= 2 { return false }
    ag_nudge = ag_nudge + 1
    ag_msgs.push({role: "user" content: "（系统提示）界面现在还停在首页，你上一步只是说了要做却没有真的调用工具。请现在真的调用合适的工具把用户的请求办完；如果用户没说批准，办到「待批准页」就停手。"})
    ag_trim_msgs()
    ag_busy = true
    ag_note = "主编还没把事办完，正在继续…"
    sync_ui()
    start_timeout(0.35, || ag_turn())
    true
}

fn ag_toggle(){
    ag_open = !ag_open
    sync_ui()
}

fn ag_clear(){
    ag_log = []
    ag_msgs = []
    ag_note = ""
    ag_used = 0
    sync_ui()
}

fn ag_set_draft(t){
    ag_draft = t
}

fn ag_line(){
    if ag_busy { return ag_note }
    if ag_note != "" { return ag_note }
    "这个程序里的一切都能让我做：改设置、生成、翻页、换头版、画配图。"
}

fn ag_pill_text(){
    if ag_busy { return "● 主编在想…" }
    if ag_open { return "收起主编" }
    "● AI 主编"
}

let role_shape = {type: "object" required: ["digest" "votes"] properties: {digest: {type: "string"} votes: {type: "array" items: {type: "integer"}}}}

fn role_of(id){
    for role in roles { if role.id == id { return role } }
    nil
}

fn panel_is(r){
    for p in panel { if p.id == r { return p } }
    nil
}

fn panel_remove(id){
    let out = []
    for p in panel { if p.id != id { out.push(p) } }
    panel = out
}

fn cand_index(id){
    let k = 0
    let at = -1
    for r in cand { if r.id == id { at = k } k = k + 1 }
    at
}

fn votes_text(vs, cap){
    let out = ""
    let i = 0
    for v in vs {
        if i < cap {
            if out != "" { out = out + "、" }
            out = out + v
        }
        i = i + 1
    }
    out
}

fn votes_for(id){
    let idx = cand_index(id)
    if idx < 0 { return 0 }
    let k = 0
    for p in panel {
        if p.state == "ok" {
            for v in p.votes { if v == idx { k = k + 1 } }
        }
    }
    k
}

fn panel_mark(id){
    let idx = cand_index(id)
    if idx < 0 { return "" }
    let out = ""
    for p in panel {
        if p.state == "ok" {
            let hit = false
            for v in p.votes { if v == idx { hit = true } }
            if out != "" { out = out + "   " }
            if hit { out = out + p.label + " 推荐" } else { out = out + p.label + " 没选" }
        }
    }
    out
}

fn panel_reset(n){
    panel = []
    panel_state = "asking"
    panel_note = "三位编辑收到 " + n + " 条候选，正在各自独立阅读…"
    panel_sig = ""
    sync_ui()
}

fn panel_ask(){
    start_timeout(0.02, || panel_role("tech"))
    start_timeout(0.04, || panel_role("biz"))
    start_timeout(0.06, || panel_role("reader"))
}

fn panel_role(id){
    let role = role_of(id)
    if role == nil { return }
    let list = ""
    let k = 0
    for r in cand {
        if k < 12 { list = list + "" + k + ". " + r.title + "\n" }
        k = k + 1
    }
    let focus = ask
    if focus == "" { focus = topics_line() }
    if focus == "未选主题（全都要）" { focus = "没有特别偏好，挑最重要的科技新闻" }
    let sys = role.line + "你是《晨报》的" + role.label + "初审编辑，只从这一个角度判断：" + role.ask + "输出一个 JSON 对象，只有两项：digest 是一句话点评（不超过 60 字）；votes 是你推荐的候选序号数组（最多 6 个）。第一个字符就是 {，不要任何思考过程，不要围栏。\n[编辑部宪法 panel/" + charter_v("panel") + "]"
    let body = "读者的关注点：" + focus + "\n\n候选标题（序号从 0 开始）\n" + list + "\n请独立给出你的初审意见。"
    let t0 = time_now()
    host.request("llm.chat", {
        system: sys
        prompt: body
        as_json: true
        temperature: 0
        max_tokens: 2048
        schema: role_shape
        label: "brief.panel." + id
    }, fn(r){
        panel_put(id, r, t0)
    })
}

fn panel_put(id, r, t0){
    let role = role_of(id)
    let label = id
    if role != nil { label = role.label }
    let item = {id: id label: label state: "ok" digest: "" votes: [] ms: 0 model: ""}
    let good = false
    if r.is_ok && r.data != nil && r.data.data != nil { good = true }
    if good {
        let d = r.data.data
        let dg = d.digest
        if dg == nil { dg = "" }
        item.digest = dg
        let vs = []
        if d.votes != nil { for v in d.votes { vs.push(v) } }
        item.votes = vs
        item.model = r.data.model
        item.ms = r.data.elapsed_ms
    } else {
        item.state = "fail"
        item.digest = "这位编辑这次没有答复。"
        if r.error != nil && r.error != "" { item.digest = "这位编辑这次没有答复。" }
    }
    panel_remove(id)
    panel.push(item)
    // 留痕：这位编辑的原话与推荐序号（复盘的第二层：谁说了什么）
    trail_set_panel(id, "" + label, item.votes, "" + item.digest, item.ms)
    panel_check()
}

fn panel_check(){
    if panel.len() < roles.len() {
        sync_ui()
        return
    }
    panel_state = "done"
    let good = 0
    let total = 0
    let sig = ""
    for p in panel {
        total = total + p.ms
        if p.state == "ok" { good = good + 1 }
        sig = sig + p.label + ":" + p.state + ":" + p.ms + ":["
        for v in p.votes { sig = sig + v + "," }
        sig = sig + "]|"
    }
    panel_sig = sig
    if good == 0 {
        panel_note = "三位编辑这次都没能给出意见，已跳过初审直接按主题规则挑选。"
        fallback_pick()
        finish()
        return
    }
    panel_note = "三位编辑背靠背读完了 " + roles.len() + " 个角度（合计 " + seconds_text(total) + "），" + good + " 位给出了推荐，已连同推荐理由交给主编终审。"
    sync_ui()
    start_timeout(0.05, || judge_try(16))
}

fn panel_text(){
    if panel.len() == 0 { return "" }
    let out = ""
    for p in panel {
        if p.state == "ok" {
            if out != "" { out = out + "\n" }
            out = out + p.label + "：" + p.digest
        }
    }
    out
}

fn panel_digest_text(){
    if panel.len() == 0 { return "" }
    let out = ""
    for p in panel {
        if p.state == "ok" {
            out = out + "【" + p.label + "编辑】" + p.digest + "\n"
            let v = votes_text(p.votes, 8)
            if v != "" { out = out + "他推荐的候选序号：" + v + "\n" }
        }
    }
    out
}

fn panel_line(id){
    let label = id
    let role = role_of(id)
    if role != nil { label = role.label }
    let p = panel_is(id)
    if p == nil { return label + "  ·  排队中" }
    if p.state == "fail" { return label + "  ·  这次没答复" }
    label + "  ·  推荐 " + p.votes.len() + " 条  ·  " + seconds_text(p.ms)
}

fn fallback_pick(){
    let hits = []
    for r in all_rows { if row_hit(r.title) { hits.push(r) } }
    hits = sort_desc(hits)
    picked = []
    let n = 0
    for r in hits {
        if n < limit { picked.push(r) n = n + 1 }
    }
}

fn art_pick_load(){
    art_pick = ["" "" ""]
    art_pick_at = time_now()
    let i = 0
    for r in picked {
        if i < 3 {
            let line = "AI 主编为什么选它：" + art_why_of(r)
            let w = art_clean(line)
            art_pick[i] = w
        }
        i = i + 1
    }
}

fn art_why_of(r){
    let out = ""
    for w in ai_whys {
        if w.id == r.id { out = w.why }
    }
    if out == nil { out = "" }
    out
}

fn picks_from_ai(list){
    picked = []
    art_pick = ["" "" ""]
    ai_whys = []
    for pk in list {
        let idx = pk.i
        if idx >= 0 && idx < cand.len() {
            let r = cand[idx]
            if !already(picked, r.id) {
                picked.push(r)
                ai_whys.push({id: r.id why: pk.why})
            }
        }
    }
    art_pick_load()
}

// 落选公开：主编得说清他砍掉了什么、为什么。取舍被看见，才能被反驳。
fn drops_from_ai(list){
    drop = []
    if list == nil { return }
    let k = 0
    for d in list {
        if k < 3 {
            let idx = d.i
            if idx != nil {
                if idx >= 0 && idx < cand.len() {
                    let r = cand[idx]
                    if !already(picked, r.id) {
                        let wy = ""
                        let wv = d["why"]
                        if wv != nil { wy = "" + wv }
                        drop.push({title: r.title tier: tier_label(r) why: wy})
                        k = k + 1
                    }
                }
            }
        }
    }
}

fn drop_count(){ drop.len() }

fn drop_line(i){
    if i >= drop.len() { return "" }
    let d = drop[i]
    let t = art_cut("" + d.title, 34)
    let w = "" + d.why
    if w == "" { return "· " + t + "\n  " + d.tier }
    "· " + t + "\n  " + d.tier + "　" + w
}

let pick_shape = {type: "object" required: ["i" "why"] properties: {i: {type: "integer"} why: {type: "string"}}}
let drop_shape = {type: "object" required: ["i" "why"] properties: {i: {type: "integer"} why: {type: "string"}}}
let brief_shape = {type: "object" required: ["intro" "picks"] properties: {intro: {type: "string"} picks: {type: "array" items: pick_shape} drops: {type: "array" items: drop_shape}}}

fn judge(){
    panel_reset(cand_n)
    panel_ask()
}

fn judge_try(n){
    ai_state = "asking"
    let list = ""
    let i = 0
    for r in cand {
        if i < n { list = list + "" + i + ". [" + tier_label(r) + "] " + r.title + "\n" }
        i = i + 1
    }
    let focus = ask
    if focus == "" { focus = topics_line() }
    if focus == "未选主题（全都要）" { focus = "没有特别偏好，挑最重要的科技新闻" }
    let panel_note_line = panel_digest_text()
    let ask_text_full = "今天是 " + today_text() + "。\n读者的关注点：" + focus + "\n读者画像：" + pf_focus() + "\n\n候选标题（序号从 0 开始）\n" + list + "\n\n三位初审编辑的独立意见如下，各自的推荐序号互不商量，仅供你参考：\n" + panel_note_line + "\n从候选里挑出最多 " + limit + " 条最值得进入晨报的科技项目，按重要性从高到低排序，每条写一句中文入选理由。当三位编辑意见不一致时，你来做最终取舍。直接输出 JSON，不要思考过程。"
    host.request("llm.chat", {
        system: "[编辑部宪法 judge/" + charter_v("judge") + "]\n你是一位科技新闻主编，手下有技术、行业、读者三位初审编辑。三位编辑已经各自给过意见，你参考但不被他们绑住，做最终取舍。候选标题前的方括号是信源等级：一手＝官方博客或仓库或论文，二手＝媒体报道，传闻＝社交平台未经证实，转载＝聚合站。硬规矩：标注为「传闻·未证实」的条目最多只允许入选 1 条，且入选理由里必须写明「尚未证实」。一手来源在同等重要程度下优先。直接输出一个 JSON 对象，第一个字符就是 {，不要输出任何推理过程或思考。不要啰嗦，不要加围栏。JSON 结构：intro 是导语（字符串），picks 是数组，每项含 i（候选序号，整数）和 why（入选理由，字符串）；drops 是数组、最多 3 项，每项含 i 和 why，记下你没选中但最可惜的候选，why 用一句中文说清为什么没上（例如信源太薄、话题与已选重复、体量太小）。"
        prompt: ask_text_full
        as_json: true
        temperature: 0
        max_tokens: 2048
        schema: brief_shape
        label: "brief.judge"
    }, fn(r){
        let ok_data = false
        if r.is_ok && r.data != nil && r.data.data != nil && r.data.data.picks != nil { ok_data = true }
        if ok_data {
            ai_on = true
            ai_state = "ok"
            ai_intro = r.data.data.intro
            ai_model = r.data.model
            ai_ms = r.data.elapsed_ms
            ai_tokens = r.data.usage.total_tokens
            if r.data.reasoning != "" { ai_think = r.data.reasoning }
            picks_from_ai(r.data.data.picks)
            drops_from_ai(r.data.data.drops)
            // 留痕：主编的导语、每一条的入选理由、以及他砍掉的（复盘第三层）
            trail_set_judge("" + ai_model, ai_ms, "" + ai_intro, picked, drop)
            if picked.len() > 0 {
                ai_note = "AI 主编审阅了 " + cand_n + " 条候选，选出 " + picked.len() + " 条。"
            } else {
                ai_note = "AI 主编没有挑中任何一条，已按主题规则兜底挑选。"
                fallback_pick()
            }
            finish()
        } else {
            let why = "没有可用的答复"
            if r.error != nil && r.error != "" { why = r.error }
            if n > 8 {
                ai_note = "第一次没拿到可用结果，已自动换更短的名单再试一次。"
                sync_ui()
                judge_try(8)
            } else {
                ai_on = false
                ai_state = "failed"
                ai_note = "AI 主编这次没有答复，已改用规则筛选。原因：" + why + "。"
                fallback_pick()
                finish()
            }
        }
    })
}

fn gather(){
    all_rows = []
    ok_sources = []
    failed = []
    for s in sources { load_source(s) }
    let sorted = sort_desc(all_rows)
    cand = []
    let n = 0
    for r in sorted {
        if n < pool { cand.push(r) n = n + 1 }
    }
    cand_n = cand.len()
    work_n = all_rows.len()
    work_cand = cand_n
    tier_tally(cand)
    // 留痕：本期到底扫了多少、留了多少、留的是哪些（复盘的第一层）
    trail_set_pool(work_n, work_cand, cand)
}

// 信源太薄的时候，主编有权不出报 —— 这不是取数失败，是拒绝出报。
// 判据刻意保守：只有「一手一条都没有，二手也少到 2 条以内」才触发，
// 也就是整个池子几乎全是聚合站和社交平台的时候。认不出的域名算二手，
// 所以正常情况下这条几乎不会亮起来 —— 它要真的罕见，才有分量。
fn refuse_check(){
    refuse_on = false
    refuse_why = ""
    if ok_sources.len() == 0 { return false }
    if cand.len() == 0 { return false }
    if tier_mix["first"] > 0 { return false }
    if tier_mix["second"] > 2 { return false }
    let s = "" + tier_mix["second"]
    let m = "" + tier_mix["rumor"]
    let p = "" + tier_mix["repost"]
    refuse_on = true
    refuse_why = "候选池里一手来源 0 条，二手 " + s + " 条，其余 " + m + " 条传闻、" + p + " 条转载。今天这些消息我没有把握，不想拿一个二手转述来充今天的晨报。"
    true
}

// 读者有权否决主编：仍要出报。授权门的老规矩 —— 决定权在人手里。
fn refuse_go(){
    refuse_on = false
    start_timeout(0.05, || fc_review())
    if ai_ready == 1 {
        phase = "judging"
        sync_ui()
        judge()
    } else {
        fallback_pick()
        finish()
    }
}

// =====================================================================
// 出报前的一问 · 主编先开口
//   对话必须双方都能发起，否则只是问答。点「生成晨报」之后，主编先问一句
//   二选一，读者答 A / B（可以语音答），也可以让他别问了直接来。
//   选项不是摆设：选中的那句会真的成为本期关注点，进 judge 的提示词。
// =====================================================================
let aq_shape = {type: "object" required: ["q" "a" "b"] properties: {q: {type: "string"} a: {type: "string"} b: {type: "string"}}}

fn aq_start(){
    if phase != "intent" { return }
    phase = "asking"
    aq_state = "asking"
    aq_q = ""
    aq_a = ""
    aq_b = ""
    aq_note = "主编正在想，今天该问你什么…"
    sync_ui()
    let body = "今天是 " + today_text() + "。\n读者当前设置：主题=" + topics_line() + "；条数上限=" + limit + " 条；读者画像：" + pf_focus() + "。\n\n请用一句不超过 20 字的话问他今天更想看哪个角度，并给出两个互相排斥的选项，每个选项不超过 18 字、必须是一个能直接当成本期关注点用的角度（例如「偏技术实现与开源进展」对「偏行业格局与商业化」）。只输出 JSON。"
    host.request("llm.chat", {
        system: "你是科技新闻主编。开报前你要问读者一个二选一的问题，用来决定今天的取舍。两个选项必须互相排斥、都必须能直接当成本期的关注点。直接输出一个 JSON 对象，第一个字符就是 {，不要围栏，不要任何思考过程。结构：q 是问题（字符串），a 是选项一（字符串），b 是选项二（字符串）。
[编辑部宪法 ask/" + charter_v("ask") + "]"
        prompt: body
        as_json: true
        temperature: 0
        max_tokens: 512
        schema: aq_shape
        label: "brief.ask"
    }, fn(r){
        let got = false
        if r.is_ok && r.data != nil && r.data.data != nil && r.data.data.q != nil { got = true }
        if got {
            aq_state = "ok"
            aq_q = r.data.data.q
            aq_a = r.data.data.a
            aq_b = r.data.data.b
            aq_note = "答 A、答 B，或者说「你定」都行。"
            sync_ui()
            if vc_auto { vc_say_now(aq_q) }
        } else {
            aq_state = "failed"
            aq_note = "主编这次没想出问题，直接给你出报计划。"
            sync_ui()
            aq_choose("skip")
        }
    })
}

// which 取 a / b / skip。选中的角度会写进本期关注点。
fn aq_choose(which){
    if which == "a" && aq_a != "" { ask = aq_a }
    if which == "b" && aq_b != "" { ask = aq_b }
    aq_state = ""
    aq_note = ""
    make_plan()
}

fn aq_text_a(){
    if aq_a == "" { return "A" }
    "A · " + aq_a
}

fn aq_text_b(){
    if aq_b == "" { return "B" }
    "B · " + aq_b
}

// =====================================================================
// 主编的采访草稿箱
//   从新闻聚合往前一步就是新闻生产。主编读完这条，起草一封只问一个问题的
//   追问信，存进本机 outbox.json。
//   发信**不在这个程序里** —— 投递是外部动作，必须由读者在外部确认后再发。
//   这条线是刻意的：能力可以给，把信发出去的手不能自己伸。
// =====================================================================
let iv_shape = {type: "object" required: ["to" "sub" "body"] properties: {to: {type: "string"} sub: {type: "string"} body: {type: "string"}}}

fn iv_kick(){
    if story == nil { return }
    if iv_state == "asking" { return }
    iv_state = "asking"
    iv_note = "主编正在读原文，起草一封追问…"
    iv_to = ""
    iv_sub = ""
    iv_body = ""
    iv_from = story.title
    sync_ui()
    let body = "这条新闻的标题：" + story.title + "\n原文链接：" + story_url_text() + "\n官方摘要：" + story_sum + "\n\n请起草一封写给相关方（公司 / 作者 / 项目维护者）的采访邮件。要求：只问一个能用一句话回答的具体问题；正文不超过三句话；语气克制，不奉承、不指控、不预设结论；不要编造收件人邮箱，找不到公开邮箱就留空字符串。只输出 JSON。"
    host.request("llm.chat", {
        system: "[编辑部宪法 interview/" + charter_v("interview") + "]
你是《晨报》主编，要给一条新闻的当事人写一封简短的追问邮件。你只问一个具体、可验证的问题。直接输出一个 JSON 对象，第一个字符就是 {，不要围栏，不要任何思考过程。结构：to 是收件人邮箱（找不到公开邮箱填空字符串），sub 是邮件主题，body 是正文。"
        prompt: body
        as_json: true
        temperature: 0
        max_tokens: 1024
        schema: iv_shape
        label: "brief.interview"
    }, fn(r){
        let got = false
        if r.is_ok && r.data != nil && r.data.data != nil && r.data.data.body != nil { got = true }
        if got {
            iv_state = "ok"
            iv_to = r.data.data.to
            iv_sub = r.data.data.sub
            iv_body = r.data.data.body
            iv_save()
            iv_note = "草稿已存在本机。发信不在这份程序里 —— 需要你在外部确认后自己发。"
        } else {
            iv_state = "failed"
            iv_note = "这次没写出草稿，可以再试一次。"
        }
        sync_ui()
    })
}

fn iv_save(){
    iv_box.push({at: time_now() story: iv_from to: iv_to sub: iv_sub body: iv_body})
    let n = iv_box.len()
    if n > 12 {
        let out = []
        let i = 0
        for x in iv_box {
            if i >= n - 12 { out.push(x) }
            i = i + 1
        }
        iv_box = out
    }
    fs.write("outbox.json", {schema: 1 saved_at: time_now() items: iv_box}.to_json())
}

fn iv_load(){
    if fs.exists("outbox.json") {
        let v = fs.read("outbox.json").parse_json()
        if v != nil && v.items != nil { iv_box = v.items }
    }
}

fn iv_reset(){
    iv_state = ""
    iv_note = ""
    iv_to = ""
    iv_sub = ""
    iv_body = ""
    iv_from = ""
}

fn iv_head(){
    if iv_state == "asking" { return "主编正在起草追问" }
    if iv_state == "failed" { return "追问草稿 · 这次没写成" }
    "主编的追问草稿"
}

fn iv_text(){
    if iv_state == "asking" { return iv_note }
    if iv_state == "failed" { return iv_note }
    let to = iv_to
    if to == "" { to = "（没找到公开邮箱，需要你自己填）" }
    "收件人：" + to + "\n主题：" + iv_sub + "\n\n" + iv_body
}

fn iv_box_line(){
    if iv_box.len() == 0 { return "" }
    let n = "" + iv_box.len()
    "追问草稿箱：" + n + " 封待你在外部确认发出"
}

// =====================================================================
// 分段朗读 · 一段一段念，可以随时插话，之后从断点接着念
//   为什么分段：宿主只给了 llm.speak（说话）和 llm.speaking（在不在说），
//   没有给「停止播放」。所以做不出真正的打断。能做的是——
//   把这一期拆成句子，一句一句排进队列；你开口时我停止排下一句，
//   当前这句念完就把话筒交给你；你说完我再从断点接着念。
//   这是这套宿主能力下，最接近「可打断对话」的做法。
// =====================================================================
fn rv_text_line(){
    if rv_q.len() == 0 { return "" }
    if rv_i >= rv_q.len() { return "已经念完了" }
    let a = "" + (rv_i + 1)
    let b = "" + rv_q.len()
    "第 " + a + " / " + b + " 段"
}

fn rv_build(){
    rv_q = []
    let t = ai_intro
    if t == "" { t = "这是今天的晨报" }
    rv_q.push(t)
    let i = 1
    for r in show_rows() {
        if i < 6 {
            let ii = "" + i
            rv_q.push("第 " + ii + " 条，" + r.title)
        }
        i = i + 1
    }
}

fn rv_start(){
    if !vc_tts {
        vc_note = "这台机器没有可用的语音合成"
        sync_ui()
        return
    }
    if rv_q.len() == 0 || rv_i >= rv_q.len() {
        rv_build()
        rv_i = 0
    }
    rv_on = true
    rv_next()
}

fn rv_next(){
    if !rv_on { return }
    if rv_i >= rv_q.len() {
        rv_on = false
        vc_note = "这一期念完了"
        sync_ui()
        return
    }
    if !vc_tts {
        rv_on = false
        vc_note = "这台机器没有可用的语音合成"
        sync_ui()
        return
    }
    let t = art_cut(rv_q[rv_i], 150)
    if t == "" {
        rv_i = rv_i + 1
        rv_next()
        return
    }
    vc_note = "正在念 · " + rv_text_line()
    sync_ui()
    // 轮询上限按宿主报的时长算：一段 150 字的导语要念 30 秒左右，
    // 写死轮数会把长段拦腰切断（每轮 0.9 秒）。
    host.request("llm.speak", {text: t lang: "zh-CN"}, fn(r){
        if !rv_on { return }
        let secs = 4
        if r.is_ok && r.data != nil {
            let sv = r.data["seconds"]
            if sv != nil { secs = sv }
        }
        let polls = 2 + floor(secs / 0.9)
        if polls < 4 { polls = 4 }
        if polls > 80 { polls = 80 }
        rv_total = polls
        start_timeout(0.9, || rv_watch(polls))
    })
}

fn rv_watch(left){
    if !rv_on { return }
    if left <= 0 {
        rv_i = rv_i + 1
        rv_next()
        return
    }
    // 至少要等够两轮（约 1.8 秒）才允许「念完了」这个判断成立。
    // 原因：llm.speak 是异步的，第一轮查询时它可能还没开始播；
    // 而有的宿主根本不提供 llm.speaking，这时 playing 会一直是 false。
    // 加这个下限，最坏情况是每段都念满 1.8 秒才推进，也不会把整期跳着念完。
    let waited = rv_total - left
    host.request("llm.speaking", {}, fn(r){
        if !rv_on { return }
        let playing = false
        if r.is_ok && r.data != nil {
            let p = r.data["playing"]
            if p != nil { if p { playing = true } }
        }
        if playing { start_timeout(0.9, || rv_watch(left - 1)) }
        else {
            if waited < 2 { start_timeout(0.9, || rv_watch(left - 1)) }
            else {
                rv_i = rv_i + 1
                rv_next()
            }
        }
    })
}

// 停：不清空队列，所以能「接着念」。插话走的也是这里。
fn rv_stop(){
    rv_on = false
    vc_note = "已停下，停在" + rv_text_line() + "。说「接着念」我就从这儿往下念。"
    sync_ui()
}

fn rv_toggle(){
    if rv_on { rv_stop() }
    else { rv_start() }
}

fn rv_text(){
    if rv_on { return "■ 停下" }
    if rv_q.len() > 0 && rv_i < rv_q.len() { return "接着念" }
    "念这一期"
}

let fetch_tick = 0

fn fetch_watch(){
    if phase != "fetching" { return }
    fetch_tick = fetch_tick + 1
    if fetch_tick < 45 { start_timeout(1.0, || fetch_watch()) return }
    if phase == "fetching" {
        busy = false
        if ok_sources.len() == 0 {
            for s in sources { if !already2(failed, s.label) { failed.push(s.label) } }
        }
        phase = "done"
        sync_ui()
    }
}

fn already2(list, label){
    for x in list { if x == label { return true } }
    false
}

fn run_brief(){
    if busy { return }
    busy = true
    fetch_tick = 0
    start_timeout(1.0, || fetch_watch())
    gather()
    if refuse_check() {
        phase = "refused"
        busy = false
        // 拒刊也是这一期的编辑部决策，照样留痕 ——
        // 「今天为什么没出报」和「今天为什么选这五条」一样值得被回放
        trail["result"] = {picked: 0 refused: true}
        trail["judge"] = {model: "" ms: 0 intro: refuse_why picks: [] drops: []}
        trail_save()
        sync_ui()
        return
    }
    start_timeout(0.05, || fc_review())
    if ai_ready == 1 {
        phase = "judging"
        sync_ui()
        judge()
    } else {
        fallback_pick()
        finish()
    }
}

fn finish(){
    finished_at = time_now()
    pf_briefs = pf_briefs + 1
    pf_save()
    if picked.len() > 0 {
        fs.write("last_brief.json", {ts: finished_at rows: picked intro: ai_intro whys: ai_whys}.to_json())
        last_rows = picked
        last_at = finished_at
        // 线索时间轴：先拿这一期跟档案比阶段，再把自己写进档案 —— 顺序不能反
        th_scan(picked)
        // 往期档案：这一期进了本报记忆，以后可以「追一条线索」
        arc_add(picked)
    } else if failed.len() < sources.len() {
        fs.write("last_brief.json", {ts: finished_at rows: []}.to_json())
        last_rows = []
        last_at = finished_at
    }
    phase = "done"
    busy = false
    // 留痕：候选池 / 初审 / 终审三层的快照先落地，
    // 后面 cover、forecast、factcheck 各自回来时再补写（trail_save 会覆盖同一期）
    trail["result"] = {picked: picked.len() refused: false}   // 正常出报；拒刊路径在 run_brief() 里单独落
    trail_save()
    sync_ui()
    if picked.len() > 0 { start_timeout(2.5, || cover_kick()) }
    // 核对先起：它要用上一期留下的台账，必须赶在 fc_kick 覆盖它之前拿到快照
    if picked.len() > 0 { start_timeout(4.4, || fact_kick()) }
    if picked.len() > 0 { start_timeout(6.2, || fc_kick()) }
    if picked.len() > 0 && vc_auto {
        start_timeout(1.2, || vc_hello_intro())
    }
}

fn vc_hello_intro(){
    if !vc_auto { return }
    let t = "今天的晨报好了。"
    if ai_intro != "" { t = t + ai_intro }
    else { t = t + "一共选了 " + picked.len() + " 条。" }
    vc_say_now(t)
}

fn load_last(){
    if fs.exists("last_brief.json") {
        let v = fs.read("last_brief.json").parse_json()
        if v != nil && v.rows != nil {
            last_rows = v.rows
            last_at = v.ts
            finished_at = v.ts
            if v.intro != nil { ai_intro = v.intro }
            if v.whys != nil { ai_whys = v.whys }
            ai_state = "restored"
            if fs.exists("cover.json") {
                let c = fs.read("cover.json").parse_json()
                if c != nil && c.ts == last_at && c.url != nil && c.url != "" {
                    cover_head = c.head
                    cover_url = c.url
                    cover_on = true
                    cover_state = "ok"
                    cover_note = "视觉主编头版"
                    if c.q != nil { cover_q = c.q }
                }
            }
        }
    }
}

fn make_plan(){
    phase = "plan"
    sync_ui()
    host.request("llm.status", {}, fn(r){
        if r.is_ok && r.data.ready {
            ai_ready = 1
            ai_model = r.data.model
        } else {
            ai_ready = 0
        }
        sync_ui()
    })
}

fn approve(){
    phase = "fetching"
    picked = []
    cover_on = false
    cover_url = ""
    cover_head = ""
    cover_state = ""
    cover_note = ""
    cover_q = ""
    panel = []
    panel_state = ""
    panel_note = ""
    panel_sig = ""
    ai_on = false
    ai_state = ""
    ai_intro = ""
    ai_note = ""
    ai_think = ""
    cand_n = 0
    fc_items = []
    fc_state = ""
    fc_note = ""
    refuse_on = false
    refuse_why = ""
    work_n = 0
    work_cand = 0
    tier_mix = {first: 0 second: 0 rumor: 0 repost: 0}
    iv_reset()
    rv_q = []
    rv_i = 0
    rv_on = false
    clash = []
    fix = []
    drop = []
    th_up = []
    clash_state = ""
    clash_note = ""
    trail_begin()
    sync_ui()
    start_timeout(0.05, || run_brief())
}

fn deny(){
    phase = "denied"
    sync_ui()
}

fn restart(){
    phase = "intent"
    cover_on = false
    cover_url = ""
    cover_head = ""
    cover_state = ""
    cover_note = ""
    cover_q = ""
    picked = []
    failed = []
    ok_sources = []
    all_rows = []
    cand = []
    cand_n = 0
    ai_on = false
    ai_state = ""
    ai_intro = ""
    ai_note = ""
    ai_think = ""
    ai_whys = []
    panel = []
    panel_state = ""
    panel_note = ""
    panel_sig = ""
    fc_items = []
    fc_state = ""
    fc_note = ""
    refuse_on = false
    refuse_why = ""
    work_n = 0
    work_cand = 0
    tier_mix = {first: 0 second: 0 rumor: 0 repost: 0}
    aq_state = ""
    aq_q = ""
    aq_a = ""
    aq_b = ""
    aq_note = ""
    iv_reset()
    rv_q = []
    rv_i = 0
    rv_on = false
    clash = []
    fix = []
    drop = []
    th_up = []
    clash_state = ""
    clash_note = ""
    // 重新开始时把留痕也清掉：否则回放卡会继续显示上一期的过程
    trail = {}
    trail_msg = ""
    sync_ui()
}

fn set_ask(t){
    ask = t
    ui.intent_line.set_text(intent_preview())
}

fn toggle_topic(id){
    if id == "ai" { if chosen["ai"] { chosen["ai"] = false } else { chosen["ai"] = true } }
    else if id == "oss" { if chosen["oss"] { chosen["oss"] = false } else { chosen["oss"] = true } }
    else if id == "sec" { if chosen["sec"] { chosen["sec"] = false } else { chosen["sec"] = true } }
    else { if chosen["chip"] { chosen["chip"] = false } else { chosen["chip"] = true } }
    sync_ui()
}

fn bump(d){
    limit = limit + d
    if limit < 3 { limit = 3 }
    if limit > 30 { limit = 30 }
    sync_ui()
}

let cover_shape = {type: "object" required: ["headline" "image"] properties: {headline: {type: "string"} image: {type: "string"}}}

fn cover_kick(){
    if picked.len() == 0 { return }
    if cover_on { return }
    cover_state = "asking"
    cover_note = "视觉主编正在为今天这一期写头版标语…"
    sync_ui()
    if ai_ready != 1 { cover_fallback()
        return }
    let lines = ""
    let i = 1
    for r in picked {
        if i < 9 { lines = lines + "" + i + ". " + r.title + "\n" }
        i = i + 1
    }
    let intro = ai_intro
    if intro == "" { intro = "（这期没有导语）" }
    host.request("llm.chat", {
        system: "[编辑部宪法 cover/" + charter_v("cover") + "]
你是报纸头版的视觉主编，负责为每天一期的科技晨报定头版标题和主画面。直接输出 JSON 对象，第一个字符就是 {，不要输出任何推理过程。JSON 结构：headline 是英文头版大标题（字符串，不超过 9 个词，全大写，不带引号），image 是英文画面描述（字符串，报纸插画风格，不含任何文字）。"
        prompt: "今天是 " + today_text() + "。\n本期晨报导语：" + intro + "\n今日入选标题（按重要性排序）：\n" + lines + "\n请为这一期设计头版：headline 写一句英文大标题，概括今天最重要的主题；image 写一句英文画面描述，用来画头版主图。"
        as_json: true
        temperature: 0
        max_tokens: 1024
        schema: cover_shape
        label: "brief.cover"
    }, fn(r){
        let good = false
        if r.is_ok && r.data != nil && r.data.data != nil && r.data.data.headline != nil && r.data.data.image != nil { good = true }
        if good {
            cover_head = "" + r.data.data.headline
            if trail.len() > 0 {
                let cv = trail["cover"]
                cv["headline"] = cover_head
                cv["state"] = "ok"
                trail["cover"] = cv
                trail_save()
            }
            cover_q = "front page newspaper editorial illustration, " + r.data.data.image + ", bold iconic composition, dramatic but tasteful, 16:9, no text, no letters, no watermark"
            cover_state = "drawing"
            cover_note = "头版标语已定，正在画头版主图…"
            sync_ui()
            start_timeout(0.05, || cover_draw())
        } else {
            cover_fallback()
        }
    })
}

fn cover_fallback(){
    let t = ""
    let i = 0
    for r in picked {
        if i == 0 { t = r.title }
        i = i + 1
    }
    if t == "" { t = "今天的科技新闻" }
    cover_head = art_cut(t, 56)
    cover_q = "front page newspaper editorial illustration ABOUT THIS STORY: " + art_cut(t, 300) + " -- iconic front page art, dramatic but tasteful, 16:9, no text, no letters, no watermark"
    cover_state = "drawing"
    cover_note = "视觉主编这次没答复，已按头条标题兜底画头版"
    sync_ui()
    start_timeout(0.05, || cover_draw())
}

fn cover_draw(){
    let u = photo_take(cover_q)
    if u == nil || u == "" {
        cover_state = "failed"
        cover_note = "这次没能画出头版图，文字内容不受影响。"
        sync_ui()
        return
    }
    let pic = ("" + u).trim()
    if art_is_photo(pic) == false {
        cover_state = "failed"
        cover_note = "这次没能画出头版图，文字内容不受影响。"
        sync_ui()
        return
    }
    cover_seed = cover_seed + 1
    cover_url = pic + "&seed=" + cover_seed
    cover_on = true
    cover_state = "ok"
    cover_note = "视觉主编头版"
    cover_save()
    sync_ui()
}

fn cover_retry(){
    if cover_q == "" {
        cover_fallback()
        return
    }
    cover_state = "drawing"
    cover_note = "正在重画头版，请稍等…"
    sync_ui()
    start_timeout(0.05, || cover_draw())
}

fn cover_save(){
    fs.write("cover.json", {ts: last_at head: cover_head url: cover_url q: cover_q}.to_json())
}

fn cover_line(){
    if cover_state == "ok" { return "官方画图能力生成 · 换一张会重新画" }
    cover_note
}

fn sync_ui(){
    ui.date.set_text(gen_time())
    ui.issue_label.set_text(issue_text())
    ui.intent_line.set_text(intent_preview())
    ui.chip_ai_on.set_visible(chosen["ai"])
    ui.chip_ai_off.set_visible(!chosen["ai"])
    ui.chip_oss_on.set_visible(chosen["oss"])
    ui.chip_oss_off.set_visible(!chosen["oss"])
    ui.chip_sec_on.set_visible(chosen["sec"])
    ui.chip_sec_off.set_visible(!chosen["sec"])
    ui.chip_chip_on.set_visible(chosen["chip"])
    ui.chip_chip_off.set_visible(!chosen["chip"])
    ui.limit_label.set_text("" + limit)
    ui.browse.set_visible(phase == "intent" || phase == "asking" || phase == "plan" || phase == "judging" || phase == "denied")
    ui.gen_pane.set_visible(phase == "intent")
    ui.plan_pane.set_visible(phase == "plan")
    ui.judge_pane.set_visible(phase == "judging")
    ui.aq_pane.set_visible(phase == "asking")
    ui.refuse_pane.set_visible(phase == "refused")
    ui.run_pane.set_visible(phase == "fetching" || phase == "done")
    ui.story_pane.set_visible(phase == "story")
    ui.story_title.set_text(story_title)
    ui.story_meta.set_text(story_meta)
    ui.story_pos.set_text(story_pos())
    ui.story_sum.set_text(story_sum)
    ui.story_sum_box.set_visible(story_sum != "")
    ui.story_state.set_text(story_state_line())
    ui.story_ai.set_text(story_ai)
    ui.story_more_head.set_text(story_more_head())
    ui.story_more_text.set_text(story_more_text())
    ui.story_more_box.set_visible(story_more.len() > 0)
    ui.arc_box.set_visible(arc_rel.len() > 0)
    ui.arc_text.set_text(arc_rel_text())
    ui.story_cmt_head.set_text(story_cmt_head())
    ui.story_cmt_text.set_text(story_cmt_text())
    ui.story_cmt_box.set_visible(story_comments.len() > 0)
    ui.story_src.set_text(story_src_text())
    ui.story_url.set_text(story_url_text())
    ui.deny_pane.set_visible(phase == "denied")
    ui.plan_topics.set_text(plan_text())
    ui.plan_limit.set_text("条数上限：" + limit + " 条")
    ui.plan_hosts.set_text("将发起网络请求的域名：" + hosts_line())
    ui.plan_ai.set_text(ai_line())
    ui.plan_ask.set_text(ask_text())
    ui.judge_line.set_text(judge_line())
    ui.panel_head.set_text(panel_head())
    ui.p1.set_text(panel_line("tech"))
    ui.p2.set_text(panel_line("biz"))
    ui.p3.set_text(panel_line("reader"))
    ui.status_line.set_text(status_line())
    ui.fail_line.set_text(fail_line())
    ui.fail_line.set_visible(fail_line() != "")
    ui.st_gen.set_text(gen_time())
    ui.st_src.set_text(src_line())
    ui.ai_sum.set_text(ai_sum_line())
    ui.ai_sum.set_visible(phase == "done")
    ui.ai_intro.set_text(ai_intro)
    ui.ai_intro.set_visible(ai_intro != "")
    ui.ai_note.set_text(ai_note_line())
    ui.ai_note.set_visible(ai_note_line() != "")
    ui.pipe_line.set_text(pipe_text())
    ui.stale_line.set_text(stale_line())
    ui.stale_line.set_visible(stale_line() != "")
    ui.pf_line.set_text(pf_view_line())
    ui.pf_line.set_visible(pf_view_line() != "")
    ui.aq_q.set_text(aq_q)
    ui.aq_btn_a.set_text(aq_text_a())
    ui.aq_btn_b.set_text(aq_text_b())
    ui.aq_note.set_text(aq_note)
    ui.refuse_why_l.set_text(refuse_why)
    ui.refuse_tier.set_text(tier_line() + "  ·  " + work_line())
    ui.work_line.set_text(work_line())
    ui.work_line.set_visible(work_line() != "")
    ui.tier_line.set_text(tier_line())
    ui.tier_line.set_visible(tier_line() != "")
    ui.iv_pane.set_visible(iv_state != "")
    ui.iv_head.set_text(iv_head())
    ui.iv_text.set_text(iv_text())
    ui.iv_note.set_text(iv_note)
    ui.ag_iv.set_text(iv_box_line())
    ui.ag_iv.set_visible(iv_box_line() != "")
    ui.rv_btn.set_text(rv_text())
    ui.list.render()
    ui.art_pane.render()
    ui.ag_panel.set_visible(ag_open)
    ui.ag_note.set_text(ag_line())
    ui.ag_caps.set_text(vc_caps())
    ui.ag_pill.set_text(ag_pill_text())
    ui.vc_mic.set_text(vc_mic_text())
    ui.vc_note.set_text(vc_note)
    ui.vc_autob.set_text(vc_auto_text())
    ui.vc_pill_mic.set_text(vc_mic_text())
    ui.vc_pill_mic.set_visible(vc_stt)
    ui.arc_pill.set_text(arc_line())
    if ag_open { ui.ag_log_box.render() }
}

fn vc_auto_text(){
    if vc_tts {
        if vc_auto { return "自动朗读：开" }
        return "自动朗读：关"
    }
    "语音：不可用"
}

fn art_load(){
    if fs.exists("art_cache.json") {
        let v = fs.read("art_cache.json").parse_json()
        if v != nil && v.items != nil {
            for it in v.items {
                if it.id != nil && it.url != nil && it.url != "" {
                    art_cache.push({id: it.id url: it.url})
                }
            }
        }
    }
}

fn cg_off(){
    ui.cg_eye.set_text("")
    ui.cg_ttl.set_text("")
    ui.cg_rul.set_text("")
    ui.cg.set_visible(false)
}

fn cg_text(){
    ui.cg_eye.set_text("M O R N I N G   B R I E F")
    ui.cg_ttl.set_text("晨报卡")
    ui.cg_rul.set_text("— 你的 AI 编辑部，随叫随到 —")
}

fn boot(){
    load_last()
    art_load()
    pf_load()
    arc_load()
    fc_load()
    ledger_load()
    trail_load()
    iv_load()
    sync_ui()
    start_timeout(0.30, || vc_probe())
    start_timeout(1.10, || cg_text())
    start_timeout(3.12, || cg_off())
}
start_timeout(0.05, || boot())

// ---- 视觉体系：晨报纸质（暖白纸面 + 墨色正文 + 晨金点缀 + 品牌洋红） ----
let ink = #x1a1c22
let secondary = #x8b8d96
let accent = #xd61f52
let ground = #xf5f2ec
let paper = #xffffff
let hair = #xe8e4dc
let gold = #xc08a34
let night = #x141a27

// ---- 主题开关 · 选中=实心墨色胶囊（暖金字），未选=描边胶囊；两态各一个控件，靠可见性切换 ----
let ChipOn = ButtonFlat{height: 34 padding: Inset{left: 16 right: 16}
    draw_bg +: {border_radius: 17.0 color: night color_hover: #x222b3c color_down: #x0b0f18 border_size: 1.0
        border_color: night border_color_hover: #x222b3c border_color_down: #x0b0f18}
    draw_text +: {color: #xffe2b8 color_hover: #xffe2b8 color_down: #xffe2b8 text_style +: {font_size: 13}}
}
let ChipOff = ButtonFlat{height: 34 padding: Inset{left: 16 right: 16}
    draw_bg +: {border_radius: 17.0 color: #xffffff00 color_hover: #x00000008 color_down: #x00000014 border_size: 1.0
        border_color: hair border_color_hover: #xd6d1c5 border_color_down: #xd6d1c5}
    draw_text +: {color: secondary color_hover: ink color_down: ink text_style +: {font_size: 13}}
}
// 深色面板里的小胶囊（主编对话条上那一排动作）
let ChipDk = ButtonFlat{height: 32 padding: Inset{left: 14 right: 14}
    draw_bg +: {border_radius: 16.0 color: #xffffff12 color_hover: #xffffff22 color_down: #xffffff33 border_size: 1.0
        border_color: #xffffff2b border_color_hover: #xffffff4d border_color_down: #xffffff4d}
    draw_text +: {color: #xdbe4f7 color_hover: #xffffff color_down: #xffffff text_style +: {font_size: 12}}
}
let NumBtn = ButtonFlat{height: 36 padding: Inset{left: 14 right: 14}
    draw_bg +: {border_radius: 18.0 color: paper color_hover: #xf1ede5 color_down: #xe7e2d8 border_size: 1.0
        border_color: hair border_color_hover: hair border_color_down: hair}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 17}}
}
let PrimaryBtn = ButtonFlat{height: 46 padding: Inset{left: 20 right: 20}
    draw_bg +: {border_radius: 14.0 color: accent color_hover: #xbd1a48 color_down: #xa2163e border_size: 0.0}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style +: {font_size: 15}}
}
let GhostBtn = ButtonFlat{height: 44 padding: Inset{left: 18 right: 18}
    draw_bg +: {border_radius: 12.0 color: #xffffff00 color_hover: #x0000000a color_down: #x00000014 border_size: 1.0
        border_color: hair border_color_hover: #xd6d1c5 border_color_down: #xd6d1c5}
    draw_text +: {color: #x45464e color_hover: ink color_down: ink text_style +: {font_size: 14}}
}
let BarBtn = ButtonFlat{height: 30 padding: Inset{left: 4 right: 8}
    draw_bg +: {color: #xffffff00 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 13}}
}
let RowText = View{width: Fill height: Fit flow: Down spacing: 4}
let RowCol = RowText{
    rm := Label{width: Fill text: "" max_lines: 1 draw_text.color: gold draw_text.text_style: theme.font_bold{font_size: 10}}
    rt := Label{width: Fill text: "" max_lines: 3 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
    rsu := Label{visible: false width: Fill text: "" max_lines: 2 draw_text.color: #x6e7280 draw_text.text_style.font_size: 11}
    rw := Label{visible: false width: Fill text: "" max_lines: 2 draw_text.color: accent draw_text.text_style.font_size: 11}
    rp := Label{visible: false width: Fill text: "" max_lines: 1 draw_text.color: #x6a4bb8 draw_text.text_style.font_size: 10}
}
let RowCard = RoundedView{width: Fill height: Fit flow: Down spacing: 4
    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
    new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
    rm := Label{width: Fill text: "" max_lines: 1 draw_text.color: gold draw_text.text_style: theme.font_bold{font_size: 10}}
    rt := Label{width: Fill text: "" max_lines: 3 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
    rsu := Label{visible: false width: Fill text: "" max_lines: 2 draw_text.color: #x6e7280 draw_text.text_style.font_size: 11}
    rw := Label{visible: false width: Fill text: "" max_lines: 2 draw_text.color: accent draw_text.text_style.font_size: 11}
    rp := Label{visible: false width: Fill text: "" max_lines: 1 draw_text.color: #x6a4bb8 draw_text.text_style.font_size: 10}
}
let RowCardImg = RoundedView{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.0}
    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
    new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
    col := RowCol{}
    rth := Image{width: 68 height: 68 fit: ImageFit.CropToFill draw_bg.color: #xf2eee6 draw_bg.border_radius: 10.0}
}
let DarkBtn = ButtonFlat{height: 34 padding: Inset{left: 16 right: 16}
    draw_bg +: {border_radius: 17.0 color: #xffffff1a color_hover: #xffffff2e color_down: #xffffff42 border_size: 1.0
        border_color: #xffffff5c border_color_hover: #xffffff8c border_color_down: #xffffff8c}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style +: {font_size: 12}}
}
let PillBtn = ButtonFlat{height: 40 padding: Inset{left: 18 right: 18}
    draw_bg +: {border_radius: 20.0 color: night color_hover: #x222b3c color_down: #x0b0f18 border_size: 1.0
        border_color: gold border_color_hover: #xd8a24a border_color_down: gold}
    draw_text +: {color: #xffe2b8 color_hover: #xfff0d6 color_down: #xffe2b8 text_style +: {font_size: 13}}
}
// 正在收音时变成实心洋红，一眼看出「它在听」
let MicBtn = ButtonFlat{height: 34 padding: Inset{left: 14 right: 14}
    draw_bg +: {border_radius: 17.0 color: #x18213a color_hover: #x1d2a45 color_down: #x121a2e border_size: 1.0
        border_color: #x2b3a5e border_color_hover: #x3d4f78 border_color_down: #x2b3a5e}
    draw_text +: {color: #xe8eefc color_hover: #xffffff color_down: #xe8eefc text_style +: {font_size: 12}}
}

HostedView{width: Fill height: Fill
    full: View{width: Fill height: Fill flow: Overlay show_bg: true draw_bg.color: ground
        browse := ScrollYView{width: Fill height: Fill flow: Down spacing: 14 padding: Inset{left: 16 right: 16 top: 16 bottom: 300}
            // ---- 报头 · 每天一份报纸的仪式感 ----
            RoundedView{width: Fill height: Fit flow: Down spacing: 7
                new_batch: true draw_bg.color: night draw_bg.border_radius: 18.0
                padding: Inset{top: 16 bottom: 18 left: 17 right: 17}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    date := Label{width: Fill text: "" draw_text.color: #x92a3c6 draw_text.text_style.font_size: 11}
                    issue_label := Label{text: "" draw_text.color: #x6d7d9c draw_text.text_style.font_size: 10}
                }
                Label{width: Fill text: "晨报卡" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 30}}
                RoundedView{width: 46 height: 2 new_batch: true draw_bg.color: gold draw_bg.border_radius: 1.0}
                Label{width: Fill text: "MORNING BRIEF · AI 编辑部 · 常驻主编在线" draw_text.color: #xe8759b draw_text.text_style.font_size: 10}
            }
            intent_line := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
            ask_in := TextInput{width: Fill height: 46 empty_text: "也可以直接写，例如：我想看芯片和 AI 的大新闻"
                on_change: |text| set_ask(text)
                draw_bg +: {color: paper color_hover: paper color_focus: paper color_empty: paper
                    border_color: hair border_color_hover: #xd6d1c5 border_color_focus: accent border_color_empty: hair
                    border_radius: 12.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
            }
            // ---- 主题开关：选中是实心墨色，未选是描边（两态各一个控件，靠可见性切换） ----
            View{width: Fill height: Fit flow: Right spacing: 8
                chip_ai_on := ChipOn{text: "AI" on_click: || toggle_topic("ai")}
                chip_ai_off := ChipOff{text: "AI" on_click: || toggle_topic("ai")}
                chip_oss_on := ChipOn{text: "开源" on_click: || toggle_topic("oss")}
                chip_oss_off := ChipOff{text: "开源" on_click: || toggle_topic("oss")}
                chip_sec_on := ChipOn{text: "安全" on_click: || toggle_topic("sec")}
                chip_sec_off := ChipOff{text: "安全" on_click: || toggle_topic("sec")}
                chip_chip_on := ChipOn{text: "芯片" on_click: || toggle_topic("chip")}
                chip_chip_off := ChipOff{text: "芯片" on_click: || toggle_topic("chip")}
            }
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 12
                Label{text: "本期条数" draw_text.color: secondary draw_text.text_style.font_size: 12}
                NumBtn{text: "-" on_click: || bump(-1)}
                limit_label := Label{text: "10" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                NumBtn{text: "+" on_click: || bump(1)}
            }
            gen_pane := View{visible: true width: Fill height: Fit flow: Down spacing: 8 align: Align{x: 0.0}
                PrimaryBtn{text: "生成晨报" on_click: || aq_start()}
                Label{width: Fill text: "点一下先出取数计划，你点「批准」之后才会联网。" draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
            // ---- 出报前的一问：主编先开口，读者答 A / B，也可以让他别问了 ----
            aq_pane := View{visible: false width: Fill height: Fit flow: Down spacing: 10
                new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
                padding: Inset{top: 14 bottom: 14 left: 16 right: 16}
                Label{width: Fill text: "出报前，主编想问一句" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
                aq_q := Label{width: Fill text: "" max_lines: 2 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                View{width: Fill height: Fit flow: Down spacing: 8
                    aq_btn_a := GhostBtn{text: "A" on_click: || aq_choose("a")}
                    aq_btn_b := GhostBtn{text: "B" on_click: || aq_choose("b")}
                }
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    aq_note := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 10}
                    BarBtn{text: "你定，不用问" on_click: || aq_choose("skip")}
                }
            }
            plan_pane := View{visible: false width: Fill height: Fit flow: Down spacing: 10
                new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
                padding: Inset{top: 14 bottom: 14 left: 16 right: 16}
                Label{width: Fill text: "待批准的取数计划" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    PrimaryBtn{text: "批准并取数" on_click: || approve()}
                    GhostBtn{text: "暂不" on_click: || deny()}
                }
                plan_ask := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
                plan_ai := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12}}
                plan_topics := Label{width: Fill text: "" draw_text.color: #x45464e draw_text.text_style.font_size: 13}
                plan_limit := Label{width: Fill text: "" draw_text.color: #x45464e draw_text.text_style.font_size: 13}
                plan_hosts := Label{width: Fill text: "" draw_text.color: #x45464e draw_text.text_style.font_size: 13}
            }
            judge_pane := View{visible: false width: Fill height: Fit flow: Down spacing: 6
                new_batch: true show_bg: true draw_bg.color: #xfdf6e4 draw_bg.border_radius: 14.0
                padding: Inset{top: 14 bottom: 14 left: 16 right: 16}
                judge_line := Label{width: Fill text: "" draw_text.color: #x9a6b12 draw_text.text_style: theme.font_bold{font_size: 13}}
                Label{width: Fill text: "三位编辑背靠背独立阅读，互相看不到对方的选择；随后由主编终审取舍。" draw_text.color: #x45464e draw_text.text_style.font_size: 12}
                View{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{top: 4 bottom: 2}
                    panel_head := Label{width: Fill text: "" draw_text.color: #x9a6b12 draw_text.text_style: theme.font_bold{font_size: 10}}
                    p1 := Label{width: Fill text: "" draw_text.color: #x45464e draw_text.text_style.font_size: 11}
                    p2 := Label{width: Fill text: "" draw_text.color: #x45464e draw_text.text_style.font_size: 11}
                    p3 := Label{width: Fill text: "" draw_text.color: #x45464e draw_text.text_style.font_size: 11}
                }
            }
            deny_pane := View{visible: false width: Fill height: Fit flow: Down spacing: 8
                new_batch: true show_bg: true draw_bg.color: #xfdf6e4 draw_bg.border_radius: 14.0
                padding: Inset{top: 14 bottom: 14 left: 16 right: 16}
                Label{width: Fill text: "已取消 — 未发起任何网络请求。" draw_text.color: #x9a6b12 draw_text.text_style: theme.font_bold{font_size: 13}}
                Label{width: Fill text: "你的授权是取数的前提；拒绝后不会读取任何来源。" draw_text.color: #x45464e draw_text.text_style.font_size: 12}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                    GhostBtn{text: "重新开始" on_click: || restart()}
                }
            }
            hint_line := Label{width: Fill text: "这份报会记住你读过什么，越读越懂你；右下角的主编能说话，也能查本报档案。" draw_text.color: #xa8a49c draw_text.text_style.font_size: 10}
        }
        // ---- 主编拒刊页：信源太薄时不出报。这不是失败，是拒绝。 ----
        refuse_pane := View{visible: false width: Fill height: Fill flow: Down
            new_batch: true show_bg: true draw_bg.color: ground
            View{width: Fill height: Fit flow: Down spacing: 10 padding: Inset{left: 16 right: 16 top: 18 bottom: 16}
                View{width: Fill height: Fit flow: Down spacing: 6
                    new_batch: true draw_bg.color: night draw_bg.border_radius: 18.0
                    padding: Inset{top: 15 bottom: 17 left: 17 right: 17}
                    Label{width: Fill text: "今日休刊" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 28}}
                    RoundedView{width: 46 height: 2 new_batch: true draw_bg.color: gold draw_bg.border_radius: 1.0}
                    Label{width: Fill text: "REFUSED TO PUBLISH · 主编拒刊" draw_text.color: #xe8759b draw_text.text_style.font_size: 10}
                }
                Label{width: Fill text: "今天这些消息我没有把握，不想拿一个二手转述来充今天的晨报。" max_lines: 3 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                View{width: Fill height: Fit flow: Down spacing: 5
                    new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                    Label{width: Fill text: "为什么不出" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    refuse_why_l := Label{width: Fill text: "" max_lines: 8 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                    refuse_tier := Label{width: Fill text: "" max_lines: 3 draw_text.color: #x6e7280 draw_text.text_style.font_size: 11}
                }
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    PrimaryBtn{text: "仍要出报" on_click: || refuse_go()}
                    GhostBtn{text: "重新开始" on_click: || restart()}
                }
                Label{width: Fill text: "拒刊是主编的判断，不是对你的束缚 —— 决定权在你手里，你说了出，我就出。" max_lines: 3 draw_text.color: #xa8a49c draw_text.text_style.font_size: 10}
            }
        }
        run_pane := View{visible: false width: Fill height: Fill flow: Down
            new_batch: true show_bg: true draw_bg.color: ground
            View{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{left: 14 right: 14 top: 10 bottom: 6}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    status_line := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                    st_gen := Label{text: "" draw_text.color: secondary draw_text.text_style.font_size: 10}
                }
                fail_line := Label{visible: false width: Fill text: "" draw_text.color: #xc0392b draw_text.text_style.font_size: 11}
                ai_sum := Label{visible: false width: Fill text: "" draw_text.color: #x6a4bb8 draw_text.text_style: theme.font_bold{font_size: 11}}
                ai_intro := Label{visible: false width: Fill text: "" max_lines: 2 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                ai_note := Label{visible: false width: Fill text: "" draw_text.color: #x6b6b70 draw_text.text_style.font_size: 10}
                View{width: Fill height: Fit flow: Down spacing: 3
                    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 10.0
                    padding: Inset{top: 8 bottom: 8 left: 10 right: 10}
                    pipe_line := Label{width: Fill text: "" draw_text.color: #x3a3a3c draw_text.text_style.font_size: 10}
                    st_src := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 10}
                }
                stale_line := Label{visible: false width: Fill text: "" draw_text.color: #x8a6a24 draw_text.text_style.font_size: 11}
                // 编辑部到底看了多少、扔了多少，以及今天这池子是什么成色
                View{width: Fill height: Fit flow: Down spacing: 3
                    new_batch: true show_bg: true draw_bg.color: #xfaf7f1 draw_bg.border_radius: 10.0
                    padding: Inset{top: 8 bottom: 8 left: 10 right: 10}
                    work_line := Label{visible: false width: Fill text: "" draw_text.color: gold draw_text.text_style: theme.font_bold{font_size: 11}}
                    tier_line := Label{visible: false width: Fill text: "" draw_text.color: #x6e7280 draw_text.text_style.font_size: 10}
                }
            }
            list := ScrollYView{width: Fill height: Fill flow: Down spacing: 8 padding: Inset{left: 14 right: 14 bottom: 12}
                on_render: || {
                    if cover_on {
                        View{width: Fill height: 196 flow: Overlay
                            new_batch: true
                            Image{width: Fill height: Fill fit: ImageFit.CropToFill draw_bg.color: #x0b1020 draw_bg.border_radius: 14.0 src: http_resource(cover_url)}
                            SolidView{width: Fill height: Fill draw_bg.color: #x07101ecc draw_bg.border_radius: 14.0}
                            View{width: Fill height: Fill flow: Down spacing: 6 padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                                    Label{width: Fill text: "晨报卡 · AI EDITION" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 10}}
                                    Label{text: cover_line() draw_text.color: #xa9badb draw_text.text_style.font_size: 9}
                                }
                                View{width: Fill height: Fill}
                                Label{width: Fill text: cover_head max_lines: 3 draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 21}}
                                View{width: Fill height: Fit flow: Right align: Align{x: 1.0 y: 1.0}
                                    DarkBtn{text: "换一张头版" on_click: || cover_retry()}
                                }
                            }
                        }
                    } else if cover_state == "asking" || cover_state == "drawing" || cover_state == "failed" {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true draw_bg.color: #x0e1424 draw_bg.border_radius: 14.0
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            Label{width: Fill text: "今日头版 · 视觉主编" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: cover_note max_lines: 3 draw_text.color: #x9fb0d0 draw_text.text_style.font_size: 11}
                        }
                    }
                    // ---- 更正 · 报错了就写在最前面 ----
                    if fix_count() > 0 {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: #xfdf0ee draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "更正 · 上一期有一处说法要改" draw_text.color: #xb03a2e draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: fix_line(0) max_lines: 4 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{visible: fix_count() > 1 width: Fill text: fix_line(1) max_lines: 4 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{visible: fix_count() > 2 width: Fill text: fix_line(2) max_lines: 4 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{width: Fill text: "本报自己记着这笔。截至今天累计更正 " + ("" + fix_total) + " 条。" draw_text.color: #x9b968c draw_text.text_style.font_size: 10}
                        }
                    }
                    // ---- 口径不一致 · 两个说法都在，我不替你选 ----
                    if clash_count() > 0 {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: #xf4f0e8 draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "本报注意到口径不一致" draw_text.color: #x8a6a24 draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: clash_line(0) max_lines: 5 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{visible: clash_count() > 1 width: Fill text: clash_line(1) max_lines: 5 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{width: Fill text: "两个数字都在，我不替你选。" draw_text.color: #x9b968c draw_text.text_style.font_size: 10}
                        }
                    }
                    // ---- 主编押下的三条预测（下一期自己回来对账） ----
                    if fc_items.len() > 0 {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: #xf4f0e8 draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "主编押下的三条 · 下一期自己回来对账" draw_text.color: #x8a6a24 draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: fc_line(0) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{width: Fill text: fc_line(1) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{width: Fill text: fc_line(2) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{width: Fill text: fc_review_line() draw_text.color: #x9b968c draw_text.text_style.font_size: 10}
                        }
                    } else if fc_state == "asking" || fc_state == "checking" {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true show_bg: true draw_bg.color: #xf4f0e8 draw_bg.border_radius: 14.0
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            Label{width: Fill text: "主编的三个预测" draw_text.color: #x8a6a24 draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: fc_note max_lines: 3 draw_text.color: #x6e7280 draw_text.text_style.font_size: 11}
                        }
                    }
                    // ---- 上一期押下的、已经对完账的记录 ----
                    if fc_hist_text() != "" {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 3
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: fc_hist_text() max_lines: 10 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                        }
                    }
                    // ---- 线索进展 · 同一条线索，本报上次听到时是什么成色 ----
                    if th_count() > 0 {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: th_line() draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: th_text(0) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{visible: th_count() > 1 width: Fill text: th_text(1) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                            Label{visible: th_count() > 2 width: Fill text: th_text(2) max_lines: 3 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                        }
                    }
                    let rows = show_rows()
                    if rows.len() == 0 {
                        View{width: Fill height: 120 align: Align{x: 0.5 y: 0.5}
                            Label{text: empty_line() draw_text.color: secondary draw_text.text_style.font_size: 12}
                        }
                    }
                    else for i r in rows {
                        GestureView{width: Fill height: Fit on_tap: |x, y| open_story(r)
                            let thumb = row_img(r)
                            if thumb != "" {
                                RowCardImg{col.rm.text: rank_text(i) + " · " + row_meta(r) col.rt.text: r.title
                                    col.rsu.text: row_sum(r) col.rsu.visible: row_sum(r) != ""
                                    col.rw.text: reason_of(r.id) col.rw.visible: reason_of(r.id) != ""
                                    col.rp.text: panel_mark(r.id) col.rp.visible: panel_mark(r.id) != ""
                                    rth.src: http_resource(thumb)}
                            } else {
                                RowCard{rm.text: rank_text(i) + " · " + row_meta(r) rt.text: r.title
                                    rsu.text: row_sum(r) rsu.visible: row_sum(r) != ""
                                    rw.text: reason_of(r.id) rw.visible: reason_of(r.id) != ""
                                    rp.text: panel_mark(r.id) rp.visible: panel_mark(r.id) != ""}
                            }
                        }
                    }
                    // ---- 回放出报过程 · 这一期是怎么做出来的 ----
                    if phase == "done" && replay_text() != "" {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "回放 · 这一期是怎么做出来的" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: replay_pool_line() max_lines: 2 draw_text.color: #x6e7280 draw_text.text_style.font_size: 11}
                            Label{width: Fill text: replay_panel_line() max_lines: 10 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 11}
                            Label{width: Fill text: replay_judge_line() max_lines: 16 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 11}
                            Label{width: Fill text: charter_version_line() max_lines: 3 draw_text.color: #x9b968c draw_text.text_style.font_size: 10}
                        }
                    }
                    // ---- 没上的三条 · 取舍被看见，才能被反驳 ----
                    if drop_count() > 0 {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true show_bg: true draw_bg.color: #xf7f5f0 draw_bg.border_radius: 14.0
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            Label{width: Fill text: "没上的三条 · 以及为什么" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: drop_line(0) max_lines: 3 draw_text.color: #x4a4c54 draw_text.text_style.font_size: 11}
                            Label{visible: drop_count() > 1 width: Fill text: drop_line(1) max_lines: 3 draw_text.color: #x4a4c54 draw_text.text_style.font_size: 11}
                            Label{visible: drop_count() > 2 width: Fill text: drop_line(2) max_lines: 3 draw_text.color: #x4a4c54 draw_text.text_style.font_size: 11}
                        }
                    }
                }
            }
            View{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{left: 14 right: 14 bottom: 60}
                pf_line := Label{visible: false width: Fill text: "" draw_text.color: #x8a6a24 draw_text.text_style.font_size: 10}
                sel_line := Label{width: Fill text: "点任意条目，在卡片里读这条新闻的来龙去脉；右下角的主编会听你说话，也能替你操作整个程序" draw_text.color: secondary draw_text.text_style.font_size: 11}
                View{width: Fill height: 44 flow: Right align: Align{y: 0.5}
                    GhostBtn{text: "重新开始" on_click: || restart()}
                }
            }
        }
        story_pane := View{visible: false width: Fill height: Fill flow: Down
            new_batch: true show_bg: true draw_bg.color: ground
            View{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{left: 10 right: 14 top: 8 bottom: 8}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
                    BarBtn{text: "返回晨报" on_click: || close_story()}
                    BarBtn{text: "写封信追问" on_click: || iv_kick()}
                    story_pos := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 10}
                }
                story_title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                story_meta := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
            ScrollYView{width: Fill height: Fill flow: Down spacing: 10 padding: Inset{left: 14 right: 14 bottom: 300}
                art_pane := View{width: Fill height: Fit flow: Down
                    on_render: || {
                        if art_on {
                            View{width: Fill height: Fit flow: Down spacing: 6
                                Image{width: Fill height: 210 fit: ImageFit.CropToFill src: http_resource(art_url)}
                                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                                    Label{width: Fill text: art_line() draw_text.color: secondary draw_text.text_style.font_size: 10}
                                    GhostBtn{text: "重画" on_click: || art_retry()}
                                    GhostBtn{text: "收起" on_click: || art_off()}
                                }
                            }
                        } else {
                            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                                Label{width: Fill text: art_line() draw_text.color: secondary draw_text.text_style.font_size: 10}
                                if art_busy {
                                    Label{text: "正在画…" draw_text.color: secondary draw_text.text_style.font_size: 10}
                                } else {
                                    BarBtn{text: "画一张配图" on_click: || art_retry()}
                                }
                            }
                        }
                    }
                }
                story_sum_box := View{width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    Label{width: Fill text: "官方摘要" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    story_sum := Label{width: Fill text: "" max_lines: 8 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 13}
                }
                View{width: Fill height: Fit flow: Down spacing: 5
                    new_batch: true show_bg: true draw_bg.color: #xf6f2ff draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    Label{width: Fill text: "AI 解读" draw_text.color: #x6a4bb8 draw_text.text_style: theme.font_bold{font_size: 11}}
                    story_state := Label{width: Fill text: "" draw_text.color: #x8e8e93 draw_text.text_style.font_size: 11}
                    story_ai := Label{width: Fill text: "" max_lines: 20 draw_text.color: ink draw_text.text_style.font_size: 13}
                }
                arc_box := View{visible: false width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xfff7f0 draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    Label{width: Fill text: "本报追过这条线索" draw_text.color: #x8a6a24 draw_text.text_style: theme.font_bold{font_size: 11}}
                    arc_text := Label{width: Fill text: "" max_lines: 6 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                }
                story_more_box := View{visible: false width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    story_more_head := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    story_more_text := Label{width: Fill text: "" max_lines: 12 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                }
                story_cmt_box := View{visible: false width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    story_cmt_head := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    story_cmt_text := Label{width: Fill text: "" max_lines: 16 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                }
                // ---- 主编的追问草稿：只写稿，绝不替读者发信 ----
                iv_pane := View{visible: false width: Fill height: Fit flow: Down spacing: 5
                    new_batch: true show_bg: true draw_bg.color: #xf4f0e8 draw_bg.border_radius: 14.0
                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                    iv_head := Label{width: Fill text: "" draw_text.color: #x8a6a24 draw_text.text_style: theme.font_bold{font_size: 11}}
                    iv_text := Label{width: Fill text: "" max_lines: 14 draw_text.color: #x3d3f47 draw_text.text_style.font_size: 12}
                    iv_note := Label{width: Fill text: "" max_lines: 3 draw_text.color: #x6e7280 draw_text.text_style.font_size: 10}
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                        GhostBtn{text: "重写一封" on_click: || iv_kick()}
                        BarBtn{text: "收起" on_click: || iv_reset()}
                    }
                }
                View{width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    Label{width: Fill text: "这条消息的出处" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    story_src := Label{width: Fill text: "" max_lines: 4 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                    story_url := Label{width: Fill text: "" max_lines: 2 draw_text.color: #x8e8e93 draw_text.text_style.font_size: 10}
                }
                View{width: Fill height: 44 flow: Right align: Align{y: 0.5} spacing: 8
                    GhostBtn{text: "上一条" on_click: || story_step(-1)}
                    GhostBtn{text: "下一条" on_click: || story_step(1)}
                }
            }
        }
        ag_dock := View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 1.0}
            ag_panel := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 10
                new_batch: true draw_bg.color: night draw_bg.border_radius: 18.0
                padding: Inset{top: 13 bottom: 15 left: 14 right: 14}
                View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                    Label{text: "AI 主编" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 13}}
                    Label{text: "常驻" draw_text.color: #x6d7d9c draw_text.text_style.font_size: 9}
                    ag_note := Label{width: Fill text: "" max_lines: 2 draw_text.color: #x93a4c6 draw_text.text_style.font_size: 10}
                    BarBtn{text: "清空" on_click: || ag_clear()}
                    BarBtn{text: "收起" on_click: || ag_toggle()}
                }
                ag_caps := Label{width: Fill text: "" max_lines: 2 draw_text.color: #x6f7f9e draw_text.text_style.font_size: 9}
                ag_iv := Label{visible: false width: Fill text: "" draw_text.color: #x8fe0b0 draw_text.text_style.font_size: 9}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    vc_mic := MicBtn{text: "🎙 说话" on_click: || vc_toggle()}
                    rv_btn := ChipDk{text: "念这一期" on_click: || rv_toggle()}
                    vc_autob := ChipDk{text: "自动朗读" on_click: || vc_toggle_auto()}
                }
                vc_note := Label{width: Fill text: "" max_lines: 2 draw_text.color: #x93a4c6 draw_text.text_style.font_size: 10}
                ag_log_box := ScrollYView{width: Fill height: 206 flow: Down spacing: 5
                    on_render: || {
                        if ag_log.len() == 0 {
                            Label{width: Fill text: "试着对我说：只看芯片和 AI，生成今天的晨报。" draw_text.color: #x7c8db0 draw_text.text_style.font_size: 11}
                        }
                        else for e in ag_log {
                            if e.who == "me" {
                                View{width: Fill height: Fit flow: Right
                                    RoundedView{width: Fit height: Fit flow: Down
                                        new_batch: true draw_bg.color: #x24304d draw_bg.border_radius: 12.0
                                        padding: Inset{top: 7 bottom: 7 left: 11 right: 11}
                                        Label{width: Fit text: e.text max_lines: 3 draw_text.color: #xe8eefc draw_text.text_style.font_size: 12}
                                    }
                                }
                            }
                            else if e.who == "tool" {
                                Label{width: Fill text: e.text max_lines: 2 draw_text.color: #x8fe0b0 draw_text.text_style.font_size: 10}
                            }
                            else {
                                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.0}
                                    Label{text: "主编" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 10}}
                                    Label{width: Fill text: e.text max_lines: 3 draw_text.color: #xdbe4f7 draw_text.text_style.font_size: 12}
                                }
                            }
                        }
                    }
                }
                View{width: Fill height: Fit flow: Right spacing: 8
                    ag_in := TextInput{width: Fill height: 42 empty_text: "对主编说一句话…" on_change: |t| ag_set_draft(t)
                        draw_bg +: {color: #x1a2338 color_hover: #x1a2338 color_focus: #x1f2a44 color_empty: #x1a2338
                            border_color: #x2b3a5e border_color_hover: #x2b3a5e border_color_focus: accent border_color_empty: #x2b3a5e
                            border_radius: 12.0}
                        draw_text +: {color: #xe8eefc color_hover: #xe8eefc color_focus: #xe8eefc color_empty: #x6f7f9e color_empty_hover: #x6f7f9e}
                    }
                    PrimaryBtn{text: "发送" on_click: || ag_send()}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    ChipDk{text: "生成今天这份" on_click: || ag_say("生成今天这份晨报")}
                    ChipDk{text: "只看 AI 和芯片" on_click: || ag_say("只看 AI 和芯片，生成今天的晨报")}
                    ChipDk{text: "报过什么" on_click: || ag_say("查一下本报档案里关于 AI 的报道")}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    ChipDk{text: "我的读者画像" on_click: || ag_say("看看我的读者画像，我今天会关心什么")}
                    ChipDk{text: "念给我听" on_click: || rv_toggle()}
                }
            }
            // ---- 底部常驻条：左边是记忆与麦克风，右边是主编的形象和入口 ----
            View{width: Fill height: Fit flow: Right align: Align{x: 1.0 y: 1.0} spacing: 9 padding: Inset{left: 14 right: 14 bottom: 14 top: 6}
                vc_pill_mic := PillBtn{visible: false text: "🎙" on_click: || vc_toggle()}
                arc_pill := Label{width: Fill height: Fit text: "" max_lines: 2 draw_text.color: #x9b968c draw_text.text_style.font_size: 9}
                View{width: 8 height: 1}
                // 主编的形象：纯 shader 画出来的小家伙，会呼吸、会眨眼、头顶有晨光
                pet := View{width: 46 height: 46 show_bg: true
                    new_batch: true
                    draw_bg +: {
                        pixel: fn() {
                            let ptT = self.draw_pass.time
                            let ptSz = self.rect_size
                            let ptP = self.pos * ptSz
                            let ptCx = ptSz.x * 0.5
                            let ptCy = ptSz.y * 0.54
                            let ptBase = ptSz.x * 0.5
                            let ptGoldA = #xffcf7a
                            let ptGoldB = #xfff2d8
                            let ptPink = #xd61f52
                            let ptEye = #x1b1016

                            let ptBr = 1.0 + 0.05 * sin(ptT * 2.0)
                            let ptR = ptBase * 0.58 * ptBr

                            let ptQx = (ptP.x - ptCx) / (ptR * 1.02)
                            let ptQy = (ptP.y - ptCy) / ptR
                            let ptBody = 1.0 - smoothstep(0.90 1.0 length(vec2(ptQx, ptQy)))

                            let ptRel = clamp((ptP.y - (ptCy - ptR)) / (2.0 * ptR) 0.0 1.0)
                            let ptSkinA = ptGoldB.mix(ptGoldA, clamp(ptRel * 1.9 0.0 1.0))
                            let ptSkin = ptSkinA.mix(ptPink, clamp((ptRel - 0.45) * 1.8 0.0 1.0) * 0.85)

                            let ptBt = fract(ptT * 0.26)
                            let ptShut = 1.0 - smoothstep(0.0 0.045 abs(ptBt - 0.5))
                            let ptEh = ptR * 0.20 * (1.0 - ptShut)
                            let ptEw = ptR * 0.155
                            let ptEy = ptCy - ptR * 0.08
                            let ptE1 = length(vec2((ptP.x - (ptCx - ptR * 0.34)) / ptEw, (ptP.y - ptEy) / (ptEh + 0.5)))
                            let ptE2 = length(vec2((ptP.x - (ptCx + ptR * 0.34)) / ptEw, (ptP.y - ptEy) / (ptEh + 0.5)))
                            let ptEye1 = 1.0 - smoothstep(0.78 1.02 ptE1)
                            let ptEye2 = 1.0 - smoothstep(0.78 1.02 ptE2)

                            let ptHd = length(vec2((ptP.x - ptCx) / ptR, (ptP.y - (ptCy - ptR * 1.34)) / (ptR * 0.34)))
                            let ptRing = (1.0 - smoothstep(0.0 0.14 abs(ptHd - 1.0))) * 0.85

                            let ptGd = length(ptP - vec2(ptCx, ptCy))
                            let ptHalo = (1.0 - smoothstep(ptR * 0.92 ptBase * 0.99 ptGd)) * 0.30

                            var ptCol = ptGoldA
                            var ptA = ptHalo
                            ptCol = ptCol.mix(ptSkin, ptBody)
                            ptA = ptA + ptBody * (1.0 - ptA)
                            ptCol = ptCol.mix(ptEye, ptEye1 * ptBody)
                            ptCol = ptCol.mix(ptEye, ptEye2 * ptBody)
                            ptCol = ptCol.mix(ptGoldB, ptRing * 0.9)
                            ptA = ptA + ptRing * 0.55 * (1.0 - ptA)

                            return vec4(ptCol.x * ptA, ptCol.y * ptA, ptCol.z * ptA, ptA)
                        }
                    }
                }
                ag_pill := PillBtn{text: "● AI 主编" on_click: || ag_toggle()}
            }
        }
        cg := View{width: Fill height: Fill show_bg: true
            new_batch: true
            draw_bg +: {
                pixel: fn() {
                    let cgT = self.draw_pass.time * 1.0
                    let cgSz = self.rect_size
                    let cgP = self.pos * cgSz
                    let cgCx = cgSz.x * 0.5
                    let cgCy = cgSz.y * 0.5
                    let cgRelX = cgP.x - cgSz.x * 0.5
                    let cgRelY = cgP.y - cgSz.y * 0.5
                    let cgInkA = #x07090f
                    let cgInkB = #x0d1220
                    let cgGrid = #x223050
                    let cgDawn = #xffd39a
                    let cgHot = #xfff6e6
                    let cgAcc = #xe0245e

                    let cgVg = clamp(cgP.y / cgSz.y, 0.0, 1.0)
                    var cgCol = cgInkA.mix(cgInkB, cgVg * 0.9)

                    let cgGA = smoothstep(0.55 1.70 cgT) * 0.5
                    let cgCell = 44.0
                    let cgDx = abs(fract(cgP.x / cgCell + 0.5) - 0.5) * cgCell
                    let cgDy = abs(fract(cgP.y / cgCell + 0.5) - 0.5) * cgCell
                    let cgGl = (1.0 - smoothstep(0.0 1.2 min(cgDx cgDy))) * cgGA
                    cgCol = cgCol.mix(cgGrid.mix(cgDawn, 0.22), cgGl)

                    let cgRise = smoothstep(1.70 2.90 cgT)
                    let cgBandY = cgSz.y * (1.15 - 1.35 * cgRise)
                    let cgDb = abs(cgP.y - cgBandY)
                    let cgBand = 1.0 - smoothstep(0.0 190.0 cgDb)
                    let cgCore = 1.0 - smoothstep(0.0 34.0 cgDb)
                    let cgBx = 1.0 - smoothstep(0.0 230.0 abs(cgP.x - cgCx))
                    cgCol = cgCol.mix(cgDawn, cgBand * cgBx * 0.42)
                    cgCol = cgCol.mix(cgHot, cgCore * cgBx * 0.85)

                    let cgPa = smoothstep(0.25 2.60 cgT)
                    let cgPd = 1.0 - cgPa
                    let cgKk = cgPa * cgPa

                    let cgR0 = 300.0 * (1.0 - cgKk) + 46.0 * cgKk
                    let cgA0 = 0.4 + cgT * 0.85
                    let cgM0 = (1.0 - smoothstep(0.0 3.2 length(cgP - vec2(cgCx + cos(cgA0) * cgR0 * 1.15, cgCy + sin(cgA0) * cgR0)))) * (0.45 + 0.55 * cgPd)
                    cgCol = cgCol.mix(cgHot, cgM0 * 0.95)

                    let cgR1 = 340.0 * (1.0 - cgKk) + 62.0 * cgKk
                    let cgA1 = 2.1 + cgT * 0.72
                    let cgM1 = (1.0 - smoothstep(0.0 2.8 length(cgP - vec2(cgCx + cos(cgA1) * cgR1 * 1.25, cgCy + sin(cgA1) * cgR1)))) * (0.42 + 0.58 * cgPd)
                    cgCol = cgCol.mix(cgDawn, cgM1 * 0.9)

                    let cgR2 = 268.0 * (1.0 - cgKk) + 38.0 * cgKk
                    let cgA2 = 3.6 + cgT * 1.05
                    let cgM2 = (1.0 - smoothstep(0.0 2.6 length(cgP - vec2(cgCx + cos(cgA2) * cgR2 * 1.05, cgCy + sin(cgA2) * cgR2)))) * (0.4 + 0.6 * cgPd)
                    cgCol = cgCol.mix(#xffe9c4, cgM2 * 0.9)

                    let cgR3 = 380.0 * (1.0 - cgKk) + 78.0 * cgKk
                    let cgA3 = 5.2 + cgT * 0.62
                    let cgM3 = (1.0 - smoothstep(0.0 2.4 length(cgP - vec2(cgCx + cos(cgA3) * cgR3 * 1.35, cgCy + sin(cgA3) * cgR3)))) * (0.38 + 0.62 * cgPd)
                    cgCol = cgCol.mix(cgDawn, cgM3 * 0.85)

                    let cgOrb = smoothstep(0.30 1.20 cgT) * (1.0 - smoothstep(2.70 3.10 cgT))
                    let cgCxr = cgRelX * cos(0.0 - 0.42) - cgRelY * sin(0.0 - 0.42)
                    let cgCyr = cgRelX * sin(0.0 - 0.42) + cgRelY * cos(0.0 - 0.42)
                    let cgRing = abs(length(vec2(cgCxr / 196.0, cgCyr / 64.0)) - 1.0)
                    let cgOrbI = (1.0 - smoothstep(0.0 0.055 cgRing)) * cgOrb
                    cgCol = cgCol.mix(cgDawn, cgOrbI * 0.55)

                    let cgSlY = cgSz.y * fract(cgT * 0.14 + 0.05)
                    let cgSl = (1.0 - smoothstep(0.0 2.5 abs(cgP.y - cgSlY))) * (1.0 - smoothstep(2.90 3.35 cgT))
                    cgCol = cgCol.mix(cgAcc, cgSl * 0.8)

                    let cgFlash = smoothstep(2.90 3.08 cgT)
                    cgCol = cgCol.mix(#xffffff, cgFlash * 0.94)

                    let cgOut = 1.0
                    return vec4(cgCol.x * cgOut cgCol.y * cgOut cgCol.z * cgOut cgOut)
                }
            }
            View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 10
                cg_eye := Label{width: Fill align: Align{x: 0.5} text: "" draw_text.color: #xffd39a draw_text.text_style.font_size: 11}
                cg_ttl := Label{width: Fill align: Align{x: 0.5} text: "" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 30}}
                cg_rul := Label{width: Fill align: Align{x: 0.5} text: "" draw_text.color: #xe0245e draw_text.text_style.font_size: 12}
            }
        }

    }
    tile: View{width: Fill height: Fill flow: Down padding: Inset{left: 14 right: 14 top: 12 bottom: 12} spacing: 6
        new_batch: true show_bg: true draw_bg.color: #xffffff
        Label{text: "晨报卡" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
        Label{width: Fill text: "一句话意图，生成一份可核验的晨报。" max_lines: 3 draw_text.color: ink draw_text.text_style.font_size: 12}
    }
}
