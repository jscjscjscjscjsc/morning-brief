    ag_draft = t
}

fn ag_line(){
    if ag_busy { return ag_note }
    if ag_note != "" { return ag_note }
    "本鹅是这份报纸的主编（智能体）：挑稿、写导语、解读、核验、画头版、开报，都是本鹅调用大模型干的。"
}

fn ag_pill_text(){
    if ag_busy { return "● 咕嘎在办…" }
    if ag_open { return "收起工作台" }
    "● 咕嘎 · 工作台"
}

let role_shape = {type: "object" required: ["digest" "votes"] properties: {digest: {type: "string"} votes: {type: "array" items: {type: "integer"}}}}

fn role_of(id){
    for role in roles { if role.id == id { return role } }
    nil
}

fn panel_is(r){
    for p in panel { if p.id == r { return p } }
    nil
}

fn panel_remove(id){
    let out = []
    for p in panel { if p.id != id { out.push(p) } }
    panel = out
}

fn cand_index(id){
    let k = 0
    let at = -1
    for r in cand { if r.id == id { at = k } k = k + 1 }
    at
}

fn votes_text(vs, cap){
    let out = ""
    let i = 0
    for v in vs {
        if i < cap {
            if out != "" { out = out + "、" }
            out = out + v
        }
        i = i + 1
    }
    out
}

fn votes_for(id){
    let idx = cand_index(id)
    if idx < 0 { return 0 }
    let k = 0
    for p in panel {
        if p.state == "ok" {
            for v in p.votes { if v == idx { k = k + 1 } }
        }
    }
    k
}

fn panel_mark(id){
    let idx = cand_index(id)
    if idx < 0 { return "" }
    let out = ""
    for p in panel {
        if p.state == "ok" {
            let hit = false
            for v in p.votes { if v == idx { hit = true } }
            if out != "" { out = out + "   " }
            if hit { out = out + p.label + " 推荐" } else { out = out + p.label + " 没选" }
        }
    }
    out
}

fn panel_text(){
    if panel.len() == 0 { return "" }
    let out = ""
    for p in panel {
        if p.state == "ok" {
            if out != "" { out = out + "\n" }
            out = out + p.label + "：" + p.digest
        }
    }
    out
}

fn panel_digest_text(){
    if panel.len() == 0 { return "" }
    let out = ""
    for p in panel {
        if p.state == "ok" {
            out = out + "【" + p.label + "编辑】" + p.digest + "\n"
            let v = votes_text(p.votes, 8)
            if v != "" { out = out + "他推荐的候选序号：" + v + "\n" }
        }
    }
    out
}

fn panel_line(id){
    let label = id
    let role = role_of(id)
    if role != nil { label = role.label }
    let p = panel_is(id)
    if p == nil { return label + "  ·  排队中" }
    if p.state == "fail" { return label + "  ·  这次没答复" }
    label + "  ·  推荐 " + p.votes.len() + " 条  ·  " + seconds_text(p.ms)
}

fn fallback_pick(){
    let hits = []
    for r in all_rows { if row_hit(r.title) { hits.push(r) } }
    hits = sort_desc(hits)
    picked = []
    let n = 0
    for r in hits {
        if n < limit { picked.push(r) n = n + 1 }
    }
}

fn art_why_of(r){
    let out = ""
    for w in ai_whys {
        if w.id == r.id { out = w.why }
    }
    if out == nil { out = "" }
    out
}

fn drop_count(){ drop.len() }

fn drop_line(i){
    if i >= drop.len() { return "" }
    let d = drop[i]
    let t = art_cut("" + d.title, 34)
    let w = "" + d.why
    if w == "" { return "· " + t + "\n  " + d.tier }
    "· " + t + "\n  " + d.tier + "　" + w
}

let pick_shape = {type: "object" required: ["i" "why"] properties: {i: {type: "integer"} why: {type: "string"}}}
let drop_shape = {type: "object" required: ["i" "why"] properties: {i: {type: "integer"} why: {type: "string"}}}
let brief_shape = {type: "object" required: ["intro" "picks"] properties: {intro: {type: "string"} picks: {type: "array" items: pick_shape} drops: {type: "array" items: drop_shape}}}

fn judge_remind(){
    // 只在后两遍追加。重问这件事要说清「上次错在哪」，不然模型会原样再错一遍。
    if judge_try2 == 0 { return "" }
    "\n\n【重问】上一次的答复不是合法 JSON（被截断，或 JSON 之外夹带了别的字）。这一次务必只输出**一个** JSON 对象：第一个字符就是 {，最后一个字符就是 }；picks 与 drops 数组里每一项都要写完整，不许省略、不许截断；不要写解释、不要加代码围栏、不要在 JSON 前后添加任何一个字。"
}

// 信源太薄的时候，主编有权不出报 —— 这不是取数失败，是拒绝出报。
// 判据刻意保守：只有「一手一条都没有，二手也少到 2 条以内」才触发，
// 也就是整个池子几乎全是聚合站和社交平台的时候。认不出的域名算二手，
// 所以正常情况下这条几乎不会亮起来 —— 它要真的罕见，才有分量。
fn refuse_check(){
    refuse_on = false
    refuse_why = ""
    if ok_sources.len() == 0 { return false }
    if cand.len() == 0 { return false }
    if tier_mix["first"] > 0 { return false }
    if tier_mix["second"] > 2 { return false }
    let s = "" + tier_mix["second"]
    let m = "" + tier_mix["rumor"]
    let p = "" + tier_mix["repost"]
    refuse_on = true
    refuse_why = "候选池里一手来源 0 条，二手 " + s + " 条，其余 " + m + " 条传闻、" + p + " 条转载。今天这些消息我没有把握，不想拿一个二手转述来充今天的晨报。"
    true
}

// 读者有权否决主编：仍要出报。授权门的老规矩 —— 决定权在人手里。
fn aq_text_a(){
    if aq_a == "" { return "A" }
    "A · " + aq_a
}

fn aq_text_b(){
    if aq_b == "" { return "B" }
    "B · " + aq_b
}

// =====================================================================
// 主编的采访草稿箱
//   从新闻聚合往前一步就是新闻生产。主编读完这条，起草一封只问一个问题的
//   追问信，存进本机 outbox.json。
//   发信**不在这个程序里** —— 投递是外部动作，必须由读者在外部确认后再发。
//   这条线是刻意的：能力可以给，把信发出去的手不能自己伸。
// =====================================================================
let iv_shape = {type: "object" required: ["to" "sub" "body"] properties: {to: {type: "string"} sub: {type: "string"} body: {type: "string"}}}

fn iv_save(){
    iv_box.push({at: time_now() story: iv_from to: iv_to sub: iv_sub body: iv_body})
    let n = iv_box.len()
    if n > 12 {
        let out = []
        let i = 0
        for x in iv_box {
            if i >= n - 12 { out.push(x) }
            i = i + 1
        }
        iv_box = out
    }
    fs.write("outbox.json", {schema: 1 saved_at: time_now() items: iv_box}.to_json())
}

fn iv_load(){
    if fs.exists("outbox.json") {
        let v = fs.read("outbox.json").parse_json()
        if v != nil && v.items != nil { iv_box = v.items }
    }
}

fn iv_reset(){
    iv_state = ""
    iv_note = ""
    iv_to = ""
    iv_sub = ""
    iv_body = ""
    iv_from = ""
}

fn iv_head(){
    if iv_state == "asking" { return "主编正在起草追问" }
    if iv_state == "failed" { return "追问草稿 · 这次没写成" }
    "主编的追问草稿"
}

fn iv_text(){
    if iv_state == "asking" { return iv_note }
    if iv_state == "failed" { return iv_note }
    let to = iv_to
    if to == "" { to = "（没找到公开邮箱，需要你自己填）" }
    "收件人：" + to + "\n主题：" + iv_sub + "\n\n" + iv_body
}

fn iv_box_line(){
    if iv_box.len() == 0 { return "" }
    let n = "" + iv_box.len()
    "追问草稿箱：" + n + " 封待你在外部确认发出"
}

// =====================================================================
// 分段朗读 · 一段一段念，可以随时插话，之后从断点接着念
//   为什么分段：宿主只给了 model.speak（说话）和 model.speaking（在不在说），
//   没有给「停止播放」。所以做不出真正的打断。能做的是——
//   把这一期拆成句子，一句一句排进队列；你开口时我停止排下一句，
//   当前这句念完就把话筒交给你；你说完我再从断点接着念。
//   这是这套宿主能力下，最接近「可打断对话」的做法。
// =====================================================================
// =====================================================================
// 咕嘎的私货 · 念报时夹带的「个人观点」
// ---------------------------------------------------------------------
// 念报不能只是「第 N 条 + 标题」—— 咕嘎是本报主编，它得有立场。
// 所以每念一条，它后面都要跟一句自己的话。规矩只有一条，而且写进了
// 编辑部宪法（charter 的 guga 条）：**私货必须和事实分得开**。
// 稿子里的事实来自取数与核验台；这些句子一律以「本鹅」开头，是它说的，
// 读者一眼能看出哪句是报、哪句是咕嘎。
//
// 为什么用本地池子，而不是再问一次模型：
//   · 念报是一条挨一条接着念的，每条都等一次模型往返会把节奏拖垮
//     （一次 3~8 秒，十条就是半分钟的空等，中途还容易被打断）；
//   · 模型一失败整段就哑了，而「念报」这件事不该依赖网络；
//   · 池子按 (题材 / 档位 + 条号 + 标题长度) 固定取，同一期念两遍听到的是
//     同一句 —— 复盘和录屏时不会出现「怎么又不一样了」。
// 想让它更有想法，改这个池子就行，不用碰念报流程。
// =====================================================================
let guga_takes = [
    // ---- 题材优先：读者最容易有共鸣的那一类 ----
    {k: "chip"   t: "芯片这条本鹅看的是数字，不是口号 —— 数字对得上才算数。"}
    {k: "chip"   t: "又是芯片。本鹅不嫌多，只看它能不能落到真机器上。"}
    {k: "chip"   t: "这条本鹅盯着看的是产能和价格，别的都是配菜。"}
    {k: "ai"     t: "AI 这条本鹅是有点偏心，但偏心归偏心，理由本鹅摆在上面了。"}
    {k: "ai"     t: "模型一天一个样，本鹅只挑那种明天还站得住的说法。"}
    {k: "ai"     t: "本鹅劝一句：别被参数吓着，能不能用是另一回事。"}
    {k: "oss"    t: "开源的，本鹅一律高看一眼 —— 摊在太阳底下给人翻的东西骗不了人。"}
    {k: "oss"    t: "代码都能翻，这条本鹅信得过，也就敢放在前几条。"}
    {k: "sec"    t: "安全这条本鹅念得最谨慎，吓人比说错更讨嫌。"}
    {k: "sec"    t: "漏洞的事宁可说轻一点，本鹅不替它渲染。"}
    {k: "money"  t: "钱的事本鹅当热闹看，估值涨跌跟饲养员关系其实不大。"}
    {k: "money"  t: "又是融资。本鹅提醒一句：数大不等于事大。"}
    // ---- 没有题材命中时，就按信源档位说（这本来也是最该告诉读者的一件事）----
    {k: "first"  t: "原始出处就在那儿摆着，这条本鹅签得下手。"}
    {k: "first"  t: "一手料，本鹅最爱这种 —— 别人嚼过一遍的本鹅是不吃的。"}
    {k: "first"  t: "官方自己开的口，那本鹅就没得挑了，进头版本鹅没意见。"}
    {k: "first"  t: "本鹅今天翻得最舒服的一页，就是它。"}
    {k: "second" t: "二手转述，本鹅给它留个心眼：听一半，信一半。"}
    {k: "second" t: "媒体说的啊…本鹅信七分，剩下三分先替饲养员存着。"}
    {k: "second" t: "别人家报的，本鹅对着口径看过一遍了，能用。"}
    {k: "rumor"  t: "这条还在天上飘着呢，本鹅只负责念，不负责背书。"}
    {k: "rumor"  t: "没影儿的事本鹅也念？念 —— 但你得知道它还没坐实。"}
    {k: "repost" t: "聚合站扒来的，本鹅顺着链子找过源头，才敢摆在这儿。"}
    {k: "repost" t: "转载的，本鹅看的是它背后那条原创够不够硬。"}
    {k: "unknown" t: "这条的来路本鹅没归好档，先念给你听，心里留个底。"}
]

// 收尾的那一句：咕嘎对整期的看法。同样是本地池子，按当期的
// 「一手条数 + 淘汰率」分档取 —— 说得跟这一期真有关系，而不是套话。
let guga_outros = [
    "今天就念到这儿。本鹅去盯明天的版面了，饲养员，明早见。"
    "念完了。你要是有意见，冲本鹅来，别冲那三条被本鹅砍掉的。"
    "就这些。本鹅的私心都在上面了，信不信由你，本鹅不哄人。"
    "收工。明天同一时间，本鹅还在这儿等你翻报纸。"
    "念完了 —— 今天这几条，本鹅自己会再想一遍。"
]

fn guga_pool(kind){
    let out = []
    for g in guga_takes {
        if g.k == kind { out.push(g) }
    }
    out
}

// 不依赖取模运算（脚本里没有 % 的现成用法，别拿它冒险）：减法取余。
// 不依赖取模运算（脚本里没有 % 的现成用法，别拿它冒险）：减法取余。
fn guga_mod(v, n){
    if n <= 0 { return 0 }
    let x = v
    while x >= n { x = x - n }
    while x < 0 { x = x + n }
    x
}

fn guga_take_pick(kind, seed){
    let pool = guga_pool(kind)
    let n = pool.len()
    if n == 0 { return "" }
    pool[guga_mod(seed, n)].t
}

// 给一条挑一句私货。题材命中就按题材说，否则按信源档位说。

// 不依赖取模运算（脚本里没有 % 的现成用法，别拿它冒险）：减法取余。
// 不依赖取模运算（脚本里没有 % 的现成用法，别拿它冒险）：减法取余。


// 给一条挑一句私货。题材命中就按题材说，否则按信源档位说。
fn rv_text_line(){
    if rv_q.len() == 0 { return "" }
    if rv_i >= rv_q.len() { return "已经念完了" }
    let a = "" + (rv_i + 1)
    let b = "" + rv_q.len()
    "第 " + a + " / " + b + " 段"
}

// 念报要念哪几条。
// 为什么不能直接用 show_rows()：那是**结果页**的口径 —— 出报完成后卡片会回到
// 首页，这时候 show_rows() 返回空，于是读者在首页点「念给我听」只会听到一句
// 兜底（实测过）。可「今天的这一期」就是磁盘上那份 last_brief.json，
// 读者站在哪一页点，都该念得出来。所以这里补一层回退。
// 念报要念哪几条。
// 为什么不能直接用 show_rows()：那是**结果页**的口径 —— 出报完成后卡片会回到
// 首页，这时候 show_rows() 返回空，于是读者在首页点「念给我听」只会听到一句
// 兜底（实测过）。可「今天的这一期」就是磁盘上那份 last_brief.json，
// 读者站在哪一页点，都该念得出来。所以这里补一层回退。
fn rv_rows(){
    let rows = show_rows()
    if rows.len() > 0 { return rows }
    if last_rows.len() > 0 { return last_rows }
    []
}

fn rv_intro(){
    if ai_intro != "" { return ai_intro }
    if fs.exists("last_brief.json") {
        let raw = fs.read("last_brief.json")
        // ⚠️ 键不存在时 v.intro 会**抛错**（见 load_last 里那条注释：
        // object_heap.rs:935 + vm.rs:861「未捕获的错误立即终止本次求值」），
        // 所以先查原文里有没有这个键，有才去读。
        if raw.search("\"intro\":\"") >= 0 {
            let v = raw.parse_json()
            if v != nil {
                let t = "" + v.intro
                if t != "" { return t }
            }
        }
    }
    "这是今天的晨报"
}

fn rv_text(){
    if rv_on { return "■ 停下" }
    if rv_q.len() > 0 && rv_i < rv_q.len() { return "接着念" }
    "念这一期"
}

let fetch_tick = 0

fn already2(list, label){
    for x in list { if x == label { return true } }
    false
}

fn issues_load(){
    if !fs.exists("issues.json") { return }
    let v = fs.read("issues.json").parse_json()
    if v == nil { return }
    let it = v["items"]
    if it == nil { return }
    issues = it
}

// 存档行形状归一：渲染路径（row_meta / row_img / row_sum / panel_mark /
// open_story）都会碰这些字段，缺一个就抛错、整个闭包作废。这里一次性补全，
// 补的都是「空值」而不是假数据 —— 显示为空，不代表这条新闻有那个信息。
fn issue_rows_safe(rows){
    let out = []
    for r in rows {
        let one = {}
        one.id = "" 
        if r["id"] != nil { one.id = "" + r["id"] }
        one.title = ""
        if r["title"] != nil { one.title = "" + r["title"] }
        one.url = ""
        if r["url"] != nil { one.url = "" + r["url"] }
        one.link = ""
        if r["link"] != nil { one.link = "" + r["link"] }
        one.source = ""
        if r["source"] != nil { one.source = "" + r["source"] }
        one.summary = ""
        if r["summary"] != nil { one.summary = "" + r["summary"] }
        one.image = ""
        if r["image"] != nil { one.image = "" + r["image"] }
        one.tier = ""
        if r["tier"] != nil { one.tier = "" + r["tier"] }
        one.published = 0
        if r["published"] != nil { one.published = r["published"] }
        // 这三个也在渲染路径上被读（hn_id 读 discussion、row_meta 读 points/comments），
        // 归一时必须一起带上 —— 少一个，打开这一期时 sync_ui 就会中途中止，
        // 表现为「界面卡在上一状态、点按钮没反应」，不报错也看不出原因。
        one.discussion = ""
        if r["discussion"] != nil { one.discussion = "" + r["discussion"] }
        one.points = nil
        if r["points"] != nil { one.points = r["points"] }
        one.comments = nil
        if r["comments"] != nil { one.comments = r["comments"] }
        out.push(one)
    }
    out
}

fn issue_tab_text(i){
    if i >= issues.len() { return "" }
    let e = issues[i]
    let cur = "" + e.id == issue_sel
    if issue_sel == "" {
        if issues.len() > 0 { cur = "" + e.id == "" + issues[issues.len() - 1].id }
    }
    let lab = "" + e.stamp
    if e.failn > 0 { lab = lab + " !" }
    if cur { return "● " + lab }
    lab
}

fn issue_note_text(){
    if issue_sel == "" { return "" }
    "正在看存档的这一期 · 点最右边带 ● 的那枚回到本期"
}

// =====================================================================
// 工作台 · 档案（按时间查往期晨报、收藏）
// ---------------------------------------------------------------------
// 读者用时间找历史晨报，两种输入都收：
//   ① 「10月11日」「10-11」「1011」「昨天」「今天」→ 归一成 月-日 再比
//   ② 任意关键词 → 落到往期正文里找（标题/摘要），跟本地知识库同款匹配
// 收藏是「整期副本」：期次存档只留最近 5 期，收藏过的那一期即使被挤出
// 存档队列也还在收藏夹里 —— 这是「收藏」相对「回看」的唯一价值。
// 只读本机，不联网。
// =====================================================================

let wb_fav_schema = 1

fn wb_set_q(t){
    wb_arc_q = t
}

fn wb_cur_issue(){
    // 正在看的那一期：优先 issue_sel 指向的往期；否则就是最新一期。
    if issues.len() == 0 { return nil }
    if issue_sel != "" {
        for e in issues {
            if "" + e.id == issue_sel { return e }
        }
    }
    issues[issues.len() - 1]
}

fn wb_is_fav(id){
    for f in wb_favs { if "" + f.id == id { return true } }
    false
}

fn wb_fav_add(e){
    // 整期副本（含正文），存进本机收藏夹。
    let rows = issue_rows_safe(e.rows)
    wb_favs.push({id: "" + e.id stamp: "" + e.stamp intro: "" + e.intro rows: rows okn: e.okn failn: e.failn})
    // 收藏夹最多留 30 期（超出踢最旧的），不至于把本机存储撑大。
    while wb_favs.len() > 30 { wb_favs.remove(0) }
}

fn wb_fav_del_id(id){
    let kept = []
    for f in wb_favs {
        if "" + f.id != id { kept.push(f) }
    }
    wb_favs = kept
}

fn wb_fav_save(){
    fs.write("wb_favs.json", {schema: wb_fav_schema saved_at: time_now() items: wb_favs}.to_json())
}

fn wb_fav_load(){
    if !fs.exists("wb_favs.json") { return }
    let v = fs.read("wb_favs.json").parse_json()
    if v == nil { return }
    let it = v["items"]
    if it != nil { wb_favs = it }
}

fn wb_issue_missing(id){
    for e in issues { if "" + e.id == id { return false } }
    true
}

fn wb_pad(t){
    let n = t.to_f64()
    if !(n >= 1) { return t }
    let i = floor(n)
    if i < 10 { return "0" + ("" + i) }
    "" + i
}

fn wb_digits_only(s){
    let out = ""
    for c in s.split("") {
        if c != "" {
            if c.search("0") >= 0 || c.search("1") >= 0 || c.search("2") >= 0 || c.search("3") >= 0 || c.search("4") >= 0
                || c.search("5") >= 0 || c.search("6") >= 0 || c.search("7") >= 0 || c.search("8") >= 0 || c.search("9") >= 0 {
                out = out + c
            }
        }
    }
    out
}

fn wb_rel_date(q){
    // 相对日期：今天 / 昨天 / 前天 → 折成 月-日
    let s = q.trim()
    let t = local_time(time_now() + 28800)
    let off = -1
    if s.search("今天") >= 0 { off = 0 }
    else if s.search("昨天") >= 0 { off = 1 }
    else if s.search("前天") >= 0 { off = 2 }
    if off < 0 { return "" }
    let d = local_time(time_now() + 28800 - off * 86400)
    pad2(d.month) + "-" + pad2(d.day)
}

fn wb_issue_date(e){
    // 期次的时间戳 → 月-日（跟 wb_norm_date 的输出同口径）
    let ts = e.id.to_f64()
    if !(ts > 0) { return "" }
    let t = local_time(ts + 28800)
    pad2(t.month) + "-" + pad2(t.day)
}

fn wb_issue_md(e){
    let ts = e.id.to_f64()
    if !(ts > 0) { return "" }
    let t = local_time(ts + 28800)
    months[t.month - 1] + " " + t.day + " " + pad2(t.hour) + ":" + pad2(t.minute)
}

fn wb_trim_res(){
    let kept = []
    let k = 0
    for e in wb_arc_res {
        if k < 2 { kept.push(e) }
        k = k + 1
    }
    wb_arc_res = kept
}

fn wb_res_line(i){
    if i >= wb_arc_res.len() { return "" }
    let e = wb_arc_res[i]
    let lab = wb_issue_md(e) + " · " + e.rows.len() + " 条"
    if wb_is_fav("" + e.id) { lab = lab + " · ★收藏" }
    lab
}

fn wb_fav_line(i){
    if i >= wb_favs.len() { return "" }
    let f = wb_favs[i]
    wb_issue_md(f) + " · " + f.rows.len() + " 条"
}

fn wb_fav_head_text(){
    if wb_favs.len() == 0 { return "收藏夹是空的 —— 找到了想留着的那一期，点「收藏」" }
    "收藏夹 · " + wb_favs.len() + " 期（点「打开」看正文，「移除」从收藏夹拿掉）"
}

fn wb_hint_text(){
    return wb_arc_note
}

// 档案分区每次 sync_ui 都刷新一遍（命名控件 + set_text / set_visible，
// 不用 on_render：面板里的 on_render 重建子控件会打断布局，见期次标签条的教训）。
fn wb_fav_i1(){
    wb_favs.len() - 1
}

fn wb_fav_i2(){
    wb_favs.len() - 2
}

fn wb_star_text(){
    let e = wb_cur_issue()
    if e == nil { return "☆ 收藏这一期" }
    if wb_is_fav("" + e.id) { return "★ 已收藏" }
    "☆ 收藏这一期"
}

fn stamp_label(ts){
    let t = local_time(ts + 28800)
    months[t.month - 1] + " " + t.day + " " + pad2(t.hour) + ":" + pad2(t.minute)
}


fn set_ask(t){
    ask = t
    ui.intent_line.set_text(intent_preview())
}

fn cover_fallback_sub(){
    // 兜底副标题：拿导语的开头，或者第一条标题。
    let t = ai_intro
    if t == "" {
        let i = 0
        for r in picked {
            if i == 0 { t = r.title }
            i = i + 1
        }
    }
    if t == "" { t = "今天的科技新闻" }
    art_cut(t, 44)
}

fn cover_save(){
    fs.write("cover.json", {ts: last_at head: cover_head sub: cover_sub url: cover_url q: cover_q}.to_json())
}

fn cover_line(){
    if cover_state == "ok" {
        if cover_mm { return "MiniMax image-01 生成 · 换一张会重新画" }
        return "官方画图能力生成 · 换一张会重新画"
    }
    cover_note
}

fn vc_auto_text(){
    // 别在没探之前就写「不可用」——那是把「还没问」说成了「不能用」。
    if !vc_probed { return "语音：点一下试" }
    if vc_tts {
        if vc_auto { return "● 自动朗读" }
        return "自动朗读"
    }
    "语音不可用"
}

fn art_load(){
    if fs.exists("art_cache.json") {
        let v = fs.read("art_cache.json").parse_json()
        if v != nil && v.items != nil {
            for it in v.items {
                if it.id != nil && it.url != nil && it.url != "" {
                    art_cache.push({id: it.id url: it.url})
                }
            }
        }
    }
}

fn cg_off(){
    ui.cg_eye.set_text("")
    ui.cg_ttl.set_text("")
    ui.cg_rul.set_text("")
    ui.cg_pet.set_visible(false)
    ui.cg.set_visible(false)
    // 常驻桌宠层与 tick 回归（开场时被收起来的）。
    ui.pet_layer.set_visible(true)
    pet_tick_on = true
}

// ---- 开场 CG · B 方案帧轮播（51 帧 @ 133ms ≈ 6.8 秒）----
// mp4 没法在 splash 里播，抽帧轮播是等价替代。放完整段自动 cg_off()。
// ⚠️ splash 没有 % 取模也没有格式化，补零用小函数手写。

// ---- 咕嘎的表情：底部那个常驻编辑形象跟着本报的进度换脸（同一套桌宠贴图）----
// 换脸只改「基础表情」；呼吸帧、说话口型、动作帧由下面的桌宠系统接管（pet_apply 统一出帧）。
let pet_expr = "idle"
fn pet_phase_expr(){
    if phase == "done" { return "cheer" }
    if phase == "refused" { return "sad" }
    if phase == "denied" { return "pout" }
    if phase == "asking" { return "surprised" }
    if phase == "fetching" || phase == "judging" { return "sleepy" }
    "idle"
}

// =====================================================================
// 咕嘎桌宠 · 从桌面企鹅整只搬进来的神态、互动与话术
// ---------------------------------------------------------------------
// 迁移说明（桌宠 -> 卡片）：
//   * 桌宠里呼吸/蹦跳/受惊抖/探头/傲娇摆头/前倾，是运行时对同一张贴图做
//     位移+挤压+旋转算出来的；卡片的脚本没有这些变换原语，所以同一套变换
//     在 my-entry/guga/bake_motion_frames.py 里离线烘焙成了帧（assets/guga/motion/），
//     运行时换帧 = 同一套动作语义。
//   * 说话口型同理：闭嘴基准帧 + 张嘴补丁 -> talk0/1/2 三帧（make_talk_frames.py），
//     念稿时循环换帧，念完停下。
//   * 话术沿用桌宠的娇憨傲娇人设（自称"本鹅"、管你叫"饲养员"），题材从
//     酒馆战棋换成本报与编辑部 —— 炉石相关的台词全部剔除，一句不留。
//   * 互动：点一下 = 戳它（桌宠的鼠标单击），长按 = 互动菜单（对应桌宠的右键菜单）。
//   * 语音：宿主有语音能力时，它的每句话都会念出来，同时嘴动（口型帧）；
//     没有语音就只出气泡和口型（不静默失败，也不因语音不可用影响别的功能）。
// =====================================================================

