    {id: "ithome"   plat: "ithome"   label: "IT之家"       host: "www.ithome.com"   note: "最新资讯"      kind: "rss"    url: "https://www.ithome.com/rss/"}
    {id: "bili"     plat: "bili"     label: "B站热门"      host: "api.bilibili.com" note: "综合热门榜"   kind: "bili"   url: "https://api.bilibili.com/x/web-interface/popular?ps=20&pn=1"}
    {id: "douyin"   plat: "douyin"   label: "抖音热榜"     host: "www.iesdouyin.com" note: "热搜榜"      kind: "dy"     url: "https://www.iesdouyin.com/web/api/v2/hotsearch/billboard/word/"}
    {id: "yt1"      plat: "youtube"  label: "YouTube · Fireship" host: "www.youtube.com" note: "最新视频" kind: "rss" url: "https://www.youtube.com/feeds/videos.xml?channel_id=UCsBjURrPoezykLs9EqgamOA"}
