// =====================================================================
// 决策台 · Jev / System One 式的「校准选择」
// ---------------------------------------------------------------------
// 2026 年 9 月，TypeSafe AI 放出 Jev：它不写文章，只把输入归进「预设输出集合」，
// 返回是/否概率、从给定选项里选一个、或按等级打分——结果带类型、带置信度，
// 程序可以直接拿去做分支。随后 OpenAI 上线 Decisions API、Databricks 出 ai_decide、
// Cloudflare 放开源 Clef 系列：行业开始分工，生成式模型写给人看，决策模型给代码用。
// 这个应用把这条分工搬进编辑部：主编（生成式）照旧写导语与入选理由，给人读；
// 决策台拿同一批候选再判一次，只回「选项 + 置信度」，给程序用。两边不一致的地方
// 记成「分歧」，写进留痕。
// 本机没有 System One 端点，所以这里走同一条 model.complete 通道，把 schema 收紧成
// 「预设集合 + 0-100」，并把「不要写理由」写进 task —— 不在没有端点时假装有端点，
// 只把决策模型那套约束老老实实照搬过来。将来有真正的决策端点，替换 vd_kick() 里
// 那一次 host.request 即可，其余不动。
// =====================================================================

// 预设输出集合：像 Jev 的 Choice 一样，答案只能落在这四个里，落不进去记 unknown。
let vd_tiers = ["first" "second" "rumor" "repost"]
let vd_shape = {type: "object" required: ["verdicts"] properties: {verdicts: {type: "array" items: {type: "object" required: ["i" "tier" "worth" "heat"] properties: {i: {type: "integer"} tier: {type: "string"} worth: {type: "integer"} heat: {type: "integer"}}}}}}

let vd_state = ""
let vd_note = ""
let vd_rows = []
let vd_agree = 0
let vd_unknown = 0
let vd_ms = 0
let vd_tokens = 0
let vd_t0 = 0

// 一次调用、三个问题，全部是「有限选项」：档位（Choice）、够不够格（Noul）、热度（Score）。
fn vd_kick(){
    if picked.len() == 0 { return }
    vd_reset()
    vd_state = "asking"
    vd_note = "决策台正在对同一批候选做一次校准判断…"
    sync_ui()
    let list = ""
    let i = 0
    for r in picked {
        list = list + "" + i + ". [" + tier_label(r) + "] " + r.title + "\n"
        i = i + 1
    }
    vd_t0 = time_now()
    host.request("model.complete", {
        task: "[编辑部宪法 judge/" + charter_v("judge") + "]\n你是决策台，不是写手。同一批候选，生成式主编已经写过理由，你只做三件事：给每条归一个信源档位、给一个「够不够格上晨报」的概率、给一个热度分。硬规矩：tier 只能取 first / second / rumor / repost 四个值之一，落不进任何一档就写 unknown；worth 是「这条够格上晨报」为真的概率，0 到 100 的整数；heat 是公众关注度，0 到 10 的整数。不要写任何解释、理由或句子。直接输出 JSON，第一个字符就是 {，不要围栏，不要思考过程。结构：verdicts 是数组，每项含 i（候选序号，整数）、tier（字符串）、worth（整数）、heat（整数）。"
        input: "候选（序号从 0 开始；每条前面的方括号是本报按域名判出的信源档位，仅供参考）：\n" + list
        schema: vd_shape
        class: "fast"
        allow_urls: false
    }, fn(r){
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.verdicts != nil {
            vd_ms = (time_now() - vd_t0) * 1000
            vd_tokens = model_tokens(r.data)
            vd_put(r.data.output.verdicts)
            vd_state = "ok"
            vd_trail()
        } else {
            vd_state = "failed"
            vd_note = "决策台这次没有答复，本期的取舍仍然以上面那一版为准。"
        }
        sync_ui()
    })
}

// 把回答收进预设集合：落不进集合的档位一律记 unknown，别让自由文本混进结构化结果。
// 同时跟本报按域名判出的档位对一下，不一致就是一次「分歧」。
fn vd_open(k){
    if k >= vd_rows.len() { return }
    open_story(vd_rows[k].row)
}

// =====================================================================
// 真伪核验台 · 把「这条是真的吗」变成一个可以被追问的数字
// ---------------------------------------------------------------------
// 读者最该问的问题是：B站、抖音这类用户投稿平台上的消息，凭什么进新闻日报。
// 日报不能只写「本报已核实」——那是一句无法追问的断言。这里换成两个可追问的量：
//
//   证据分（本机算，可复算）  来源档位先验 + 跨源一致性加成，且被档位封顶
//   模型分（一次有限选项调用）模型只回「为真概率 / 依据 / 有没有相反证据」
//   校准分 = (模型分 + 2 × 证据分) / 3        证据占 2/3
//
// 权重这样分是有意的：模型可以补上「这句话本身合不合理」，但不允许它单独
// 把一条消息判成真的。一条只有一家在说的消息，模型说 95 也没用。
//
// 每条还给一个**区间**，宽度随同行来源数收窄 ——「为真 62%」和
// 「为真 62%，区间 44–80」说的是两件事，后者才是诚实的。
//
// 跨源一致性是真数出来的：把标题切成「长词」当指纹，拿去别的来源的标题里找，
// 命中 ≥2 个长词（或 1 个 10 字以上的长词）就算同一件事，然后数**不同渠道**。
// 同域名重复出现只算一次 —— 同一家媒体转自己不算互相印证。
// =====================================================================

let vf_shape = {type: "object" required: ["items"] properties: {items: {type: "array" items: {type: "object" required: ["i" "truth" "basis" "contra"] properties: {i: {type: "integer"} truth: {type: "integer"} basis: {type: "string"} contra: {type: "boolean"}}}}}}

// 用户投稿平台：单来源不足以当新闻，必须有人跟着报
let vf_ugc = ["bilibili.com" "douyin.com" "iesdouyin.com" "youtube.com"]
// 一手机构/权威科技媒体：自己就是消息源，或有一手采编
let vf_auth = ["reuters.com" "bloomberg.com" "apnews.com" "ft.com" "wsj.com" "nytimes.com" "theverge.com" "arstechnica.com" "techcrunch.com" "wired.com" "ithome.com" "infoq.cn" "sspai.com" "arxiv.org" "github.com" "techmeme.com" "ycombinator.com" "nasa.gov" "nature.com" "science.org" "ieee.org"]

// 指纹词用的一条正则，**模块级只建一次**。
// 踩过的坑：最初把它写在 vf_words() 里，每个词现建一次 —— 6 条入选 × 80 条候选 × 每条七八个词，
// 一次回调里要建将近三千个正则，直接把脚本的指令预算打爆
// （`[E] script instruction limit exceeded`），核验台在界面上永远停在「正在判…」。
// 这个平台的回调是**带指令预算**的，重活必须提前算好、能缓存的都缓存。
//
// 用 `\w+` 一次扫完整条标题（match_all），而不是「按空格切分 + 每个词做一次
// `replace([^\w], "")`」。后者一条标题十几个词就要跑十几次正则；
// 索引范围扩到 80 条全量之后，这一步会把脚本的**时间预算**顶爆
// （`[E] script time budget exceeded` —— 注意这跟指令数超限是两回事，是墙钟时间）。
let vf_wordpat = regex("\\w+", "g")

let vf_state = ""
let vf_note = ""
let vf_rows = []
let vf_ev = []
// id → 指纹词表。整批候选在 vf_kick 开头一次性算好，后面全是纯字符串比对，不再碰正则。
let vf_wc = {}
// 长词 → 域名表（倒排索引）。跨源一致性靠它做 O(总词数) 判定，而不是 O(入选×候选)。
let vf_index = {}
let vf_ms = 0
let vf_tokens = 0
let vf_t0 = 0
let vf_avg = 0
let vf_weak = 0
let vf_contra = 0
// 当前被「点开看证据链」的那几行（存行号）。核验台的数字之所以可核对，
// 是因为点一下能看见它是怎么加出来的 —— 这一步以前缺，分数就只是一句断言。
let vf_x = []
// 核验台这次问了几遍（第一遍拿不到合法 JSON 会带着「只输出 JSON」的提醒重问一次）
let vf_try = 0
// 每次问答的编号。重问会 +1，旧的定时器与旧的回调一到就作废，
// 免得第一次的半路答复把第二次的结果盖掉。
let vf_gen = 0
// 交给核验台的那份候选清单（序号 + 本报已算出的证据）。重问时原样再用一遍。
let vf_list = ""

fn vf_words(t){
    // 标题 → 指纹词。用 `\w+` 一次扫出所有「词」，标点符号自动被隔开丢掉。
    //
    // 踩过的坑（已报上游，见 my-entry/patches/UPSTREAM-regex-p.md）：
    // makepad 内置正则只认 \n \r \t 与 \d \s \w，**没有 \p{...}**。
    // 最早的写法是 `\p{P}|\p{S}|\s`，编译直接失败 —— 不是返回 false，
    // 而是抛出一个 script trap，把**整个 vf_kick() 吞掉**：请求根本没发出去，
    // 界面上停在「核验台正在判…」一动不动，看不出任何原因。
    // `\w` 是完整的 Unicode 词类（libs/regex/src/unicode.rs 的 WORD 表，
    // U+4E00–U+A48C 在里面），中英混排都稳，正好够用。
    //
    // 这里只做**粗筛**（字节数 ≥6），不做逐字符精确计数：
    // 精确字数（vf_chars）要分配一个字符数组，是整条链路里最贵的一步，
    // 而它在后面 vf_peer_scan_s 里对少数条目算一次就够了。
    // 粗筛偏宽不会有正确性问题 —— 被判进来的短词在扫描阶段还会被精确字数挡掉。
    let out = []
    let ms = ("" + t).match_all(vf_wordpat)
    if ms == nil { return out }
    for m in ms {
        let c = "" + m.value
        if c.len() < 6 { continue }
        out.push(c)
    }
    out
}

fn vf_warm(){
    // 整批条目一次算完指纹词，写进缓存。这是把「每条比一次」从
    // O(入选 × 候选 × 词数) 降到 O(条目 × 词数) 的关键一步 —— 也正是不爆指令预算的原因。
    //
    // 索引范围是**全部抓到的条目**（all_rows），不是候选池。这一点很关键：
    // 候选池只有 16 条（我们从 80 条里挑出来的），而「有几家渠道在报同一件事」
    // 是这条消息**在整个抓取范围内的**属性，跟它有没有被我们选中无关。
    // 只索引候选池的话，HN 的 30 条一条都没进池，于是同一条消息即使被 HN 和 TechMeme
    // 同时收录也永远算不出来 —— 界面上表现为「无第二家跟进」恒为 0，看不出错。
    vf_wc = {}
    for c in all_rows { vf_wc[c.id] = vf_words(c.title) }
    for r in picked { if vf_wc[r.id] == nil { vf_wc[r.id] = vf_words(r.title) } }
    vf_index_build()
}

fn vf_wcache(r){
    let got = vf_wc[r.id]
    if got != nil { return got }
    let w = vf_words(r.title)
    vf_wc[r.id] = w
    w
}

fn vf_index_build(){
    // 倒排索引：长词 → 出现过这个词的域名（域名用 | 包起来，便于精确包含判断）。
    //
    // 原来是「每条入选 × 每条候选」两两比标题（O(n²)），一次回调里要跑几百次集合比对，
    // 实测会把脚本的指令预算打爆，核验台在界面上永远停在「正在判…」。
    // 改成倒排之后是 O(总词数)，而且**跨源一致性才真的数得出来**。
    //
    // 用「|域名|…|」这种字符串而不是数组，是因为要跨 map 读改写：
    // 数组是不是引用语义在这个 DSL 里不好确认，字符串拼接没有这个问题。
    //
    // 只索引 4 字以上的词：短词（AI、the、new）跨标题重合太普遍，
    // 会把两条无关新闻算成互相印证 —— 那是比「数不出来」更严重的错。
    vf_index = {}
    for c in all_rows {
        let h = row_ch(c)
        if h == "" { continue }
        for w in vf_wcache(c) {
            // vf_words 已经保证每个词 ≥4 字，这里不再重复逐字符计数（那是最贵的一步）。
            let cur = vf_index[w]
            let needle = "|" + h + "|"
            if cur == nil { vf_index[w] = needle }
            else if cur.search(needle) < 0 { vf_index[w] = cur + h + "|" }
        }
    }
}

fn vf_peer_scan_s(r, min_chars, need_strong){
    // 一次扫描同时算「强印证」和「弱信号」。
    //   强（need_strong 为真）：与某一家重合 ≥2 个长词，或重合 1 个 10 字以上的长词。
    //   弱（need_strong 为假）：与某一家至少重合 1 个 ≥min_chars 字的词。
    // 强信号进分数；弱信号只在界面上提一句，**绝不参与打分** ——
    // 两家都提到 Microsoft 不构成互相印证，但读者有权利知道我们看见了什么。
    let h0 = row_ch(r)
    let doms = []
    let cnt = []
    let longest = []
    for w in vf_wcache(r) {
        let n = vf_chars(w)
        if n < min_chars { continue }
        let bag = vf_index[w]
        if bag == nil { continue }
        for h in vf_dom_split(bag) {
            if h == h0 { continue }
            let k = vf_pos(doms, h)
            if k < 0 {
                doms.push(h)
                cnt.push(1)
                longest.push(n)
            } else {
                cnt[k] = cnt[k] + 1
                if n > longest[k] { longest[k] = n }
            }
        }
    }
    let hit = []
    let k = 0
    for h in doms {
        // 变量名不能叫 ok —— 保留字（parser.rs: if id == id!(ok) 会把裸 ok 当 ok 表达式）。
        // 踩过：写成 let ok = false，整个 vf_peer_scan_s 被 parser skip，
        //      倒排索引静默失效、核验台「同行家数」恒 0。
        let pass = false
        if need_strong {
            if cnt[k] >= 2 || longest[k] >= 10 { pass = true }
        } else {
            pass = true
        }
        if pass { hit.push(h) }
        k = k + 1
    }
    {n: hit.len() doms: hit}
}

fn vf_peers(r){
    // 强印证：有几家**不同渠道**在报同一件事。只有这个数进证据分。
    vf_peer_scan_s(r, 4, true).n
}

fn vf_weak_peers(r){
    // 弱信号：有几家不同渠道至少共享一个 6 字以上的长词。不进分数，只提示。
    let strong = vf_peer_scan_s(r, 4, true).doms
    let all = vf_peer_scan_s(r, 6, false).doms
    let n = 0
    for h in all {
        if !already2(strong, h) { n = n + 1 }
    }
    n
}

fn vf_peers_dom(r, want){
    // 与本条强印证的那几家分别是谁（给阅读页用）。
    vf_peer_scan_s(r, 4, true).doms
}

fn vf_same(a, b){
    // 两行是不是在说同一件事 —— 纯字符串集合比对，全程不碰正则。
    // 现在只被阅读页的「跟谁对上了」用到，主路径走倒排索引。
    let wa = vf_wcache(a)
    let wb = vf_wcache(b)
    let n = 0
    let longest = 0
    for w in wa {
        if already2(wb, w) {
            n = n + 1
            if vf_chars(w) > longest { longest = vf_chars(w) }
        }
    }
    if n >= 2 { return true }
    if n >= 1 && longest >= 10 { return true }
    false
}

fn vf_peers_slow(r){
    // 保留一份「两两比」的实现：倒排索引只按词命中，理论上会有假阳性
    // （比如两家都在说 Microsoft 但说的不是一件事）。这个方法用来对账，
    // 不参与主路径。真要复核某一条时，可以手工换成它。
    let hosts = []
    let h0 = row_ch(r)
    for c in all_rows {
        if c.id == r.id { continue }
        let h = row_ch(c)
        if h == h0 { continue }
        if vf_same(r, c) {
            if !already2(hosts, h) { hosts.push(h) }
        }
    }
    hosts.len()
}

fn vf_evidence(r){
    // 可复算的证据分。先验 + 跨源加成，再按档位封顶：
    //   * 传闻任何时候不许超过 55
    //   * 用户投稿平台且无人跟报，不许超过 58
    //
    // 返回的是**逐段可核对的拆解**，不只是最后那个分数。
    // 踩过的坑：原来只返回 {score peers}，界面上一条「另有 1 家渠道也在报」的记录
    // 证据分仍显示 74 —— 读者根本看不出跨源加成有没有真的加进去。
    // 「可核对」既然是卖点，口径就必须自洽：先验多少、加成多少、有没有触顶，
    // 三段都要能摆出来，读者才能自己加一遍对上。
    let peers = vf_peers(r)
    let bonus = 0
    let bwhy = "没有第二家渠道同报，不加分"
    if peers >= 1 { bonus = 10 bwhy = "" + peers + " 家不同渠道同报（达 1 家门槛，+10）" }
    if peers >= 2 { bonus = 17 bwhy = "" + peers + " 家不同渠道同报（达 2 家门槛，+17）" }
    if peers >= 4 { bonus = 22 bwhy = "" + peers + " 家不同渠道同报（达 4 家门槛，+22）" }
    let cap = 92
    let cwhy = "通用上限"
    if tier_of(r) == "rumor" { cap = 55 cwhy = "传闻封顶" }
    for d in vf_ugc {
        if dom_hit(row_host(r), d) { if peers == 0 { cap = 58 cwhy = "用户投稿且无人跟报，封顶" } }
    }
    let prior = vf_prior(r)
    let raw = prior + bonus
    let v = raw
    let capped = false
    if v > cap { v = cap capped = true }
    if v < 5 { v = 5 }
    {score: v peers: peers prior: prior bonus: bonus raw: raw cap: cap capped: capped capwhy: cwhy bonuswhy: bwhy}
}

fn vf_kick(){
    if picked.len() == 0 { return }
    vf_reset()
    vf_state = "asking"
    vf_note = "真伪核验台正在对每条候选做一次校准判断…"
    sync_ui()
    // 先把整批候选的指纹词算好，再按条取证据 —— 顺序不能反，否则每条都要重算一遍。
    vf_warm()
    // 先把本地证据算出来，连同行一起交给模型 ——
    // 让它在证据上判断，而不是凭空猜；模型看不到的，我们也不假装它看到了。
    vf_list = ""
    let i = 0
    for r in picked {
        let ev = vf_evidence(r)
        vf_ev.push(ev)
        vf_list = vf_list + "" + i + ". [" + vd_tier_name(tier_of(r)) + " · 同报渠道 " + ev.peers + " 家] " + r.title + "\n"
        i = i + 1
    }
    vf_ask()
}

fn vf_ask(){
    // 与核验台的一次问答。单独拎出来，是为了能**重问**：
    // 模型偶尔会返回一个被截断的 JSON（宿主报 `EOF while parsing a list`），
    // 一次拿不到合法结果，就带着「只输出 JSON」的提醒再问一次，
    // 而不是把这一次失败直接当成「核验台不干了」。
    // 重问只给一次机会（vf_try 到 1 就收手，一共问两遍），落回本机证据模式 ——
    // 不能拿读者的等待时间去换一个不保证会来的答复。
    vf_gen = vf_gen + 1
    let g = vf_gen
    vf_t0 = time_now()
    // 兜底：模型这条线可能永远不会回来（网络断了、宿主换了实现、脚本自己抛错）。
    // 没有这道闸，界面会永远停在「核验台正在判…」——那比给一个保守分数更糟。
    start_timeout(50.0, || vf_watch(g))
    host.request("model.complete", {
        task: "[编辑部宪法 judge/" + charter_v("judge") + "]\n你是核验台，不是写手。给你一批已入选的候选，每条前面的方括号里是本报**已经算出**的证据：信源档位、还有几家不同渠道在报同一件事。你只回答三个字段：truth 是「这条消息本身为真」的概率，0 到 100 的整数；basis 是一句不超过 22 个字的依据，必须指向可检验的东西——谁说的、有没有原始出处、数字或时间对不对；contra 是布尔值，见到相反证据写 true，没有写 false。硬规矩：truth 不许超过 95，也不许低于 5；同报渠道 0 家时不许超过 70；档位是「传闻·未证实」时不许超过 55。不要写解释，不要复述标题，不要输出思考过程。直接输出 JSON，第一个字符就是 {。结构：items 是数组，每项含 i（候选序号，整数）、truth（整数）、basis（字符串）、contra（布尔）。" + vf_remind()
        input: "候选（序号从 0 开始；方括号里是本报已算出的证据，不是你判断的结果）：\n" + vf_list
        schema: vf_shape
        class: "fast"
        allow_urls: false
    }, fn(r){
        if vf_gen != g { return }
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.items != nil {
            vf_ms = (time_now() - vf_t0) * 1000
            vf_tokens = model_tokens(r.data)
            vf_put(r.data.output.items)
            vf_state = "ok"
            vf_trail()
            sync_ui()
        } else if vf_try < 1 {
            // 一共问两遍：第一遍不成，带着提醒再问一遍，第二遍不成才落到本机证据模式。
            let why = ""
            if r.error != nil && r.error != "" { why = "（" + art_cut("" + r.error, 48) + "）" }
            vf_note = "核验台这次的答复不是合法 JSON" + why + "，已带着「只输出 JSON」的提醒重问一次。"
            vf_try = vf_try + 1
            sync_ui()
            vf_ask()
        } else {
            vf_note = "核验台两次都没有给出可用答复。下面给出的是**只用本机证据**算出的分（不含模型那一票）。"
            vf_put([])
            vf_state = "local"
            vf_trail()
            sync_ui()
        }
    })
}

fn vf_watch(g){
    // 到点还没消息就降级：宁可给一个只用本机证据算出来的保守分，也不留一块死界面。
    if vf_gen != g { return }
    if vf_state != "asking" { return }
    if vf_rows.len() > 0 { return }
    vf_note = "核验台没有在时限内答复。下面给出的是**只用本机证据**算出的分（不含模型那一票）。"
    vf_put([])
    vf_state = "local"
    vf_trail()
    sync_ui()
}

fn vf_put(list){
    vf_rows = []
    let seen = []
    for v in list {
        let idx = v.i
        if idx == nil { continue }
        if idx < 0 || idx >= picked.len() { continue }
        if already2(seen, idx) { continue }
        seen.push(idx)
        let m = 0
        if v["truth"] != nil { m = v["truth"] }
        if m < 0 { m = 0 }
        if m > 100 { m = 100 }
        let basis = ""
        if v["basis"] != nil { basis = art_cut("" + v["basis"], 40) }
        let contra = false
        if v["contra"] != nil { contra = v["contra"] }
        vf_push(idx, m, basis, contra)
    }
    // 模型漏答的条目，用纯证据分补齐：宁可分数偏保守，也不要缺一行
    let i = 0
    for r in picked {
        if !already2(seen, i) {
            vf_push(i, -1, "核验台没有对这条作答，这一分只由本机证据给出", false)
        }
        i = i + 1
    }
    // 汇总
    let sum = 0
    vf_weak = 0
    vf_contra = 0
    for x in vf_rows {
        sum = sum + x.cal
        if x.cal < 60 { vf_weak = vf_weak + 1 }
        if x.contra { vf_contra = vf_contra + 1 }
    }
    if vf_rows.len() > 0 { vf_avg = floor(sum / vf_rows.len()) }
}

fn vf_push(idx, m, basis, contra){
    // 越界一律丢掉，绝不抛错：这道闸门后面接着的是定时器与模型回调，
    // 在那儿抛一个 trap 会把整条链路连同界面一起带走。
    if idx < 0 || idx >= picked.len() { return }
    if idx >= vf_ev.len() { return }
    let r = picked[idx]
    let ev = vf_ev[idx]
    let cal = ev.score
    if m >= 0 { cal = floor((m + ev.score * 2) / 3) }
    let sp = vf_spread(ev.peers)
    let half = floor(sp / 2)
    let lo = cal - half
    let hi = cal + half
    if lo < 1 { lo = 1 }
    if hi > 99 { hi = 99 }
    vf_rows.push({row: r model: m ev: ev.score peers: ev.peers weak: vf_weak_peers(r) contra: contra basis: basis cal: cal lo: lo hi: hi prior: ev.prior bonus: ev.bonus raw: ev.raw cap: ev.cap capped: ev.capped capwhy: ev.capwhy bonuswhy: ev.bonuswhy doms: vf_peers_dom(r, 4)})
}

fn vf_toggle(k){
    // 点一行 = 展开/收起它的证据链。不改成「点了就跳阅读页」——
    // 读者在这一屏问的是「你这个 74 分是怎么来的」，不是「这条新闻写了什么」。
    if vf_x_has(k) {
        let out = []
        for i in vf_x { if i != k { out.push(i) } }
        vf_x = out
    } else {
        vf_x.push(k)
    }
    sync_ui()
}

fn vf_shared_words(r){
    // 本条标题里，**在别的渠道的标题里也出现过**的长词（判定用的那批）。
    // 只给读者看，不参与打分 —— 打分的口径在 vf_peer_scan_s 里，这里只是把它摊开。
    let h0 = row_ch(r)
    let out = []
    for w in vf_wcache(r) {
        if vf_chars(w) < 4 { continue }
        let bag = vf_index[w]
        if bag == nil { continue }
        let seen = false
        for h in vf_dom_split(bag) {
            if h != h0 { seen = true }
        }
        if seen {
            out.push(w)
            if out.len() >= 6 { break }
        }
    }
    let s = ""
    let j = 0
    for w in out {
        if j > 0 { s = s + "、" }
        s = s + w
        j = j + 1
    }
    s
}

fn vf_chain(k){
    // 点开后看到的东西：每一段数字是怎么来的、跟报的是谁、以及最后那一步加权。
    // 这一屏的存在意义就是让「可核对」从一句口号变成一串可以当场验算的等式。
    if k >= vf_rows.len() { return "" }
    let x = vf_rows[k]
    let t = "这一条的数是怎么来的（每一段都能自己验算）：\n"
    t = t + "① 来源档位先验 " + x.prior + " 分 —— 域名 " + row_host(x.row) + "，档位「" + tier_label(x.row) + "」\n"
    t = t + "② 跨源加成 +" + x.bonus + " 分 —— " + x.bonuswhy + "\n"
    t = t + "③ 合计 " + x.raw + " 分，上限 " + x.cap + " 分（" + x.capwhy + "）"
    if x.capped { t = t + "，这一条触顶了" }
    t = t + "，所以证据分 = " + x.ev + "\n"
    if x.doms.len() == 0 {
        t = t + "跟报渠道：无（整批抓到的条目标题里，没有第二家渠道跟它重合到判定门槛）\n"
    } else {
        let j = 0
        let nm = ""
        for h in x.doms {
            if j > 0 { nm = nm + "、" }
            nm = nm + ch_label(h)
            j = j + 1
        }
        t = t + "跟报渠道（" + x.doms.len() + " 家）：" + nm + "\n"
    }
    let sw = vf_shared_words(x.row)
    if sw != "" { t = t + "比对用的长词：" + sw + "（判定门槛：与同一家重合 ≥2 个长词，或 1 个 ≥10 字的长词）\n" }
    let mm = "模型这一票 " + x.model
    if x.model < 0 { mm = "模型这一票：没有作答（这一条只由本机证据给出）" }
    t = t + mm + "\n"
    t = t + "④ 校准分 " + x.cal + " = (模型 " + x.model + " + 2 × 证据 " + x.ev + ") ÷ 3 —— 证据占三分之二，模型是配角"
    t
}

fn vf_open(k){
    if k >= vf_rows.len() { return }
    open_story(vf_rows[k].row)
}



HostedView{width: Fill height: Fill
    full: View{width: Fill height: Fill flow: Overlay show_bg: true draw_bg.color: ground
        browse := ScrollYView{width: Fill height: Fill flow: Down spacing: 14 padding: Inset{left: 16 right: 16 top: 16 bottom: 300}
            // ---- 报头 · 清晨太阳：夜将尽、日初升 ----
            //   纯 shader 画（不加载任何图片）：天空从夜蓝渐到地平线暖金，
            //   右下角一轮初升的太阳，光晕随呼吸微动，一道晨光带缓缓摆过去。
            //   「清晨太阳」是这一版的主题，所以它出现在最显眼的位置，而不是又一块深色底。
            hero := RoundedView{width: Fill height: 168
                new_batch: true draw_bg.border_radius: 20.0
                draw_bg +: {
                    pixel: fn() {
                        let mbT = self.draw_pass.time * 1.0
                        let mbSz = self.rect_size
                        let mbP = self.pos * mbSz
                        let mbU = mbP.x / mbSz.x
                        let mbV = mbP.y / mbSz.y
                        // 天空：夜蓝 -> 蓝紫 -> 地平线暖金（三段渐变）
                        let mbTop = #x0b1424
                        let mbMid = #x24304e
                        let mbHor = #xc9822f
                        var mbCol = mbTop.mix(mbMid, smoothstep(0.0 0.62 mbV))
                        mbCol = mbCol.mix(mbHor, smoothstep(0.66 1.06 mbV))
                        // 地平线亮带
                        let mbHz = 1.0 - smoothstep(0.0 26.0 abs(mbP.y - mbSz.y * 0.86))
                        mbCol = mbCol.mix(#xffd9a0, mbHz * 0.35)
                        // 太阳：右下角一轮，带两层光晕
                        let mbSun = vec2(mbSz.x * 0.78, mbSz.y * 1.02)
                        let mbR = length(mbP - mbSun)
                        let mbDisc = 1.0 - smoothstep(15.0 17.5 mbR)
                        let mbGlow = 1.0 - smoothstep(0.0 96.0 mbR)
                        let mbHalo = 1.0 - smoothstep(0.0 200.0 mbR)
                        mbCol = mbCol.mix(#xffca7a, mbHalo * mbHalo * 0.5)
                        mbCol = mbCol.mix(#xffdc9e, mbGlow * 0.55)
                        mbCol = mbCol.mix(#xfff6e6, mbDisc)
                        // 晨光带：缓慢摆动的柔光条
                        let mbBandY = mbSz.y * (0.52 + sin(mbU * 3.1 + mbT * 0.5) * 0.04)
                        let mbBand = (1.0 - smoothstep(0.0 30.0 abs(mbP.y - mbBandY))) * 0.14
                        mbCol = mbCol.mix(#ffe9c4, mbBand)
                        // 顶部一颗小星（未落尽），缓慢明灭
                        let mbStar = vec2(mbSz.x * 0.16, mbSz.y * 0.18)
                        let mbSr = length(mbP - mbStar)
                        let mbTw = 0.55 + 0.45 * sin(mbT * 0.9)
                        mbCol = mbCol.mix(#cfe0ff, (1.0 - smoothstep(0.0 1.6 mbSr)) * mbTw * 0.8)
                        // 圆角裁剪
                        let mbSdf = Sdf2d.viewport(mbP)
                        mbSdf.box(0.0 0.0 mbSz.x mbSz.y max(1.0 self.border_radius))
                        mbSdf.fill_keep(mbCol)
                        return mbSdf.result
                    }
                }
                View{width: Fill height: Fill flow: Down spacing: 7 padding: Inset{top: 16 bottom: 18 left: 18 right: 18}
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                        date := Label{width: Fill text: "" draw_text.color: #xbccbe8 draw_text.text_style.font_size: 11}
                        issue_label := Label{text: "" draw_text.color: #x9fb0cf draw_text.text_style.font_size: 10}
                    }
                    Label{width: Fill text: "晨报卡" draw_text.color: #xfffaf2 draw_text.text_style: theme.font_bold{font_size: 30}}
                    RoundedView{width: 46 height: 2 new_batch: true draw_bg.color: #xffd39a draw_bg.border_radius: 1.0}
                    View{width: Fill height: Fill}
                    Label{width: Fill text: "MORNING BRIEF · 晨报卡 · 主编咕嘎 · 编辑部常驻 · 能调用大模型干活" draw_text.color: #xffe2b8 draw_text.text_style.font_size: 10}
                }
            }
            intent_line := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
            ask_in := TextInput{width: Fill height: 46 empty_text: "也可以直接写，例如：我想看芯片和 AI 的大新闻"
