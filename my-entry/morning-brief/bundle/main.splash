    ui.story_meta.set_text(story_meta)
    ui.story_pos.set_text(story_pos())
    ui.story_sum.set_text(story_sum)
    ui.story_sum_box.set_visible(story_sum != "")
    ui.story_vf_line.set_text(vf_story_line())
    ui.story_vf_who.set_text(vf_story_who())
    ui.story_vf_who.set_visible(vf_story_who() != "")
    ui.story_vf_basis.set_text(vf_story_basis())
    ui.story_vf_box.set_visible(vf_story_line() != "" || vf_story_who() != "")
    ui.story_state.set_text(story_state_line())
    ui.story_ai.set_text(story_ai)
    ui.story_more_head.set_text(story_more_head())
    ui.story_more_text.set_text(story_more_text())
    ui.story_more_box.set_visible(story_more.len() > 0)
    ui.arc_box.set_visible(arc_rel.len() > 0)
    ui.arc_text.set_text(arc_rel_text())
    ui.story_cmt_head.set_text(story_cmt_head())
    ui.story_cmt_text.set_text(story_cmt_text())
    ui.story_cmt_box.set_visible(story_comments.len() > 0)
    ui.story_src.set_text(story_src_text())
    ui.story_url.set_text(story_url_text())
    ui.deny_pane.set_visible(phase == "denied")
    // 标签条刷新（终版 B）：不用 on_render 也不用 render()（那会白屏，见声明处注释）。
    // 可见性完全由 run_pane 托管（fetching/done 才可见），这里只重写文字与可见性。
    // 注意：tab_b* 绝不能在 warm_static 里引导 —— 实测会把 warm_static 搞坏
    // （plan_ok 等全部掉出布局）；可见容器里的静态控件不需要引导，直接 set_text。
    ui.tab_b0.set_text(issue_tab_text(0))
    ui.tab_b0.set_visible(issue_tab_text(0) != "")
    ui.tab_b1.set_text(issue_tab_text(1))
    ui.tab_b1.set_visible(issue_tab_text(1) != "")
    ui.tab_b2.set_text(issue_tab_text(2))
    ui.tab_b2.set_visible(issue_tab_text(2) != "")
    ui.tab_b3.set_text(issue_tab_text(3))
    ui.tab_b3.set_visible(issue_tab_text(3) != "")
    ui.tab_b4.set_text(issue_tab_text(4))
    ui.tab_b4.set_visible(issue_tab_text(4) != "")
    ui.note.set_text(issue_note_text())
    ui.note.set_visible(issue_note_text() != "")
    ui.plan_topics.set_text(plan_text())
    ui.plan_limit.set_text("条数上限：" + limit + " 条")
    ui.plan_hosts.set_text("将发起网络请求的域名：" + hosts_line())
    ui.plan_verity.set_text(vf_platform_line())
    ui.plan_ai.set_text(ai_line())
    ui.plan_ask.set_text(ask_text())
    ui.judge_line.set_text(judge_line())
    ui.panel_head.set_text(panel_head())
    ui.p1.set_text(panel_line("tech"))
    ui.p2.set_text(panel_line("biz"))
    ui.p3.set_text(panel_line("reader"))
    ui.status_line.set_text(status_line())
    ui.fail_line.set_text(fail_line())
    ui.fail_line.set_visible(fail_line() != "")
    ui.st_gen.set_text(gen_time())
    ui.st_src.set_text(src_line())
    ui.ai_sum.set_text(ai_sum_line())
    ui.ai_sum.set_visible(phase == "done")
    ui.ai_intro.set_text(ai_intro)
    ui.ai_intro.set_visible(ai_intro != "")
    ui.ai_note.set_text(ai_note_line())
    ui.ai_note.set_visible(ai_note_line() != "")
    ui.pipe_line.set_text(pipe_text())
    ui.stale_line.set_text(stale_line())
    ui.stale_line.set_visible(stale_line() != "")
    // 页脚的「读者画像」那行已经改成 list 的 on_render 里匿名 Label + if 判断，
    // 不再有那个命名控件（旧的 set_text / set_visible 两行随之作废）。
    ui.aq_q.set_text(aq_q)
    ui.aq_btn_a.set_text(aq_text_a())
    ui.aq_btn_b.set_text(aq_text_b())
    ui.aq_note.set_text(aq_note)
    ui.refuse_why_l.set_text(refuse_why)
    ui.refuse_tier.set_text(tier_line() + "  ·  " + work_line())
    ui.work_line.set_text(work_line())
    ui.work_line.set_visible(work_line() != "")
    ui.tier_line.set_text(tier_line())
    ui.tier_line.set_visible(tier_line() != "")
    ui.iv_pane.set_visible(iv_state != "")
    ui.iv_head.set_text(iv_head())
    ui.iv_text.set_text(iv_text())
    ui.iv_note.set_text(iv_note)
    ui.ag_iv.set_text(iv_box_line())
    ui.ag_iv.set_visible(iv_box_line() != "")
    ui.list.render()
    ui.art_pane.render()
    // 收音台开着时收起工作台（开麦那一屏只留一个焦点）；浮层一关自动恢复。
    ui.ag_panel.set_visible(ag_open && !vc_sheet_on)
    ui.ag_note.set_text(ag_line())
    ui.ag_caps.set_text(vc_caps())
    ui.ag_pill.set_text(ag_pill_text())
    // 气泡开关的文字跟着状态走（pet_toggle_bubble 改完状态会调到这里）
    ui.pet_bub_b.set_text(pet_bub_text())
    ui.vc_big.set_text(vc_big_text())
    ui.vc_note.set_text(vc_note)
    ui.vc_autob.set_text(vc_auto_text())
    ui.vc_contb.set_text(vc_cont_text())
    // 工作台三个分区：只有当前那个可见（标题上的 ● 也在 wb_tab_text 里）
    ui.wb_t0.set_visible(wb_tab == 0)
    ui.wb_t1.set_visible(wb_tab == 1)
    ui.wb_t2.set_visible(wb_tab == 2)
    ui.wb_b0.set_text(wb_tab_text(0))
    ui.wb_b1.set_text(wb_tab_text(1))
    ui.wb_b2.set_text(wb_tab_text(2))
    // 档案分区：检索结果与收藏列表每次刷新到这里（都是命名控件 + set_text，
    // 不用 on_render —— 面板在 on_render 里重建子控件会打断布局，见期次标签条的教训）
    wb_arc_sync()
    // 豆包式收音条：开麦时整屏浮出，关麦即收
    ui.vc_sheet.set_visible(vc_sheet_on)
    ui.vc_live.set_text(vc_live_text())
    ui.vc_sheet_hint.set_text(vc_sheet_hint())
    ui.arc_pill.set_text(arc_line())
    pet_guga(pet_phase_expr())
    // 麦克风一开，咕嘎就竖耳朵（惊讶脸 + 一行「本鹅在听」）——所有开关麦的路径
    // 都会经过 sync_ui，所以联动挂在这一个点上，不用到处加。
    pet_listen_sync()
    // 浏览记录面板：今天派咕嘎去问过的每一笔都在这儿对账。
    bl_sync()
    // 读者画像面板：主编记住的主人 —— 跟浏览记录互斥，理由见 pf_open_from_menu。
    pf_sync()
    // 读者画像面板：主编记住的主人 —— 跟浏览记录互斥，理由见 pf_open_from_menu。
    pf_sync()
    if ag_open { ui.ag_log_box.render() }
}

fn pet_set_size(i){
    if i < 0 { i = 0 }
    if i > 3 { i = 3 }
    if i == pet_size_i { return }
    pet_size_i = i
    pet_size_sync()
    // 换小了可能压到边界，重新钳一次
    pet_set_pos(pet_px, pet_py)
    pet_geo_save()
    pet_say_line(pet_pick(pet_lines_of("size")), false)
}

// 拖动：dx/dy 是相对按下的累计偏移（宿主 GestureView 的口径）。
// 拖的过程里只切占位控件，绝不重建桌宠本体 —— 这是手势能一路跟到 phase 2 的原因。
// 捏合缩放（触屏；鼠标上不产生这个事件）—— 用累计倍数跨过阈值就换一档。
fn pet_pinch(scale, px, py, phase){
    if phase == 0 { pet_pinch_on = true  pet_pinch_last = 1.0  return }
    if !pet_pinch_on { return }
    if scale >= pet_pinch_last + 0.45 {
        pet_pinch_last = scale
        pet_set_size(pet_size_i + 1)
    }
    else if scale <= pet_pinch_last - 0.28 {
        pet_pinch_last = scale
        pet_set_size(pet_size_i - 1)
    }
    if phase == 2 { pet_pinch_on = false }
}

// ===== 点击涟漪 · 点哪儿哪儿起一圈金色水波 =====
//   见 main.splash 顶部说明：鼠标追踪式波纹做不到（脚本拿不到指针、传不了
//   uniform），这里做「点击扩散环」——一样是「指尖落到水面上」的手感。
let rip_on = false
let rip_band = 1              // 0=上 1=中 2=下

fn pf_open_from_menu(){
    // 「画像」这一格：收主编台、开画像面板。
    // 与浏览记录面板同位（同一竖排），两个同时开会顶到卡片外面，所以互斥。
    pet_menu_close()
    pf_open = true
    bl_open = false
    pf_sync()
    bl_sync()
    pet_say_line(pet_pick(pet_lines_of("profile")), false)
}

// 「记一条偏好」：不开新面板，直接把主编的输入行交给主人 ——
// 偏好必须是主人亲口说的，卡里不替他编。主编收到后会调 remember_reader 落库。
fn pf_add_hint(){
    pf_open = false
    pf_sync()
    ag_open = true
    ag_note = "说一条要我长期记住的偏好（比如「多关注开源社区」），我记下来，以后每一期都算数。"
    sync_ui()
    pet_say_line(pet_pick(pet_lines_of("profile")), false)
}

// 「照着画像排一期」：把画像当唯一选材依据发给主编，让它先出计划再取数。
// 「照着画像排一期」：把画像当唯一选材依据发给主编，让它先出计划再取数。
fn pf_use(){
    pet_work_done("read")
    pf_open = false
    pf_sync()
    pet_say_line(pet_pick(pet_lines_of("plan")), false)
    ag_take("照着我的读者画像给我排一期：只挑我常读的那几类，别按大众口味选。先给我取数计划。",
        "主编接手了：按你的画像选材。")
}

// 把一次询问写进主编的对话里（沿用主编那套 22 件工具的链路，
// 它自己会去联网取数、筛选、落到本报上）。
// 向主编问某品类：界面上立刻亮一条「正在查」，再让主编去干活。
fn bl_ask(kind, q){
    bl_load()
    bl_begin(kind, q)
    if !ag_open {
        ag_open = true
        ag_note = "主编正在替你跑这一条。"
    }
    ag_say(q)
    bl_sync()
}


// 拖动：dx/dy 是相对按下的累计偏移（宿主 GestureView 的口径）。
// 拖的过程里只切占位控件，绝不重建桌宠本体 —— 这是手势能一路跟到 phase 2 的原因。
// 捏合缩放（触屏；鼠标上不产生这个事件）—— 用累计倍数跨过阈值就换一档。

// ===== 点击涟漪 · 点哪儿哪儿起一圈金色水波 =====
//   见 main.splash 顶部说明：鼠标追踪式波纹做不到（脚本拿不到指针、传不了
//   uniform），这里做「点击扩散环」——一样是「指尖落到水面上」的手感。


// 「记一条偏好」：不开新面板，直接把主编的输入行交给主人 ——
// 偏好必须是主人亲口说的，卡里不替他编。主编收到后会调 remember_reader 落库。

// 「照着画像排一期」：把画像当唯一选材依据发给主编，让它先出计划再取数。
// 「照着画像排一期」：把画像当唯一选材依据发给主编，让它先出计划再取数。

// 把一次询问写进主编的对话里（沿用主编那套 22 件工具的链路，
// 它自己会去联网取数、筛选、落到本报上）。
// 向主编问某品类：界面上立刻亮一条「正在查」，再让主编去干活。

fn pet_toggle_bubble(){
    pet_bubble_on = !pet_bubble_on
    if pet_bubble_on {
        // 打开时用一句话自证「气泡长这样」，不然开关像没生效。
        pet_line = "咕～气泡打开了，本鹅说话都会冒在这儿。"
        pet_line_until = time_now() + 2.6
        pet_sync_bubble()
    } else {
        pet_line = ""
        pet_line_until = 0
        pet_sync_bubble()
    }
    sync_ui()
}

fn pet_voice(text){
    // 一律交给 vc_say_now：它会在第一次出声时惰性探 model.speech，
    // 探不到就自己留一行状态提示，气泡与动作照常 —— 不做「假装在说话」的表演。
    //
    // 旧注释说「刻意不顺手探宿主：应用没申请 llm 能力，这一探会被拒」——
    // 那是语音还挂在 llm 家族上的时候。现在挂在 model 家族（manifest 已声明，
    // 宿主也确实答得上来），所以「用时再探」是安全的，而且不探就永远不出声。
    vc_say_now(text)
}

fn pet_say_line(l, with_voice){
    if l == nil { return }
    let text = "" + l.t
    pet_line = text
    pet_line_until = time_now() + pet_line_dur(text)
    // 嘴只在真的有声音时动（vc_say_now 里还会再启动一次，重复调用无副作用）。
    // 宿主没有语音能力时不动嘴 —— 与桌宠一致，不做「假装在说话」的表演。
    if vc_tts { pet_talk_start(text) }
    pet_react(l.e, l.a)
    // 立刻把气泡切出来：动作序列（pet_run_seq）只换帧、不同步气泡，
    // 少了这一行，菜单点完要等下一次心跳（最多 1 秒）气泡才出现。
    pet_sync_bubble()
    if with_voice { pet_voice(text) }
    else if vc_tts { vc_say_now(text) }
}

fn pet_tap(){
    // 点一下桌宠 = 打开咕嘎工作台（对话 / 干活 / 档案都在里面）。
    // 这是「说话 + 咕嘎 + 主编台」三合一之后唯一的入口：
    // 菜单开着时再点一下 = 收起来。
    if ag_open { wb_close() return }
    wb_open(0)
    // 开面板的同时它还是那只爱答不理的鹅，先说一句话。
    if pg_hunger < 25.0 { pet_say_line(pet_pick(pet_lines_of("hungry")), true) }
    else { pet_say_line(pet_pick(pet_lines_of("click")), true) }
}

fn pet_menu_toggle(){
    // 双击 / 长按与单击走同一个门：都是开关工作台。
    if ag_open { wb_close() } else { wb_open(0) }
}

// ---- 主编台的功能（不是摸鱼）----
// 这一版把「摸摸 / 喂鱼 / 逗逗 / 打盹 / 摇一个」整行删掉了：主编台是干活的地方，
// 不是逗宠物的地方。换成五件实事 ——
//   总结今天这一期 / 换头版（构图）/ 看读者画像（主人被记住的历史喜好）/
//   查更正台账 / 回放出报过程。
// 每一件都走主编那套工具链路（ag_* 收口），咕嘎只负责开口和被派活。
// ---- 主编台的功能（不是摸鱼）----
// 这一版把「摸摸 / 喂鱼 / 逗逗 / 打盹 / 摇一个」整行删掉了：主编台是干活的地方，
// 不是逗宠物的地方。换成五件实事 ——
//   总结今天这一期 / 换头版（构图）/ 看读者画像（主人被记住的历史喜好）/
//   查更正台账 / 回放出报过程。
// 每一件都走主编那套工具链路（ag_* 收口），咕嘎只负责开口和被派活。
fn pet_menu_close(){
    // 干活类入口点完把工作台收起来（结果要靠气泡与页面说话）。
    // 用「关」而不是「切」：万一哪天有个入口在面板没开时也调到这里，toggle 反而会打开。
    if !ag_open { return }
    ag_open = false
    sync_ui()
}


fn wb_close(){
    if !ag_open { return }
    ag_open = false
    sync_ui()
}

fn wb_pick(i){
    wb_tab = i
    // 切到「往期」时先把最近几期摆出来 —— 用户要的是「生成的晨报会留存
    // 下来、一打开就能看见」，而不是一个空白输入框等着他敲字。
    if i == 2 && wb_arc_res.len() == 0 && issues.len() > 0 { wb_quick("") return }
    sync_ui()
}

// 「总结」——把今天这一期从头到尾讲一遍。
// 还没出报时不硬发，直接说实话（主编没版面可总结，发过去也只是浪费一次联网）。
fn pet_sum_brief(){
    if picked.len() == 0 && last_rows.len() == 0 {
        pet_close_panels()
        pet_say_line(pet_pick(pet_lines_of("nosum")), false)
        return
    }
    pet_work_done("sum")
    pet_say_line(pet_pick(pet_lines_of("sum")), false)
    ag_take("把今天这一期晨报总结一下：先用一句话说清今天最重要的那件事，再按条点出其余各条分别在讲什么，"
        + "最后告诉我今天有没有互相打架的说法。",
        "主编接手了：总结今天这一期。")
}

// ---- 菜单里的「体量」与「主编」两类动作 ----
// 体量只切四只尺寸的可见开关，不碰任何几何字段；
// 主编类一律走主编那套 22 件工具的链路（ag_*），咕嘎只负责开口和被派活。
// ---- 菜单里的「体量」与「主编」两类动作 ----
// 体量只切四只尺寸的可见开关，不碰任何几何字段；
// 主编类一律走主编那套 22 件工具的链路（ag_*），咕嘎只负责开口和被派活。
fn pet_menu_size(i){
    // 形体一格：工作台开着就留在工作台上（不再顺手关面板）；
    // 那句「现在是几号本鹅」由 pet_set_size 里的 pet_say_line 说。
    pet_set_size(i)
}

fn ag_take(q, note){
    if !ag_open {
        ag_open = true
        ag_note = note
    }
    ag_say(q)
    sync_ui()
}

fn pet_ask_kind(kind){
    // 问新闻：把话交给主编去办，工作台自动切回「对话」分区 ——
    // 办的过程与气话都摆在那儿，读者一眼能看见。
    wb_go_talk()
    pet_say_line(pet_pick(pet_lines_of("ask")), true)
    bl_ask(kind, "我想了解「" + kind + "」类的新闻。请你联网查一下，把结果汇总到今日晨报的浏览记录里，"
        + "并在卡片上留一份给我。")
}

// 工作台切到「对话」分区（干活类入口点完之后统一回这里看结果）。
// 工作台切到「对话」分区（干活类入口点完之后统一回这里看结果）。
fn wb_go_talk(){
    ag_open = true
    wb_tab = 0
    if bl_open { bl_open = false bl_sync() }
    if pf_open { pf_open = false pf_sync() }
    sync_ui()
}

fn pet_menu_cmd(kind){
    if kind == "chat" {
        // 只是想聊天：切到对话分区、把输入行留给饲养员，
        // 不替他发任何话（这里刻意不走 ag_take —— 空串会被 ag_send 挡掉，
        // 但 ag_take 会顺手把 ag_note 清成空，把提示吃掉）。
        wb_go_talk()
        ag_note = "主编在。今天汇总过什么，他张口就能接着说。"
        sync_ui()
        pet_say_line(pet_pick(pet_lines_of("idle")), false)
        return
    }
    if kind == "brief" {
        pet_work_done("brief")
        wb_go_talk()
        pet_say_line(pet_pick(pet_lines_of("duty")), false)
        ag_take("生成今天这份晨报", "主编接手了：出今天这一期。")
        return
    }
    if kind == "art" {
        pet_work_done("art")
        wb_go_talk()
        pet_say_line(pet_pick(pet_lines_of("cover")), false)
        ag_take("给今天头条的那条新闻画一张配图", "主编接手了：画配图。")
        return
    }
    if kind == "talk" {
        pet_work_done("talk")
        wb_go_talk()
        pet_say_line(pet_pick(pet_lines_of("sum")), false)
        ag_take("把今天汇总的内容做一次分析讨论，给我三个可以继续追问的方向",
            "主编接手了：做一次分析讨论。")
        return
    }
    // ---- 换头版（构图）：视觉主编重画今天的头版 ----
    if kind == "cover" {
        pet_work_done("cover")
        wb_go_talk()
        pet_say_line(pet_pick(pet_lines_of("cover")), false)
        ag_take("换一张今天的头版：重新画一张封面图。", "主编接手了：重画头版。")
        return
    }
    // ---- 查更正台账：本报认过的错、口径打过架的记录，全在本机 ----
    if kind == "ledger" {
        pet_work_done("read")
        wb_go_talk()
        pet_say_line(pet_pick(pet_lines_of("ledger")), false)
        ag_take("查一下你们的更正台账：累计更正过几条、发现过几次跨源口径不一致，最近的具体记录是什么。",
            "主编接手了：查更正台账。")
        return
    }
    // ---- 回放出报过程：上一期是怎么选出来的，原话回放 ----
    if kind == "trail" {
        pet_work_done("read")
        wb_go_talk()
        pet_say_line(pet_pick(pet_lines_of("trail")), false)
        ag_take("回放一下最近一期的出报过程：扫了多少条、候选池里是哪些、三位初审各自说了什么、你终审的取舍理由。",
            "主编接手了：回放出报过程。")
        return
    }
    if kind == "browse" {
        // 浏览记录仍是独立浮层（工作台以外的旁证面板），跟画像互斥。
        bl_open = true
        pf_open = false
        bl_sync()
        pf_sync()
        pet_say_line(pet_pick(pet_lines_of("browse")), false)
    }
}

fn pet_phase_sync(){
    // 收割要在「比对上期 phase」之前做，返回值带着「这一期是问出来的」这个事实 ——
    // bl_harvest 会把 bl_pending 清掉，晚一步就问不出来了。
    let harvested = bl_harvest()
    if phase == pet_last_phase { return }
    pet_last_phase = phase
    if pet_talk_on || pet_act != "" { return }
    if phase == "done" {
        if harvested || bl_pending >= 0 { pet_say_line(pet_pick(pet_lines_of("asked")), false) }
        else { pet_say_line(pet_pick(pet_lines_of("report")), false) }
    }
    else if phase == "refused" { pet_say_line(pet_pick(pet_lines_of("refused")), false) }
    else if phase == "denied" { pet_say_line(pet_pick(pet_lines_of("denied")), false) }
}

fn pet_breath_tick(){
    pg_status_tick()
    pet_phase_sync()
    if pet_bubble_vis && time_now() >= pet_line_until {
        pet_line = ""
        pet_sync_bubble()
    }
    if pet_act != "" || pet_talk_on { return }
    // 工作台开着 → 整只鹅静止：呼吸帧（每 4 秒 expr ↔ expr_breath）
    // 和闲置小动作（bounce/peek/tsundere，每 10~25 秒一次）全都是
    // 「换贴图」，每次换都有加载间隙 —— 压在面板边上就是一闪。
    // 关掉工作台一切照旧。
    if ag_open { return }
    // 呼吸每 2 拍换一次帧（4 秒一个来回，跟桌宠的呼吸周期一致）。
    // 每拍都换 = 1Hz 硬切，实机上整只企鹅在闪 —— 用户第一句反馈就是它。
    pet_breath_gate = 1 - pet_breath_gate
    if pet_breath_gate == 0 { pet_breath = !pet_breath }
    if pet_hold != "" && time_now() >= pet_hold_until { pet_hold = "" }
    pet_idle_cd = pet_idle_cd - 1
    if pet_idle_cd <= 0 {
        pet_idle_cd = 10 + pet_rand_n(15)
        if pet_hold == "" {
            let r = random()
            if r < 0.40 {
                pet_hold = "cheer"
                pet_hold_until = time_now() + 1.4
                pet_run_seq("bounce")
            }
            else if r < 0.58 {
                pet_hold = "idle"
                pet_hold_until = time_now() + 1.6
                pet_run_seq("peek")
            }
            else if r < 0.76 {
                pet_hold = "pout"
                pet_hold_until = time_now() + 2.2
                pet_run_seq("tsundere")
            }
            else {
                pet_hold = pet_pick(["cheer" "surprised" "pout"])
                pet_hold_until = time_now() + 1.8
            }
        }
    }
    pet_apply()
}

fn pet_tick_go(){
    if !pet_tick_on { return }
    pet_breath_tick()
    start_timeout(1.0, || pet_tick_go())
}

fn pet_boot(){
    // 状态和体量/位置同存 guga_pet.json（见 pg_geo_write），一次读盘全拿回来。
    pg_status_load()
    bl_load()
    pet_last_phase = phase
    pet_idle_cd = 8 + pet_rand_n(10)
    pet_tick_on = true
    // 先把上一次的体量与位置摆回去，再让表情系统接管。
    pet_size_sync()
    pet_spacers_sync()
    pet_apply()
    start_timeout(0.6, || pet_tick_go())
}
fn boot(){
    // ⚠️ 开屏 CG 的关闭定时器必须**第一个**挂上，别问为什么，看这条：
    // splash 里未捕获的错误会立即终止本次求值（vm.rs:861），函数一旦中途中止，
    // 剩下的语句（包括定时器注册）就全部作废。cg_off() 原来排在函数最后一行，
    // 只要前面任何一步恢复读盘抛错，CG 就永远盖着 → 白屏。
    // 现在先挂定时器：后面无论谁炸，CG 都会按时关掉。
    // B 方案帧轮播（6.8 秒）取代原 3.12 秒的 shader 动画 —— 帧链自己会在
    // 第 51 帧后调 cg_off()；这个兜底定时器只在帧链意外中断时救场。
    // 开场 3.12 秒里常驻桌宠整只收起（CG 里不该出现咕嘎，饲养员 10-13 点破），
    // cg_off() 里恢复。
    ui.pet_layer.set_visible(false)
    pet_tick_on = false
    start_timeout(1.10, || cg_text())
    start_timeout(1.46, || cg_pet_in())
    start_timeout(3.12, || cg_off())
    // 档位查表必须先建：取数时每一条都要判档位，建表一次、查表 O(1)。
    // 忘了这一步的后果是静默的 —— 所有域名都落到兜底的「二手」，不报错。
    tier_map_build()
    warm_static()
    load_last()
    art_load()
    pf_load()
    arc_load()
    fc_load()
    ledger_load()
    trail_load()
    issues_load()
    wb_fav_load()
    iv_load()
    sync_ui()
    // 咕嘎桌宠上线：呼吸、闲时小动作、气泡与互动的循环从这里开始。
    // （语音不在启动时探测 —— 见 pet_voice 与下面这行的来由）
    pet_boot()
    // 语音能力探测是惰性的：等真正要说话 / 开麦 / 点朗读开关时才探 model.speech。
    // 原因：启动阶段探一次，无论成败都会多一次宿主往返；而且历史上探 llm.speech
    // 会被直接拒绝并重入 isolate（ISSUE-03），所以统一走「用时再探」。
    // 触发点只有三处：vc_say_now / vc_start / vc_toggle_auto，都经 vc_probe()，
    // 探测期间积压的请求由 vc_wait_say / vc_wait_mic 在回调里补发。
    // （曾经这里的注释写了惰性，但 vc_probe 一个调用点都没有 —— 结果 vc_tts 永远是
    //   false，桌宠彻底不出声。注释和实现必须一起改，别只改一边。）
    // （开屏 CG 的三个定时器已上移到 boot() 开头 —— 理由见那里的注释。）
}
start_timeout(0.05, || boot())

