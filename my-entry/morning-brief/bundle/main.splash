// =====================================================================
// 读者画像面板 · 主编台「画像」
//   摆出来的都是 pf_* 里已有的真数据（profile.json，只存本机）：
//   出过几期、读过几条、常读哪几类各多少次、你亲口要它记住的偏好。
//   两个按钮也都是真动作：「记一条偏好」把输入行交给主人去说（主编会用
//   remember_reader 落库）；「照着画像排一期」直接把画像当作选材依据发过去。
// =====================================================================
// =====================================================================
// 读者画像面板 · 主编台「画像」
//   摆出来的都是 pf_* 里已有的真数据（profile.json，只存本机）：
//   出过几期、读过几条、常读哪几类各多少次、你亲口要它记住的偏好。
//   两个按钮也都是真动作：「记一条偏好」把输入行交给主人去说（主编会用
//   remember_reader 落库）；「照着画像排一期」直接把画像当作选材依据发过去。
// =====================================================================


// 「记一条偏好」：不开新面板，直接把主编的输入行交给主人 ——
// 偏好必须是主人亲口说的，卡里不替他编。主编收到后会调 remember_reader 落库。
fn pet_frame_set(name){
    if name == pet_cur_frame { return }
    pet_cur_frame = name
    pet_src_apply()
}

// 给「当前这一只」换图。
//
// 为什么不再一次给四只都 set_src：说话口型是每 0.16 秒一帧、动作序列
// 0.10~0.20 秒一帧，点一下企鹅会连着换好几次帧 —— 一次给四只都下发，
// 一秒钟就是几十次贴图重载，每次都会让画面闪一下。用户看到的就是
// 「点一下桌宠就时不时闪烁」（2026-10-13 反馈）。
//
// 四只里同一时刻只有一只是可见的（pet_size_sync 管可见性），所以只喂那一只；
// 换尺寸时由 pet_size_sync 补一次，不会漏。
fn pet_apply(){
    // 帧的优先级：动作 > 听麦 > 说话口型 > 临时表情 > 常态（带呼吸）
    if pet_act != "" { pet_sync_bubble() return }
    if pet_listen { pet_frame_set(pet_breath_frame("surprised")) pet_sync_bubble() return }
    if pet_talk_on { pet_sync_bubble() return }
    if pet_hold != "" && time_now() < pet_hold_until {
        pet_frame_set(pet_breath_frame(pet_hold))
        pet_sync_bubble()
        return
    }
    pet_frame_set(pet_breath_frame(pet_stock_expr()))
    pet_sync_bubble()
}

fn pet_seq_step(gen){
    // 代次不符 = 这条序列已被新的动作取代，旧定时器到此为止。
    // 没有这道闸，连点企鹅会同时跑几条序列，帧速翻倍、动作乱跳。
    if gen != pet_seq_gen { return }
    if pet_act == "" { return }
    if pet_seq_i >= pet_seq_q.len() {
        pet_act = ""
        pet_apply()
        return
    }
    let s = pet_seq_q[pet_seq_i]
    pet_frame_set(s.f)
    pet_seq_i = pet_seq_i + 1
    start_timeout(s.d, || pet_seq_step(gen))
}

fn pet_talk_stop(){
    pet_talk_on = false
    pet_apply()
}

fn pet_listen_sync(){
    if pet_listen == vc_listen { return }
    pet_listen = vc_listen
    if pet_listen {
        pet_line = "咕嘎？本鹅在听，你说。"
        pet_line_until = time_now() + 30.0
    }
    else if pet_line == "咕嘎？本鹅在听，你说。" { pet_line = "" }
    pet_apply()
}

// 把回答收进预设集合：落不进集合的档位一律记 unknown，别让自由文本混进结构化结果。
// 同时跟本报按域名判出的档位对一下，不一致就是一次「分歧」。
fn vd_put(list){
    vd_rows = []
    vd_agree = 0
    vd_unknown = 0
    for v in list {
        let idx = v.i
        if idx != nil {
            if idx >= 0 && idx < picked.len() {
                let r = picked[idx]
                let t = "" + v["tier"]
                let known = false
                for p in vd_tiers { if p == t { known = true } }
                if known == false { t = "unknown" vd_unknown = vd_unknown + 1 }
                let w = 0
                if v["worth"] != nil { w = v["worth"] }
                let h = 0
                if v["heat"] != nil { h = v["heat"] }
                let same = false
                if t == tier_of(r) { same = true vd_agree = vd_agree + 1 }
                vd_rows.push({row: r tier: t worth: w heat: h same: same})
            }
        }
    }
}

fn vd_trail(){
    if trail.len() == 0 { return }
    let box = []
    for v in vd_rows {
        box.push({title: v.row.title tier: v.tier worth: v.worth heat: v.heat same: v.same})
    }
    trail["decision"] = {agree: vd_agree total: vd_rows.len() unknown: vd_unknown ms: vd_ms tokens: vd_tokens rows: box}
    trail_save()
}

fn vf_prior(r){
    let h = row_host(r)
    for d in vf_ugc { if dom_hit(h, d) { return 46 } }
    for d in vf_auth { if dom_hit(h, d) { return 74 } }
    let t = tier_of(r)
    if t == "first" { return 76 }
    if t == "second" { return 64 }
    if t == "rumor" { return 38 }
    52
}

fn vf_trail(){
    if trail.len() == 0 { return }
    let box = []
    for x in vf_rows {
        box.push({title: x.row.title host: row_host(x.row) cal: x.cal lo: x.lo hi: x.hi peers: x.peers model: x.model ev: x.ev contra: x.contra basis: x.basis})
    }
    trail["verity"] = {avg: vf_avg weak: vf_weak contra: vf_contra ms: vf_ms tokens: vf_tokens rows: box}
    trail_save()
}

fn trail_set_pool(n, cn, rows){
    if trail.len() == 0 { return }
    trail["pool"]["scanned"] = n
    trail["pool"]["cand"] = cn
    let t = []
    let i = 0
    for r in rows {
        if i < 20 { t.push({t: r.title tier: tier_label(r)}) }
        i = i + 1
    }
    trail["pool"]["titles"] = t
}

// 回放页：把最近一期摊开
fn replay_text(){
    // 这里原来每帧都 fs.read + parse_json，是白屏的直接元凶之一。
    // 现在统一走 replay_all()（整包只读一次盘，见上面的注释）。
    let it = replay_all()
    let n = it.len()
    if n == 0 { return "" }
    let t = it[n - 1]
    // 如果当前这一期就是最新一期，用内存里的（更及时）
    if trail.len() > 0 && trail["date"] == t["date"] { t = trail }
    let out = "第 " + ("" + n) + " 期 · " + ("" + t["date"]) + " 的出报过程"
    let ch = t["charter"]
    if ch != nil {
        let vj = ch["judge"]
        let vfc = ch["factcheck"]
        let vs = "judge " + ("" + vj) + " · factcheck " + ("" + vfc)
        out = out + "\n照着的规矩：" + vs
    }
    out = out + "\n" + replay_pool_line()
    out = out + "\n" + replay_panel_line()
    out = out + "\n" + replay_judge_line()
    out
}

fn gh_rows(body){
    // GitHub 搜索 API 的 JSON：仓库全名 + 一句话简介当标题，星数当热度。
    // 缺字段一律「先取键再判空」，跟 hn_rows 一个读法，避免整轮取数卡死。
    let out = []
    let data = body.parse_json()
    if data == nil || data.items == nil { return out }
    for it in data.items {
        let title = it["full_name"]
        if title == nil { continue }
        title = "" + title
        if title == "" { continue }
        let desc = it["description"]
        if desc != nil && desc != "" { title = title + " — " + ("" + desc) }
        let link = ""
        let hu = it["html_url"]
        if hu != nil { link = "" + hu }
        if link == "" { continue }
        let sid = ""
        let ii = it["id"]
        if ii != nil { sid = "" + ii }
        // 时间必须真转成 Unix 秒：写 0 会让这个来源在 sort_desc 里永远沉底（见 iso_secs 的注释）。
        let pub = 0
        let ca = it["created_at"]
        if ca != nil { pub = iso_secs("" + ca) }
        out.push({id: "gh-" + sid title: title link: link source: "GitHub" published: pub
            summary: "" image: "" discussion: "" points: it["stargazers_count"] comments: nil})
    }
    out
}

fn load_source(s){
    let rows = nil
    try {
        let res = fetch(s.url).await()
        if res == nil {
            // 请求层就没回来：DNS / 连接 / TLS / 超时，宿主只把 on_error 交给我们，
            // 拿不到细分原因，只能如实说「连不上或超时」。
            src_fail(s.label, "连不上或超时")
            return
        }
        if res.status_code >= 400 {
            src_fail(s.label, "对方回了 " + res.status_code)
            return
        }
        if res.body == nil {
            src_fail(s.label, "回了空内容")
            return
        }
        let body = res.body.to_string()
        if s.kind == "hn" { rows = hn_rows(body) }
        else if s.kind == "gh" { rows = gh_rows(body) }
        else if s.kind == "bili" { rows = bili_rows(body) }
        else if s.kind == "dy" { rows = dy_rows(body) }
        else { rows = feed_rows(body, s) }
    } catch err {
        // 注意：这个语言的 catch **不绑定变量**（写成 `catch err { … err … }` 会在 catch 块里
        // 再抛一个 "variable err not found in scope"，把真正的错盖掉）。所以这里不引用它。
        src_fail(s.label, "解析出错")
        return
    }
    if rows == nil || rows.len() == 0 {
        src_fail(s.label, "取到了，但没有可用条目")
        return
    }
    ok_sources.push({label: s.label n: rows.len()})
    for r in rows {
        // 打上渠道标记：跨源印证按渠道算，不按 link 域名算（理由见 row_ch 的注释）。
        r["ch"] = s.id
        // 档位也在这一刻算好写回，后面全局复用（理由见 tier_of 的注释）。
        r["tier"] = tier_of_h(row_host(r))
        all_rows.push(r)
    }
}

// 记一次失败。三件事必须同时成立，否则账会乱：
//   * 只记**这次真的勾选了**的来源（没勾的平台不算失败，否则「失败数」会超过「应取数」）
//   * 同一个来源只记一次（watchdog 与真实失败会先后报到）
//   * **带上原因** —— 否则界面上只有一句「未取到」，用户无法分辨是自己网络的问题、
//     对方站点的问题，还是本程序的问题。这条是产品要求，不只是调试信息。
fn gather(){
    all_rows = []
    ok_sources = []
    failed = []
    for s in sources { if plat_on(s.plat) { load_source(s) } }
    let sorted = sort_desc(all_rows)
    cand = []
    // 选池分两步：先给「一手来源」留保底名额，再按时间补足。
    //
    // 为什么需要保底：池子是按时间截的（pool=16），而一手来源（官方博客、仓库、论文）
    // 天然比聚合站「旧」——一条仓库条目可能挂了一周，而 TechMeme 每分钟都在刷。
    // 纯按时间截，一手会被系统性挤出，最后就变成「一手 0 · 转载 15」，
    // 而那个构成恰好触发主编拒刊。这不是取数失败，是选池规则自己把好东西扔了。
    //
    // 保底比例取 pool 的四分之一：既保证一手有存在感，又不会让它霸屏，
    // 剩下的名额仍然按时间给最新消息。
    let quota = floor(pool / 4)
    if quota < 2 { quota = 2 }
    let frows = []
    for r in sorted {
        if tier_of(r) == "first" { frows.push(r) }
        if frows.len() >= quota { break }
    }
    for r in frows { cand.push(r) }
    for r in sorted {
        if cand.len() >= pool { break }
        if already(cand, r.id) { continue }
        cand.push(r)
    }
    cand_n = cand.len()
    work_n = all_rows.len()
    work_cand = cand_n
    tier_tally(cand)
    // 留痕：本期到底扫了多少、留了多少、留的是哪些（复盘的第一层）
    trail_set_pool(work_n, work_cand, cand)
}

// 信源太薄的时候，主编有权不出报 —— 这不是取数失败，是拒绝出报。
// 判据刻意保守：只有「一手一条都没有，二手也少到 2 条以内」才触发，
// 也就是整个池子几乎全是聚合站和社交平台的时候。认不出的域名算二手，
// 所以正常情况下这条几乎不会亮起来 —— 它要真的罕见，才有分量。
fn pet_guga(expr){
    if expr == pet_expr { return }
    pet_expr = expr
    pet_apply()
}
fn pet_run_seq(name){
    // 工作台开着不播动作序列 —— 理由同 pet_talk_tick：每 0.1~0.3 秒
    // 换一张贴图，换帧间隙就是闪。关掉工作台动作照播。
    if ag_open { return }
    pet_seq_gen = pet_seq_gen + 1
    pet_act = name
    pet_seq_q = []
    if name == "bounce" {
        pet_seq_q = [
            {f: "cheer_squat" d: 0.10}
            {f: "cheer_jump" d: 0.20}
            {f: "cheer_squat" d: 0.10}
        ]
    }
    else if name == "shake" {
        pet_seq_q = [
            {f: "surprised_wobL" d: 0.12}
            {f: "surprised_wobR" d: 0.12}
            {f: "surprised_wobL" d: 0.12}
        ]
    }
    else if name == "tsundere" {
        pet_seq_q = [
            {f: "pout_swingL" d: 0.34}
            {f: "pout_swingR" d: 0.34}
            {f: "pout_swingL" d: 0.30}
        ]
    }
    else if name == "peek" {
        pet_seq_q = [ {f: "idle_peek" d: 1.0} ]
    }
    else if name == "point" {
        pet_seq_q = [ {f: "pout_go" d: 1.1} ]
    }
    pet_seq_i = 0
    pet_seq_step(pet_seq_gen)
}

fn pet_talk_tick(){
    if !pet_talk_on { return }
    if time_now() >= pet_talk_until { pet_talk_stop() return }
    // 工作台开着时，咕嘎的话直接进对话区，口型动画就省了。
    // 口型是每 0.16 秒换一次贴图 —— makepad 换贴图有一瞬加载间隙，
    // 就是用户看到的「点开工作台以后时不时闪烁」的主源（2026-10-13）。
    if ag_open { return }
    if pet_act != "" { return }   // 动作帧优先，口型等动作播完再动
    pet_talk_t = pet_talk_t + 1
    if pet_talk_t > 4 { pet_talk_t = 1 }
    if pet_talk_t == 1 { pet_frame_set("talk1") }
    else if pet_talk_t == 2 { pet_frame_set("talk2") }
    else if pet_talk_t == 3 { pet_frame_set("talk0") }
    else { pet_frame_set("talk2") }
}

fn pet_react(expr, action){
    pet_hold = expr
    pet_hold_until = time_now() + 3.0
    if action != "none" { pet_run_seq(action) }
    else { pet_apply() }
}

fn pet_talk_go(){
    if !pet_talk_on { return }
    pet_talk_tick()
    if pet_talk_on { start_timeout(0.16, || pet_talk_go()) }
}

fn pet_talk_start(text){
    let d = pet_line_dur(text) + 0.3
    pet_talk_until = time_now() + d
    pet_talk_t = 0
    if pet_talk_on { return }
    pet_talk_on = true
    start_timeout(0.16, || pet_talk_go())
}

// 本期留痕的骨架。approve() 里初始化，各处逐步填。
fn trail_begin(){
    trail = {
        ts: time_now()
        date: today_text()
        charter: {}
        pool: {scanned: 0 cand: 0 titles: []}
        panel: []
        judge: {model: "" ms: 0 intro: "" picks: [] drops: []}
        fore: {model: "" ms: 0 items: []}
        fact: {clashes: 0 fixes: 0 note: ""}
        cover: {headline: "" state: ""}
        result: {picked: 0 refused: false}
    }
    // 记下这一期照着哪版提示词编的 —— 出事能倒推
    for c in charter { trail["charter"][c.id] = c.v }
}

fn story_ai_ask(){
    let sid = story.id
    let body = "标题：" + story_title
    if story_sum != "" { body = body + "\n概述：" + story_sum }
    if story_more.len() > 0 { body = body + "\n另有 " + story_more.len() + " 家媒体在跟进这条消息。" }
    if story_comments.len() > 0 {
        body = body + "\n网友讨论：\n"
        let i = 0
        for c in story_comments {
            if i < 4 { body = body + "- " + c.author + "：" + c.text + "\n" }
            i = i + 1
        }
    }
    story_t0 = time_now()
    host.request("model.complete", {
        task: "[编辑部宪法 story/" + charter_v("story") + "]
你是一位科技晨报的解读编辑，读者是关心科技行业但不懂技术的普通人。用中文回答，写成两段共三到五句话，不要用任何符号排版，不要罗列，不要重复标题原文。第一段说清这件事到底发生了什么，第二段说清它为什么值得关心。如果给了网友讨论，最后点一句大家在争论什么。你的输出是一个 JSON 对象，text 字段就是这段解读正文。"
        input: body
        schema: {type: "object" required: ["text"] properties: {text: {type: "string"}}}
        class: "strong"
        allow_urls: true
    }, fn(r){
        if r.is_ok && r.data != nil && r.data.output.text != nil && r.data.output.text != "" {
            story_ai = r.data.output.text.trim()
            story_state = "ok"
            story_ms = (time_now() - story_t0) * 1000
        } else {
            story_state = "fail"
            story_err = "AI 这次没有答复，上面几块是官方页面里的原文。"
        }
        sync_ui()
    })
}

fn story_ai_go(){
    if story_state != "loading" { return }
    story_state = "ai"
    sync_ui()
    story_ai_ask()
}

fn story_finish(){
    if story_state == "loading" { story_ai_go() }
}

fn load_story_comments(){
    let hid = hn_id(story)
    let url = "https://hn.algolia.com/api/v1/items/" + hid
    let res = fetch(url).await()
    if res != nil && res.status_code < 400 && res.body != nil {
        let d = res.body.to_string().parse_json()
        if d != nil && d.children != nil {
            let n = 0
            for c in d.children {
                if n < 6 {
                    if c.text != nil && c.text != "" {
                        let who = c.author
                        if who == nil || who == "" { who = "匿名" }
                        story_comments.push({author: who text: clean_html(c.text)})
                    }
                    n = n + 1
                }
            }
        }
    } else {
        story_err = "没能取到这条讨论，页面上的其他内容仍然可用。"
    }
    story_finish()
}

fn load_story_page(){
    let key = story_key(story.link)
    let parts = story.link.split("#")
    let base = parts[0]
    let res = fetch(base).await()
    if res != nil && res.status_code < 400 && res.body != nil {
        let doc = res.body.to_string().parse_html()
        let blk = doc.query("div#" + key)
        let ii = blk.query("div.ii").array()
        if ii.len() > 0 {
            let raw = ii[0].text.trim()
            let parts = raw.split("—")
            if parts.len() > 1 { story_sum = parts[1].trim() } else { story_sum = raw }
        }
        let links = blk.query("span.bls a").array()
        for a in links {
            let href = a.attr("href")
            if href != nil && href != "" { story_more.push({name: a.text.trim() url: href}) }
        }
        sync_ui()
    } else {
        story_err = "没能打开这条新闻的官方页面，下面只有列表里已有的信息。"
    }
    story_finish()
}

// 看门狗：官方页面抓取可能很慢（境外站点），不能让阅读页一直停在「正在打开」。
// 到点还没落地就直接进入 AI 解读，界面上说明官方原文这次没取到。
// 看门狗：官方页面抓取可能很慢（境外站点），不能让阅读页一直停在「正在打开」。
// 到点还没落地就直接进入 AI 解读，界面上说明官方原文这次没取到。
fn story_watch(left){
    if story_state != "loading" { return }
    if left <= 0 {
        story_err = "这次没能及时取到官方页面，下面是列表里已有的信息和 AI 解读。"
        story_finish()
        sync_ui()
        return
    }
    start_timeout(1.0, || story_watch(left - 1))
}

fn load_story(){
    if story == nil { return }
    story_state = "loading"
    start_timeout(1.0, || story_watch(12))
    if hn_id(story) != "" { load_story_comments() } else { load_story_page() }
}

fn art_ready(){
    // 换了新闻就不再管上一条的图：后台线程会自己把结果写进缓存，下次打开直接用。
    if story == nil { return }
    if art_pending != art_q { return }
    let t0 = time_now()
    let u = art_take_shot()
    if u == nil || u == "" {
        // 宿主带 MiniMax 时配图是后台画的：头几次问只会拿到空串。
        // 按配额再等几轮；用完还没拿到才算真失败。
        if art_wait > 0 {
            art_wait = art_wait - 1
            art_busy = true
            art_note = "正在生成这条消息的配图"
            sync_ui()
            start_timeout(0.8, || art_ready())
            return
        }
        art_busy = false
        art_note = "这次没能画出配图，文字内容不受影响。"
        sync_ui()
        return
    }
    art_busy = false
    let pic = ("" + u).trim()
    if art_is_photo(pic) == false {
        let small = pic
        if small.len() > 60 { small = art_cut(small, 60) }
        art_note = "这次没能画出配图，文字内容不受影响。"
        art_pick[0] = small
        sync_ui()
        return
    }
    art_seed = art_seed + 1
    if art_mm_url(pic) { art_url = pic } else { art_url = pic + "&seed=" + art_seed }
    art_mm = art_mm_url(pic)
    art_on = true
    art_ms = time_now() - t0
    art_note = "AI 配图已就绪"
    art_put(story.id, art_url)
    art_save()
    sync_ui()
}

fn art_go(){
    if story == nil { return }
    if art_q == "" { return }
    if art_pending == art_q {
        if art_url != "" { art_on = true art_busy = false if art_cached == 1 { art_note = "这条消息的配图来自本机缓存" } else { art_note = "配图已就绪" } sync_ui() }
        return
    }
    art_pending = art_q
    art_on = false
    art_url = ""
    art_ms = 0
    art_busy = true
    art_note = "正在为这条消息画一张配图"
    sync_ui()
    let cache = art_cached_for(story.id)
    if cache != "" {
        art_url = cache
        art_mm = art_mm_url(cache)
        art_cached = 1
        art_busy = true
        art_note = "正在读本机缓存，马上就好"
        art_on = false
        sync_ui() start_timeout(0.05, || art_go())
        return
    }
    art_cached = 0
    art_wait = 40
    start_timeout(0.05, || art_ready())
}

fn art_kick(){
    if story == nil { return }
    art_q = art_prompt()
    art_go()
}

fn art_off(){
    art_busy = false
    art_on = false
    art_url = ""
    art_mm = false
    art_note = "已收起配图，只保留文字内容"
    sync_ui()
}

fn art_retry(){
    if story == nil { return }
    if art_q == "" { art_q = art_prompt() }
    if art_q == "" { return }
    art_pending = art_q
    art_on = false
    art_url = ""
    art_mm = false
    art_ms = 0
    art_cached = 0
    art_wait = 40
    art_busy = true
    art_note = "正在为这条消息重新画一张配图"
    sync_ui()
    start_timeout(0.05, || art_ready())
}

fn open_story(r){
    story = r
    story_title = r.title
    story_meta = row_meta(r)
    story_sum = r["summary"]
    if story_sum == nil { story_sum = "" }
    story_more = []
    story_comments = []
    story_ai = ""
    story_ms = 0
    story_err = ""
    story_state = "loading"
    phase = "story"
    art_q = ""
    art_pending = ""
    art_url = ""
    art_on = false
    art_mm = false
    art_ms = 0
    art_cached = 0
    art_wait = 0
    art_note = ""
    // 画像 + 记忆：读过什么、这条和往期哪几条是一条线索
    pf_watch(r)
    arc_rel = arc_rel_for(r)
    sync_ui()
    start_timeout(0.05, || load_story())
    start_timeout(0.60, || art_kick())
}

fn close_story(){
    story = nil
    story_state = ""
    art_q = ""
    art_pending = ""
    art_url = ""
    art_on = false
    art_mm = false
    art_note = ""
    phase = "done"
    sync_ui()
}

fn story_step(d){
    if story == nil { return }
    let rows = story_rows()
    let k = 0
    let i = -1
    for r in rows {
        if r.id == story.id { i = k }
        k = k + 1
    }
    if i < 0 { return }
    let j = i + d
    if j < 0 || j >= rows.len() { return }
    open_story(rows[j])
}


// =====================================================================
// 语音层 · 主编说得出、听得见（宿主语音服务：model.speech / speak / listen_*）
//   为什么挂在 model 而不是 llm：发布契约里 llm 家族只给 os. 系统应用，
//   商店应用申请不到；model 是本卡已经在 manifest 里声明过的家族，
//   宿主把语音方法挂在 model 上，应用才拿得到。
// =====================================================================
// =====================================================================
// 语音层 · 主编说得出、听得见（宿主语音服务：model.speech / speak / listen_*）
//   为什么挂在 model 而不是 llm：发布契约里 llm 家族只给 os. 系统应用，
//   商店应用申请不到；model 是本卡已经在 manifest 里声明过的家族，
//   宿主把语音方法挂在 model 上，应用才拿得到。
// =====================================================================
fn vc_probe(){
    if vc_probed { return }
    host.request("model.speech", {}, fn(r){
        vc_probed = true
        if r.is_ok && r.data != nil {
            let tts = r.data["tts"]
            if tts != nil {
                // 注意：不能在 splash 里用 `ok` 当变量名，它是保留字。
                let tv = tts["available"]
                if tv != nil {
                    if tv { vc_tts = true } else { vc_tts = false }
                }
                let vs = tts["voices"]
                if vs != nil { vc_voices = vs.len() vc_voice = vc_pick_voice(vs) }
            }
            let stt = r.data["stt"]
            if stt != nil {
                let sv = stt["available"]
                if sv != nil {
                    if sv { vc_stt = true } else { vc_stt = false }
                }
            }
        }
        if vc_tts && vc_stt { vc_note = "咕嘎能说话（" + guga_voice_name() + "），也能听见你" }
        else if vc_tts { vc_note = "咕嘎能说话（" + guga_voice_name() + "）；这台机器没有可用的语音识别，打字一样用" }
        else { vc_note = "这台机器没有可用的语音能力，全程打字也算数" }
        sync_ui()
        // 探测期间积压的请求，现在真的可以办了。
        if vc_wait_say != "" {
            let t = vc_wait_say
            vc_wait_say = ""
            vc_say_now(t)
        }
        if vc_wait_mic {
            vc_wait_mic = false
            vc_start()
        }
        // 探测前点过「念给我听」的，现在真的可以念了。
        if rv_wait {
            rv_wait = false
            rv_start()
        }
    })
}

fn vc_say_now(text){
    if !vc_probed {
        // 第一次要说话，才第一次问宿主 —— 把这句话先存着，探完接着说。
        vc_wait_say = text
        vc_note = "正在问宿主：这台机器能不能开口说话…"
        sync_ui()
        vc_probe()
        return
    }
    if !vc_tts {
        // 评审意见 3：语音层失败要给一行状态提示，不能静默返回。
        vc_note = "这台机器没有可用的语音合成，念不出来；文字照常显示"
        sync_ui()
        return
    }
    let t = art_cut(text, 150)
    if t == "" { return }
    // 谁在说话，咕嘎的嘴就跟着动（口型帧循环；宿主播完自动停）
    pet_talk_start(t)
    host.request("model.speak", {text: t lang: "zh-CN" voice: vc_voice, rate: 1.15, pitch: 1.07}, fn(r){
        // 播报失败也要看得见，别让读者以为这句话已经念过了。
        if !r.is_ok {
            let why = "语音播报失败"
            if r.error != nil && r.error != "" { why = why + "：" + r.error }
            vc_note = why + "。文字照常显示，其余功能不受影响"
            sync_ui()
        }
    })
}

// 自动朗读只在「对主编说过话」的时候出声，不打搅只想看报的人。
// 自动朗读只在「对主编说过话」的时候出声，不打搅只想看报的人。
fn vc_say(text){
    if !vc_auto { return }
    vc_say_now(text)
}

fn vc_toggle(){
    if vc_listen { vc_finish_round(true) }
    else { vc_start() }
}

fn vc_toggle_auto(){
    vc_auto = !vc_auto
    if vc_auto { vc_note = "咕嘎回复时会自动念出来" }
    else { vc_note = "自动朗读已关，只显示文字" }
    // 读者点的是语音开关，那就顺手把能力探了 —— 不然胶囊一直写着「待试」。
    if !vc_probed { vc_probe() }
    sync_ui()
}

fn vc_toggle_cont(){
    vc_cont = !vc_cont
    if vc_cont { vc_note = "连续对话：这一轮答完，麦克风会自动再打开" }
    else { vc_note = "连续对话已关：每次都要点话筒" }
    sync_ui()
}

// ---- 连续会话：一段话可以有很多个 final ----
// Windows 识别器把「停顿」当一句话的结束，长句会在中间切出好几个 final。
// 老逻辑收到第一个 final 就发送 → 长语音只会送出去前半句（用户报的
// 「长语音识别不能用」就是它）。现在：final 累积、只在收尾（点 ↑ / 安静下来）
// 时整段发送；界面上以「已听到」实时显示累积文本。
fn vc_start(){
    if !vc_probed {
        // 第一次要开麦，才第一次问宿主。
        vc_wait_mic = true
        vc_note = "正在问宿主：这台机器能不能开麦…"
        sync_ui()
        vc_probe()
        return
    }
    if !vc_stt {
        // 没有识别能力就别把收音台空放在那儿 —— 收起浮层、留一行说明。
        vc_sheet_on = false
        vc_note = "这台机器没有可用的语音识别，先用文字对我说"
        sync_ui()
        return
    }
    vc_partial = ""
    vc_accum = ""
    vc_poll_fail = 0
    vc_auto_mic = false
    vc_mic_retry = 0
    vc_level = 0.0
    vc_note = "正在打开麦克风…"
    vc_sheet_on = true
    sync_ui()
    host.request("model.listen_start", {language: "zh-CN"}, fn(r){
        if r.is_ok {
            vc_listen = true
            vc_note = "我在听，说完点 ↑ 发出去（停顿一下我也会自己发）"
            sync_ui()
            start_timeout(0.4, || vc_poll_go())
        } else {
            vc_sheet_on = false
            vc_note = "麦克风打不开：" + r.error
            sync_ui()
        }
    })
}

fn vc_stop(){
    vc_listen = false
    vc_note = "麦克风已关上"
    sync_ui()
    // 关麦的收尾统一走 vc_close_mic：失败会写回一行状态，不静默。
    vc_close_mic()
}

// 收尾一轮收音：send=true 把累积的话送进对话，false 丢弃。
// 收尾一轮收音：send=true 把累积的话送进对话，false 丢弃。
fn vc_finish_round(send){
    let text = vc_accum
    if vc_partial != "" {
        if text != "" { text = text + " " }
        text = text + vc_partial
    }
    vc_listen = false
    vc_partial = ""
    vc_accum = ""
    vc_sheet_on = false
    vc_last_voice = text != ""
    // 说话的人是「对主编说话」，插话前先停下朗读（断点保留）。
    if text != "" && rv_on { rv_stop() }
    if send && text != "" {
        if vc_cont { vc_auto_mic = true }
        vc_note = "已听到：" + text
        sync_ui()
        if ag_busy { vc_pending = text }
        else { ag_say(text) }
    } else if !send {
        vc_note = "这一句不要了。想再说，点一下话筒。"
        sync_ui()
    } else {
        // 真的一个字都没听到。这里必须给出**可操作**的话 ——
        //「可以重说」等于没说：用户不知道自己还能做什么（2026-10-13 反馈）。
        vc_note = "没听到内容。可以查三处：① 系统音量/麦克风有没有静音 ② 设置 → 隐私和安全性 → 麦克风 → 让桌面应用访问、并确认默认输入设备是你的麦克风 ③ 说话时离麦近一点。也可以直接打字对我说。"
        sync_ui()
    }
    vc_close_mic()
}

// 点 ↑：把现在听到的整段发出去（不再等停顿）。
// 点 ↑：把现在听到的整段发出去（不再等停顿）。
fn vc_send_now(){
    if vc_listen { vc_finish_round(true) }
    else if vc_accum != "" { vc_finish_round(true) }
}

// 点 ×：这一段放弃。
// 点 ×：这一段放弃。
fn vc_cancel(){
    if vc_listen { vc_finish_round(false) }
    else {
        vc_sheet_on = false
        vc_note = "已取消这一句"
        sync_ui()
    }
}

// 安静下来的收尾：识别器自己报了最终结果（ended / live=false）时调用。
// 安静下来的收尾：识别器自己报了最终结果（ended / live=false）时调用。
fn vc_round_ended(){
    if !vc_listen { return }
    // ⚠️ 识别器**经常刚开麦就报一次 ended**（麦克风还在热身、或系统刚切过默认
    // 输入设备），这时候一个字都还没听到。原来直接走 vc_finish_round(true)，
    // 落地就是那句「没听到内容。麦克风已经关上」—— 用户看到的现象就是
    // 「点语音对话没反应」（2026-10-13 反馈）。这里改成：一个字都没听到就先
    // 自己重开一次收音，连着两次都不行才判定为真的没听到。
    if vc_accum == "" && vc_partial == "" && vc_mic_retry < 2 {
        vc_mic_retry = vc_mic_retry + 1
        vc_note = "麦克风刚热起来就断了，正在重开（第 " + ("" + vc_mic_retry) + " 次）…"
        sync_ui()
        vc_listen = false
        vc_close_mic()
        start_timeout(0.6, || vc_reopen_mic())
        return
    }
    vc_finish_round(true)
}

// 自动重开一次收音。只有「收音台还开着」才重开 —— 用户自己关掉的就别去打扰。
// 打不开时不再直接认输：cancelled 竞态下旧会话可能要 1~2 秒才退干净，
// 连试两次（共用 vc_mic_retry 计数）都失败才关台报错。
// 自动重开一次收音。只有「收音台还开着」才重开 —— 用户自己关掉的就别去打扰。
// 打不开时不再直接认输：cancelled 竞态下旧会话可能要 1~2 秒才退干净，
// 连试两次（共用 vc_mic_retry 计数）都失败才关台报错。
fn vc_reopen_mic(){
    if !vc_sheet_on { return }
    if vc_accum != "" || vc_partial != "" { return }
    host.request("model.listen_start", {language: "zh-CN"}, fn(r){
        if r.is_ok {
            vc_listen = true
            vc_note = "已经重新开麦 —— 说吧，说完点 ↑"
            sync_ui()
            start_timeout(0.4, || vc_poll_go())
        } else if vc_mic_retry < 2 {
            vc_mic_retry = vc_mic_retry + 1
            start_timeout(0.8, || vc_reopen_mic())
        } else {
            vc_sheet_on = false
            vc_note = "麦克风打不开：" + r.error
            sync_ui()
        }
    })
}

// ===== 收音台（豆包式全屏浮层）=====
// 点一下「语音对话」就开麦并浮出这一层：上面实时转写，下面 × ／波形 ／ ↑。
// 说的每一段都并进同一段文本（长语音），点 ↑ 或停顿后整段送进对话。
// ===== 收音台（豆包式全屏浮层）=====
// 点一下「语音对话」就开麦并浮出这一层：上面实时转写，下面 × ／波形 ／ ↑。
// 说的每一段都并进同一段文本（长语音），点 ↑ 或停顿后整段送进对话。
fn vc_voice_go(){
    if vc_listen { vc_send_now() return }
    vc_sheet_on = true
    sync_ui()
    vc_start()
}

fn vc_poll_go(){
    if !vc_listen { return }
    host.request("model.listen_poll", {}, fn(r){
        if !r.is_ok {
            // 轮询本身失败：计数，连错三次就停下并说明，不让界面假装还在听。
            vc_poll_fail = vc_poll_fail + 1
            if vc_poll_fail >= 3 {
                let why = "语音识别中断了"
                if r.error != nil && r.error != "" { why = why + "：" + r.error }
                vc_note = why
                vc_listen = false
                vc_sheet_on = false
                sync_ui()
            }
        } else {
            vc_poll_fail = 0
            if r.data != nil {
                let evs = r.data["events"]
                if evs != nil {
                    for e in evs {
                        // 这一轮已经收尾（点了 ↑ / 没听到内容 / 已报错）之后，
                        // 宿主那边还会飘来一两个迟到的事件（停麦时系统常把
                        // UserCanceled 当完成原因回来）。这时不能再动界面 ——
                        // 否则刚写好的「已听到：…」会被一句「cancelled」顶掉，
                        // 看起来就像语音功能坏了。
                        if !vc_listen { break }
                        let kv = e["kind"]
                        let k = ""
                        if kv != nil { k = "" + kv }
                        let tv = e["text"]
                        let t = ""
                        if tv != nil { t = "" + tv }
                        if k == "partial" {
                            // 实时转写：正在说的半句
                            vc_partial = t
                        }
                        if k == "final" && t != "" {
                            // 累积这一句（长语音的每一段都并进 accum，不再打断）
                            vc_partial = ""
                            if vc_accum != "" { vc_accum = vc_accum + " " }
                            vc_accum = vc_accum + t
                            vc_level = 1.0
                        }
                        if k == "level" {
                            // 识别器有电平事件时驱动波形；没有也行（时间脉冲兜底）
                            let lv = e["v"]
                            if lv != nil { vc_level = lv }
                        }
                        if k == "error" {
                            // cancelled = 新会话撞上了还没退干净的旧会话（WinRT
                            // 同进程同时只容得下一个连续识别会话）。之前直接关
                            // 收音台报错，用户看到的就是「语音识别停了：cancelled」，
                            // 再点一次又撞 —— 死循环。现在：一个字都没听到时
                            // 静默重开（跟 ended 重开共用 vc_mic_retry 计数），
                            // 连着两次都不行才认输报错。
                            let is_cancel = t.search("cancel") >= 0
                            if is_cancel && vc_accum == "" && vc_partial == "" && vc_mic_retry < 2 {
                                vc_mic_retry = vc_mic_retry + 1
                                vc_note = "收音通道被上一次占用，正在重开（第 " + ("" + vc_mic_retry) + " 次）…"
                                vc_listen = false
                                vc_close_mic()
                                start_timeout(0.8, || vc_reopen_mic())
                            } else {
                                vc_note = "语音识别停了：" + t
                                vc_sheet_on = false
                                vc_listen = false
                            }
                        }
                        if k == "ended" && vc_listen {
                            // 识别器自己收尾 = 读者停下来了：整段发出去。
                            vc_round_ended()
                        }
                    }
                }
                let live = r.data["live"]
                if live != nil && live == false && vc_listen {
                    vc_round_ended()
                }
                sync_ui()
            }
        }
        if vc_listen { start_timeout(0.4, || vc_poll_go()) }
        else { vc_close_mic() }
    })
}

// 关麦收尾：所有「这一轮结束」的路径共用这一处，失败就说出来，别静默。
// 关麦收尾：所有「这一轮结束」的路径共用这一处，失败就说出来，别静默。
fn vc_close_mic(){
    host.request("model.listen_stop", {}, fn(r){
        if !r.is_ok {
            let why = "麦克风已关上，但宿主没能确认"
            if r.error != nil && r.error != "" { why = why + "：" + r.error }
            vc_note = why
            sync_ui()
        }
    })
}

// ---- 连续对话：答完一句，等它念完，自动把麦克风再打开 ----
// 读数来源有二：宿主没有 speaking 方法时，vc_speak_check 的失败分支
// 会直接把这一轮结束掉（不无限等）。
// ---- 连续对话：答完一句，等它念完，自动把麦克风再打开 ----
// 读数来源有二：宿主没有 speaking 方法时，vc_speak_check 的失败分支
// 会直接把这一轮结束掉（不无限等）。
fn vc_wait_speak_then_mic(left){
    if !vc_auto_mic { return }
    if left <= 0 { vc_auto_mic = false vc_start() return }
    host.request("model.speaking", {}, fn(r){
        if !vc_auto_mic { return }
        let playing = false
        if r.is_ok && r.data != nil {
            let p = r.data["playing"]
            if p != nil { if p { playing = true } }
        }
        if playing { start_timeout(0.5, || vc_wait_speak_then_mic(left - 1)) }
        else { vc_auto_mic = false vc_start() }
    })
}

// 播放状态回读：让「正在说」这件事在界面上看得见（也用来验证语音真的在走）
// 播放状态回读：让「正在说」这件事在界面上看得见（也用来验证语音真的在走）
fn vc_speak_check(left){
    if left <= 0 { return }
    host.request("model.speaking", {}, fn(r){
        if r.is_ok && r.data != nil {
            let p = r.data["playing"]
            let s = r.data["seconds"]
            let playing = false
            if p != nil { if p { playing = true } }
            if playing {
                let sv = ""
                if s != nil { sv = "" + s }
                vc_note = "主编正在说话…（这一轮约 " + sv + " 秒）"
                sync_ui()
                start_timeout(0.9, || vc_speak_check(left - 1))
            } else {
                vc_note = "已经念完了"
                sync_ui()
            }
        }
    })
}

// =====================================================================
// 读者画像 · 这份报只为一个人编（存在 profile.json，不上传）
// =====================================================================
fn fc_fallback(){
    fc_items = []
    fc_state = "off"
    fc_note = "这次没能拿定主意，主编没有押注"
    sync_ui()
}

// 出报后：让主编公开押三条可验证的预测
// 出报后：让主编公开押三条可验证的预测
fn fc_kick(){
    if picked.len() == 0 { return }
    fc_items = []
    fc_state = "asking"
    fc_note = "主编正在写下三条可以验证的预测…"
    sync_ui()
    if ai_ready != 1 { fc_fallback() return }
    let lines = ""
    let i = 1
    for r in picked {
        if i < 9 { lines = lines + "" + i + ". " + r.title + "\n" }
        i = i + 1
    }
    let intro = ai_intro
    if intro == "" { intro = "这一期没有导语" }
    host.request("model.complete", {
        task: "[编辑部宪法 forecast/" + charter_v("forecast") + "]
你是科技晨报的主编，现在要做两件事。第一，在报纸上公开发表三条预测：每一条都是未来一周内可以被事实检验的具体判断，不是模棱两可的评论，也不是对已发生事情的复述；text 是一句中文预测，不超过 40 字，watch 是一句验证口径，说清看到什么就算说中。第二，把这一期报到的三到五条硬事实记进 claims（每项一句中文，尽量带上具体数字、公司名或版本号）—— 那是本报自己的台账，下一期要拿它对账，所以只写你在本期标题里确实看到的，不要推测、不要补充。直接输出一个 JSON 对象，第一个字符就是 {，不要任何思考过程。"
        input: "今天是 " + today_text() + "。\n本期导语：" + intro + "\n今日入选标题：\n" + lines + "\n请给出三条预测，并把本期报到的硬事实记进 claims。"
        schema: fc_shape
        class: "strong"
        allow_urls: true
    }, fn(r){
        let good = false
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.items != nil { good = true }
        if !good { fc_fallback() return }
        fc_items = []
        let k = 0
        for it in r.data.output.items {
            if k < 3 {
                let tx = it["text"]
                let wt = it["watch"]
                let t2 = ""
                if tx != nil { t2 = "" + tx }
                let w2 = ""
                if wt != nil { w2 = "" + wt }
                if t2 != "" {
                    fc_items.push({text: t2 watch: w2})
                    let stamp = "" + time_now()
                    let kn = "" + k
                    fc_open.push({id: "fc-" + stamp + "-" + kn date: today_text() text: t2 watch: w2})
                }
                k = k + 1
            }
        }
        if fc_items.len() == 0 { fc_fallback() return }
        claims_new = []
        let cw = r.data.output.claims
        if cw != nil {
            let ck = 0
            for c in cw {
                if ck < 5 {
                    let cs = "" + c
                    if cs != "" { claims_new.push(cs) }
                    ck = ck + 1
                }
            }
        }
        claim_save()
        claims_open = claims_new
        fc_state = "ok"
        fc_note = "主编押了 " + fc_items.len() + " 条，下一期自己回来对账"
        fc_save()
        if trail.len() > 0 {
            let fo = trail["fore"]
            fo["model"] = "" + ai_model
            fo["items"] = fc_items
            trail["fore"] = fo
            trail_save()
        }
        sync_ui()
    })
}

// 回访：拿今天取到的新标题，给上一期押下的预测对账
// 回访：拿今天取到的新标题，给上一期押下的预测对账
fn fc_review(){
    if fc_open.len() == 0 { return }
    if cand.len() == 0 { return }
    if ai_ready != 1 { return }
    fc_state = "checking"
    fc_note = "主编正在回访上一期押下的预测…"
    sync_ui()
    let plist = ""
    let i = 0
    for f in fc_open {
        if i < 6 {
            let isn = "" + i
            let ft = ""
            let fv = f["text"]
            if fv != nil { ft = "" + fv }
            let fw = ""
            let wv = f["watch"]
            if wv != nil { fw = "" + wv }
            plist = plist + isn + ". " + ft + "（看到「" + fw + "」算说中）\n"
        }
        i = i + 1
    }
    let tlist = ""
    let j = 0
    for r in cand {
        if j < 16 { tlist = tlist + "" + j + ". " + r.title + "\n" }
        j = j + 1
    }
    host.request("model.complete", {
        task: "[编辑部宪法 forecast/" + charter_v("forecast") + "]
你是晨报主编，正在为自己上一期公开发表的预测对账。逐条判断：今天的新标题里已经有明确证据支持它 = hit；已经有明确证据推翻它 = miss；还在进行中、或今天完全没有相关信息 = open。不要勉强下结论，没有证据就老实说 open。note 是一句中文说明，不超过 30 字。直接输出一个 JSON 对象，第一个字符就是 {。"
        input: "待对账的预测：\n" + plist + "\n今天取到的新标题：\n" + tlist + "\n请逐条给出 verdict（只能是 hit / miss / open）和 note。"
        schema: fc_check_shape
        class: "fast"
        allow_urls: true
    }, fn(r){
        let good = false
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.results != nil { good = true }
        if !good {
            fc_state = "ok"
            fc_note = "这一期没能对上账，下一期再试"
            sync_ui()
            return
        }
        let results = r.data.output.results
        let kept = []
        let done = []
        let k = 0
        let h = fc_hit
        let m = fc_miss
        for f in fc_open {
            let v = "open"
            let nn = "还没有可以作证的报道"
            for res in results {
                let iv = res["i"]
                if iv != nil {
                    if iv == k {
                        let vv = res["verdict"]
                        if vv != nil {
                            let sv = "" + vv
                            if sv == "hit" || sv == "miss" { v = sv }
                        }
                        let nv = res["note"]
                        if nv != nil {
                            let sn = "" + nv
                            if sn != "" { nn = sn }
                        }
                    }
                }
            }
            if v == "hit" {
                h = h + 1
                done.push({id: f.id date: f.date text: f.text watch: f.watch verdict: "hit" note: nn})
            } else if v == "miss" {
                m = m + 1
                done.push({id: f.id date: f.date text: f.text watch: f.watch verdict: "miss" note: nn})
            } else {
                kept.push(f)
            }
            k = k + 1
        }
        fc_open = kept
        for d in done { fc_hist.push(d) }
        if fc_hist.len() > 60 {
            let keep = []
            let c = 0
            let ln = fc_hist.len()
            for e in fc_hist {
                if c >= ln - 60 { keep.push(e) }
                c = c + 1
            }
            fc_hist = keep
        }
        fc_hit = h
        fc_miss = m
        fc_state = "ok"
        fc_note = fc_review_line()
        fc_save()
        sync_ui()
    })
}

// =====================================================================
// 核对 · 今天的说法有没有打架，上一期说过的有没有错
//   一次调用做两件事，因为本质是同一件事：把两批文本摆在一起找出对不上的
//   地方。同期比对挑出「口径不一致」，跨期比对挑出「我说错了」。
//   宁可真话难听：没有就老实返回空数组，不许为了有东西而凑数。
// =====================================================================
let fact_shape = {type: "object" required: ["clashes" "fixes"] properties: {clashes: {type: "array" items: {type: "object" required: ["a" "b" "note"] properties: {a: {type: "integer"} b: {type: "integer"} note: {type: "string"}}}} fixes: {type: "array" items: {type: "object" required: ["i" "note"] properties: {i: {type: "integer"} note: {type: "string"}}}}}}

// 把序号映射成下标：用计数比较，不直接拿它当索引。
// 这样即便宿主把 integer 返回成字符串，也只是匹配不上（-1），不会中断渲染。
fn fact_fallback(){
    clash = []
    fix = []
    clash_state = "off"
    clash_note = "今天没能静下来核对一遍说法"
    sync_ui()
}

fn fact_kick(){
    clash = []
    fix = []
    if cand.len() < 2 { clash_state = "off" clash_note = "" return }
    if ai_ready != 1 { fact_fallback() return }
    claims_check = claims_open
    clash_state = "asking"
    clash_note = "主编正在把今天的说法摆在一起核一遍…"
    sync_ui()
    let tlist = ""
    let i = 0
    for r in cand {
        if i < 16 { tlist = tlist + "" + i + ". [" + tier_label(r) + "] " + r.title + "\n" }
        i = i + 1
    }
    let clist = ""
    let k = 0
    for c in claims_check {
        if k < 6 { clist = clist + "" + k + ". " + c + "\n" }
        k = k + 1
    }
    if clist == "" { clist = "（上一期没有留下待核对的硬事实：fixes 请返回空数组）" }
    host.request("model.complete", {
        task: "[编辑部宪法 factcheck/" + charter_v("factcheck") + "]
你是晨报主编，正在做两件核对工作，都要对自己狠一点。\n① clashes：今天的候选标题里，如果有两条讲的是同一件事、但关键数字或说法对不上（出货量、金额、日期、版本号、结论），把这一对挑出来，a 和 b 是候选序号，note 用一句中文说清分歧在哪、两边各是什么。如果没有任何两条指向同一件事，或者说法并不冲突，就返回空数组 —— 不要为了有东西而硬凑。\n② fixes：把上一期留下的硬事实与今天的新标题逐一比对。只有今天出现了明确证据推翻它的，才挑出来记一条，i 是事实序号，note 用一句中文说清新的说法是什么。今天没有消息、只是没被提到、或者略有出入但算不上推翻，一律不算，不要输出。\n直接输出一个 JSON 对象，第一个字符就是 {，不要任何思考过程。"
        input: "今天是 " + today_text() + "。\n\n今天的候选标题（核对它们之间有没有互相矛盾的说法）：\n" + tlist + "\n上一期本报记下的硬事实（核对是否被今天推翻）：\n" + clist + "\n请给出 clashes 与 fixes 两个数组。"
        schema: fact_shape
        class: "strong"
        allow_urls: true
    }, fn(r){
        let good = false
        if r.is_ok && r.data != nil && r.data.output != nil { good = true }
        if !good { fact_fallback() return }
        clash = []
        let cw = r.data.output.clashes
        if cw != nil {
            let n = 0
            for c in cw {
                if n < 2 {
                    let ai = idx_in(c["a"], cand, cand.len())
                    let bi = idx_in(c["b"], cand, cand.len())
                    if ai >= 0 && bi >= 0 && ai != bi {
                        let nt = ""
                        let nv = c["note"]
                        if nv != nil { nt = "" + nv }
                        let ra = cand[ai]
                        let rb = cand[bi]
                        clash.push({a: ra.title b: rb.title ta: tier_label(ra) tb: tier_label(rb) note: nt})
                        n = n + 1
                    }
                }
            }
        }
        fix = []
        let fw = r.data.output.fixes
        if fw != nil {
            let m = 0
            for f in fw {
                if m < 3 {
                    let fi = idx_in(f["i"], claims_check, claims_check.len())
                    if fi >= 0 {
                        let nt = ""
                        let nv = f["note"]
                        if nv != nil { nt = "" + nv }
                        fix.push({date: today_text() claim: claims_check[fi] note: nt})
                        m = m + 1
                    }
                }
            }
        }
        clash_total = clash_total + clash.len()
        fix_total = fix_total + fix.len()
        clash_state = "ok"
        let cs = "" + clash.len()
        let fs2 = "" + fix.len()
        if clash.len() > 0 && fix.len() > 0 {
            clash_note = "今天有 " + cs + " 处口径打架，" + fs2 + " 条旧说法要更正"
        } else if clash.len() > 0 {
            clash_note = "今天有 " + cs + " 处口径打架"
        } else if fix.len() > 0 {
            clash_note = "今天要对上一期的 " + fs2 + " 条说法作更正"
        } else {
            clash_note = "今天没有发现口径打架，上一期也没有需要更正的说法"
        }
        if trail.len() > 0 {
            let ft = trail["fact"]
            ft["clashes"] = clash_total
            ft["fixes"] = fix_total
            ft["note"] = clash_note
            trail["fact"] = ft
            trail_save()
        }
        fact_save()
        sync_ui()
    })
}

fn ag_do(tool, args){
    if tool == "set_topics" {
        let list = []
        let vs = ag_arg(args, "topics")
        if vs != nil { for t in vs { list.push("" + t) } }
        ag_apply_topics(list)
        sync_ui()
        return "品类已切换为：" + topics_line()
    }
    if tool == "set_platforms" {
        let list = []
        let vs = ag_arg(args, "platforms")
        if vs != nil { for t in vs { list.push("" + t) } }
        ag_apply_plats(list)
        sync_ui()
        return "取数平台已切换为：" + plat_line()
    }
    if tool == "set_limit" {
        let n = ag_num(ag_arg(args, "n"), limit)
        limit = n
        if limit < 3 { limit = 3 }
        if limit > 30 { limit = 30 }
        sync_ui()
        return "条数上限改为 " + limit + " 条"
    }
    if tool == "set_intent" {
        let s = ""
        let v = ag_arg(args, "text")
        if v != nil { s = "" + v }
        ask = s
        sync_ui()
        if ask == "" { return "关注点已清空" }
        return "关注点已写为：" + ask
    }
    if tool == "make_plan" {
        make_plan()
        return "取数计划已写好，界面切到待批准页；批准前不会联网"
    }
    if tool == "approve" {
        if !ag_user_approved() {
            return "还没批准：用户没有说「批准」或「开始取数」。请用 say 把计划讲给用户听，等他说了批准再调用本工具（他也可以直接点界面上的「批准并取数」）。"
        }
        approve()
        return "已按用户的话批准取数，正在联网取数"
    }
    if tool == "deny" {
        deny()
        return "已取消，未发起任何网络请求"
    }
    if tool == "restart" {
        restart()
        return "已清空这一期，回到首页"
    }
    if tool == "open_story" {
        let i = ag_num(ag_arg(args, "i"), 0)
        let r = ag_row_at(i)
        if r == nil { return "没有第 " + i + " 条；现在已经入选 " + show_rows().len() + " 条" }
        open_story(r)
        return "已打开第 " + i + " 条：" + r.title
    }
    if tool == "close_story" {
        if phase != "story" { return "现在不在阅读页，不用返回" }
        close_story()
        return "已回到晨报列表"
    }
    if tool == "step_story" {
        if phase != "story" { return "现在不在阅读页；先用 open_story 打开某一条" }
        let d = ag_num(ag_arg(args, "d"), 1)
        if d < 0 { d = -1 }
        else { d = 1 }
        story_step(d)
        return "已切到：" + story_title
    }
    if tool == "redraw_cover" {
        if picked.len() == 0 { return "现在没有可换的头版；先取数生成这一期" }
        cover_retry()
        return "视觉主编已经去重画头版了"
    }
    if tool == "draw_art" {
        if phase != "story" { return "先打开一条新闻（open_story），才能给它画配图" }
        art_retry()
        return "正在给这一条画配图"
    }
    if tool == "search_archive" {
        let q = ""
        let v = ag_arg(args, "q")
        if v != nil { q = "" + v }
        arc_hits = arc_find(q)
        if phase != "story" { phase = "done" }
        sync_ui()
        return arc_hits_text()
    }
    if tool == "find_brief" {
        let w = ""
        let v = ag_arg(args, "when")
        if v != nil { w = "" + v }
        if w == "" { return "要说清找哪一期：「10月11日」「1011」「昨天」都行。" }
        wb_arc_q = w
        wb_do_find()
        if wb_arc_res.len() == 0 { return wb_arc_note }
        let e = wb_arc_res[0]
        return "找到 " + wb_arc_note + "。第一条是 " + wb_issue_md(e) + " 那一期（" + e.rows.len() + " 条）。要打开就说「打开这一期」。"
    }
    if tool == "open_brief" {
        if wb_arc_res.len() == 0 { return "还没有找到要打开的往期；先用 find_brief 找一期。" }
        wb_res_open(0)
        return "已打开 " + ("" + wb_arc_res[0].stamp) + " 这一期，正文在结果页。"
    }
    if tool == "star_brief" {
        let e = wb_cur_issue()
        if e == nil { return "还没有可收藏的一期。" }
        if wb_is_fav("" + e.id) { return "这一期已经在收藏夹里了。" }
        wb_fav_add(e)
        wb_fav_save()
        sync_ui()
        return "已收藏 " + ("" + e.stamp) + "；收藏夹现在有 " + wb_favs.len() + " 期。"
    }
    if tool == "remember_reader" {
        let s = ""
        let v = ag_arg(args, "text")
        if v != nil { s = "" + v }
        if s == "" { return "没听清要记什么，再说一次" }
        pf_note_add(s)
        sync_ui()
        return "已记住：" + s + "。以后每一期都会照这条偏好选。"
    }
    if tool == "speak" {
        let s = ""
        let v = ag_arg(args, "text")
        if v != nil { s = "" + v }
        if s == "" { s = ag_note }
        if !vc_tts { return "这台机器没有可用的语音合成，念不出来" }
        vc_auto = false
        vc_say_now(s)
        return "正在念：" + art_cut(s, 40)
    }
    if tool == "read_brief" {
        if picked.len() == 0 && last_rows.len() == 0 { return "现在还没有可念的晨报；先生成一期" }
        // 语音能力是「用时再探」的，所以这里不能直接判 vc_tts —— 那会让
        // 「开机后第一句话就是念给我听」永远得到「没有可用的语音合成」。
        // 没探过就先探，探完 rv_wait 会自动接着念（见 vc_probe 的收尾）。
        if !vc_probed {
            rv_wait = true
            vc_probe()
            return "我先问一句这台机器能不能出声，然后就开始念这一期。"
        }
        if !vc_tts { return "这台机器没有可用的语音合成，念不出来" }
        vc_auto = false
        rv_build()
        rv_i = 0
        rv_on = true
        rv_next()
        return "开始分段念这一期，" + rv_text_line() + "。读者随时可以插话，我会停下等着。"
    }
    if tool == "stop_read" {
        if !rv_on { return "现在没有在念" }
        rv_stop()
        return "已停下，" + vc_note
    }
    if tool == "pick_angle" {
        if phase != "asking" { return "现在没有待回答的问题" }
        let w = ""
        let v = ag_arg(args, "which")
        if v != nil { w = "" + v }
        if w == "" { w = "skip" }
        let picked_text = "让主编自己定"
        if w == "a" { picked_text = aq_a }
        if w == "b" { picked_text = aq_b }
        aq_choose(w)
        return "好，今天的角度按「" + picked_text + "」来，取数计划这就出来。"
    }
    if tool == "draft_interview" {
        if phase != "story" { return "先打开一条新闻（open_story），才有可追问的对象" }
        iv_kick()
        return "正在给这条起草一封追问邮件，写好会存进本机草稿箱。发信不在这份程序里，需要你之后在外部确认。"
    }
    if tool == "read_ledger" {
        return ledger_text()
    }
    if tool == "read_trail" {
        return trail_text() + "

" + replay_text()
    }
    if tool == "read_charter" {
        return charter_text() + "
当前 " + charter_version_line()
    }
    "没有 " + tool + " 这个工具"
}

// =====================================================================
// L2 决策层 · 主编循环：读用户的话 → 说话还是调用工具 → 拿到结果再来一轮
// =====================================================================
let ag_shape = {type: "object" required: ["say" "tool"] properties: {say: {type: "string"} tool: {type: "string"} args: {}}}

// 主编的「操作手册」：工具清单 + 本报编辑方针。
// 为什么单拎出来、不写在 ag_system 里：宿主对 task 有 4096 字节的硬上限
// （model-service 的 MAX_TASK_BYTES）。整本手册连工具清单接近 7.6K 字节，
// 塞进 task 会被宿主在联网之前就拒掉 —— 实测报错就是
// 「task is 6759 bytes; a task is at most 4096」，主编整个链路因此从来没通过。
// input 的上限是 32768 字节，装得下，模型在用户消息里一样看得到。
fn ag_send(){
    if ag_busy { return }
    let text = ag_draft
    if text == "" { return }
    ag_draft = ""
    ui.ag_in.set_text("")
    ag_log.push({who: "me" text: text})
    ag_msgs.push({role: "user" content: text})
    ag_trim_msgs()
    ag_trim_log()
    ag_steps = 0
    ag_prev = ""
    ag_nudge = 0
    ag_last_user = text
    ag_busy = true
    ag_note = "主编正在读你的话…"
    sync_ui()
    start_timeout(0.05, || ag_turn())
}

fn ag_say(text){
    ag_draft = text
    ag_send()
}

fn ag_turn(){
    ag_steps = ag_steps + 1
    if ag_steps > 6 {
        ag_busy = false
        ag_note = "这一轮走了六步还没收口，先停在这里"
        bl_settle()
        sync_ui()
        return
    }
    let convo = []
    for m in ag_msgs { convo.push(m) }
    ag_t0 = time_now()
    host.request("model.complete", {task: ag_system() input: {manual: ag_manual() context: ag_context() history: convo} schema: ag_shape class: "strong" allow_urls: true}, fn(r){
        ag_reply(r)
    })
}

fn ag_reply(r){
    if !r.is_ok || r.data == nil || r.data.output == nil {
        ag_busy = false
        ag_note = "主编这次没有答复"
        if r.error != nil && r.error != "" { ag_note = "主编这次没有答复（" + r.error + "）" }
        // 模型这条腿断了，就先给饲养员一个说得清的由头，而不是一串英文报错。
        let why = "主编没接上模型"
        if r.error != nil {
            let e = "" + r.error
            if e.search("balance") >= 0 { why = "模型账户没额度" }
            else if e.search("timed out") >= 0 { why = "模型超时没回话" }
            else if e.search("no model key") >= 0 { why = "这台机器没配模型密钥" }
        }
        bl_fail(why)
        ag_log.push({who: "ai" text: "我这边没接上模型，这次答不上来。界面上的按钮都还在，直接点也一样用。"})
        ag_trim_log()
        sync_ui()
        ag_after_answer()
        return
    }
    let d = r.data.output
    let say = ""
    if d.say != nil { say = "" + d.say }
    let tool = ""
    if d.tool != nil { tool = "" + d.tool }
    let args = d["args"]
    ag_used = ag_used + 1
    let line = say
    if tool != "" && tool != "none" {
        if line != "" { line = line + " " }
        line = line + "[调用工具 " + tool + "]"
    }
    if line != "" { ag_msgs.push({role: "assistant" content: line}) }
    if say != "" { ag_log.push({who: "ai" text: say}) }
    if tool == "" || tool == "none" {
        if ag_unfinished() && ag_nudge_more() { return }
        ag_busy = false
        ag_note = "主编 · " + seconds_text((time_now() - ag_t0) * 1000) + " · " + ag_model_text()
        bl_settle()
        bl_settle()
        ag_trim_log()
        sync_ui()
        // 主编的收尾话，配上自己的声音说一遍
        if say != "" && tool != "speak" { vc_say(say) }
        // 说完这一轮：排队的话继续送，连续对话则自动再把麦克风打开。
        ag_after_answer()
        return
    }
    let sig = tool
    if args != nil { sig = sig + "|" + args.to_json() }
    if sig == ag_prev {
        ag_log.push({who: "tool" text: "· " + tool + " 重复调用已跳过"})
        ag_msgs.push({role: "user" content: "工具 " + tool + " 刚才已经调用过，结果一样，不用再来一遍。请直接用 say 回一句收尾。"})
        ag_trim_log()
        ag_trim_msgs()
        ag_busy = false
        ag_note = "已跳过重复调用：" + tool
        bl_settle()
        sync_ui()
        ag_after_answer()
        return
    }
    ag_prev = sig
    let res = ag_do(tool, args)
    ag_log.push({who: "tool" text: "· " + tool + " → " + res})
    ag_msgs.push({role: "user" content: "工具 " + tool + " 的结果：" + res + "。事情办完就用 say 回一句收尾；还要办就继续调用工具。"})
    ag_trim_log()
    ag_trim_msgs()
    ag_note = "已执行：" + tool
    sync_ui()
    start_timeout(0.40, || ag_turn())
}

// 用户要的是「一份晨报」这类任务，而界面还停在首页 —— 那就是还没办完。
// （模型会说「这就去出计划」却不真的调用工具，这一步把它推回去。）
let ag_nudge = 0

fn ag_nudge_more(){
    if ag_nudge >= 2 { return false }
    ag_nudge = ag_nudge + 1
    ag_msgs.push({role: "user" content: "（系统提示）界面现在还停在首页，你上一步只是说了要做却没有真的调用工具。请现在真的调用合适的工具把用户的请求办完；如果用户没说批准，办到「待批准页」就停手。"})
    ag_trim_msgs()
    ag_busy = true
    ag_note = "主编还没把事办完，正在继续…"
    sync_ui()
    start_timeout(0.35, || ag_turn())
    true
}

fn ag_toggle(){
    // 底栏那枚「工作台」胶囊：开着就收、关着就开（默认落在对话分区）。
    if ag_open { wb_close() } else { wb_open(0) }
}

// 一轮答复说完之后的收尾：先把排队的话（说话时主编正忙）送进去；
// 没有排队的、且是连续对话模式，就把麦克风自动再打开。
// 一轮答复说完之后的收尾：先把排队的话（说话时主编正忙）送进去；
// 没有排队的、且是连续对话模式，就把麦克风自动再打开。
fn ag_after_answer(){
    if vc_pending != "" {
        let t = vc_pending
        vc_pending = ""
        ag_say(t)
        return
    }
    if vc_auto_mic { start_timeout(0.3, || vc_wait_speak_then_mic(20)) }
}

fn ag_clear(){
    ag_log = []
    ag_msgs = []
    ag_note = ""
    ag_used = 0
    sync_ui()
}

fn panel_reset(n){
    panel = []
    panel_state = "asking"
    panel_note = "三位编辑收到 " + n + " 条候选，正在各自独立阅读…"
    panel_sig = ""
    sync_ui()
}

fn panel_ask(){
    start_timeout(0.02, || panel_role("tech"))
    start_timeout(0.04, || panel_role("biz"))
    start_timeout(0.06, || panel_role("reader"))
}

fn panel_role(id){
    let role = role_of(id)
    if role == nil { return }
    let list = ""
    let k = 0
    for r in cand {
        if k < 12 { list = list + "" + k + ". " + r.title + "\n" }
        k = k + 1
    }
    let focus = ask
    if focus == "" { focus = topics_line() }
    if focus == "未选主题（全都要）" { focus = "没有特别偏好，挑最重要的科技新闻" }
    let sys = role.line + "你是《晨报》的" + role.label + "初审编辑，只从这一个角度判断：" + role.ask + "输出一个 JSON 对象，只有两项：digest 是一句话点评（不超过 60 字）；votes 是你推荐的候选序号数组（最多 6 个）。第一个字符就是 {，不要任何思考过程，不要围栏。\n[编辑部宪法 panel/" + charter_v("panel") + "]"
    let body = "读者的关注点：" + focus + "\n\n候选标题（序号从 0 开始）\n" + list + "\n请独立给出你的初审意见。"
    let t0 = time_now()
    host.request("model.complete", {
        task: sys
        input: body
        schema: role_shape
        class: "fast"
        allow_urls: true
    }, fn(r){
        panel_put(id, r, t0)
    })
}

fn panel_put(id, r, t0){
    let role = role_of(id)
    let label = id
    if role != nil { label = role.label }
    let item = {id: id label: label state: "ok" digest: "" votes: [] ms: 0 model: ""}
    let good = false
    if r.is_ok && r.data != nil && r.data.output != nil { good = true }
    if good {
        let d = r.data.output
        let dg = d.digest
        if dg == nil { dg = "" }
        item.digest = dg
        let vs = []
        if d.votes != nil { for v in d.votes { vs.push(v) } }
        item.votes = vs
        item.model = "AI"
        item.ms = (time_now() - t0) * 1000
    } else {
        item.state = "fail"
        item.digest = "这位编辑这次没有答复。"
        if r.error != nil && r.error != "" { item.digest = "这位编辑这次没有答复。" }
    }
    panel_remove(id)
    panel.push(item)
    // 留痕：这位编辑的原话与推荐序号（复盘的第二层：谁说了什么）
    trail_set_panel(id, "" + label, item.votes, "" + item.digest, item.ms)
    panel_check()
}

fn panel_check(){
    if panel.len() < roles.len() {
        sync_ui()
        return
    }
    panel_state = "done"
    let good = 0
    let total = 0
    let sig = ""
    for p in panel {
        total = total + p.ms
        if p.state == "ok" { good = good + 1 }
        sig = sig + p.label + ":" + p.state + ":" + p.ms + ":["
        for v in p.votes { sig = sig + v + "," }
        sig = sig + "]|"
    }
    panel_sig = sig
    if good == 0 {
        panel_note = "三位编辑这次都没能给出意见，已跳过初审直接按主题规则挑选。"
        fallback_pick()
        finish()
        return
    }
    panel_note = "三位编辑背靠背读完了 " + roles.len() + " 个角度（合计 " + seconds_text(total) + "），" + good + " 位给出了推荐，已连同推荐理由交给主编终审。"
    sync_ui()
    start_timeout(0.05, || judge_try(16))
}

fn judge(){
    panel_reset(cand_n)
    panel_ask()
}

fn judge_try(n){
    // 第一遍（n > 8）重置重试计数：judge_try(16) → judge_try(8) → judge_try(6) 是一条链。
    if n > 8 { judge_try2 = 0 }
    ai_state = "asking"
    let list = ""
    let i = 0
    for r in cand {
        if i < n { list = list + "" + i + ". [" + tier_label(r) + "] " + r.title + "\n" }
        i = i + 1
    }
    let focus = ask
    if focus == "" { focus = topics_line() }
    if focus == "未选主题（全都要）" { focus = "没有特别偏好，挑最重要的科技新闻" }
    let panel_note_line = panel_digest_text()
    let ask_text_full = "今天是 " + today_text() + "。\n读者的关注点：" + focus + "\n读者画像：" + pf_focus() + "\n\n候选标题（序号从 0 开始）\n" + list + "\n\n三位初审编辑的独立意见如下，各自的推荐序号互不商量，仅供你参考：\n" + panel_note_line + "\n从候选里挑出最多 " + limit + " 条最值得进入晨报的科技项目，按重要性从高到低排序，每条写一句中文入选理由。当三位编辑意见不一致时，你来做最终取舍。直接输出 JSON，不要思考过程。" + judge_remind()
    ai_t0 = time_now()
    host.request("model.complete", {
        task: "[编辑部宪法 judge/" + charter_v("judge") + "]\n你是一位科技新闻主编，手下有技术、行业、读者三位初审编辑。三位编辑已经各自给过意见，你参考但不被他们绑住，做最终取舍。候选标题前的方括号是信源等级：一手＝官方博客或仓库或论文，二手＝媒体报道，传闻＝社交平台未经证实，转载＝聚合站。硬规矩：标注为「传闻·未证实」的条目最多只允许入选 1 条，且入选理由里必须写明「尚未证实」。一手来源在同等重要程度下优先。直接输出一个 JSON 对象，第一个字符就是 {，不要输出任何推理过程或思考。不要啰嗦，不要加围栏。JSON 结构：intro 是导语（字符串），picks 是数组，每项含 i（候选序号，整数）和 why（入选理由，字符串）；drops 是数组、最多 3 项，每项含 i 和 why，记下你没选中但最可惜的候选，why 用一句中文说清为什么没上（例如信源太薄、话题与已选重复、体量太小）。"
        input: ask_text_full
        schema: brief_shape
        class: "strong"
        allow_urls: true
    }, fn(r){
        let ok_data = false
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.picks != nil { ok_data = true }
        if ok_data {
            ai_on = true
            ai_state = "ok"
            ai_intro = r.data.output.intro
            ai_model = "咕嘎 · 主编"
            ai_ms = (time_now() - ai_t0) * 1000
            ai_tokens = model_tokens(r.data)
            ai_think = ""
            picks_from_ai(r.data.output.picks)
            drops_from_ai(r.data.output.drops)
            // 留痕：主编的导语、每一条的入选理由、以及他砍掉的（复盘第三层）
            trail_set_judge("" + ai_model, ai_ms, "" + ai_intro, picked, drop)
            if picked.len() > 0 {
                ai_note = "咕嘎审阅了 " + cand_n + " 条候选，选出 " + picked.len() + " 条。"
            } else {
                ai_note = "咕嘎没有挑中任何一条，已按主题规则兜底挑选。"
                fallback_pick()
            }
            finish()
        } else {
            let why = "没有可用的答复"
            if r.error != nil && r.error != "" { why = r.error }
            if n > 8 {
                ai_note = "第一次没拿到可用结果，已自动换更短的名单再试一次。"
                sync_ui()
                judge_try(8)
            } else if judge_try2 < 1 {
                // 缩短名单之后仍然不是合法 JSON —— 多半是答复被截断。
                // 再收窄一次，并且明确告诉它「上次错在哪」。
                // 一共三遍：16 条 → 8 条 → 6 条 + 提醒，之后才认输走规则模式。
                judge_try2 = judge_try2 + 1
                ai_note = "这一次拿到的也不是合法 JSON，已带上「只输出 JSON」的提醒重问一次。"
                sync_ui()
                judge_try(6)
            } else {
                ai_on = false
                ai_state = "failed"
                ai_note = "咕嘎连续三次都没有给出可用答复，已改用规则筛选。原因：" + why + "。"
                fallback_pick()
                finish()
            }
        }
    })
}

// 读者有权否决主编：仍要出报。授权门的老规矩 —— 决定权在人手里。
fn refuse_go(){
    refuse_on = false
    start_timeout(0.05, || fc_review())
    if ai_ready == 1 {
        phase = "judging"
        sync_ui()
        judge()
    } else {
        fallback_pick()
        finish()
    }
}

// =====================================================================
// 出报前的一问 · 主编先开口
//   对话必须双方都能发起，否则只是问答。点「生成晨报」之后，主编先问一句
//   二选一，读者答 A / B（可以语音答），也可以让他别问了直接来。
//   选项不是摆设：选中的那句会真的成为本期关注点，进 judge 的提示词。
// =====================================================================
let aq_shape = {type: "object" required: ["q" "a" "b"] properties: {q: {type: "string"} a: {type: "string"} b: {type: "string"}}}

fn aq_start(){
    if phase != "intent" { return }
    phase = "asking"
    aq_state = "asking"
    aq_q = ""
    aq_a = ""
    aq_b = ""
    aq_note = "主编正在想，今天该问你什么…"
    sync_ui()
    let body = "今天是 " + today_text() + "。\n读者当前设置：主题=" + topics_line() + "；条数上限=" + limit + " 条；读者画像：" + pf_focus() + "。\n\n请用一句不超过 20 字的话问他今天更想看哪个角度，并给出两个互相排斥的选项，每个选项不超过 18 字、必须是一个能直接当成本期关注点用的角度（例如「偏技术实现与开源进展」对「偏行业格局与商业化」）。只输出 JSON。"
    host.request("model.complete", {
        task: "你是科技新闻主编。开报前你要问读者一个二选一的问题，用来决定今天的取舍。两个选项必须互相排斥、都必须能直接当成本期的关注点。直接输出一个 JSON 对象，第一个字符就是 {，不要围栏，不要任何思考过程。结构：q 是问题（字符串），a 是选项一（字符串），b 是选项二（字符串）。
[编辑部宪法 ask/" + charter_v("ask") + "]"
        input: body
        schema: aq_shape
        class: "fast"
        allow_urls: true
    }, fn(r){
        let got = false
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.q != nil { got = true }
        if got {
            aq_state = "ok"
            aq_q = r.data.output.q
            aq_a = r.data.output.a
            aq_b = r.data.output.b
            aq_note = "答 A、答 B，或者说「你定」都行。"
            sync_ui()
            if vc_auto { vc_say_now(aq_q) }
        } else {
            aq_state = "failed"
            aq_note = "主编这次没想出问题，直接给你出报计划。"
            sync_ui()
            aq_choose("skip")
        }
    })
}

// which 取 a / b / skip。选中的角度会写进本期关注点。
// which 取 a / b / skip。选中的角度会写进本期关注点。
fn aq_choose(which){
    if which == "a" && aq_a != "" { ask = aq_a }
    if which == "b" && aq_b != "" { ask = aq_b }
    aq_state = ""
    aq_note = ""
    make_plan()
}

fn iv_kick(){
    if story == nil { return }
    if iv_state == "asking" { return }
    iv_state = "asking"
    iv_note = "主编正在读原文，起草一封追问…"
    iv_to = ""
    iv_sub = ""
    iv_body = ""
    iv_from = story.title
    sync_ui()
    let body = "这条新闻的标题：" + story.title + "\n原文链接：" + story_url_text() + "\n官方摘要：" + story_sum + "\n\n请起草一封写给相关方（公司 / 作者 / 项目维护者）的采访邮件。要求：只问一个能用一句话回答的具体问题；正文不超过三句话；语气克制，不奉承、不指控、不预设结论；不要编造收件人邮箱，找不到公开邮箱就留空字符串。只输出 JSON。"
    host.request("model.complete", {
        task: "[编辑部宪法 interview/" + charter_v("interview") + "]
你是《晨报》主编，要给一条新闻的当事人写一封简短的追问邮件。你只问一个具体、可验证的问题。直接输出一个 JSON 对象，第一个字符就是 {，不要围栏，不要任何思考过程。结构：to 是收件人邮箱（找不到公开邮箱填空字符串），sub 是邮件主题，body 是正文。"
        input: body
        schema: iv_shape
        class: "strong"
        allow_urls: true
    }, fn(r){
        let got = false
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.body != nil { got = true }
        if got {
            iv_state = "ok"
            iv_to = r.data.output.to
            iv_sub = r.data.output.sub
            iv_body = r.data.output.body
            iv_save()
            iv_note = "草稿已存在本机。发信不在这份程序里 —— 需要你在外部确认后自己发。"
        } else {
            iv_state = "failed"
            iv_note = "这次没写出草稿，可以再试一次。"
        }
        sync_ui()
    })
}

fn rv_start(){
    // 还没探过语音能力 → 先探，探完接着念（别急着判"没有语音"）。
    if !vc_probed {
        rv_wait = true
        vc_note = "正在问宿主：这台机器能不能开口说话…"
        sync_ui()
        vc_probe()
        return
    }
    if !vc_tts {
        vc_note = "这台机器没有可用的语音合成"
        sync_ui()
        return
    }
    if rv_q.len() == 0 || rv_i >= rv_q.len() {
        rv_build()
        rv_i = 0
    }
    rv_on = true
    rv_next()
}

fn rv_next(){
    if !rv_on { return }
    if rv_i >= rv_q.len() {
        rv_on = false
        vc_note = "这一期念完了"
        sync_ui()
        return
    }
    if !vc_tts {
        rv_on = false
        vc_note = "这台机器没有可用的语音合成"
        sync_ui()
        return
    }
    let t = art_cut(rv_q[rv_i], 150)
    if t == "" {
        rv_i = rv_i + 1
        rv_next()
        return
    }
    vc_note = "正在念 · " + rv_text_line()
    sync_ui()
    // 分段朗读的每一段，咕嘎的嘴也跟着动（同一套口型帧）
    pet_talk_start(t)
    // 轮询上限按宿主报的时长算：一段 150 字的导语要念 30 秒左右，
    // 写死轮数会把长段拦腰切断（每轮 0.9 秒）。
    host.request("model.speak", {text: t lang: "zh-CN" voice: vc_voice, rate: 1.15, pitch: 1.07}, fn(r){
        if !rv_on { return }
        // 念不出来就停下并说清楚。以前这里不管成败都照常计时推进，
        // 宿主没有语音时整期会「无声地念完」，读者以为是自己没听见。
        if !r.is_ok {
            rv_on = false
            let why = "这一期念不出来"
            if r.error != nil && r.error != "" { why = why + "：" + r.error }
            vc_note = why + "。文字照常显示，其余功能不受影响"
            sync_ui()
            return
        }
        let secs = 4
        if r.data != nil {
            let sv = r.data["seconds"]
            if sv != nil { secs = sv }
        }
        let polls = 2 + floor(secs / 0.9)
        if polls < 4 { polls = 4 }
        if polls > 80 { polls = 80 }
        rv_total = polls
        start_timeout(0.9, || rv_watch(polls))
    })
}

fn rv_watch(left){
    if !rv_on { return }
    if left <= 0 {
        rv_i = rv_i + 1
        rv_next()
        return
    }
    // 至少要等够两轮（约 1.8 秒）才允许「念完了」这个判断成立。
    // 原因：model.speak 是异步的，第一轮查询时它可能还没开始播；
    // 而有的宿主根本不提供 model.speaking，这时 playing 会一直是 false。
    // 加这个下限，最坏情况是每段都念满 1.8 秒才推进，也不会把整期跳着念完。
    let waited = rv_total - left
    host.request("model.speaking", {}, fn(r){
        if !rv_on { return }
        let playing = false
        if r.is_ok && r.data != nil {
            let p = r.data["playing"]
            if p != nil { if p { playing = true } }
        }
        if playing { start_timeout(0.9, || rv_watch(left - 1)) }
        else {
            if waited < 2 { start_timeout(0.9, || rv_watch(left - 1)) }
            else {
                rv_i = rv_i + 1
                rv_next()
            }
        }
    })
}

// 停：不清空队列，所以能「接着念」。插话走的也是这里。
// 停：不清空队列，所以能「接着念」。插话走的也是这里。
fn rv_stop(){
    rv_on = false
    vc_note = "已停下，停在" + rv_text_line() + "。说「接着念」我就从这儿往下念。"
    sync_ui()
}

fn rv_toggle(){
    if rv_on { rv_stop() }
    else { rv_start() }
}

fn fetch_watch(){
    if phase != "fetching" { return }
    fetch_tick = fetch_tick + 1
    // 90 秒是这个 watchdog 的耐心上限。取数是真的联网，境外口偶尔要 10 秒以上，
    // 45 秒时曾经误判过整轮「全部失败」，所以放宽。
    if fetch_tick < 90 { start_timeout(1.0, || fetch_watch()) return }
    if phase == "fetching" {
        busy = false
        // 补记：只补「勾选了却一直没有音信」的那几家。
        // 曾经这里是 `for s in sources` 全量补记，导致没勾的平台也被写进失败名单，
        // 失败数超过应取数，标题就会写成「未能获取任何来源」而正文却有取用条数。
        for s in sources {
            if plat_on(s.plat) && !src_ok(s.label) { src_fail(s.label, "超时未回") }
        }
        phase = "done"
        sync_ui()
    }
}

fn run_brief(){
    if busy { return }
    busy = true
    fetch_tick = 0
    start_timeout(1.0, || fetch_watch())
    gather()
    if refuse_check() {
        phase = "refused"
        busy = false
        // 拒刊也是这一期的编辑部决策，照样留痕 ——
        // 「今天为什么没出报」和「今天为什么选这五条」一样值得被回放
        trail["result"] = {picked: 0 refused: true}
        trail["judge"] = {model: "" ms: 0 intro: refuse_why picks: [] drops: []}
        trail_save()
        sync_ui()
        return
    }
    start_timeout(0.05, || fc_review())
    if ai_ready == 1 {
        phase = "judging"
        sync_ui()
        judge()
    } else {
        fallback_pick()
        finish()
    }
}

fn finish(){
    finished_at = time_now()
    pf_briefs = pf_briefs + 1
    pf_save()
    if picked.len() > 0 {
        fs.write("last_brief.json", {ts: finished_at rows: picked intro: ai_intro whys: ai_whys}.to_json())
        last_rows = picked
        // 期次存档：顶部标签条靠它才能翻回前几期
        issues_push()
        last_at = finished_at
        // 线索时间轴：先拿这一期跟档案比阶段，再把自己写进档案 —— 顺序不能反
        th_scan(picked)
        // 往期档案：这一期进了本报记忆，以后可以「追一条线索」
        arc_add(picked)
    } else if ok_sources.len() > 0 {
        // 取到数了、但一条都没选上 —— 这是「筛选结果为空」，值得记一期空刊
        fs.write("last_brief.json", {ts: finished_at rows: []}.to_json())
        last_rows = []
        last_at = finished_at
    }
    phase = "done"
    busy = false
    // 留痕：候选池 / 初审 / 终审三层的快照先落地，
    // 后面 cover、forecast、factcheck 各自回来时再补写（trail_save 会覆盖同一期）
    trail["result"] = {picked: picked.len() refused: false}   // 正常出报；拒刊路径在 run_brief() 里单独落
    trail_save()
    sync_ui()
    if picked.len() > 0 { start_timeout(2.5, || cover_kick()) }
    if picked.len() > 0 { start_timeout(3.3, || vd_kick()) }   // 决策台：挤在封面与核对之间落地，独自起一个定时器，别跟别人同一行
    if picked.len() > 0 { start_timeout(4.0, || vf_kick()) }   // 核验台：先算本地证据再见模型，跟决策台错开，避免同一时刻两条请求
    if picked.len() > 0 { start_timeout(4.4, || fact_kick()) }   // 核对先起：要用上一期留下的台账，必须赶在 fc_kick 覆盖它之前拿到快照
    if picked.len() > 0 { start_timeout(6.2, || fc_kick()) }
    if picked.len() > 0 && vc_auto {
        start_timeout(1.2, || vc_hello_intro())
    }
}

fn vc_hello_intro(){
    if !vc_auto { return }
    let t = "今天的晨报好了。"
    if ai_intro != "" { t = t + ai_intro }
    else { t = t + "一共选了 " + picked.len() + " 条。" }
    vc_say_now(t)
}

fn load_last(){
    if fs.exists("last_brief.json") {
        let v = fs.read("last_brief.json").parse_json()
        if v != nil && v.rows != nil {
            last_rows = v.rows
            last_at = v.ts
            finished_at = v.ts
            if v.intro != nil { ai_intro = v.intro }
            if v.whys != nil { ai_whys = v.whys }
            ai_state = "restored"
            if fs.exists("cover.json") {
                let c_raw = fs.read("cover.json")
                let c = c_raw.parse_json()
                if c != nil && c.ts == last_at && c.url != nil && c.url != "" {
                    cover_head = c.head
                    cover_sub = ""
                    // ⚠️ 这里原来是 `if c.sub != nil { cover_sub = "" + c.sub }`，
                    // 一直以为 `!= nil` 能判空。但在 splash 里**读一个不存在的键会抛错**
                    // （object_heap.rs:935），而未捕获的错误会「立即终止本次求值」
                    // （vm.rs:861 "An uncaught error terminates this evaluation"）。
                    // 于是 boot() 走到这一行就整个断掉：后面的 art_load / pf_load /
                    // trail_load / pet_boot 以及 **cg_off() 的注册**全被跳过，
                    // 开屏 CG 永远盖在主界面上 —— 用户看到的就是「白屏」。
                    // 10-11 之前写下的 cover.json 没有 sub 字段（那时还没有副标题），
                    // 所以先查原文里有没有 `"sub":"`，有才去读，键必定存在，不会再抛。
                    if c_raw.search("\"sub\":\"") >= 0 { cover_sub = "" + c.sub }
                    cover_url = c.url
                    cover_mm = art_mm_url(c.url)
                    cover_on = true
                    cover_state = "ok"
                    cover_note = "视觉主编头版"
                    if c.q != nil { cover_q = c.q }
                }
            }
        }
    }
    // ★ 白屏根因修复：把上一期的出报留痕一次性读进内存。
    //
    // 原来 `trail` 重启后是空的（出报时才填），而 replay_now() 在 trail 为空时
    // 会 fs.read("trail.json") + parse_json()。结果页的 on_render 每帧都要调
    // replay_text / replay_pool_line / replay_panel_line / replay_judge_line，
    // 等于**每帧 4 次读盘 + 4 次 JSON 解析**。脚本单次求值有墙钟预算，
    // 被这一项打爆后 VM 直接掐断（日志：`script time budget exceeded`，vm.rs:1046），
    // 这一帧什么都画不出来 → 白屏；下一帧照样超时 → 永远白屏，只能退出重开。
    //
    // 更糟的是「退出重开」恰恰会再次走进这个状态：last_brief.json 恢复了正文、
    // trail 却还是空的 —— 所以用户看到的是「经常白屏、重开也治不好」。
    //
    // 现在启动时读一次进 `trail`，replay_now() 命中内存，每帧零 I/O。
    if fs.exists("trail.json") {
        let tv = fs.read("trail.json").parse_json()
        if tv != nil {
            let it = tv["items"]
            if it != nil {
                let n = it.len()
                if n > 0 { trail = it[n - 1] }
            }
        }
    }
}

// =====================================================================
// 期次切换 · 顶部的标签条
//   像浏览器的标签页：出过的每一期都留一份正文，点标签就能来回翻。
//   存档最多 5 期（issues.json），只写在本机，不上传任何地方。
// ---------------------------------------------------------------------

fn issue_pick_at(i){
    if i >= issues.len() { return }
    // 最右边（最新）那一枚就是「本期」
    if i == issues.len() - 1 {
        issue_sel = ""
    } else {
        issue_sel = "" + issues[i].id
    }
    sync_ui()
}

fn wb_quick(t){
    wb_arc_q = t
    wb_do_find()
}

fn wb_star_toggle(){
    // 收藏/取消收藏「正在看的这一期」。没在看往期时收藏最新那一期。
    let e = wb_cur_issue()
    if e == nil {
        wb_arc_note = "还没有可收藏的一期 —— 先出一期试试。"
        sync_ui()
        return
    }
    let myid = "" + e.id
    if wb_is_fav(myid) {
        wb_fav_del_id(myid)
        wb_arc_note = "已取消收藏：" + ("" + e.stamp)
    } else {
        wb_fav_add(e)
        wb_arc_note = "已收藏这一期：" + ("" + e.stamp) + "（整期留在收藏夹，退出存档队列也不丢）"
    }
    wb_fav_save()
    sync_ui()
}

fn wb_fav_open(i){
    if i >= wb_favs.len() { return }
    let f = wb_favs[i]
    // 打开收藏的往期：直接点亮结果页看那一期的正文（不依赖 issues 还在不在）。
    issue_sel = "" + f.id
    // 收藏不在 issues 里（已被挤出存档）时，把它临时顶进 issues，
    // 让 issues_rows() 能找到它 —— 复制一份，不污染存档数据。
    if wb_issue_missing("" + f.id) {
        issues.push({id: "" + f.id stamp: "" + f.stamp intro: "" + f.intro rows: f.rows okn: f.okn failn: f.failn})
    }
    wb_run = true
    phase = "done"
    wb_arc_note = "正在看收藏的这一期：" + ("" + f.stamp)
    sync_ui()
}

fn wb_res_open(i){
    if i >= wb_arc_res.len() { return }
    let e = wb_arc_res[i]
    if "" + e.id == "" + issues[issues.len() - 1].id { issue_sel = "" }
    else { issue_sel = "" + e.id }
    wb_run = true
    phase = "done"
    wb_arc_note = "正在看往期：" + ("" + e.stamp)
    sync_ui()
}

fn wb_res_star(i){
    if i >= wb_arc_res.len() { return }
    let e = wb_arc_res[i]
    let myid = "" + e.id
    if wb_is_fav(myid) {
        wb_fav_del_id(myid)
        wb_arc_note = "已取消收藏：" + ("" + e.stamp)
    } else {
        wb_fav_add(e)
        wb_arc_note = "已收藏：" + ("" + e.stamp)
    }
    wb_fav_save()
    sync_ui()
}

fn wb_fav_del(i){
    if i >= wb_favs.len() { return }
    let f = wb_favs[i]
    wb_fav_del_id("" + f.id)
    wb_fav_save()
    wb_arc_note = "已从收藏夹移除：" + ("" + f.stamp)
    sync_ui()
}

// ---- 时间归一：把读者输入折成「月-日」或关键词 ----
// 支持：10月11日 / 10-11 / 10/11 / 1011 / 昨天 / 今天 / 前天。
fn wb_do_find(){
    let q = wb_arc_q.trim()
    wb_arc_res = []
    if issues.len() == 0 && wb_favs.len() == 0 {
        wb_arc_note = "还没有出过报 —— 往期档案是空的。先出一期，这里就有东西可查了。"
        sync_ui()
        return
    }
    if q == "" {
        // 空查询 = 最近三期（存档不够就用收藏夹补位）
        let n = issues.len()
        let k = 0
        for e in issues {
            if k >= n - 3 { wb_arc_res.push(e) }
            k = k + 1
        }
        for f in wb_favs {
            if wb_arc_res.len() >= 3 { break }
            let dup = false
            for e in wb_arc_res { if "" + e.id == "" + f.id { dup = true } }
            if !dup { wb_arc_res.push(f) }
        }
        wb_arc_note = "最近 " + wb_arc_res.len() + " 期（最多列 2 条）"
        wb_trim_res()
        sync_ui()
        return
    }
    let want = wb_norm_date(q)
    if want == "" { want = wb_rel_date(q) }
    if want != "" {
        // 按日期找：命中所有同日的（同一天可能出过多期）
        for e in issues {
            if wb_issue_date(e) == want { wb_arc_res.push(e) }
        }
        if wb_arc_res.len() > 0 {
            wb_arc_note = "找到 " + want + " 的 " + wb_arc_res.len() + " 期"
            wb_trim_res()
            sync_ui()
            return
        }
        // 存档里没有这一天：也许在收藏夹里（存档只留 5 期）
        let fav_hit = []
        for f in wb_favs {
            if wb_issue_date(f) == want { fav_hit.push(f) }
        }
        if fav_hit.len() > 0 {
            wb_arc_note = "存档里没有 " + want + "，但收藏夹里有 " + fav_hit.len() + " 期 —— 点「打开」看它。"
            wb_arc_res = fav_hit
            wb_trim_res()
            sync_ui()
            return
        }
        wb_arc_note = "存档（最近 " + issues.len() + " 期）与收藏夹里都没有 " + want + " 这一天。"
        sync_ui()
        return
    }
    // 关键词：往期正文里找（标题/摘要），最多列 2 条
    let hits = []
    for e in issues {
        let rows = issue_rows_safe(e.rows)
        let hit = false
        for r in rows {
            let hay = "" + r.title + " " + r.summary
            if hay.search(q) >= 0 { hit = true }
        }
        if hit { hits.push(e) }
    }
    if hits.len() == 0 {
        // 关键词也去收藏夹里找一遍（老期次被挤出存档时仍可查）
        for f in wb_favs {
            let rows = issue_rows_safe(f.rows)
            let hit = false
            for r in rows {
                let hay = "" + r.title + " " + r.summary
                if hay.search(q) >= 0 { hit = true }
            }
            if hit { hits.push(f) }
        }
        if hits.len() > 0 {
            wb_arc_note = "存档里没找到「" + q + "」，收藏夹里找到 " + hits.len() + " 期"
            wb_arc_res = hits
            wb_trim_res()
            sync_ui()
            return
        }
        wb_arc_note = "没找到含「" + q + "」的往期。可以试试日期（10月11日 / 1011 / 昨天）或换个关键词。"
        sync_ui()
        return
    }
    wb_arc_res = hits
    wb_arc_note = "含「" + q + "」的往期共 " + hits.len() + " 期（最多列 2 条）"
    wb_trim_res()
    sync_ui()
}

fn wb_fav_open1(){
    if wb_favs.len() >= 1 { wb_fav_open(wb_fav_i1()) }
}

fn wb_fav_del1(){
    if wb_favs.len() >= 1 { wb_fav_del(wb_fav_i1()) }
}

fn wb_fav_open2(){
    if wb_favs.len() >= 2 { wb_fav_open(wb_fav_i2()) }
}

fn wb_fav_del2(){
    if wb_favs.len() >= 2 { wb_fav_del(wb_fav_i2()) }
}

fn make_plan(){
    phase = "plan"
    sync_ui()
    host.request("model.complete", {
        // 探测 schema 的 key 不能叫 ok —— splash 把裸的 ok 当关键字
        // （parser.rs: `if id == id!(ok)`），会当成 ok 表达式来解析。
        task: "这是一次可用性探测。只回答一个 JSON 对象，ready 为 true。"
        input: "probe"
        schema: {type: "object" required: ["ready"] properties: {ready: {type: "boolean"}}}
        class: "fast"
    }, fn(r){
        if r.is_ok && r.data != nil && r.data.output != nil {
            ai_ready = 1
            ai_model = "咕嘎 · 主编"
        } else {
            ai_ready = 0
        }
        sync_ui()
    })
}

