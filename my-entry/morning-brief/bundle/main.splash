    {id: "hn"       plat: "hn"       label: "Hacker News"  host: "hn.algolia.com"   note: "首页热榜 30 条" kind: "hn"     url: "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=30"}
